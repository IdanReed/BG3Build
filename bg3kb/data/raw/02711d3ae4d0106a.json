.png/38px-Rarity_Icon.png.webp 1.5x, /w/images/e/ef/Rarity_Icon.png 2x\"><img alt=\"Rarity: Common\" src=\"/w/images/thumb/e/ef/Rarity_Icon.png/25px-Rarity_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ef/Rarity_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Rarity: Common</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp, /w/images/thumb/e/ea/Weight_Icon.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 2 kg (4 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 2 kg (4 lb)</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 14 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  14  gp</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"￼START_WIDGET&quot;'-fd775c0e7a88c362END_WIDGET ￼START_WIDGET&quot;'-531692ec7d2f50e8END_WIDGET\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">S_DEN_NarrativeLoot_IdolBook</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:S_DEN_NarrativeLoot_IdolBook\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:S_DEN_NarrativeLoot_IdolBook\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">f09a77cc-fa1c-45c3-abb0-7cdb2349e957</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:f09a77cc-fa1c-45c3-abb0-7cdb2349e957\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:f09a77cc-fa1c-45c3-abb0-7cdb2349e957\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div>   \n<div style=\"clear: both;\"></div></div>\n    <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>In the <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Servants%27_Quarters\" title=\"Servants' Quarters\"><picture><source srcset=\"/w/images/thumb/0/02/Custom_Map_Icon.png/25px-Custom_Map_Icon.png.webp, /w/images/thumb/0/02/Custom_Map_Icon.png/38px-Custom_Map_Icon.png.webp 1.5x, /w/images/thumb/0/02/Custom_Map_Icon.png/50px-Custom_Map_Icon.png.webp 2x\"><img alt=\"Servants' Quarters\" src=\"/w/images/thumb/0/02/Custom_Map_Icon.png/25px-Custom_Map_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/02/Custom_Map_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Servants%27_Quarters\" class=\"mw-redirect\" title=\"Servants' Quarters\">Servants' Quarters</a> at <span class=\"bg3wiki-coordinates\">X:&nbsp;-472&nbsp;Y:&nbsp;4</span></li></ul>\n</div>  <h2><span class=\"mw-headline\" id=\"Text\"> Text </span></h2>\n<div class=\"bg3wiki-book-text\">\n<p>[The tablet catalogues various magical artefacts of druidic nature. One particular entry has been outlined.]\n</p><p><br>\n</p><p><a href=\"/wiki/Idol_of_Silvanus\" title=\"Idol of Silvanus\">Idol of Silvanus</a>\n</p><p><br>\n</p><p>A ritual relic formed from the wood and resin of an oak touched by the Forest Father himself. Pray to it quietly to reap <a href=\"/wiki/Silvanus\" title=\"Silvanus\">Silvanus'</a> blessing and commune with nature.\n</p><p><br>\n</p><p>[Below the entry, a chalked note snakes across the stone.]\n</p><p><br>\n</p><p>So much more. More prayer, more power. RITE OF THORNS.\n</p>\n</div> <h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<p>See also:\n</p>\n<ul><li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Rite_of_Thorns_(scroll)\" title=\"Rite of Thorns (scroll)\"><picture><source srcset=\"/w/images/thumb/1/1b/BOOK_Generic_Druid_Rite_Unfa