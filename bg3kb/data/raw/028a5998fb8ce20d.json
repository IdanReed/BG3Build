olor pi-item-spacing\" data-source=\"con\">+1</td>\n\t\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"int\">0</td>\n\t\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"wis\">0</td>\n\t\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"cha\">+1</td>\n\t\t</tr>\n\t</tbody>\n</table></section><section class=\"pi-item pi-group pi-border-color\"><h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Resistances <sup><a href=\"/wiki/Resistances\" title=\"Resistances\">(info)</a></sup></h2><div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"resistances\" data-item-name=\"resistances\">\n\t<div class=\"pi-data-value pi-font\"><ul><li><span typeof=\"mw:File\"><span title=\"Resistant to all Poison\"><picture><source srcset=\"/w/images/thumb/0/0b/Poison_Resistance_Full.png/28px-Poison_Resistance_Full.png.webp, /w/images/thumb/0/0b/Poison_Resistance_Full.png/42px-Poison_Resistance_Full.png.webp 1.5x, /w/images/thumb/0/0b/Poison_Resistance_Full.png/56px-Poison_Resistance_Full.png.webp 2x\"><img alt=\"Resistant to all Poison\" src=\"/w/images/thumb/0/0b/Poison_Resistance_Full.png/28px-Poison_Resistance_Full.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/0/0b/Poison_Resistance_Full.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li></ul></div>\n</div></section><section class=\"pi-item pi-group pi-border-color\"><h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Features</h2><div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"passives\" data-item-name=\"passives\">\n\t<div class=\"pi-data-value pi-font\"><ul><li><div class=\"bg3wiki-pi-creature-detail\"><div class=\"bg3wiki-pi-creature-detail-title\"><p><span class=\"bg3wiki-icontext-block\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Darkvision\" title=\"Darkvision\"><picture><source srcset=\"/w/images/thumb/0/0d/Darkvision_Icon.webp/25px-Darkvision_Icon.webp, /w/images/thumb/0/0d/Darkvision_Icon.webp/38px-Darkvision_Icon.webp 1.5x, /w/images/thumb/0/0d/Darkvision_Icon.webp/50px-Darkvision_Icon.webp 2x\"><img alt=\"Darkvision\" src=\"/w/images/thumb/0/0d/Darkvision_Icon.webp/25px-Darkvision_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0d/Darkvision_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Darkvision\" title=\"Darkvision\"><b>Darkvision</b></a></span></p></div><div class=\"bg3wiki-pi-creature-detail-text\"><p>Can see in the dark up to a certain distance.</p></div></div></li><li><div class=\"bg3wiki-pi-creature-detail\"><div class=\"bg3wiki-pi-creature-detail-title\"><p><span class=\"bg3wiki-icontext-block\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Dwarven_Resilience\" title=\"Dwarven Resilience\"><picture><source srcset=\"/w/images/thumb/1/16/Dwarven_Resilience_Icon.webp/25px-Dwarven_Resilience_Icon.webp, /w/images/thumb/1/16/Dwarven_Resilience_Icon.webp/38px-Dwarven_Resilience_Icon.webp 1.5x, /w/images/thumb/1/16/Dwarven_Resilience_Icon.webp/50px-Dwarven_Resilience_Icon.webp 2x\"><img alt=\"Dwarven Resilience\" src=\"/w/images/thumb/1/16/Dwarven_Resilience_Icon.webp/25px-Dwarven_Resilience_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/16/Dwarven_Resilience_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Dwarven_Resilience\" title=\"Dwarven Resilience\"><b>Dwarven Resilience</b></a></span></p></div><div class=\"bg3wiki-pi-creature-detail-text\"><p><a href=\"/wiki/Advantage\" title=\"Advantage\">Advantage</a> on <a href=\"/wiki/Saving_throw\" class=\"mw-redirect\" title=\"Saving throw\">saving throws</a> against being <a href=\"/wiki/Poisoned_(Condition)\" title=\"Poisoned (Condition)\">poisoned</a> and <a href=\"/wiki/Resistance\" class=\"mw-redirect\" title=\"Resistance\">resistance</a> to <a href=\"/wiki/Poison\" title=\"Poison\">poison</a> damage.</p></div></div></li><li><div class=\"bg3wiki-pi-creature-detail\"><div class=\"bg3wiki-pi-creature-detail-title\"><p><span class=\"bg3wiki-icontext-block\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Fast_Hands\" title=\"Fast Hands\"><picture><source srcset=\"/w/images/thumb/d/dc/Fast_Hands_Icon.webp/25px-Fast_Hands_Icon.webp, /w/images/thumb/d/dc/Fast_Hands_Icon.webp/38px-Fast_Hands_Icon.webp 1.5x, /w/images/thumb/d/dc/Fast_Hands_Icon.webp/50px-Fast_Hands_Icon.webp 2x\"><img alt=\"Fast Hands\" src=\"/w/images/thumb/d/dc/Fast_Hands_Icon.webp/25px-Fast_Hands_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/dc/Fast_Hands_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Fast_Hands\" title=\"Fast Hands\"><b>Fast Hands</b></a></span></p></div><div class=\"bg3wiki-pi-creature-detail-text\"><p>Gain an extra <a href=\"/wiki/Bonus_action\" class=\"mw-redirect\" title=\"Bonus action\">bonus action</a>.</p></div></div></li><li><div class=\"bg3wiki-pi-creature-detail\"><div class=\"bg3wiki-pi-creature-detail-title\"><p><span class=\"bg3wiki-icontext-block\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Opportunity_Attack\" title=\"Opportunity Attack\"><picture><source srcset=\"/w/images/thumb/3/35/Opportunity_Attack_Icon.webp/25px-Opportunity_Attack_Icon.webp, /w/images/thumb/3/35/Opportunity_Attack_Icon.webp/38px-Opportunity_Attack_Icon.webp 1.5x, /w/images/thumb/3/35/Opportunity_Attack_Icon.webp/50px-Opportunity_Attack_Icon.webp 2x\"><img alt=\"Opportunity Attack\" src=\"/w/images/thumb/3/35/Opportunity_Attack_Icon.webp/25px-Opportunity_Attack_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/35/Opportunity_Attack_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Opportunity_Attack\" title=\"Opportunity Attack\"><b>Opportunity Attack</b></a></span></p></div><div class=\"bg3wiki-pi-creature-detail-text\"><p>Attack an enemy moving out of reach.</p></div></div></li><li><div class=\"bg3wiki-pi-creature-detail\"><div class=\"bg3wiki-pi-creature-detail-title\"><p><span class=\"bg3wiki-icontext-block\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Second-Story_Work\" title=\"Second-Story Work\"><picture><source srcset=\"/w/images/thumb/1/1d/Second-Story_Work_Icon.webp/25px-Second-Story_Work_Icon.webp, /w/images/thumb/1/1d/Second-Story_Work_Icon.webp/38px-Second-Story_Work_Icon.webp 1.5x, /w/images/thumb/1/1d/Second-Story_Work_Icon.webp/50px-Second-Story_Work_Icon.webp 2x\"><img alt=\"Second-Story Work\" src=\"/w/images/thumb/1/1d/Second-Story_Work_Icon.webp/25px-Second-Story_Work_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/1d/Second-Story_Work_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Second-Story_Work\" title=\"Second-Story Work\"><b>Second-Story Work</b></a></span></p></div><div class=\"bg3wiki-pi-creature-detail-text\"><p>You've mastered the art of falling and gain <a href=\"/wiki/Resistance\" class=\"mw-redirect\" title=\"Resistance\">Resistance</a> to <a href=\"/wiki/Falling_damage\" title=\"Falling damage\">Falling damage</a>.</p></div></div></li></ul></div>\n</div></section></section>\n\t\t\t</div>\n\t</div>\n</section></aside>\n<b>Rurik</b> was a <a href=\"/wiki/Dwarf\" title=\"Dwarf\">Dwarf</a> <a href=\"/wiki/Rogue\" title=\"Rogue\">Rogue</a> located outside the <a href=\"/wiki/The_Risen_Road#Toll_House\" title=\"The Risen Road\">Risen Road Toll House</a>, in <a href=\"/wiki/Early_Access\" title=\"Early Access\">Early Access</a>. \n<h2><span class=\"mw-headline\" id=\"Involvement\">Involvement</span></h2>\n<p>Rurik was one of <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Anders\" title=\"Anders\"><picture><source srcset=\"/w/images/thumb/c/ce/Portrait_Anders.png/25px-Portrait_Anders.png.webp, /w/images/thumb/c/ce/Portrait_Anders.png/38px-Portrait_Anders.png.webp 1.5x, /w/images/thumb/c/ce/Portrait_Anders.png/50px-Portrait_Anders.png.webp 2x\"><img alt=\"Anders'\" src=\"/w/images/thumb/c/ce/Portrait_Anders.png/25px-Portrait_Anders.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/ce/Portrait_Anders.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Anders\" title=\"Anders\">Anders'</a> companions in the <a href=\"/wiki/The_Risen_Road#Toll_House\" title=\"The Risen Road\">Risen Road Toll House</a>, who are hunting Karlach.\n</p><p>If the party entered combat with Anders, Rurik would join the fight and defend him. Rurik was a <a href=\"/wiki/Thief\" title=\"Thief\">Thief</a> Rogue and carried a <a href=\"/wiki/Smokepowder_Bomb\" title=\"Smokepowder Bomb\">Smokepowder Bomb</a> with him. \n</p>\n<div class=\"navbox-styles\"><s