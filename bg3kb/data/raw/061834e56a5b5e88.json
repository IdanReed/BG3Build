e/e7/Saving_Throw_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Constitution\" title=\"Constitution\">CON</a> <a href=\"/wiki/Saving_throws\" title=\"Saving throws\">Save</a>\n</td>\n<td><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Green_Dragonborn\" title=\"Green Dragonborn\"><picture><source srcset=\"/w/images/thumb/a/a4/Race_Green_Dragonborn.png/25px-Race_Green_Dragonborn.png.webp, /w/images/thumb/a/a4/Race_Green_Dragonborn.png/38px-Race_Green_Dragonborn.png.webp 1.5x, /w/images/thumb/a/a4/Race_Green_Dragonborn.png/50px-Race_Green_Dragonborn.png.webp 2x\"><img alt=\"Green Dragonborn\" src=\"/w/images/thumb/a/a4/Race_Green_Dragonborn.png/25px-Race_Green_Dragonborn.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a4/Race_Green_Dragonborn.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Green_Dragonborn\" class=\"mw-redirect\" title=\"Green Dragonborn\">Green Dragonborn</a>\n</td></tr></tbody></table>\n<p>Outside of the differences listed in the table, all breath weapons are the same:\n</p><p><span class=\"bg3wiki-info-blob\"><a href=\"/wiki/Spell_save_DC\" class=\"mw-redirect\" title=\"Spell save DC\">Spell save DC</a> = 8 + <a href=\"/wiki/Constitution\" title=\"Constitution\">Constitution</a> modifier + <a href=\"/wiki/Proficiency_Bonus\" class=\"mw-redirect\" title=\"Proficiency Bonus\">Proficiency Bonus</a></span>\n</p>\n<ul><li>On save, the target still takes half the damage</li>\n<li>Recharge on <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">short rest</a></li>\n<li>Initial damage of 2d6</li>\n<li>Damage increases to 3d6 at level 6</li>\n<li>Damage increases to 4d6 at level 11</li></ul>\n<h2><span class=\"mw-headline\" id=\"Equipment\">Equipment</span></h2>\n<ul><li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-rare\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Drakethroat_Glaive\" title=\"Drakethroat Glaive\"><picture><source srcset=\"/w/images/thumb/0/03/Glaive_PlusTwo_Unfaded_Icon.png/30px-Glaive_PlusTwo_Unfaded_Icon.png.webp, /w/images/thumb/0/03/Glaive_PlusTwo_Unfaded_Icon.png/45px-Glaive_PlusTwo_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/0/03/Glaive_PlusTwo_Unfaded_Icon.png/60px-Glaive_PlusTwo_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/0/03/Glaive_PlusTwo_Unfaded_Icon.png/30px-Glaive_PlusTwo_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/03/Glaive_PlusTwo_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Drakethroat_Glaive\" title=\"Drakethroat Glaive\">Drakethroat Glaive</a></span>: <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Vicious_Dragon_Breath\" title=\"Vicious Dragon Breath\"><picture><source srcset=\"/w/images/thumb/a/a9/Generic_Feature_Icon.webp/20px-Generic_Feature_Icon.webp, /w/images/thumb/a/a9/Generic_Feature_Icon.webp/30px-Generic_Feature_Icon.webp 1.5x, /w/images/thumb/a/a9/Generic_Feature_Icon.webp/40px-Generic_Feature_Icon.webp 2x\"><img alt=\"Vicious Dragon Breath\" src=\"/w/images/thumb/a/a9/Generic_Feature_Icon.webp/20px-Generic_Feature_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a9/Generic_Feature_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Vicious_Dragon_Breath\" title=\"Vicious Dragon Breath\">Vicious Dragon Breath</a> – Enemies have <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Disadvantage\" title=\"Disadvantage\"><picture><source srcset=\"/w/images/thumb/b/b9/Disadvantage_Icon.png/27px-Disadvantage_Icon.png.webp, /w/images/thumb/b/b9/Disadvantage_Icon.png/41px-Disadvantage_Icon.png.webp 1.5x, /w/images/thumb/b/b9/Disadvantage_Icon.png/55px-Disadvantage_Icon.png.webp 2x\"><img alt=\"Disadvantage\" src=\"/w/images/thumb/b/b9/Disadvantage_Icon.png/27px-Disadvantage_Icon.png.webp\" decoding=\"async\" width=\"27\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b9/Disadvantage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Disadvantage\" class=\"mw-redirect\" title=\"Disadvantage\">Disadvantage</a> on <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp, /w/images/e/e7/Saving_Throw_Icon.png 1.5x\"><img alt=\"Saving Throw\" src=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/e7/Saving_Throw_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Saving_Throw\" class=\"mw-redirect\" title=\"Saving Throw\">Saving Throws</a> against your <a href=\"/wiki/Dragonborn\" title=\"Dragonborn\">dragonborn</a> breath weapon.</li></ul>\n<h2><span class=\"mw-headline\" id=\"Notes\">Notes</span></h2>\n<ul><li>Although similar in name, visuals, and mechanics, <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Dazzling_Breath\" title=\"Dazzling Breath\"><picture><source srcset=\"/w/images/thumb/b/b3/Dazzling_Breath_Icon.webp/20px-Dazzling_Breath_Icon.webp, /w/images/thumb/b/b3/Dazzling_Breath_Icon.webp/30px-Dazzling_Breath_Icon.webp 1.5x, /w/images/thumb/b/b3/Dazzling_Breath_Icon.webp/40px-Dazzling_Breath_Icon.webp 2x\"><img alt=\"Dazzling Breath\" src=\"/w/images/thumb/b/b3/Dazzling_Breath_Icon.webp/20px-Dazzling_Breath_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b3/Dazzling_Breath_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dazzling_Breath\" title=\"Dazzling Breath\">Dazzling Breath</a> is noticably <i>not</i> a dragonborn breath weapon, but a <a href=\"/wiki/Circle_of_Stars\" class=\"mw-redirect\" title=\"Circle of Stars\">Circle of Stars</a> subclass feature.</li></ul>\n<h2><span class=\"mw-headline\" id=\"External_links\">External links</span></h2>\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Dragon_breath\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/images/thumb/6/68/FRWiki_Icon.png/44px-FRWiki_Icon.png.webp 2x\"><img alt=\"Dragon breath\" src=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/FRWiki_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <span class=\"bg3wiki-icontext-extlink\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Dragon_breath\">Dragon breath</a></span> on the <a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external t