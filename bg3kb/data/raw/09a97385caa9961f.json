con.png/30px-Piercing_Damage_Icon.png.webp 1.5x, /w/images/thumb/0/0b/Piercing_Damage_Icon.png/40px-Piercing_Damage_Icon.png.webp 2x\"><img alt=\"Piercing\" src=\"/w/images/thumb/0/0b/Piercing_Damage_Icon.png/20px-Piercing_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0b/Piercing_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Piercing\" title=\"Piercing\"><span class=\"bg3wiki-damage-type-piercing\">Piercing</span></a></div><div style=\"white-space:nowrap\"> + <span class=\"bg3wiki-damage-type-poison\">1d4</span><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Poison\" title=\"Poison\"><picture><source srcset=\"/w/images/thumb/5/55/Poison_Damage_Icon.png/20px-Poison_Damage_Icon.png.webp, /w/images/thumb/5/55/Poison_Damage_Icon.png/30px-Poison_Damage_Icon.png.webp 1.5x, /w/images/thumb/5/55/Poison_Damage_Icon.png/40px-Poison_Damage_Icon.png.webp 2x\"><img alt=\"Poison\" src=\"/w/images/thumb/5/55/Poison_Damage_Icon.png/20px-Poison_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/55/Poison_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Poison\" title=\"Poison\"><span class=\"bg3wiki-damage-type-poison\">Poison</span></a> (On a failed save)</div></div></div></dd>\n<dt>Details</dt>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp, /w/images/thumb/b/ba/Attack_Roll_Icon.png/38px-Attack_Roll_Icon.png.webp 1.5x, /w/images/thumb/b/ba/Attack_Roll_Icon.png/50px-Attack_Roll_Icon.png.webp 2x\"><img alt=\"Attack