-Range_Icon.png.webp 1.5x, /w/images/0/08/Range_Icon.png 2x\"><img alt=\"Range: 2.5 m (8 ft)\" src=\"/w/images/thumb/0/08/Range_Icon.png/25px-Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/0/08/Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Range: 2.5 m (8 ft)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp, /w/images/thumb/e/ea/Weight_Icon.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 8.1 kg (16.2 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 8.1 kg (16.2 lb)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 65 gp / 250 gpHHonour\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  65  gp /  250  gp<abbr title=\"Honour mode only\" class=\"bg3wiki-damage-rider-source nomobile\">H</abbr><sup class=\"mobileonly\">Honour</sup></dd>\n<dd><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">MAG_Throwable_Pike</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:MAG_Throwable_Pike\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:MAG_Throwable_Pike\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">1047ac9f-7860-44fd-9154-0f06fe64936c</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:1047ac9f-7860-44fd-9154-0f06fe64936c\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:1047ac9f-7860-44fd-9154-0f06fe64936c\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>Stats</summary>\n<code class=\"bg3wiki-uid-box\">MAG_Throwable_Pike</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:MAG_Throwable_Pike+type:stat\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:MAG_Throwable_Pike+type:stat\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></dd></dl>\n</div> \n<h3><span class=\"mw-headline\" id=\"Special\"> Special </span></h3>\n<p><b>The holder of this item gains:</b>\n\n</p>\n<dl><dt><a href=\"/wiki/Homing_Weapon\" title=\"Homing Weapon\">Homing Weapon</a></dt><dd>This weapon will return to its owner when thrown.</dd></dl>\n<h3><span class=\"mw-headline\" id=\"Weapon_actions\"> Weapon actions </span></h3>\n<p><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp, /w/images/2/2d/Proficiency_Icon.png 1.5x\"><img alt=\"Proficiency Icon.png\" src=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2d/Proficiency_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <i>If you have <a href=\"/wiki/Proficiency\" title=\"Proficiency\">proficiency</a>, equip in <strong>main hand</strong> to gain:</i>\n</p>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Brace_(Melee)\" title=\"Brace (Melee)\"><picture><source srcset=\"/w/images/thumb/f/fd/Brace_Melee_Icon.webp/40px-Brace_Melee_Icon.webp, /w/images/thumb/f/fd/Brace_Melee_Icon.webp/60px-Brace_Melee_Icon.webp 1.5x, /w/images/thumb/f/fd/Brace_Melee_Icon.webp/80px-Brace_Melee_Icon.webp 2x\"><img alt=\"Brace (Melee)\" src=\"/w/images/thumb/f/fd/Brace_Melee_Icon.webp/40px-Brace_Melee_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/fd/Brace_Melee_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Brace_(Melee)\" title=\"Brace (Melee)\">Brace (Melee)</a> (<span aria-label=\"Movement Speed\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/9/97/Movement_Speed_Icon.png/23px-Movement_Speed_Icon.png.webp, /w/images/9/97/Movement_Speed_Icon.png 1.5x\"><img alt=\"Movement Speed\" src=\"/w/images/thumb/9/97/Movement_Speed_Icon.png/23px-Movement_Speed_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/9/97/Movement_Speed_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Spend 6 m (20 ft) of your <a href=\"/wiki/Movement_Speed\" class=\"mw-redirect\" title=\"Movement Speed\">movement</a>. For the rest of your turn, roll melee damage twice and use the highest result. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Piercing_Strike\" title=\"Piercing Strike\"><picture><source srcset=\"/w/images/thumb/c/c4/Piercing_Strike_Icon.webp/40px-Piercing_Strike_Icon.webp, /w/images/thumb/c/c4/Piercing_Strike_Icon.webp/60px-Piercing_Strike_Icon.webp 1.5x, /w/images/thumb/c/c4/Piercing_Strike_Icon.webp/80px-Piercing_Strike_Icon.webp 2x\"><img alt=\"Piercing Strike\" src=\"/w/images/thumb/c/c4/Piercing_Strike_Icon.webp/40px-Piercing_Strike_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c4/Piercing_Strike_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Piercing_Strike\" title=\"Piercing Strike\">Piercing Strike</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Stab an enemy and possibly inflict <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Gaping_Wounds_(Condition)\" title=\"Gaping Wounds (Condition)\"><picture><source srcset=\"/w/images/thumb/a/ab/Open_Wound_Condition_Icon.webp/25px-Open_Wound_Condition_Icon.webp, /w/images/thumb/a/ab/Open_Wound_Condition_Icon.webp/38px-Open_Wound_Condition_Icon.webp 1.5x, /w/images/thumb/a/ab/Open_Wound_Condition_Icon.webp/50px-Open_Wound_Condition_Icon.webp 2x\"><img alt=\"Gaping Wounds\" src=\"/w/images/thumb/a/ab/Open_Wound_Condition_Icon.webp/25px-Open_Wound_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/ab/Open_Wound_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Gaping_Wounds_(Condition)\" title=\"Gaping Wounds (Condition)\">Gaping Wounds</a>. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Rush_Attack\" title=\"Rush Attack\"><picture><source srcset=\"/w/images/thumb/1/1a/Rush_Attack_Icon.webp/40px-Rush_Attack_Icon.webp, /w/images/thumb/1/1a/Rush_Attack_Icon.webp/60px-Rush_Attack_Icon.webp 1.5x, /w/images/thumb/1/1a/Rush_Attack_Icon.webp/80px-Rush_Attack_Icon.webp 2x\"><img alt=\"Rush Attack\" src=\"/w/images/thumb/1/1a/Rush_Attack_Icon.webp/40px-Rush_Attack_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/1a/Rush_Attack_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Rush_Attack\" title=\"Rush Attack\">Rush Attack</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Charge forward and attack the first enemy in your way, possibly pushing them <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Off_Balance_(Condition)\" title=\"Off Balance (Condition)\"><picture><source srcset=\"/w/images/thumb/3/3e/Off_Balance_Condition_Icon.webp/20px-Off_Balance_Condition_Icon.webp, /w/images/thumb/3/3e/Off_Balance_Condition_Icon.webp/30px-Off_Balance_Condition_Icon.webp 1.5x, /w/images/thumb/3/3e/Off_Balance_Condition_Icon.webp/40px-Off_Balance_Condition_Icon.webp 2x\"><img alt=\"Off Balance\" src=\"/w/images/thumb/3/3e/Off_Balance_Condition_Icon.webp/20px-Off_Balance_Condition_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/3e/Off_Balance_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Off_Balance_(Condition)\" title=\"Off Balance (Condition)\">Off Balance</a>. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl></div> \n<h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li><a href=\"/wiki/Goblin_Camp\" title=\"Goblin Camp\">Goblin Camp</a> <span class=\"bg3wiki-coordinates\">X:&nbsp;-99&nbsp;Y:&nbsp;424</span>: Sold by <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Grat\" title=\"Grat\"><picture><source srcset=\"/w/images/thumb/f/f7/Portrait_Grat.png/25px-Portrait_Grat.png.webp, /w/images/thumb/f/f7/Portrait_Grat.png/38px-Portrait_Grat.png.webp 1.5x, /w/images/thumb/f/f7/Portrait_Grat.png/50px-Portrait_Grat.png.webp 2x\"><img alt=\"Grat the Trader\" src=\"/w/images/thumb/f/f7/Portrait_Grat.png/25px-Portrait_Grat.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f7/Portrait_Grat.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Grat\" title=\"Grat\">Grat the Trader</a></li></ul>\n</div> \n<h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>Returning Pike is the only pike in the game with the <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Thrown\" title=\"Thrown\"><picture><source srcset=\"/w/images/thumb/2/21/Thrown_Icon.png/25px-Thrown_Icon.png.webp, /w/images/thumb/2/21/Thrown_Icon.png/38px-Thrown_Icon.png.webp 1.5x, /w/images/thumb/2/21/Thrown_Icon.png/50px-Thrown_Icon.png.webp 2x\"><img alt=\"Thrown\" src=\"/w/images/thumb/2/21/Thrown_Icon.png/25px-Thrown_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/21/Thrown_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Thrown\" title=\"Thrown\">Thrown</a> property.</li>\n<li>Returning Pike is automatically equipped to the <i>Main Hand</i> (melee) of the thrower after being thrown even if it was not already equipped, potentially replacing any currently equipped melee weapons. This can allow for swapping weapons in combat without using an action.</li>\n<li>With higher than normal base damage for a thrown weapon (d10 versus a typical d8 or d6) and its <a href=\"/wiki/Homing_Weapon\" title=\"Homing Weapon\">returning</a> property, the Returning Pike works well early in the game with <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Tavern_Brawler\" title=\"Tavern Brawler\"><picture><source srcset=\"/w/images/thumb/3/31/Tavern_Brawler_Icon.webp/25px-Tavern_Brawler_Icon.webp, /w/images/thumb/3/31/Tavern_Brawler_Icon.webp/38px-Tavern_Brawler_Icon.webp 1.5x, /w/images/thumb/3/31/Tavern_Brawler_Icon.webp/50px-Tavern_Brawler_Icon.webp 2x\"><img alt=\"Tavern Brawler\" src=\"/w/images/thumb/3/31/Tavern_Brawler_Icon.webp/25px-Tavern_Brawler_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/31/Tavern_Brawler_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Tavern_Brawler\" title=\"Tavern Brawler\">Tavern Brawler</a> and <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Enraged_Throw\" title=\"Enraged Throw\"><picture><source srcset=\"/w/images/thumb/c/cf/Enraged_Throw_Icon.webp/25px-Enraged_Throw_Icon.webp, /w/images/thumb/c/cf/Enraged_Throw_Icon.webp/38px-Enraged_Throw_Icon.webp 1.5x, /w/images/thumb/c/cf/Enraged_Throw_Icon.webp/50px-Enraged_Throw_Icon.webp 2x\"><img alt=\"Enraged Throw\" src=\"/w/images/thumb/c/cf/Enraged_Throw_Icon.webp/25px-Enraged_Throw_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/cf/Enraged_Throw_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Enraged_Throw\" title=\"Enraged Throw\">Enraged Throw</a>.</li></ul>\n\n</div> \n<h2><span class=\"mw-headline\" id=\"Bugs\"> Bugs </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n\n<p><i>Regarding Homing Weapon:</i></p>\n<ul><li>Once a weapon with the Homing Weapon passive is dropped, this passive will not show if the weapon is examined while it is on the ground. Aditionally, when a dropped weapon with this passive is subsequently picked up and thrown (regardless of which character throws it), it will return to the <i>Main Hand</i> (melee) of the character who initially dropped the item.</li></ul>\n</div>    \n<!-- \nNewPP limit report\nCached time: 20260714194926\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.139 seconds\nReal time usage: 0.149 seconds\nPreprocessor visited node count: 5310/1000000\nPost‐expand include size: 74789/4194304 bytes\nTemplate argument size: 14938/4194304 bytes\nHighest expansion depth: 28/200\nExpensive parser function count: 1/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 4/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.046/7.000 seconds\nLua memory usage: 1727384/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%  122.795      1 Template:WeaponPage\n100.00%  122.795      1 -total\n 27.96%   34.330     20 Template:Icon_