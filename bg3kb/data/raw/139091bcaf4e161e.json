iew source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Gale\" title=\"Gale\">Gale</a></dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/2a/Melee_Range_Icon.png/25px-Melee_Range_Icon.png.webp, /w/images/thumb/2/2a/Melee_Range_Icon.png/38px-Melee_Range_Icon.png.webp 1.5x, /w/images/2/2a/Melee_Range_Icon.png 2x\"><img alt=\"Melee: 1.5 m (5 ft)\" src=\"/w/images/thumb/2/2a/Melee_Range_Icon.png/25px-Melee_Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2a/Melee_Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Melee: 1.5 m (5 ft)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp, /w/images/thumb/e/ea/Weight_Icon.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 1.35 kg (2.7 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 1.35 kg (2.7 lb)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 200 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  200  gp</dd>\n<dd><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">CHA_CompassSpear</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:CHA_CompassSpear\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:CHA_CompassSpear\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">7fdf8022-629a-4b34-b0c0-3295bfb2903d</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:7fdf8022-629a-4b34-b0c0-3295bfb2903d\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:7fdf8022-629a-4b34-b0c0-3295bfb2903d\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>Stats</summary>\n<code class=\"bg3wiki-uid-box\">CHA_CompassSpear</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:CHA_CompassSpear+type:stat\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:CHA_CompassSpear+type:stat\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></dd></dl>\n</div> \n<h3><span class=\"mw-headline\" id=\"Special\"> Special </span></h3>\n<p><b>The holder of this item gains:</b>\n\n</p>\n<dl><dt><a href=\"/wiki/Death%27s_Promise\" title=\"Death's Promise\">Death's Promise</a></dt><dd>When the spear misses its target, the wielder's next <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp, /w/images/thumb/b/ba/Attack_Roll_Icon.png/38px-Attack_Roll_Icon.png.webp 1.5x, /w/images/thumb/b/ba/Attack_Roll_Icon.png/50px-Attack_Roll_Icon.png.webp 2x\"><img alt=\"Attack roll\" src=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/b/ba/Attack_Roll_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Attack_roll\" class=\"mw-redirect\" title=\"Attack roll\">Attack roll</a> against that target gains <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/True_Strike_(Condition)\" title=\"True Strike (Condition)\"><picture><source srcset=\"/w/images/thumb/e/ef/True_Strike_Condition_Icon.webp/25px-True_Strike_Condition_Icon.webp, /w/images/thumb/e/ef/True_Strike_Condition_Icon.webp/38px-True_Strike_Condition_Icon.webp 1.5x, /w/images/thumb/e/ef/True_Strike_Condition_Icon.webp/50px-True_Strike_Condition_Icon.webp 2x\"><img alt=\"True Strike\" src=\"/w/images/thumb/e/ef/True_Strike_Condition_Icon.webp/25px-True_Strike_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/ef/True_Strike_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/True_Strike_(Condition)\" title=\"True Strike (Condition)\">True Strike</a>.</dd></dl>\n<h3><span class=\"mw-headline\" id=\"Weapon_actions\"> Weapon actions </span></h3>\n<p><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp, /w/images/2/2d/Proficiency_Icon.png 1.5x\"><img alt=\"Proficiency Icon.png\" src=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2d/Proficiency_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <i>If you have <a href=\"/wiki/Proficiency\" title=\"Proficiency\">proficiency</a>, equip in <strong>main hand</strong> to gain:</i>\n</p>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Rush_Attack\" title=\"Rush Attack\"><picture><source srcset=\"/w/images/thumb/1/1a/Rush_Attack_Icon.webp/40px-Rush_Attack_Icon.webp, /w/images/thumb/1/1a/Rush_Attack_Icon.webp/60px-Rush_Attack_Icon.webp 1.5x, /w/images/thumb/1/1a/Rush_Attack_Icon.webp/80px-Rush_Attack_Icon.webp 2x\"><img alt=\"Rush Attack\" src=\"/w/images/thumb/1/1a/Rush_Attack_Icon.webp/40px-Rush_Attack_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/1a/Rush_Attack_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Rush_Attack\" title=\"Rush Attack\">Rush Attack</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Charge forward and attack the first enemy in your way, possibly pushing them <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Off_Balance_(Condition)\" title=\"Off Balance (Condition)\"><picture><source srcset=\"/w/images/thumb/3/3e/Off_Balance_Condition_Icon.webp/20px-Off_Balance_Condition_Icon.webp, /w/images/thumb/3/3e/Off_Balance_Condition_Icon.webp/30px-Off_Balance_Condition_Icon.webp 1.5x, /w/images/thumb/3/3e/Off_Balance_Condition_Icon.webp/40px-Off_Balance_Condition_Icon.webp 2x\"><img alt=\"Off Balance\" src=\"/w/images/thumb/3/3e/Off_Balance_Condition_Icon.webp/20px-Off_Balance_Condition_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/3e/Off_Balance_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Off_Balance_(Condition)\" title=\"Off Balance (Condition)\">Off Balance</a>. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl></div> \n<h2><span class=\"mw-headline\" id=\"Condition:_True_Strike\"> Condition: True Strike </span></h2>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\">\n<div class=\"bg3wiki-condition\"><strong><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/True_Strike_(Condition)\" title=\"True Strike (Condition)\"><picture><source srcset=\"/w/images/thumb/e/ef/True_Strike_Condition_Icon.webp/30px-True_Strike_Condition_Icon.webp, /w/images/thumb/e/ef/True_Strike_Condition_Icon.webp/45px-True_Strike_Condition_Icon.webp 1.5x, /w/images/thumb/e/ef/True_Strike_Condition_Icon.webp/60px-True_Strike_Condition_Icon.webp 2x\"><img alt=\"True Strike\" src=\"/w/images/thumb/e/ef/True_Strike_Condition_Icon.webp/30px-True_Strike_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/ef/True_Strike_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/True_Strike_(Condition)\" title=\"True Strike (Condition)\">True Strike</a></strong><p><span class=\"bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp, /w/images/thumb/6/6a/Duration_Icons.png/38px-Duration_Icons.png.webp 1.5x, /w/images/thumb/6/6a/Duration_Icons.png/50px-Duration_Icons.png.webp 2x\"><img alt=\"Duration Icons.png\" src=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/6/6a/Duration_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Duration: 2  turns</p>\n<div>\n<ul><li>The spellcaster has <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Advantage\" title=\"Advantage\"><picture><source srcset=\"/w/images/thumb/f/fc/Advantage_Icon.png/28px-Advantage_Icon.png.webp, /w/images/thumb/f/fc/Advantage_Icon.png/42px-Advantage_Icon.png.webp 1.5x, /w/images/thumb/f/fc/Advantage_Icon.png/55px-Advantage_Icon.png.webp 2x\"><img alt=\"Advantage\" src=\"/w/images/thumb/f/fc/Advantage_Icon.png/28px-Advantage_Icon.png.webp\" decoding=\"async\" width=\"28\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/fc/Advantage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Advantage\" title=\"Advantage\">Advantage</a> on <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp, /w/images/thumb/b/ba/Attack_Roll_Icon.png/38px-Attack_Roll_Icon.png.webp 1.5x, /w/images/thumb/b/ba/Attack_Roll_Icon.png/50px-Attack_Roll_Icon.png.webp 2x\"><img alt=\"Attack Roll\" src=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/b/ba/Attack_Roll_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Attack_Roll\" class=\"mw-redirect\" title=\"Attack Roll\">Attack Rolls</a> against this creature.</li></ul>\n</div>\n </div>\n</div>\n<h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li><a href=\"/wiki/Dank_Crypt\" class=\"mw-redirect\" title=\"Dank Crypt\">Dank Crypt</a> <span class=\"bg3wiki-coordinates\">X:&nbsp;-293&nbsp;Y:&nbsp;-323</span>: In the sarcophagus surrounded by statues and traps</li></ul>\n</div> \n<h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n\n<p><i>Regarding Death's Promise:</i></p>\n<ul><li>Death's Promise triggers on missed melee attacks only (including <a href=\"/wiki/Opportunity_Attack\" title=\"Opportunity Attack\">Opportunity Attack</a>), not when <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Thrown\" title=\"Thrown\"><picture><source srcset=\"/w/images/thumb/2/21/Thrown_Icon.png/25px-Thrown_Icon.png.webp, /w/images/thumb/2/21/Thrown_Icon.png/38px-Thrown_Icon.png.webp 1.5x, /w/images/thumb/2/21/Thrown_Icon.png/50px-Thrown_Icon.png.webp 2x\"><img alt=\"Thrown\" src=\"/w/images/thumb/2/21/Thrown_Icon.png/25px-Thrown_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/21/Thrown_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Thrown\" title=\"Thrown\">Thrown</a>.</li></ul>\n</div>     \n<h2><span class=\"mw-headline\" id=\"Gallery\">Gallery</span></h2>\n<ul class=\"gallery mw-gallery-packed\">\n\t\t<li class=\"gallerybox\" style=\"width: 302px\">\n\t\t\t<div class=\"thumb\" style=\"width: 300px;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:The_Watcher%27s_Guide_ingame.png\" class=\"mw-file-description\" title=\"Appearance in game\"><picture><source src