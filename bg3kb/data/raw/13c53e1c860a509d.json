_Displacer_beast.png 1.5x\"><img src=\"/w/images/thumb/1/19/Portrait_Displacer_beast.png/120px-Portrait_Displacer_beast.png.webp\" decoding=\"async\" width=\"120\" height=\"120\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/19/Portrait_Displacer_beast.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n<div style=\"width: 160px; height: 160px; position: absolute\"><span typeof=\"mw:File\"><a href=\"/wiki/Displacer_beast\" title=\"Displacer beast\"><picture><source srcset=\"/w/images/thumb/1/14/Portrait_Frame.png/160px-Portrait_Frame.png.webp, /w/images/thumb/1/14/Portrait_Frame.png/240px-Portrait_Frame.png.webp 1.5x, /w/images/thumb/1/14/Portrait_Frame.png/320px-Portrait_Frame.png.webp 2x\"><img src=\"/w/images/thumb/1/14/Portrait_Frame.png/160px-Portrait_Frame.png.webp\" decoding=\"async\" width=\"160\" height=\"160\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/14/Portrait_Frame.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n</div>\n<table class=\"bg3wiki-attrblock-table\"><tbody><tr class=\"bg3wiki-attrblock-score-row\">\n\t\t<td>\n\t\t<p><a href=\"/wiki/Strength\" title=\"Strength\">STR</a></p>\n\t\t<div><b><span>18</span></b></div> <span>(+4)</span>\n</td>\n\n<td>\n\t\t<p><a href=\"/wiki/Dexterity\" title=\"Dexterity\">DEX</a></p>\n\t\t<div><b><span>15</span></b></div> <span>(+2)</span>\n</td>\n\n<td>\n\t\t<p><a href=\"/wiki/Constitution\" title=\"Constitution\">CON</a></p>\n\t\t<div><b><span>16</span></b></div> <span>(+3)</span>\n</td>\n\n\t\t\n\n\t\t\n\n\t\t\n\t</tr><tr><td colspan=\"100%\" class=\"bg3wiki-attrblock-divider\"><hr></td></tr><tr class=\"bg3wiki-attrblock-stat-row\">\n\t<td colspan=\"2\"><p><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><span><picture><source srcset=\"/w/images/thumb/2/25/HP_Icon.png/24px-HP_Icon.png.webp, /w/images/thumb/2/25/HP_Icon.png/36px-HP_Icon.png.webp 1.5x, /w/images/2/25/HP_Icon.png 2x\"><img src=\"/w/images/thumb/2/25/HP_Icon.png/24px-HP_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/25/HP_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Hit Points</p></td>\n\t<td colspan=\"1\"><p>85</p></td>\n</tr><tr class=\"bg3wiki-attrblock-stat-row\">\n\t<td colspan=\"2\"><p><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><span><picture><source srcset=\"/w/images/thumb/b/b0/Creature_AC_Icon.png/24px-Creature_AC_Icon.png.webp, /w/images/thumb/b/b0/Creature_AC_Icon.png/36px-Creature_AC_Icon.png.webp 1.5x, /w/images/b/b0/Creature_AC_Icon.png 2x\"><img src=\"/w/images/thumb/b/b0/Creature_AC_Icon.png/24px-Creature_AC_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/b/b0/Creature_AC_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Armour Class</p></td>\n\t<td colspan=\"1\"><p>16</p></td>\n</tr><tr class=\"bg3wiki-attrblock-stat-row bg3wiki-attrblock-nowrap\">\n\t<td colspan=\"2\"><p><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><span><picture><source srcset=\"/w/images/thumb/5/5f/Creature_Speed_Icon.png/24px-Creature_Speed_Icon.png.webp, /w/images/thumb/5/5f/Creature_Speed_Icon.png/36px-Creature_Speed_Icon.png.webp 1.5x, /w/images/5/5f/Creature_Speed_Icon.png 2x\"><img src=\"/w/images/thumb/5/5f/Creature_Speed_Icon.png/24px-Creature_Speed_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/5/5f/Creature_Speed_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Movement Speed</p></td>\n\t<td colspan=\"1\"><p>12 m (40 ft)</p></td>\n</tr></tbody></table><div style=\"clear: both;\"></div><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Dismiss_Displacer_Beast_Shape\" title=\"Dismiss Displacer Beast Shape\"><picture><source srcset=\"/w/images/thumb/0/00/Dismiss_Wild_Shape_Icon.webp/40px-Dismiss_Wild_Shape_Icon.webp, /w/images/thumb/0/00/Dismiss_Wild_Shape_Icon.webp/60px-Dismiss_Wild_Shape_Icon.webp 1.5x, /w/images/thumb/0/00/Dismiss_Wild_Shape_Icon.webp/80px-Dismiss_Wild_Shape_Icon.webp 2x\"><img alt=\"Dismiss Displacer Beast Shape\" src=\"/w/images/thumb/0/00/Dismiss_Wild_Shape_Icon.webp/40px-Dismiss_Wild_Shape_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/00/Dismiss_Wild_Shape_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dismiss_Displacer_Beast_Shape\" title=\"Dismiss Displacer Beast Shape\">Dismiss Displacer Beast Shape</a> </dt>\n<dd>Dismiss your displacer beast shape and change back to your original form. </dd>\n</dl><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Displace_(Displacer_Beast)\" title=\"Displace (Displacer Beast)\"><picture><source srcset=\"/w/images/thumb/6/6c/Displace_Displacer_Beast_Icon.webp/40px-Displace_Displacer_Beast_Icon.webp, /w/images/thumb/6/6c/Displace_Displacer_Beast_Icon.webp/60px-Displace_Displacer_Beast_Icon.webp 1.5x, /w/images/thumb/6/6c/Displace_Displacer_Beast_Icon.webp/80px-Displace_Displacer_Beast_Icon.webp 2x\"><img alt=\"Displace\" src=\"/w/images/thumb/6/6c/Displace_Displacer_Beast_Icon.webp/40px-Displace_Displacer_Beast_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/6c/Displace_Displacer_Beast_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Displace_(Displacer_Beast)\" title=\"Displace (Displacer Beast)\">Displace</a> (<span aria-label=\"Bonus Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp, /w/images/thumb/c/c9/Bonus_Action_Icon.png/35px-Bonus_Action_Icon.png.webp 1.5x, /w/images/thumb/c/c9/Bonus_Action_Icon.png/46px-Bonus_Action_Icon.png.webp 2x\"><img alt=\"Bonus Action\" src=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c9/Bonus_Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Teleport yourself and a target to a nearby location, shredding the target's mind and leaving behind an illusory copy of yourself. </dd>\n</dl><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Illusory_Copy\" title=\"Illusory Copy\"><picture><source srcset=\"/w/images/thumb/3/33/Illusory_Copy_Icon.webp/40px-Illusory_Copy_Icon.webp, /w/images/thumb/3/33/Illusory_Copy_Icon.webp/60px-Illusory_Copy_Icon.webp 1.5x, /w/images/thumb/3/33/Illusory_Copy_Icon.webp/80px-Illusory_Copy_Icon.webp 2x\"><img alt=\"Illusory Copy\" src=\"/w/images/thumb/3/33/Illusory_Copy_Icon.webp/40px-Illusory_Copy_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/33/Illusory_Copy_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Illusory_Copy\" title=\"Illusory Copy\">Illusory Copy</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Create an illusory displacer beast to attack nearby enemies. </dd>\n</dl><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Tentacle_Whip_(Displacer_Beast)\" title=\"Tentacle Whip (Displacer Beast)\"><picture><source srcset=\"/w/images/thumb/3/32/Tentacle_Whip_Displacer_Beast_Icon.webp/40px-Tentacle_Whip_Displacer_Beast_Icon.webp, /w/images/thumb/3/32/Tentacle_Whip_Displacer_Beast_Icon.webp/60px-Tentacle_Whip_Displacer_Beast_Icon.webp 1.5x, /w/images/thumb/3/32/Tentacle_Whip_Displacer_Beast_Icon.webp/80px-Tentacle_Whip_Displacer_Beast_Icon.webp 2x\"><img alt=\"Tentacle Whip\" src=\"/w/images/thumb/3/32/Tentacle_Whip_Displacer_Beast_Icon.webp/40px-Tentacle_Whip_Displacer_Beast_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/32/Tentacle_Whip_Displacer_Beast_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Tentacle_Whip_(Displacer_Beast)\" title=\"Tentacle Whip (Displacer Beast)\">Tentacle Whip</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Lash out with a sleek, spinous tentacle. </dd>\n</dl><dl><dt><span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Extra_Attack\" title=\"Extra Attack\"><picture><source srcset=\"/w/images/thumb/5/5a/Extra_Attack_Icon.webp/40px-Extra_Attack_Icon.webp, /w/images/thumb/5/5a/Extra_Attack_Icon.webp/60px-Extra_Attack_Icon.webp 1.5x, /w/images/thumb/5/5a/Extra_Attack_Icon.webp/80px-Extra_Attack_Icon.webp 2x\"><img alt=\"Extra Attack\" src=\"/w/images/thumb/5/5a/Extra_Attack_Icon.webp/40px-Extra_Attack_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/5a/Extra_Attack_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Extra_Attack\" title=\"Extra Attack\">Extra Attack</a></span></dt><dd>You can make an additional free attack after making an unarmed or weapon attack.</dd></dl><dl><dt><span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Improved_Extra_Attack\" title=\"Improved Extra Attack\"><picture><source srcset=\"/w/images/thumb/5/5a/Extra_Attack_Icon.webp/40px-Extra_Attack_Icon.webp, /w/images/thumb/5/5a/Extra_Attack_Icon.webp/60px-Extra_Attack_Icon.webp 1.5x, /w/images/thumb/5/5a/Extra_Attack_Icon.webp/80px-Extra_Attack_Icon.webp 2x\"><img alt=\"Improved Extra Attack\" src=\"/w/images/thumb/5/5a/Extra_Attack_Icon.webp/40px-Extra_Attack_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/5a/Extra_Attack_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Improved_Extra_Attack\" title=\"Improved Extra Attack\">Improved Extra Attack</a></span></dt><dd>You can make two additional attacks after attacking with your main-hand weapon.</dd></dl><dl><dt><span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Evasion\" title=\"Evasion\"><picture><source srcset=\"/w/images/thumb/7/7c/Evasion_Icon.webp/40px-Evasion_Icon.webp, /w/images/thumb/7/7c/Evasion_Icon.webp/60px-Evasion_Icon.webp 1.5x, /w/images/thumb/7/7c/Evasion_Icon.webp/80px-Evasion_Icon.webp 2x\"><img alt=\"Evasion\" src=\"/w/images/thumb/7/7c/Evasion_Icon.webp/40px-Evasion_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/7c/Evasion_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Evasion\" title=\"Evasion\">Evasion</a></span></dt><dd>Your agility lets you dodge out of the way of certain spells. When a spell or effect would deal half damage on a successful <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp, /w/images/e/e7/Saving_Throw_Icon.png 1.5x\"><img alt=\"Dexterity Saving Throw\" src=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/e7/Saving_Throw_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dexterity\" title=\"Dexterity\">Dexterity</a> <a href=\"/wiki/Saving_Throw\" class=\"mw-redirect\" title=\"Saving Throw\">Saving Throw</a>, it deals no damage if you succeed, and only half damage if you fail.</dd></dl>\n</div>\n<h2><span class=\"mw-headline\" id=\"Sources_of_Displacer_Beast_Form\">Sources of Displacer Beast Form</span></h2>\n<div class=\"bg3wiki-condition-sources\"><ul>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 5px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Displacer_Beast_Shape\" title=\"Displacer Beast Shape\"><picture><source srcset=\"/w/images/thumb/3/3a/Displacer_Beast_Shape_Icon.webp/30px-Displacer_Beast_Shape_Icon.webp, /w/images/thumb/3/3a/Displacer_Beast_Shape_Icon.webp/45px-Displacer_Beast_Shape_Icon.webp 1.5x, /w/images/thumb/3/3a/Displacer_Beast_Shape_Icon.webp/60px-Displacer_Beast_Shape_Icon.webp 2x\"><img alt=\"Displacer Beast Shape\" src=\"/w/images/thumb/3/3a/Displacer_Beast_Shape_Icon.webp/30px-Displacer_Beast_Shape_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/3a/Displacer_Beast_Shape_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Displacer_Beast_Shape\" title=\"Displacer Beast Shape\">Displacer Beast Shape</a></span></li>\n</ul></div>\n<!-- \nNewPP limit report\nCached time: 20260714203009\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.097 seconds\nReal time usage: 0.108 seconds\nPreprocessor visited node count: 3610/1000000\nPost‐expand include size: 57621/4194304 bytes\nTemplate argument size: 9211/4194304 bytes\nHighest expansion depth: 26/200\nExpensive parser function count: 0/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 2/5000000 bytes\nExtLoops count: 4/10