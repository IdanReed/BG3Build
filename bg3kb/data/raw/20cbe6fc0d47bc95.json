image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Two-Handed\" title=\"Two-Handed\">Two-Handed</a></dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Dippable\" title=\"Dippable\"><picture><source srcset=\"/w/images/thumb/0/0a/Dippable_Icon.png/25px-Dippable_Icon.png.webp, /w/images/thumb/0/0a/Dippable_Icon.png/38px-Dippable_Icon.png.webp 1.5x, /w/images/0/0a/Dippable_Icon.png 2x\"><img alt=\"Dippable\" src=\"/w/images/thumb/0/0a/Dippable_Icon.png/25px-Dippable_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0a/Dippable_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dippable\" class=\"mw-redirect\" title=\"Dippable\">Dippable</a></dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/2a/Melee_Range_Icon.png/25px-Melee_Range_Icon.png.webp, /w/images/thumb/2/2a/Melee_Range_Icon.png/38px-Melee_Range_Icon.png.webp 1.5x, /w/images/2/2a/Melee_Range_Icon.png 2x\"><img alt=\"Melee: 1.5 m (5 ft)\" src=\"/w/images/thumb/2/2a/Melee_Range_Icon.png/25px-Melee_Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2a/Melee_Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Melee: 1.5 m (5 ft)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp, /w/images/thumb/e/ea/Weight_Icon.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 2.7 kg (5.4 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 2.7 kg (5.4 lb)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 150 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  150  gp</dd>\n<dd><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">QUEST_FOR_SussurGreatsword</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:QUEST_FOR_SussurGreatsword\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:QUEST_FOR_SussurGreatsword\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">44dedec0-df82-4ed3-b9ca-147bd830e312</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:44dedec0-df82-4ed3-b9ca-147bd830e312\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:44dedec0-df82-4ed3-b9ca-147bd830e312\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>Stats</summary>\n<code class=\"bg3wiki-uid-box\">FOR_IncompleteMasterwork_SussurGreatsword</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:FOR_IncompleteMasterwork_SussurGreatsword+type:stat\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:FOR_IncompleteMasterwork_SussurGreatsword+type:stat\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></dd></dl>\n</div> \n<h3><span class=\"mw-headline\" id=\"Special\"> Special </span></h3>\n<p><b>The holder of this item gains:</b>\n\n</p>\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Silenced_(Condition)\" title=\"Silenced (Condition)\"><picture><source srcset=\"/w/images/thumb/b/b6/Silenced_Condition_Icon.webp/25px-Silenced_Condition_Icon.webp, /w/images/thumb/b/b6/Silenced_Condition_Icon.webp/38px-Silenced_Condition_Icon.webp 1.5x, /w/images/thumb/b/b6/Silenced_Condition_Icon.webp/50px-Silenced_Condition_Icon.webp 2x\"><img alt=\"Silences\" src=\"/w/images/thumb/b/b6/Silenced_Condition_Icon.webp/25px-Silenced_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b6/Silenced_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Silenced_(Condition)\" title=\"Silenced (Condition)\">Silences</a> the target on hit if it fails a <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp, /w/images/e/e7/Saving_Throw_Icon.png 1.5x\"><img alt=\"DC&nbsp;12 Constitution Saving Throw\" src=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/e7/Saving_Throw_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dice_rolls#Save_DCs\" title=\"Dice rolls\">DC</a>&nbsp;12 <a href=\"/wiki/Constitution\" title=\"Constitution\">Constitution</a> <a href=\"/wiki/Saving_Throw\" class=\"mw-redirect\" title=\"Saving Throw\">Saving Throw</a>.</li></ul>\n<h3><span class=\"mw-headline\" id=\"Weapon_actions\"> Weapon actions </span></h3>\n<p><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp, /w/images/2/2d/Proficiency_Icon.png 1.5x\"><img alt=\"Proficiency Icon.png\" src=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2d/Proficiency_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <i>If you have <a href=\"/wiki/Proficiency\" title=\"Proficiency\">proficiency</a>, equip in <strong>main hand</strong> to gain:</i>\n</p>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Cleave\" title=\"Cleave\"><picture><source srcset=\"/w/images/thumb/a/a7/Cleave_Icon.webp/40px-Cleave_Icon.webp, /w/images/thumb/a/a7/Cleave_Icon.webp/60px-Cleave_Icon.webp 1.5x, /w/images/thumb/a/a7/Cleave_Icon.webp/80px-Cleave_Icon.webp 2x\"><img alt=\"Cleave\" src=\"/w/images/thumb/a/a7/Cleave_Icon.webp/40px-Cleave_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a7/Cleave_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Cleave\" title=\"Cleave\">Cleave</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Swing your weapon in a large arc to attack up to 3 enemies at once. They each take half the damage your weapon usually deals. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lacerate\" title=\"Lacerate\"><picture><source srcset=\"/w/images/thumb/a/af/Lacerate_Icon.webp/40px-Lacerate_Icon.webp, /w/images/thumb/a/af/Lacerate_Icon.webp/60px-Lacerate_Icon.webp 1.5x, /w/images/thumb/a/af/Lacerate_Icon.webp/80px-Lacerate_Icon.webp 2x\"><img alt=\"Lacerate\" src=\"/w/images/thumb/a/af/Lacerate_Icon.webp/40px-Lacerate_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/af/Lacerate_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Lacerate\" title=\"Lacerate\">Lacerate</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Slash at your target's vital points to make it <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Bleeding_(Condition)\" title=\"Bleeding (Condition)\"><picture><source srcset=\"/w/images/thumb/2/25/Bleeding_Condition_Icon.webp/20px-Bleeding_Condition_Icon.webp, /w/images/thumb/2/25/Bleeding_Condition_Icon.webp/30px-Bleeding_Condition_Icon.webp 1.5x, /w/images/thumb/2/25/Bleeding_Condition_Icon.webp/40px-Bleeding_Condition_Icon.webp 2x\"><img alt=\"Bleed\" src=\"/w/images/thumb/2/25/Bleeding_Condition_Icon.webp/20px-Bleeding_Condition_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/25/Bleeding_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Bleeding_(Condition)\" title=\"Bleeding (Condition)\">Bleed</a>. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Pommel_Strike\" title=\"Pommel Strike\"><picture><source srcset=\"/w/images/thumb/1/1e/Pommel_Strike_Icon.webp/40px-Pommel_Strike_Icon.webp, /w/images/thumb/1/1e/Pommel_Strike_Icon.webp/60px-Pommel_Strike_Icon.webp 1.5x, /w/images/thumb/1/1e/Pommel_Strike_Icon.webp/80px-Pommel_Strike_Icon.webp 2x\"><img alt=\"Pommel Strike\" src=\"/w/images/thumb/1/1e/Pommel_Strike_Icon.webp/40px-Pommel_Strike_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/1e/Pommel_Strike_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Pommel_Strike\" title=\"Pommel Strike\">Pommel Strike</a> (<span aria-label=\"Bonus Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp, /w/images/thumb/c/c9/Bonus_Action_Icon.png/35px-Bonus_Action_Icon.png.webp 1.5x, /w/images/thumb/c/c9/Bonus_Action_Icon.png/46px-Bonus_Action_Icon.png.webp 2x\"><img alt=\"Bonus Action\" src=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c9/Bonus_Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Make a non-lethal attack against an enemy and possibly <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Dazed_(Condition)\" title=\"Dazed (Condition)\"><picture><source srcset=\"/w/images/thumb/a/a2/Dazed_Condition_Icon.webp/25px-Dazed_Condition_Icon.webp, /w/images/thumb/a/a2/Dazed_Condition_Icon.webp/38px-Dazed_Condition_Icon.webp 1.5x, /w/images/thumb/a/a2/Dazed_Condition_Icon.webp/50px-Dazed_Condition_Icon.webp 2x\"><img alt=\"Daze\" src=\"/w/images/thumb/a/a2/Dazed_Condition_Icon.webp/25px-Dazed_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a2/Dazed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dazed_(Condition)\" title=\"Dazed (Condition)\">Daze</a> them. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl></div> \n<h2><span class=\"mw-headline\" id=\"Condition:_Silenced\"> Condition: Silenced </span></h2>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\">\n<div class=\"bg3wiki-condition\"><strong><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Silenced_(Condition)\" title=\"Silenced (Condition)\"><picture><source srcset=\"/w/images/thumb/b/b6/Silenced_Condition_Icon.webp/30px-Silenced_Condition_Icon.webp, /w/images/thumb/b/b6/Silenced_Condition_Icon.webp/45px-Silenced_Condition_Icon.webp 1.5x, /w/images/thumb/b/b6/Silenced_Condition_Icon.webp/60px-Silenced_Condition_Icon.webp 2x\"><img alt=\"Silenced\" src=\"/w/images/thumb/b/b6/Silenced_Condition_Icon.webp/30px-Silenced_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b6/Silenced_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Silenced_(Condition)\" title=\"Silenced (Condition)\">Silenced</a></strong><p><span class=\"bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp, /w/images/thumb/6/6a/Duration_Icons.png/38px-Duration_Icons.png.webp 1.5x, /w/images/thumb/6/6a/Duration_Icons.png/50px-Duration_Icons.png.webp 2x\"><img alt=\"Duration Icons.png\" src=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/6/6a/Duration_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Duration: 2  turns</p><p><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp, /w/images/e/e7/Saving_Throw_Icon.png 1.5x\"><img alt=\"CON Save (DC&nbsp;12)\" src=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/e7/Saving_Throw_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Constitution\" title=\"Constitution\">CON</a> <a href=\"/wiki/Saving_throws\" title=\"Saving throws\">Save</a> (<a href=\"/wiki/DC\" class=\"mw-redirect\" title=\"DC\">DC</a>&nbsp;12)</p>\n<div>\n<ul><li>Creature can't speak or cast spells with a verbal component, and is immune to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Thunder\" title=\"Thunder\"><picture><source srcset=\"/w/images/thumb/8/87/Thunder_Damage_Icon.png/20px-Thunder_Damage_Icon.png.webp, /w/images/thumb/8/87/Thunder_Damage_Icon.png/30px-Thunder_Damage_Icon.png.webp 1.5x, /w/images/thumb/8/87/Thunder_Damage_Icon.png/40px-Thunder_Damage_Icon.png.webp 2x\"><img alt=\"Thunder\" src=\"/w/images/thumb/8/87/Thunder_Damage_Icon.png/20px-Thunder_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/87/Thunder_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Thunder\" title=\"Thunder\"><span class=\"bg3wiki-damage-type-thunder\">Thunder</span></a> damage.</li></ul>\n</div>\n </div>\n</div>\n<h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li><a href=\"/wiki/Blighted_Village\" title=\"Blighted Village\">Blighted Village</a> <span class=\"bg3wiki-coordinates\">X:&nbsp;-477&nbsp;Y:&nbsp;-378</span>: Reward for completing the quest <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Finish_the_Masterwork_Weapon\" title=\"Finish the Masterwork Weapon\"><picture><source srcset=\"/w/images/thumb/6/69/Quest_Map_Icon.png/22px-Quest_Map_Icon.png.webp, /w/images/thumb/6/69/Quest_Map_Icon.png/33px-Quest_Map_Icon.png.webp 1.5x, /w/images/thumb/6/69/Quest_Map_Icon.png/44px-Quest_Map_Icon.png.webp 2x\"><img alt=\"Finish the Masterwork Weapon\" src=\"/w/images/thumb/6/69/Quest_Map_Icon.png/22px-Quest_Map_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/69/Quest_Map_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Finish_the_Masterwork_Weapon\" title=\"Finish the Masterwork Weapon\">Finish the Masterwork Weapon</a></li></ul>\n</div> \n<h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>To obtain this item, a <span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Greatsword\" title=\"Greatsword\"><picture><source srcset=\"/w/images/thumb/6/68/Greatsword_Unfaded_Icon.png/20px-Greatsword_Unfaded_Icon.png.webp, /w/images/thumb/6/68/Greatsword_Unfaded_Icon.png/30px-Greatsword_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/6/68/Greatsword_Unfaded_Icon.png/40px-Greatsword_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/6/68/Greatsword_Unfaded_Icon.png/20px-Greatsword_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/Greatsword_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> <a href=\"/wiki/Greatsword\" title=\"Greatsword\">Greatsword</a> must be combined with the <span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-story\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Sussur_Tree_Bark\" title=\"Sussur Tree Bark\"><picture><source srcset=\"/w/images/thumb/d/db/Sussur_Tree_Bark_Item_Icon.png/20px-Sussur_Tree_Bark_Item_Icon.png.webp, /w/images/thumb/d/db/Sussur_Tree_Bark_Item_Icon.png/30px-Sussur_Tree_Bark_Item_Icon.png.webp 1.5x, /w/images/thumb/d/db/Sussur_Tree_Bark_Item_Icon.png/40px-Sussur_Tree_Bark_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/d/db/Sussur_Tree_Bark_Item_Icon.png/20px-Sussur_Tree_Bark_Item_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/db/Sussur_Tree_Bark_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> <a href=\"/wiki/Sussur_Tree_Bark\" title=\"Sussur Tree Bark\">Sussur Tree Bark</a> in the <a href=\"/wiki/Blighted_Village#Blacksmith's_Forge\" title=\"Blighted Village\">Blacksmith's Forge</a>.</li>\n<li>The <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Silenced_(Condition)\" title=\"Silenced (Condition)\"><picture><source srcset=\"/w/images/thumb/b/b6/Silenced_Condition_Icon.webp/25px-Silenced_Condition_Icon.webp, /w/images/thumb/b/b6/Silenced_Condition_Icon.webp/38px-Silenced_Condition_Icon.webp 1.5x, /w/images/thumb/b/b6/Silenced_Condition_Icon.webp/50px-Silenced_Condition_Icon.webp 2x\"><img alt=\"Silencing\" src=\"/w/images/thumb/b/b6/Silenced_Condition_Icon.webp/25px-Silenced_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b6/Silenced_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Silenced_(Condition)\" title=\"Silenced (Condition)\">Silencing</a> effect only works on melee hits; not when throwing the item at a target.</li>\n<li>Prior to Hotfix #33, the item description incorrectly omitted the mention of a saving throw.</li>\n<li>Sussar weapons cannot be <a href=\"/wiki/Dyes\" title=\"Dyes\">dyed</a>.</li></ul>\n</div>     \n<h2><span class=\"mw-headline\" id=\"Gallery\">Gallery</span></h2>\n<ul class=\"gallery mw-gallery-packed\">\n\t\t<li class=\"gallerybox\" style=\"width: 446.66666666667px\">\n\t\t\t<div class=\"thumb\" style=\"width: 444.66666666667px;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Selena-t-st-sussurgreatsword.jpg\" class=\"mw-file-description\" title=\"Render by Selena Tobin\"><picture><source srcset=\"/w/images/thumb/f/fc/Selena-t-st-sussurgreatsword.jpg/667px-Selena-t-st-sussurgreatsword.jpg.webp, /w/images/thumb/f/fc/Selena-t-st-sussurgreatsword.jpg/1001px-Selena-t-st-sussurgreatsword.jpg.webp 1.5x, /w/images/thumb/f/fc/Selena-t-st-sussurgreatsword.jpg/1334px-Selena-t-st-sussurgreatsword.jpg.webp 2x\"><img alt=\"Render by Selena Tobin\" src=\"/w/images/thumb/f/fc/Selena-t-st-sussurgreatsword.jpg/667px-Selena-t-st-sussurgreatsword.jpg.webp\" decoding=\"async\" width=\"445\" height=\"250\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/fc/Selena-t-st-sussurgreatsword.jpg\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n\t\t\t<div class=\"gallerytext\">Render by Selena Tobin</div>\n\t\t</li>\n</ul>\n<h2><span class=\"mw-headline\" id=\"See_also\">See also</span></h2>\n<ul><li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-rare\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Sussur_Dagger\" title=\"Sussur Dagger\"><picture><source srcset=\"/w/images/thumb/8/83/Sussur_Dagger_Unfaded_Icon.png/30px-Sussur_Dagger_Unfaded_Icon.png.webp, /w/images/thumb/8/83/Sussur_Dagger_Unfaded_Icon.png/45px-Sussur_Dagger_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/8/83/Sussur_Dagger_Unfaded_Icon.png/60px-Sussur_Dagger_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/8/83/Sussur_Dagger_Unfaded_Icon.png/30px-Sussur_Dagger_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/83/Sussur_Dagger_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Sussur_Dagger\" title=\"Sussur Dagger\">Sussur Dagger</a></span></li>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-rare\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Sussur_Sickle\" title=\"Sussur Sickle\"><picture><source srcset=\"/w/images/thumb/8/88/Sussur_Sickle_Unfaded_Icon.png/30px-Sussur_Sickle_Unfaded_Icon.png.webp, /w/images/thumb/8/88/Sussur_Sickle_Unfaded_Icon.png/45px-Sussur_Sickle_Unfaded_Icon.png.webp 1.5x, /w/images/th