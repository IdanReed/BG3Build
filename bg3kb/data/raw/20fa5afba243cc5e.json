ource\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Throw\" title=\"Throw\">Throw</a> the potion.\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/0/08/Range_Icon.png/25px-Range_Icon.png.webp, /w/images/thumb/0/08/Range_Icon.png/38px-Range_Icon.png.webp 1.5x, /w/images/0/08/Range_Icon.png 2x\"><img alt=\"Range: 18 m (60 ft)\" src=\"/w/images/thumb/0/08/Range_Icon.png/25px-Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/0/08/Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Range: 18 m (60 ft)</li>\n<li><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp, /w/images/thumb/d/d0/Aoe_Icon.png/38px-Aoe_Icon.png.webp 1.5x, /w/images/d/d0/Aoe_Icon.png 2x\"><img alt=\"Aoe Icon.png\" src=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/d/d0/Aoe_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span>Creates area: <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Malice_(cloud)\" title=\"Malice (cloud)\"><picture><source srcset=\"/w/images/thumb/f/f2/Malice_cloud_Icon.webp/25px-Malice_cloud_Icon.webp, /w/images/thumb/f/f2/Malice_cloud_Icon.webp/38px-Malice_cloud_Icon.webp 1.5x, /w/images/thumb/f/f2/Malice_cloud_Icon.webp/50px-Malice_cloud_Icon.webp 2x\"><img alt=\"Malice\" src=\"/w/images/thumb/f/f2/Malice_cloud_Icon.webp/25px-Malice_cloud_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f2/Malice_cloud_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Malice_(cloud)\" title=\"Malice (cloud)\">Malice</a></li></ul></li></ul>\n<div style=\"clear: both;\"></div></div>\n<h2><span class=\"mw-headline\" id=\"Condition:_Coated_in_Malice\"> Condition: Coated in Malice </span></h2>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\">\n<div class=\"bg3wiki-condition\"><strong><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Coated_in_Malice_(Condition)\" title=\"Coated in Malice (Condition)\"><picture><source srcset=\"/w/images/thumb/f/f2/Coated_in_Basic_Poison_Condition_Icon.webp/30px-Coated_in_Basic_Poison_Condition_Icon.webp, /w/images/thumb/f/f2/Coated_in_Basic_Poison_Condition_Icon.webp/45px-Coated_in_Basic_Poison_Condition_Icon.webp 1.5x, /w/images/thumb/f/f2/Coated_in_Basic_Poison_Condition_Icon.webp/60px-Coated_in_Basic_Poison_Condition_Icon.webp 2x\"><img alt=\"Coated in Malice\" src=\"/w/images/thumb/f/f2/Coated_in_Basic_Poison_Condition_Icon.webp/30px-Coated_in_Basic_Poison_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f2/Coated_in_Basic_Poison_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Coated_in_Malice_(Condition)\" title=\"Coated in Malice (Condition)\">Coated in Malice</a></strong><p><span class=\"bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp, /w/images/thumb/6/6a/Duration_Icons.png/38px-Duration_Icons.png.webp 1.5x, /w/images/thumb/6/6a/Duration_Icons.png/50px-Duration_Icons.png.webp 2x\"><img alt=\"Duration Icons.png\" src=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-