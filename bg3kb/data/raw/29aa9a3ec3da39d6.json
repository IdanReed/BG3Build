_Icon.png 1.5x\"><img alt=\"Price: 40 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  40  gp</dd>\n<dd><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">DEN_CapturedGoblin_MurderDagger</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:DEN_CapturedGoblin_MurderDagger\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:DEN_CapturedGoblin_MurderDagger\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">520d3f36-af72-4385-89af-f585c8edc9cf</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:520d3f36-af72-4385-89af-f585c8edc9cf\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:520d3f36-af72-4385-89af-f585c8edc9cf\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>Stats</summary>\n<code class=\"bg3wiki-uid-box\">DEN_CapturedGoblin_MurderDagger</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:DEN_CapturedGoblin_MurderDagger+type:stat\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:DEN_CapturedGoblin_MurderDagger+type:stat\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></dd></dl>\n</div> \n<h3><span class=\"mw-headline\" id=\"Special\"> Special </span></h3>\n<p><b>The holder of this item gains:</b>\n\n</p>\n<dl><dt><a href=\"/wiki/Deathly_Slumber\" title=\"Deathly Slumber\">Deathly Slumber</a></dt><dd>Deals an additional <span class=\"bg3wiki-damage-type-necrotic\">1d4</span>⁠<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Necrotic\" title=\"Necrotic\"><picture><source srcset=\"/w/images/thumb/3/39/Necrotic_Damage_Icon.png/25px-Necrotic_Damage_Icon.png.webp, /w/images/thumb/3/39/Necrotic_Damage_Icon.png/38px-Necrotic_Damage_Icon.png.webp 1.5x, /w/images/thumb/3/39/Necrotic_Damage_Icon.png/50px-Necrotic_Damage_Icon.png.webp 2x\"><img alt=\"Necrotic\" src=\"/w/images/thumb/3/39/Necrotic_Damage_Icon.png/25px-Necrotic_Damage_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/39/Necrotic_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Necrotic\" title=\"Necrotic\"><span class=\"bg3wiki-damage-type-necrotic\">Necrotic</span></a> to creatures that are <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Knocked_Out_(Condition)\" title=\"Knocked Out (Condition)\"><picture><source srcset=\"/w/images/thumb/9/97/Knocked_Out_Condition_Icon.webp/25px-Knocked_Out_Condition_Icon.webp, /w/images/thumb/9/97/Knocked_Out_Condition_Icon.webp/38px-Knocked_Out_Condition_Icon.webp 1.5x, /w/images/thumb/9/97/Knocked_Out_Condition_Icon.webp/50px-Knocked_Out_Condition_Icon.webp 2x\"><img alt=\"Knocked Out\" src=\"/w/images/thumb/9/97/Knocked_Out_Condition_Icon.webp/25px-Knocked_Out_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/97/Knocked_Out_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Knocked_Out_(Condition)\" title=\"Knocked Out (Condition)\">Knocked Out</a> or <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Sleeping_(Condition)\" title=\"Sleeping (Condition)\"><picture><source srcset=\"/w/images/thumb/3/35/Sleeping_Condition_Icon.webp/25px-Sleeping_Condition_Icon.webp, /w/images/thumb/3/35/Sleeping_Condition_Icon.webp/38px-Sleeping_Condition_Icon.webp 1.5x, /w/images/thumb/3/35/Sleeping_Condition_Icon.webp/50px-Sleeping_Condition_Icon.webp 2x\"><img alt=\"Sleeping\" src=\"/w/images/thumb/3/35/Sleeping_Condition_Icon.webp/25px-Sleeping_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/35/Sleeping_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Sleeping_(Condition)\" title=\"Sleeping (Condition)\">Sleeping</a>.</dd></dl>\n<h3><span class=\"mw-headline\" id=\"Weapon_actions\"> Weapon actions </span></h3>\n<p><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp, /w/images/2/2d/Proficiency_Icon.png 1.5x\"><img alt=\"Proficiency Icon.png\" src=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2d/Proficiency_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <i>If you have <a href=\"/wiki/Proficiency\" title=\"Proficiency\">proficiency</a>, equip in <strong>main hand</strong> to gain:</i>\n</p>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Piercing_Strike\" title=\"Piercing Strike\"><picture><source srcset=\"/w/images/thumb/c/c4/Piercing_Strike_Icon.webp/40px-Piercing_Strike_Icon.webp, /w/images/thumb/c/c4/Piercing_Strike_Icon.webp/60px-Piercing_Strike_Icon.webp 1.5x, /w/images/thumb/c/c4/Piercing_Strike_Icon.webp/80px-Piercing_Strike_Icon.webp 2x\"><img alt=\"Piercing Strike\" src=\"/w/images/thumb/c/c4/Piercing_Strike_Icon.webp/40px-Piercing_Strike_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c4/Piercing_Strike_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Piercing_Strike\" title=\"Piercing Strike\">Piercing Strike</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture>