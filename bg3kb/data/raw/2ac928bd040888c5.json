lers --></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">CONT_GEN_Chest_Wood_Painted_A</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:CONT_GEN_Chest_Wood_Painted_A\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:CONT_GEN_Chest_Wood_Painted_A\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">9e7c9903-5690-488d-b648-462fa5cbaafe</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:9e7c9903-5690-488d-b648-462fa5cbaafe\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:9e7c9903-5690-488d-b648-462fa5cbaafe\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div>   \n<div style=\"clear: both;\"></div></div>\n<h2><span class=\"mw-headline\" id=\"Condition:_sturdy\"> Condition: sturdy </span></h2>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\">\n<div class=\"bg3wiki-condition\"><strong><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Sturdy_(Condition)\" title=\"Sturdy (Condition)\"><picture><source srcset=\"/w/images/thumb/3/32/Sturdy_Condition_Icon.webp/30px-Sturdy_Condition_Icon.webp, /w/images/thumb/3/32/Sturdy_Condition_Icon.webp/45px-Sturdy_Condition_Icon.webp 1.5x, /w/images/thumb/3/32/Sturdy_Condition_Icon.webp/60px-Sturdy_Condition_Icon.webp 2x\"><img alt=\"Sturdy\" src=\"/w/images/thumb/3/32/Sturdy_Condition_Icon.webp/30px-Sturdy_Condition_Icon.webp\