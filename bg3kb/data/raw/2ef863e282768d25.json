ed_Condition_Icon.webp/60px-Jolted_Condition_Icon.webp 2x\"><img alt=\"Jolted\" src=\"/w/images/thumb/c/c5/Jolted_Condition_Icon.webp/30px-Jolted_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c5/Jolted_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Jolted_(Condition)\" title=\"Jolted (Condition)\">Jolted</a></strong><p><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp, /w/images/thumb/d/d0/Aoe_Icon.png/38px-Aoe_Icon.png.webp 1.5x, /w/images/d/d0/Aoe_Icon.png 2x\"><img alt=\"Radius:&nbsp;6 m (20 ft)\" src=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/d/d0/Aoe_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠Radius:&nbsp;6 m (20 ft)</p>\n<div>\n<ul><li>Takes <span class=\"bg3wiki-damage-type-lightning\">1d4</span>⁠<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lightning\" title=\"Lightning\"><picture><source srcset=\"/w/images/thumb/3/31/Lightning_Damage_Icon.png/20px-Lightning_Damage_Icon.png.webp, /w/images/thumb/3/31/Lightning_Damage_Icon.png/30px-Lightning_Damage_Icon.png.webp 1.5x, /w/images/thumb/3/31/Lightning_Damage_Icon.png/40px-Lightning_Damage_Icon.png.webp 2x\"><img alt=\"Lightning\" src=\"/w/images/thumb/3/31/Lightning_Damage_Icon.png/20px-Lightning_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/31/Lightning_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Lightning\" title=\"Lightning\"><span class=\"bg3wiki-damage-type-lightning\">Lightning</span></a> damage each turn and can't take <span style=\"display: inline-block; height: 20px; width: 20px; margin-left: -3px; margin-top: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/c/c1/Reaction_Icon.png/23px-Reaction_Icon.png.webp, /w/images/thumb/c/c1/Reaction_Icon.png/35px-Reaction_Icon.png.webp 1.5x, /w/images/thumb/c/c1/Reaction_Icon.png/46px-Reaction_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/c/c1/Reaction_Icon.png/23px-Reaction_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c1/Reaction_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Actions#Reactions\" title=\"Actions\">Reactions</a>. Removed upon leaving the Lightning Aura.</li></ul>\n</div>\n </div>\n</div>\n<h2><span class=\"mw-headline\" id=\"Sources_of_Lightning_Aura\">Sources of Lightning Aura</span></h2>\n<div class=\"bg3wiki-condition-sources\"><ul>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 5px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lightning_Aura\" title=\"Lightning Aura\"><picture><source srcset=\"/w/images/thumb/2/2c/Lightning_Aura_Icon.webp/30px-Lightning_Aura_Icon.webp, /w/images/thumb/2/2c/Lightning_Aura_Icon.webp/45px-Lightning_Aura_Icon.webp 1.5x, /w/images/thumb/2/2c/Lightning_Aura_Icon.webp/60px-Lightning_Aura_Icon.webp 2x\"><img alt=\"Lightning Aura\" src=\"/w/images/thumb/2/2c/Lightning_Aura_Icon.webp/30px-Lightning_Aura_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/2c/Lightning_Aura_Icon.webp\" class=\"mw-file-source\" title=\"View source im