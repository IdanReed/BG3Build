vertical-align: middle;\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Prone_(Condition)\" title=\"Prone (Condition)\"><picture><source srcset=\"/w/images/thumb/8/8e/Prone_Condition_Icon.webp/25px-Prone_Condition_Icon.webp, /w/images/thumb/8/8e/Prone_Condition_Icon.webp/38px-Prone_Condition_Icon.webp 1.5x, /w/images/thumb/8/8e/Prone_Condition_Icon.webp/50px-Prone_Condition_Icon.webp 2x\"><img alt=\"Prone\" src=\"/w/images/thumb/8/8e/Prone_Condition_Icon.webp/25px-Prone_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/8e/Prone_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span><span class=\"bg3wiki-after-icon\"></span></span></span>&nbsp;<span class=\"bg3wiki-icontext-text\" style=\"\"><a href=\"/wiki/Prone_(Condition)\" title=\"Prone (Condition)\">Prone</a></span>. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Per turn\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: Per turn.)</dd>\n</dl><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Gore_(Minotaur)\" title=\"Gore (Minotaur)\"><picture><source srcset=\"/w/images/thumb/d/d0/Gore_Minotaur_Icon.webp/40px-Gore_Minotaur_Icon.webp, /w/images/thumb/d/d0/Gore_Minotaur_Icon.webp/60px-Gore_Minotaur_Icon.webp 1.5x, /w/images/thumb/d/d0/Gore_Minotaur_Icon.webp/80px-Gore_Minotaur_Icon.webp 2x\"><img alt=\"Gore\" src=\"/w/images/thumb/d/d0/Gore_Minotaur_Icon.webp/40px-Gore_Minotaur_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d0/Gore_Minotaur_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Gore_(Minotaur)\" title=\"Gore (Minotaur)\">Gore</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Impale a target and push it back 2 m / 7 ft. </dd>\n</dl><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Reckless_Roar\" title=\"Reckless Roar\"><picture><source srcset=\"/w/images/thumb/4/4b/Reckless_Roar_Icon.webp/40px-Reckless_Roar_Icon.webp, /w/images/thumb/4/4b/Reckless_Roar_Icon.webp/60px-Reckless_Roar_Icon.webp 1.5x, /w/images/thumb/4/4b/Reckless_Roar_Icon.webp/80px-Reckless_Roar_Icon.webp 2x\"><img alt=\"Reckless Roar\" src=\"/w/images/thumb/4/4b/Reckless_Roar_Icon.webp/40px-Reckless_Roar_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/4b/Reckless_Roar_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Reckless_Roar\" title=\"Reckless Roar\">Reckless Roar</a> (<span aria-label=\"Bonus Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp, /w/images/thumb/c/c9/Bonus_Action_Icon.png/35px-Bonus_Action_Icon.png.webp 1.5x, /w/images/thumb/c/c9/Bonus_Action_Icon.png/46px-Bonus_Action_Icon.png.webp 2x\"><img alt=\"Bonus Action\" src=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c9/Bonus_Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Gain <span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fc/Advantage_Icon.png/35px-Advantage_Icon.png.webp, /w/images/thumb/f/fc/Advantage_Icon.png/53px-Advantage_Icon.png.webp 1.5x, /w/images/f/fc/Advantage_Icon.png 2x\"><img alt=\"Advantage Icon.png\" src=\"/w/images/thumb/f/fc/Advantage_Icon.png/35px-Advantage_Icon.png.webp\" decoding=\"async\" width=\"35\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fc/Advantage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span><span class=\"bg3wiki-after-icon\"></span> <a href=\"/wiki/Advantage\" title=\"Advantage\">Advantage</a> on <a href=\"/wiki/Attack_Rolls\" class=\"mw-redirect\" title=\"Attack Rolls\">Attack Rolls</a>. Attackers also gain <span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fc/Advantage_Icon.png/35px-Advantage_Icon.png.webp, /w/images/thumb/f/fc/Advantage_Icon.png/53px-Advantage_Icon.png.webp 1.5x, /w/images/f/fc/Advantage_Icon.png 2x\"><img alt=\"Advantage Icon.png\" src=\"/w/images/thumb/f/fc/Advantage_Icon.png/35px-Advantage_Icon.png.webp\" decoding=\"async\" width=\"35\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fc/Advantage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span><span class=\"bg3wiki-after-icon\"></span> <a href=\"/wiki/Advantage\" title=\"Advantage\">Advantage</a> on <a href=\"/wiki/Attack_Rolls\" class=\"mw-redirect\" title=\"Attack Rolls\">Attack Rolls</a> against you. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Per turn\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: Per turn.)</dd>\n</dl><dl><dt><span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Muscular\" title=\"Muscular\"><picture><source srcset=\"/w/images/thumb/b/bc/Muscular_Icon.webp/40px-Muscular_Icon.webp, /w/images/thumb/b/bc/Muscular_Icon.webp/60px-Muscular_Icon.webp 1.5x, /w/images/b/bc/Muscular_Icon.webp 2x\"><img alt=\"Muscular\" src=\"/w/images/thumb/b/bc/Muscular_Icon.webp/40px-Muscular_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/bc/Muscular_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Muscular\" title=\"Muscular\">Muscular</a></span></dt><dd>This creature is very strong. It has <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Advantage\" title=\"Advantage\"><picture><source srcset=\"/w/images/thumb/f/fc/Advantage_Icon.png/28px-Advantage_Icon.png.webp, /w/images/thumb/f/fc/Advantage_Icon.png/42px-Advantage_Icon.png.webp 1.5x, /w/images/thumb/f/fc/Advantage_Icon.png/55px-Advantage_Icon.png.webp 2x\"><img alt=\"Advantage\" src=\"/w/images/thumb/f/fc/Advantage_Icon.png/28px-Advantage_Icon.png.webp\" decoding=\"async\" width=\"28\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/fc/Advantage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Advantage\" title=\"Advantage\">Advantage</a> on <a href=\"/wiki/Ability_Check\" class=\"mw-redirect\" title=\"Ability Check\">Ability Checks</a> and <a href=\"/wiki/Saving_Throw\" class=\"mw-redirect\" title=\"Saving Throw\">Saving Throws</a> using <a href=\"/wiki/Athletics\" title=\"Athletics\">Athletics</a>.</dd></dl>\n</div>\n<h2><span class=\"mw-headline\" id=\"Sources_of_Alternate_Form:_Minotaur\">Sources of Alternate Form: Minotaur</span></h2>\n<div class=\"bg3wiki-condition-sources\"><ul>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 5px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Alternate_Form:_Minotaur\" title=\"Alternate Form: Minotaur\"><picture><source srcset=\"/w/images/thumb/f/f6/Polymorph_Icon.webp/30px-Polymorph_Icon.webp, /w/images/thumb/f/f6/Polymorph_Icon.webp/45px-Polymorph_Icon.webp 1.5x, /w/images/thumb/f/f6/Polymorph_Icon.webp/60px-Polymorph_Icon.webp 2x\"><img alt=\"Alternate Form: Minotaur\" src=\"/w/images/thumb/f/f6/Polymorph_Icon.webp/30px-Polymorph_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f6/Polymorph_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Alternate_Form:_Minotaur\" title=\"Alternate Form: Minotaur\">Alternate Form: Minotaur</a></span></li>\n</ul></div>\n<h2><span class=\"mw-headline\" id=\"Conditions_with_the_same_stack_ID\"> Conditions with the same stack ID </span></h2>\nConditions with the <a href=\"/wiki/Stack_ID\" class=\"mw-redirect\" title=\"Stack ID\">stack ID</a> <code>POLYMORPH</code>, only one of these can be applied at the same time:<table class=\"wikitable sortable\" style=\"width:100%;\">\n<tbody><tr>\n  <th>Condition</th>\n  <th>Effects</th>\n</tr>\n<tr id=\"Alternate_Form:_Dire_Wolf\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Alternate_Form:_Dire_Wolf_(Condition)\" title=\"Alternate Form: Dire Wolf (Condition)\"><picture><source srcset=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/45px-Polymorphed_Condition_Icon.webp 1.5x, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/60px-Polymorphed_Condition_Icon.webp 2x\"><img alt=\"Alternate Form: Dire Wolf\" src=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Polymorphed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Alternate_Form:_Dire_Wolf_(Condition)\" title=\"Alternate Form: Dire Wolf (Condition)\">Alternate Form: Dire Wolf</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Transformed into a Dire Wolf in all the ways that matter.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Alternate_Form:_Minotaur\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Alternate_Form:_Minotaur_(Condition)\" title=\"Alternate Form: Minotaur (Condition)\"><picture><source srcset=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/45px-Polymorphed_Condition_Icon.webp 1.5x, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/60px-Polymorphed_Condition_Icon.webp 2x\"><img alt=\"Alternate Form: Minotaur\" src=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Polymorphed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a class=\"mw-selflink selflink\">Alternate Form: Minotaur</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Transformed into a Minotaur in all the ways that matter.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Alternate_Form:_Phase_Spider\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Alternate_Form:_Phase_Spider_(Condition)\" title=\"Alternate Form: Phase Spider (Condition)\"><picture><source srcset=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/45px-Polymorphed_Condition_Icon.webp 1.5x, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/60px-Polymorphed_Condition_Icon.webp 2x\"><img alt=\"Alternate Form: Phase Spider\" src=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Polymorphed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Alternate_Form:_Phase_Spider_(Condition)\" title=\"Alternate Form: Phase Spider (Condition)\">Alternate Form: Phase Spider</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Transformed into a Phase Spider in all the ways that matter.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Alternate_Form:_Shadow_Mastiff\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Alternate_Form:_Shadow_Mastiff_(Condition)\" title=\"Alternate Form: Shadow Mastiff (Condition)\"><picture><source srcset=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/45px-Polymorphed_Condition_Icon.webp 1.5x, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/60px-Polymorphed_Condition_Icon.webp 2x\"><img alt=\"Alternate Form: Shadow Mastiff\" src=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Polymorphed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Alternate_Form:_Shadow_Mastiff_(Condition)\" title=\"Alternate Form: Shadow Mastiff (Condition)\">Alternate Form: Shadow Mastiff</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Transformed into a Shadow Mastiff in all the ways that matter.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Big_Pig\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Big_Pig_(Condition)\" title=\"Big Pig (Condition)\"><picture><source srcset=\"/w/images/thumb/7/75/Big_Pig_Condition_Icon.webp/30px-Big_Pig_Condition_Icon.webp, /w/images/thumb/7/75/Big_Pig_Condition_Icon.webp/45px-Big_Pig_Condition_Icon.webp 1.5x, /w/images/thumb/7/75/Big_Pig_Condition_Icon.webp/60px-Big_Pig_Condition_Icon.webp 2x\"><img alt=\"Big Pig\" src=\"/w/images/thumb/7/75/Big_Pig_Condition_Icon.webp/30px-Big_Pig_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/75/Big_Pig_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Big_Pig_(Condition)\" title=\"Big Pig (Condition)\">Big Pig</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Pigs are smart and pigs are fun - that's why Dolly made you one!</li></ul>\n</td>\n\n</tr>\n<tr id=\"Cattle_Prattle\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Cattle_Prattle_(Condition)\" title=\"Cattle Prattle (Condition)\"><picture><source srcset=\"/w/images/thumb/a/a1/Cattle_Prattle_Condition_Icon.webp/30px-Cattle_Prattle_Condition_Icon.webp, /w/images/thumb/a/a1/Cattle_Prattle_Condition_Icon.webp/45px-Cattle_Prattle_Condition_Icon.webp 1.5x, /w/images/thumb/a/a1/Cattle_Prattle_Condition_Icon.webp/60px-Cattle_Prattle_Condition_Icon.webp 2x\"><img alt=\"Cattle Prattle\" src=\"/w/images/thumb/a/a1/Cattle_Prattle_Condition_Icon.webp/30px-Cattle_Prattle_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a1/Cattle_Prattle_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Cattle_Prattle_(Condition)\" title=\"Cattle Prattle (Condition)\">Cattle Prattle</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Want to converse like a cow? Dolly Thrice will show you how.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Polymorph\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Polymorph_(Condition)\" title=\"Polymorph (Condition)\"><picture><source srcset=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/45px-Polymorphed_Condition_Icon.webp 1.5x, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/60px-Polymorphed_Condition_Icon.webp 2x\"><img alt=\"Polymorph\" src=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Polymorphed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Polymorph_(Condition)\" title=\"Polymorph (Condition)\">Polymorph</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>You are now a particularly ripe wheel of cheese, unpleasant to the nostril.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Polymorph_Self\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Polymorph_Self_(Condition)\" title=\"Polymorph Self (Condition)\"><picture><source srcset=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/45px-Polymorphed_Condition_Icon.webp 1.5x, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/60px-Polymorphed_Condition_Icon.webp 2x\"><img alt=\"Polymorph Self\" src=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Polymorphed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Polymorph_Self_(Condition)\" title=\"Polymorph Self (Condition)\">Polymorph Self</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Transformed into a blue jay, able to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Fly_(class_action)\" title=\"Fly (class action)\"><picture><source srcset=\"/w/images/thumb/f/f3/Fly_Icon.webp/25px-Fly_Icon.webp, /w/images/thumb/f/f3/Fly_Icon.webp/38px-Fly_Icon.webp 1.5x, /w/images/thumb/f/f3/Fly_Icon.webp/50px-Fly_Icon.webp 2x\"><img alt=\"Fly\" src=\"/w/images/thumb/f/f3/Fly_Icon.webp/25px-Fly_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f3/Fly_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Fly_(class_action)\" title=\"Fly (class action)\">Fly</a> for 5 rounds.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Polymorphed\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Polymorphed_(Condition)\" title=\"Polymorphed (Condition)\"><picture><source srcset=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/45px-Polymorphed_Condition_Icon.webp 1.5x, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/60px-Polymorphed_Condition_Icon.webp 2x\"><img alt=\"Polymorphed\" src=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Polymorphed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Polymorphed_(Condition)\" title=\"Polymorphed (Condition)\">Polymorphed</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Creature is turned into a harmless sheep with 3 <a href=\"/wiki/Hit_Points\" class=\"mw-redirect\" title=\"Hit Points\">Hit Points</a> for 5 turns.</li>\n<li>If the sheep's Hit Points are reduced to 0, the creature reverts to its original form with its original Hit Points.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Polymorphed\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Polymorphed_(Tressym)_(Condition)\" title=\"Polymorphed (Tressym) (Condition)\"><picture><source srcset=\"/w/images/thumb/5/58/Polymorphed_Tressym_Condition_Icon.webp/30px-Polymorphed_Tressym_Condition_Icon.webp, /w/images/thumb/5/58/Polymorphed_Tressym_Condition_Icon.webp/45px-Polymorphed_Tressym_Condition_Icon.webp 1.5x, /w/images/thumb/5/58/Polymorphed_Tressym_Condition_Icon.webp/60px-Polymorphed_Tressym_Condition_Icon.webp 2x\"><img alt=\"Polymorphed\" src=\"/w/images/thumb/5/58/Polymorphed_Tressym_Condition_Icon.webp/30px-Polymorphed_Tressym_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/58/Polymorphed_Tressym_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Polymorphed_(Tressym)_(Condition)\" title=\"Polymorphed (Tressym) (Condition)\">Polymorphed</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Changed into a beast.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Toad_Mode\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Toad_Mode_(Condition)\" title=\"Toad Mode (Condition)\"><picture><source srcset=\"/w/images/thumb/4/4c/Toad_Mode_Condition_Icon.webp/30px-Toad_Mode_Condition_Icon.webp, /w/images/thumb/4/4c/Toad_Mode_Condition_Icon.webp/45px-Toad_Mode_Condition_Icon.webp 1.5x, /w/images/thumb/4/4c/Toad_Mode_Condition_Icon.webp/60px-Toad_Mode_Condition_Icon.webp 2x\"><img alt=\"Toad Mode\" src=\"/w/images/thumb/4/4c/Toad_Mode_Condition_Icon.webp/30px-Toad_Mode_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/4c/Toad_Mode_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Toad_Mode_(Condition)\" title=\"Toad Mode (Condition)\">Toad Mode</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>If you do not want to think, Dolly Thrice will make you shrink.</li></ul>\n</td>\n\n</tr>\n</tbody></table>\n<!-- \nNewPP limit report\nCached time: 20260715065443\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.136 seconds\nReal time usage: 0.144 seconds\nPreprocessor visited node count: 6293/1000000\nPost‐expand include size: 100625/4194304 bytes\nTemplate argument size: 16180/4194304 bytes\nHighest expansion depth: 26/200\nExpensive parser function count: 0/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 0/5000000 bytes\nExtLoops count: 4/1000\nLua time usage: 0.077/7.000 seconds\nLua memory usage: 1925980/52428800 bytes\n-->