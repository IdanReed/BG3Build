b9/Disadvantage_Icon.png/27px-Disadvantage_Icon.png.webp\" decoding=\"async\" width=\"27\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b9/Disadvantage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Disadvantage\" class=\"mw-redirect\" title=\"Disadvantage\">Disadvantage</a> on <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp, /w/images/thumb/b/ba/Attack_Roll_Icon.png/38px-Attack_Roll_Icon.png.webp 1.5x, /w/images/thumb/b/ba/Attack_Roll_Icon.png/50px-Attack_Roll_Icon.png.webp 2x\"><img alt=\"Attack Roll\" src=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/b/ba/Attack_Roll_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Attack_Roll\" class=\"mw-redirect\" title=\"Attack Roll\">Attack Rolls</a>. Range of attacks and spells reduced to 3 m (10 ft).</li>\n<li>Attack Rolls against Blinded creatures have <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Advantage\" title=\"Advantage\"><picture><source srcset=\"/w/images/thumb/f/fc/Advantage_Icon.png/28px-Advantage_Icon.png.webp, /w/images/thumb/f/fc/Advantage_Icon.png/42px-Advantage_Icon.png.webp 1.5x, /w/images/thumb/f/fc/Advantage_Icon.png/55px-Advantage_Icon.png.webp 2x\"><img alt=\"Advantage\" src=\"/w/images/thumb/f/fc/Advantage_Icon.png/28px-Advantage_Icon.png.webp\" decoding=\"async\" width=\"28\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/fc/Advantage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Advantage\" title=\"Advantage\">Advantage</a>.</li></ul>\n</div>\n </div>\n</div><h2><span class=\"mw-headline\" id=\"How_to_learn\"> How to learn </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<p>Granted by items:\n</p>\n<ul>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-rare\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Least_Expected\" title=\"Least Expected\"><picture><source srcset=\"/w/images/thumb/4/46/Shortbow_PlusOne_Unfaded_Icon.png/30px-Shortbow_PlusOne_Unfaded_Icon.png.webp, /w/images/thumb/4/46/Shortbow_PlusOne_Unfaded_Icon.png/45px-Shortbow_PlusOne_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/4/46/Shortbow_PlusOne_Unfaded_Icon.png/60px-Shortbow_PlusOne_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/4/46/Shortbow_PlusOne_Unfaded_Icon.png/30px-Shortbow_PlusOne_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/46/Shortbow_PlusOne_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Least_Expected\" title=\"Least Expected\">Least Expected</a></span> </li>\n</ul>\n</div>  <h2><span class=\"mw-headline\" id=\"Visuals\"> Visuals </span></h2>\n<span class=\"mw-default-size\" typeof=\"mw:File\"><div class=\"embedvideo-wrapper embedvideo--local-embed-style\" style=\"position: relative;\"><div class=\"embedvideo-localEmbedStyle\" aria-hidden=\"true\"><div class=\"embedvideo-overlay\"><div class=\"embedvideo-loader\"><div class=\"embedvideo-loader__fakeButton\">Play Video</div><div class=\"embedvideo-loader__footer\"><div class=\"embedvideo-loader__service\">Local File</div></div></div></div></div><video src=\"https://bg3.wiki/w/images/6/65/Blinding_Shot_Action.mp4\" width=\"640\" he