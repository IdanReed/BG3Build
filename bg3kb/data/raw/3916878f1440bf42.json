.5x, /w/images/thumb/2/28/Jump_Icon.webp/80px-Jump_Icon.webp 2x\"><img alt=\"Crushing Flight\" src=\"/w/images/thumb/2/28/Jump_Icon.webp/40px-Jump_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/28/Jump_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Crushing_Flight\" title=\"Crushing Flight\">Crushing Flight</a> (<span aria-label=\"Bonus Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp, /w/images/thumb/c/c9/Bonus_Action_Icon.png/35px-Bonus_Action_Icon.png.webp 1.5x, /w/images/thumb/c/c9/Bonus_Action_Icon.png/46px-Bonus_Action_Icon.png.webp 2x\"><img alt=\"Bonus Action\" src=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c9/Bonus_Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> + <span aria-label=\"Movement Speed\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/9/97/Movement_Speed_Icon.png/23px-Movement_Speed_Icon.png.webp, /w/images/9/97/Movement_Speed_Icon.png 1.5x\"><img alt=\"Movement Speed\" src=\"/w/images/thumb/9/97/Movement_Speed_Icon.png/23px-Movement_Speed_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/9/97/Movement_Speed_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Leap at a target to bite it and knock it <span class=\"bg3wiki-icontext-icon-wrapper\" style=\"display: inline-flex; align-items: center; justify-content: center; min-width: 25px; height: 25px;\"><span class=\"bg3wiki-icontext-icon\" style=\"vertical-align: middle;\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Prone_(Condition)\" title=\"Prone (Condition)\"><picture><source srcset=\"/w/images/thumb/8/8e/Prone_Condition_Icon.webp/25px-Prone_Condition_Icon.webp, /w/images/thumb/8/8e/Prone_Condition_Icon.webp/38px-Prone_Condition_Icon.webp 1.5x, /w/images/thumb/8/8e/Prone_Condition_Icon.webp/50px-Prone_Condition_Icon.webp 2x\"><img alt=\"Prone\" src=\"/w/images/thumb/8/8e/Prone_Condition_Icon.webp/25px-Prone_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/8e/Prone_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span><span class=\"bg3wiki-after-icon\"></span></span></span>&nbsp;<span class=\"bg3wiki-icontext-text\" style=\"\"><a href=\"/wiki/Prone_(Condition)\" title=\"Prone (Condition)\">Prone</a></span>. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Per turn\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: Per turn.)</dd>\n</dl>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Shadowy_Claws\" title=\"Shadowy Claws\"><picture><source srcset=\"/w/images/thumb/6/6c/Claws_Bear_Icon.webp/40px-Claws_Bear_Icon.webp, /w/images/thumb/6/6c/Claws_Bear_Icon.webp/60px-Claws_Bear_Icon.webp 1.5x, /w/images/thumb/6/6c/Claws_Bear_Icon.webp/80px-Claws_Bear_Icon.webp 2x\"><img alt=\"Shadowy Claws\" src=\"/w/images/thumb/6/6c/Claws_Bear_Icon.webp/40px-Claws_Bear_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/6c/Claws_Bear_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Shadowy_Claws\" title=\"Shadowy Claws\">Shadowy Claws</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Lash out with deadly claws and push the target back 1.5 m / 5 ft. </dd>\n</dl>\n<dl><dt><span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Ethereal\" title=\"Ethereal\"><picture><source srcset=\"/w/images/thumb/9/9d/Generic_Ethereal_Icon.webp/40px-Generic_Ethereal_Icon.webp, /w/images/thumb/9/9d/Generic_Ethereal_Icon.webp/60px-Generic_Ethereal_Icon.webp 1.5x, /w/images/thumb/9/9d/Generic_Ethereal_Icon.webp/80px-Generic_Ethereal_Icon.webp 2x\"><img alt=\"Ethereal\" src=\"/w/images/thumb/9/9d/Generic_Ethereal_Icon.webp/40px-Generic_Ethereal_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/9d/Generic_Ethereal_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Ethereal\" title=\"Ethereal\">Ethereal</a></span></dt><dd>Affected entity is incorporeal and can't be <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Shove\" title=\"Shove\"><picture><source srcset=\"/w/images/thumb/6/6b/Shove_Icon.webp/25px-Shove_Icon.webp, /w/images/thumb/6/6b/Shove_Icon.webp/38px-Shove_Icon.webp 1.5x, /w/images/thumb/6/6b/Shove_Icon.webp/50px-Shove_Icon.webp 2x\"><img alt=\"Shoved\" src=\"/w/images/thumb/6/6b/Shove_Icon.webp/25px-Shove_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/6b/Shove_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Shove\" title=\"Shove\">Shoved</a>, <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Throw\" title=\"Throw\"><picture><source srcset=\"/w/images/thumb/e/e3/Throw_Icon.webp/25px-Throw_Icon.webp, /w/images/thumb/e/e3/Throw_Icon.webp/38px-Throw_Icon.webp 1.5x, /w/images/thumb/e/e3/Throw_Icon.webp/50px-Throw_Icon.webp 2x\"><img alt=\"Thrown\" src=\"/w/images/thumb/e/e3/Throw_Icon.webp/25px-Throw_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e3/Throw_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Throw\" title=\"Throw\">Thrown</a>, or used as an <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Improvised_Melee_Weapon\" titl