Petal_Condition_Icon.webp/25px-Hands_Off%2C_Petal_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/6c/Hands_Off%2C_Petal_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Hands_Off,_Petal_(2)_(Condition)\" title=\"Hands Off, Petal (2) (Condition)\">Hands Off, Petal</a>, dealing <span class=\"bg3wiki-damage-type-psychic\">3d4</span>⁠<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Psychic\" title=\"Psychic\"><picture><source srcset=\"/w/images/thumb/0/04/Psychic_Damage_Icon.png/20px-Psychic_Damage_Icon.png.webp, /w/images/thumb/0/04/Psychic_Damage_Icon.png/30px-Psychic_Damage_Icon.png.webp 1.5x, /w/images/thumb/0/04/Psychic_Damage_Icon.png/40px-Psychic_Damage_Icon.png.webp 2x\"><img alt=\"Psychic\" src=\"/w/images/thumb/0/04/Psychic_Damage_Icon.png/20px-Psychic_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/04/Psychic_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Psychic\" title=\"Psychic\"><span class=\"bg3wiki-damage-type-psychic\">Psychic</span></a> and <span class=\"bg3wiki-damage-type-psychic\">4d4</span>⁠<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Psychic\" title=\"Psychic\"><picture><source srcset=\"/w/images/thumb/0/04/Psychic_Damage_Icon.png/20px-Psychic_Damage_Icon.png.webp, /w/images/thumb/0/04/Psychic_Damage_Icon.png/30px-Psychic_Damage_Icon.png.webp 1.5x, /w/images/thumb/0/04/Psychic_Damage_Icon.png/40px-Psychic_Damage_Icon.png.webp 2x\"><img alt=\"Psychic\" src=\"/w/images/thumb/0/04/Psychic_Damage_Icon.png/20px-Psychic_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" 