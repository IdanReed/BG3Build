con.png/38px-Melee_Range_Icon.png.webp 1.5x, /w/images/2/2a/Melee_Range_Icon.png 2x\"><img alt=\"Melee: 1.5 m (5 ft)\" src=\"/w/images/thumb/2/2a/Melee_Range_Icon.png/25px-Melee_Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2a/Melee_Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Melee: 1.5 m (5 ft)</dd></dl>\n</div>\n\n<div class=\"noexcerpt mw-collapsed mw-collapsible nomobile\">\n<h2><span class=\"mw-headline\" id=\"Technical_details\">Technical details <span class=\"mw-collapsible-toggle-placeholder\"></span></span></h2>\n<div class=\"mw-collapsible-content\"><div style=\"display: flex\">\n  <div><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> UID</div>\n  <div style=\"display: grid; grid-template-columns: min-content auto; grid-gap: 6px; margin-left: 6px;\">  \n  <code class=\"bg3wiki-uid-box\" style=\"margin:0 0 auto\">Target_MAG_Critical_Critical_Combo</code><div><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:Target_MAG_Critical_Critical_Combo\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:Target_MAG_Critical_Critical_Combo\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></div>\n  </div>\n</div><div style=\"displ