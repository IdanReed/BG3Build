_Condition_Icon.webp/25px-Generic_Physical_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/4a/Generic_Physical_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Critical_Hit!_(Condition)\" title=\"Critical Hit! (Condition)\">Critical Hit!</a></li>\n</ul>\n<p>Granted by items:\n</p>\n<ul>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-rare\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Combination_Axe\" title=\"Combination Axe\"><picture><source srcset=\"/w/images/thumb/7/79/Battleaxe_PlusOne_Unfaded_Icon.png/30px-Battleaxe_PlusOne_Unfaded_Icon.png.webp, /w/images/thumb/7/79/Battleaxe_PlusOne_Unfaded_Icon.png/45px-Battleaxe_PlusOne_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/7/79/Battleaxe_PlusOne_Unfaded_Icon.png/60px-Battleaxe_PlusOne_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/7/79/Battleaxe_PlusOne_Unfaded_Icon.png/30px-Battleaxe_PlusOne_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/79/Battleaxe_PlusOne_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Combination_Axe\" title=\"Combination Axe\">Combination Axe</a></span> </li>\n</ul>\n</div><h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>This weapon action requires and consumes the <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Critical_Hit!_(Condition)\" title=\"Critical Hit! (Condition)\"><picture><source srcset=\"/w/images/thumb/4/4a/Generic_Physical_Condition_Icon.webp/20px-Generic_Physical_Co