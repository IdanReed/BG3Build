px-Conjure_Elemental_Air_Myrmidon_Icon.webp 1.5x, /w/images/thumb/4/41/Conjure_Elemental_Air_Myrmidon_Icon.webp/50px-Conjure_Elemental_Air_Myrmidon_Icon.webp 2x\"><img alt=\"Conjure Elemental: Air Myrmidon\" src=\"/w/images/thumb/4/41/Conjure_Elemental_Air_Myrmidon_Icon.webp/25px-Conjure_Elemental_Air_Myrmidon_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/41/Conjure_Elemental_Air_Myrmidon_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Conjure_Elemental:_Air_Myrmidon\" title=\"Conjure Elemental: Air Myrmidon\">Conjure Elemental: Air Myrmidon</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Conjure_Elemental:_Earth_Myrmidon\" title=\"Conjure Elemental: Earth Myrmidon\"><picture><source srcset=\"/w/images/thumb/c/c2/Conjure_Elemental_Earth_Myrmidon_Icon.webp/25px-Conjure_Elemental_Earth_Myrmidon_Icon.webp, /w/images/thumb/c/c2/Conjure_Elemental_Earth_Myrmidon_Icon.webp/38px-Conjure_Elemental_Earth_Myrmidon_Icon.webp 1.5x, /w/images/thumb/c/c2/Conjure_Elemental_Earth_Myrmidon_Icon.webp/50px-Conjure_Elemental_Earth_Myrmidon_Icon.webp 2x\"><img alt=\"Conjure Elemental: Earth Myrmidon\" src=\"/w/images/thumb/c/c2/Conjure_Elemental_Earth_Myrmidon_Icon.webp/25px-Conjure_Elemental_Earth_Myrmidon_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c2/Conjure_Elemental_Earth_Myrmidon_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Conjure_Elemental:_Earth_Myrmidon\" title=\"Conjure Elemental: Earth Myrmidon\">Conjure Elemental: Earth Myrmidon</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Conju