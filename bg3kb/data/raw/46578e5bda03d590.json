it_Gale.png.webp 2x\"><img alt=\"Gale\" src=\"/w/images/thumb/1/11/Portrait_Gale.png/25px-Portrait_Gale.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/11/Portrait_Gale.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Gale\" title=\"Gale\">Gale</a></dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/2a/Melee_Range_Icon.png/25px-Melee_Range_Icon.png.webp, /w/images/thumb/2/2a/Melee_Range_Icon.png/38px-Melee_Range_Icon.png.webp 1.5x, /w/images/2/2a/Melee_Range_Icon.png 2x\"><img alt=\"Melee: 1.5 m (5 ft)\" src=\"/w/images/thumb/2/2a/Melee_Range_Icon.png/25px-Melee_Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2a/Melee_Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Melee: 1.5 m (5 ft)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp, /w/images/thumb/e/ea/Weight_Icon.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 2.7 kg (5.4 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 2.7 kg (5.4 lb)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thum