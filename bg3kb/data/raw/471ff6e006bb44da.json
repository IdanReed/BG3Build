m.png/60px-Portrait_Taslim.png.webp 2x\"><img alt=\"Taslim\" src=\"/w/images/thumb/6/65/Portrait_Taslim.png/30px-Portrait_Taslim.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/65/Portrait_Taslim.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Taslim\" title=\"Taslim\">Taslim</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Teghun\" title=\"Teghun\"><picture><source srcset=\"/w/images/thumb/4/41/Portrait_Teghun.png/30px-Portrait_Teghun.png.webp, /w/images/thumb/4/41/Portrait_Teghun.png/45px-Portrait_Teghun.png.webp 1.5x, /w/images/thumb/4/41/Portrait_Teghun.png/60px-Portrait_Teghun.png.webp 2x\"><img alt=\"Teghun\" src=\"/w/images/thumb/4/41/Portrait_Teghun.png/30px-Portrait_Teghun.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/41/Portrait_Teghun.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Teghun\" title=\"Teghun\">Teghun</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Vin_Dorgo\" title=\"Vin Dorgo\"><picture><source srcset=\"/w/images/thumb/d/de/Portrait_Vin_Dorgo.png/30px-Portrait_Vin_Dorgo.png.webp, /w/images/thumb/d/de/Portrait_Vin_Dorgo.png/45px-Portrait_Vin_Dorgo.png.webp 1.5x, /w/images/thumb/d/de/Portrait_Vin_Dorgo.png/60px-Portrait_Vin_Dorgo.png.webp 2x\"><img alt=\"Vin Dorgo\" src=\"/w/images/thumb/d/de/Portrait_Vin_Dorgo.png/30px-Portrait_Vin_Dorgo.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/de/Portrait_Vin_Dorgo.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Vin_Dorgo\" title=\"Vin Dorgo\">Vin Dorgo</a></li>\n</ul></div>\n<h2><span class=\"mw-headline\" id=\"Conditions_with_the_same_stack_ID\"> Conditions with the same stack ID </span></h2>\nConditions with the <a href=\"/wiki/Stack_ID\" class=\"mw-redirect\" title=\"Stack ID\">stack ID</a> <code>DRUNK</code>, only one of these can be applied at the same time:<table class=\"wikitable sortable\" style=\"width:100%;\">\n<tbody><tr>\n  <th>Condition</th>\n  <th>Effects</th>\n</tr>\n<tr id=\"Drunk\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Drunk_(Condition)\" title=\"Drunk (Condition)\"><picture><source srcset=\"/w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/30px-Alcohol_Condition_Icon.webp, /w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/45px-Alcohol_Condition_Icon.webp 1.5x, /w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/60px-Alcohol_Condition_Icon.webp 2x\"><img alt=\"Drunk\" src=\"/w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/30px-Alcohol_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0a/Alcohol_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a class=\"mw-selflink selflink\">Drunk</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Has <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Disadvantage\" title=\"Disadvantage\"><picture><source srcset=\"/w/images/thumb/b/b9/Disadvantage_Icon.png/27px-Disadvantage_Icon.png.webp, /w/images/thumb/b/b9/Disadvantage_Icon.png/41px-Disadvantage_Icon.png.webp 1.5x, /w/images/thumb/b/b9/Disadvantage_Icon.png/55px-Disadvantage_Icon.png.webp 2x\"><img alt=\"Disadvantage\" src=\"/w/images/thumb/b/b9/Disadvantage_Icon.png/27px-Disadvantage_Icon.png.webp\" decoding=\"async\" width=\"27\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b9/Disadvantage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Disadvantage\" class=\"mw-redirect\" title=\"Disadvantage\">Disadvantage</a> on <a href=\"/wiki/Dexterity\" title=\"Dexterity\">Dexterity</a> and <a href=\"/wiki/Charisma\" title=\"Charisma\">Charisma</a> <a href=\"/wiki/Ability_Check\" class=\"mw-redirect\" title=\"Ability Check\">Checks</a>.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Firewine_Belly\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Firewine_Belly_(Condition)\" title=\"Firewine Belly (Condition)\"><picture><source srcset=\"/w/images/thumb/4/4b/Firewine_Belly_Condition_Icon.webp/30px-Firewine_Belly_Condition_Icon.webp, /w/images/thumb/4/4b/Firewine_Belly_Condition_Icon.webp/45px-Firewine_Belly_Condition_Icon.webp 1.5x, /w/images/thumb/4/4b/Firewine_Belly_Condition_Icon.webp/60px-Firewine_Belly_Condition_Icon.webp 2x\"><img alt=\"Firewine Belly\" src=\"/w/images/thumb/4/4b/Firewine_Belly_Condition_Icon.webp/30px-Firewine_Belly_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/4b/Firewine_Belly_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Firewine_Belly_(Condition)\" title=\"Firewine Belly (Condition)\">Firewine Belly</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Drunk on Firewine. Has <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Disadvantage\" title=\"Disadvantage\"><picture><source srcset=\"/w/images/thumb/b/b9/Disadvantage_Icon.png/27px-Disadvantage_Icon.png.webp, /w/images/thumb/b/b9/Disadvantage_Icon.png/41px-Disadvantage_Icon.png.webp 1.5x, /w/images/thumb/b/b9/Disadvantage_Icon.png/55px-Disadvantage_Icon.png.webp 2x\"><img alt=\"Disadvantage\" src=\"/w/images/thumb/b/b9/Disadvantage_Icon.png/27px-Disadvantage_Icon.png.webp\" decoding=\"async\" width=\"27\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b9/Disadvantage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Disadvantage\" class=\"mw-redirect\" title=\"Disadvantage\">Disadvantage</a> on <a href=\"/wiki/Charisma\" title=\"Charisma\">Charisma</a> and <a href=\"/wiki/Dexterity\" title=\"Dexterity\">Dexterity</a> <a href=\"/wiki/Ability_Check\" class=\"mw-redirect\" title=\"Ability Check\">Checks</a></li>\n<li>If the drunk entity is killed with <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Fire\" title=\"Fire\"><picture><source srcset=\"/w/images/thumb/8/84/Fire_Damage_Icon.png/20px-Fire_Damage_Icon.png.webp, /w/images/thumb/8/84/Fire_Damage_Icon.png/30px-Fire_Damage_Icon.png.webp 1.5x, /w/images/thumb/8/84/Fire_Damage_Icon.png/40px-Fire_Damage_Icon.png.webp 2x\"><img alt=\"Fire\" src=\"/w/images/thumb/8/84/Fire_Damage_Icon.png/20px-Fire_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/84/Fire_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Fire\" title=\"Fire\"><span class=\"bg3wiki-damage-type-fire\">Fire</span></a>, a <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Firewine_Explosion\" title=\"Firewine Explosion\"><picture><source srcset=\"/w/images/thumb/8/8f/Warding_Flare_Icon.webp/25px-Warding_Flare_Icon.webp, /w/images/thumb/8/8f/Warding_Flare_Icon.webp/38px-Warding_Flare_Icon.webp 1.5x, /w/images/thumb/8/8f/Warding_Flare_Icon.webp/50px-Warding_Flare_Icon.webp 2x\"><img alt=\"Firewine Explosion\" src=\"/w/images/thumb/8/8f/Warding_Flare_Icon.webp/25px-Warding_Flare_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/8f/Warding_Flare_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Firewine_Explosion\" title=\"Firewine Explosion\">Firewine Explosion</a> occurs.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Hungover\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Hungover_(Condition)\" title=\"Hungover (Condition)\"><picture><source srcset=\"/w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/30px-Alcohol_Condition_Icon.webp, /w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/45px-Alcohol_Condition_Icon.webp 1.5x, /w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/60px-Alcohol_Condition_Icon.webp 2x\"><img alt=\"Hungover\" src=\"/w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/30px-Alcohol_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0a/Alcohol_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Hungover_(Condition)\" title=\"Hungover (Condition)\">Hungover</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>You have <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Disadvantage\" title=\"Disadvantage\"><picture><source srcset=\"/w/images/thumb/b/b9/Disadvantage_Icon.png/27px-Disadvantage_Icon.png.webp, /w/images/thumb/b/b9/Disadvantage_Icon.png/41px-Disadvantage_Icon.png.webp 1.5x, /w/images/thumb/b/b9/Disadvantage_Icon.png/55px-Disadvantage_Icon.png.webp 2x\"><img alt=\"Disadvantage\" src=\"/w/images/thumb/b/b9/Disadvantage_Icon.png/27px-Disadvantage_Icon.png.webp\" decoding=\"async\" width=\"27\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b9/Disadvantage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Disadvantage\" class=\"mw-redirect\" title=\"Disadvantage\">Disadvantage</a> on <a href=\"/wiki/Dexterity\" title=\"Dexterity\">Dexterity</a> and <a href=\"/wiki/Charisma\" title=\"Charisma\">Charisma</a> <a href=\"/wiki/Ability_Check\" class=\"mw-redirect\" title=\"Ability Check\">Checks</a>.</li>\n<li>You tell yourself 'I'm never drinking again'. You're a liar.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Ingested_Karabasan's_Gift\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Ingested_Karabasan%27s_Gift_(Condition)\" title=\"Ingested Karabasan's Gift (Condition)\"><picture><source srcset=\"/w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/30px-Alcohol_Condition_Icon.webp, /w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/45px-Alcohol_Condition_Icon.webp 1.5x, /w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/60px-Alcohol_Condition_Icon.webp 2x\"><img alt=\"Ingested Karabasan's Gift\" src=\"/w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/30px-Alcohol_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0a/Alcohol_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Ingested_Karabasan%27s_Gift_(Condition)\" title=\"Ingested Karabasan's Gift (Condition)\">Ingested Karabasan's Gift</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>After 1 turn the affected entity will become <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Paralysed_(Condition)\" title=\"Paralysed (Condition)\"><picture><source srcset=\"/w/images/thumb/0/09/Paralysed_Condition_Icon.webp/25px-Paralysed_Condition_Icon.webp, /w/images/thumb/0/09/Paralysed_Condition_Icon.webp/38px-Paralysed_Condition_Icon.webp 1.5x, /w/images/thumb/0/09/Paralysed_Condition_Icon.webp/50px-Paralysed_Condition_Icon.webp 2x\"><img alt=\"Paralysed\" src=\"/w/images/thumb/0/09/Paralysed_Condition_Icon.webp/25px-Paralysed_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/09/Paralysed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Paralysed_(Condition)\" title=\"Paralysed (Condition)\">Paralysed</a></li></ul>\n</td>\n\n</tr>\n</tbody></table><div class=\"bg3wiki-preview-only\">\n\n<h2><span class=\"mw-headline\" id=\"Brief_preview\"> Brief preview </span></h2>\n<div class=\"bg3wiki-tooltip-box\">Has Disadvantage on Dexterity and Charisma checks.</div>\n</div>\n<!-- \nNewPP limit report\nCached time: 20260714195336\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.118 seconds\nReal time usage: 0.124 seconds\nPreprocessor visited node count: 6440/1000000\nPost‐expand include size: 94594/4194304 bytes\nTemplate argument size: 26141/4194304 bytes\nHighest expansion depth: 28/200\nExpensive parser function count: 11/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 0/5000000 bytes\nExtLoops count: 4/1000\nLua time usage: 0.063/7.000 seconds\nLua memory usage: 1274698/52428800 bytes\n-->\n<!--\nTransclusion expansi