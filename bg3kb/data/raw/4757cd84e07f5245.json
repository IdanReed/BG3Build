rait_Tamia_Holzt.png/25px-Portrait_Tamia_Holzt.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a3/Portrait_Tamia_Holzt.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Tamia_Holzt\" title=\"Tamia Holzt\">Tamia Holzt</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ef/Rarity_Icon.png/25px-Rarity_Icon.png.webp, /w/images/thumb/e/ef/Rarity_Icon.png/38px-Rarity_Icon.png.webp 1.5x, /w/images/e/ef/Rarity_Icon.png 2x\"><img alt=\"Rarity: Common\" src=\"/w/images/thumb/e/ef/Rarity_Icon.png/25px-Rarity_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ef/Rarity_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Rarity: Common</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp, /w/images/thumb/e/ea/Weight_Icon.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 0.5 kg (1 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 0.5 kg (1 lb)</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 14 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  14  gp</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"￼START_WIDGET&quot;'-87695fb6d17b4c4eEND_WIDGET ￼START_WIDGET&quot;'-670ff9d0b0913b5aEND_WIDGET\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">S_BOOK_GEN_TamiaDomina</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:S_BOOK_GEN_TamiaDomina\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:S_BOOK_GEN_TamiaDomina\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">6e71d368-dd14-41ad-b590-2e00f128dde7</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:6e71d368-dd14-41ad-b590-2e00f128dde7\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:6e71d368-dd14-41ad-b590-2e00f128dde7\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div>   \n<div style=\"clear: both;\"></div></div>\n    <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>In a row of books in the <a href=\"/wiki/Steel_Watch_Foundry\" title=\"Steel Watch Foundry\">Steel Watch Foundry</a> at <span class=\"bg3wiki-coordinates\">X:&nbsp;-330&nbsp;Y:&nbsp;-157</span></li></ul>\n</div>  <h2><span class=\"mw-headline\" id=\"Text\"> Text </span></h2>\n<div class=\"bg3wiki-book-text\">\n<p>A handwritten journal, a sort of diary recounting sexual relations over the last month between 'TH' and 'BD'. Each entry notes a new position checked off from the '<a href=\"/wiki/The_Quarta_Sune\" title=\"The Quarta Sune\">Quarta Sune</a>', with 'TH' always in the dominant position.\n</p>\n</div> <h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>Based on the initials, the initials 'TH' likely belong to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Tamia_Holzt\" title=\"Tamia Holzt\"><picture><source srcset=\"/w/images/thumb/a/a3/Portrait_Tamia_Holzt.png/25px-Portrait_Tamia_Holzt.png.webp, /w/images/thumb/a/a3/Portrait_Tamia_Holzt.png/38px-Portrait_Tamia_Holzt.png.webp 1.5x, /w/images/thumb/a/a3/Portrait_Tamia_Holzt.png/50px-Portrait_Tamia_Holzt.png.webp 2x\"><img alt=\"Tamia Holzt\" src=\"/w/images/thumb/a/a3/Portrait_Tamia_Holzt.png/25px-Portrait_Tamia_Holzt.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a3/Portrait_Tamia_Holzt.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Tamia_Holzt\" title=\"Tamia Holzt\">Tamia Holzt</a>, and 'BD' could potentially refer to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Bagdog\" title=\"Bagdog\"><picture><source srcset=\"/w/images/thumb/8/84/Portrait_Bagdog.png/25px-Portrait_Bagdog.png.webp, /w/images/thumb/8/84/Portrait_Bagdog.png/38px-Portrait_Bagdog.png.webp 1.5x, /w/images/thumb/8/84/Portrait_Bagdog.png/50px-Portrait_Bagdog.png.webp 2x\"><img alt=\"Bagdog\" src=\"/w/images/thumb/8/84/Portrait_Bagdog.png/25px-Portrait_Bagdog.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/84/Portrait_Bagdog.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Bagdog\" title=\"Bagdog\">Bagdog</a>.</li></ul>\n</div>   \n<!-- \nNewPP limit report\nCached time: 20260715052021\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.054 seconds\nReal time usage: 0.056 seconds\nPreprocessor visited node count: 2146/1000000\nPost‐expand include size: 31911/4194304 bytes\nTemplate argument size: 7685/4194304 bytes\nHighest expansion depth: 29/200\nExpensive parser function count: 3/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 2/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.011/7.000 seconds\nLua memory usage: 936204/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%   44.442      1 Template:MiscItemPage\n100.00%   44.442      1 -total\n 55.96%   24.870      9 Template:Icon_text\n 49.01%   21.781     21 Template:Trim\n 20.24%    8.997      2 Template:Uid\n 17.66%    7.851      4 Template:Icon_link\n 14.19%    6.305      1 Template:Main_only\n 13.68%    6.081      3 Template:CharLink\n 11.82%    5.254      2 Template:T