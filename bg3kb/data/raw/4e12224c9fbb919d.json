c/Shattered_Condition_Icon.webp/35px-Shattered_Condition_Icon.webp, /w/images/thumb/e/ec/Shattered_Condition_Icon.webp/53px-Shattered_Condition_Icon.webp 1.5x, /w/images/e/ec/Shattered_Condition_Icon.webp 2x\"><img src=\"/w/images/thumb/e/ec/Shattered_Condition_Icon.webp/35px-Shattered_Condition_Icon.webp\" decoding=\"async\" width=\"35\" height=\"35\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ec/Shattered_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div></td><td class=\"mbox-text\"><div class=\"mbox-text-span\">This article is about content that is <b><a href=\"/wiki/Category:Inaccessible\" title=\"Category:Inaccessible\">inaccessible</a> through normal gameplay</b>. It can still be accessed via in-game exploits or third party tools.</div></td></tr></tbody></table>\n<p class=\"mw-empty-elt\"> \n</p>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-uncommon\"><figure class=\"mw-default-size mw-halign-right\" typeof=\"mw:File/Frameless\"><a href=\"/wiki/File:Hag%27s_Ring_Faded.png\" class=\"mw-file-description\"><picture><source srcset=\"/w/images/thumb/1/12/Hag%27s_Ring_Faded.png/300px-Hag%27s_Ring_Faded.png.webp, /w/images/1/12/Hag%27s_Ring_Faded.png 1.5x\"><img alt=\"Hag's Ring image\" src=\"/w/images/thumb/1/12/Hag%27s_Ring_Faded.png/300px-Hag%27s_Ring_Faded.png.webp\" decoding=\"async\" width=\"300\" height=\"300\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/12/Hag%27s_Ring_Faded.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a><figcaption></figcaption></figure>\n<p><a class=\"mw-selflink selflink\"><span style=\"color: #01BD39 ;\">Hag's Ring</span></a> is an uncommon <a href=\"/wiki/Rings\" title=\"Rings\">Ring</a> that grants the wearer access to Vicious Mockery\n</p>\n<div style=\"font-size:110%; font-family:'Linux Libertine', 'Georgia', serif; display: flex; flex-wrap: wrap;\">\n<div style=\"opacity: 0.5; margin: 0.5em 0.5em 0.5em 0;\"><span typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/5/5b/Description_Icon.png/24px-Description_Icon.png.webp, /w/images/thumb/5/5b/Description_Icon.png/36px-Description_Icon.png.webp 1.5x, /w/images/5/5b/Description_Icon.png 2x\"><img src=\"/w/images/thumb/5/5b/Description_Icon.png/24px-Description_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/5/5b/Description_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n<div class=\"bg3wiki-blockquote-text\" style=\"width:100px; flex-grow: 1; font-style: italic;\">\n<p>Grimy, discoloured, and revoltingly ugly. Auntie Ethel must have made it herself. Surprisingly, you feel no disgust. Instead it fills you with a longing, as if it's calling out for its like.\n</p>\n</div></div>\n<h2><span class=\"mw-headline\" id=\"Properties\"> Properties </span></h2>\n<div class=\"bg3wiki-property-list\" style=\"margin-left: 7px\"> \n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Rings\" title=\"Rings\"><picture><source srcset=\"/w/images/thumb/c/c4/Rings_Icon.png/25px-Rings_Icon.png.webp, /w/images/thumb/c/c4/Rings_Icon.png/38px-Rings_Icon.png.webp 1.5x, /w/images/thumb/c/c4/Rings_Icon.png/50px-Rings_Icon.png.webp 2x\"><img alt=\"Rings\" src=\"/w/images/thumb/c/c4/Rings_Icon.png/25px-Rings_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c4/Rings_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Rings\" title=\"Rings\">Rings</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><sourc