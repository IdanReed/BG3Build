-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 14 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  14  gp</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"￼START_WIDGET&quot;'-8dadfd14efb8e7daEND_WIDGET ￼START_WIDGET&quot;'-e99c2c93dbf26cb9END_WIDGET\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">BOOK_LOW_TheLodge_InvitationThanks</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:BOOK_LOW_TheLodge_InvitationThanks\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:BOOK_LOW_TheLodge_InvitationThanks\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">d9ef31be-80bd-4f69-a6aa-e74e6f30ca25</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:d9ef31be-80bd-4f69-a6aa-e74e6f30ca25\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:d9ef31be-80bd-4f69-a6aa-e74e6f30ca25\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div>   \n<div style=\"clear: both;\"></div></div>\n    <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>On the second floor of the <a href=\"/wiki/Lodge\" class=\"mw-redirect\" title=\"Lodge\">Lodge</a> at <span class=\"bg3wiki-coordinates\">X:&nbsp;-190&nbsp;Y:&nbsp;-90</span></li></ul>\n</div>  <h2><span class=\"mw-headline\" id=\"Text\"> Text </span></h2>\n<div class=\"bg3wiki-book-text\">\n<p>To our esteemed colleague of the Society,\n</p><p><br>\nYour invitation to present our work at The Lodge was gratefully received. A full response will be forthcoming, once I have had the opportunity to consult with my colleague, <a href=\"/wiki/Omeluum\" title=\"Omeluum\">Omeluum</a>. In the meantime, please consider this note a tentative acceptance, with thanks for your interest. I look forward to speaking in person, soon.\n</p><p><br>\nKind Regards,\n</p><p><br>\nBlurg\n</p>\n</div>    \n<!-- \nNewPP limit report\nCached time: 20260714202448\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.051 seconds\nReal time usage: 0.053 seconds\nPreprocessor visited node count: 1605/1000000\nPost‐expand include size: 28155/4194304 bytes\nTemplate argument size: 6927/4194304 bytes\nHighest expansion depth: 29/200\nExpensive parser function count: 2/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 2/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.011/7.000 seconds\nLua memory usage: 936700/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%   41.921      1 Template:MiscItemPage\n100