ync\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f2/Coated_in_Basic_Poison_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Coated_in_Basic_Poison_(Condition)\" title=\"Coated in Basic Poison (Condition)\">Coated in Basic Poison</a> to your active weapon.<br></li></ul>\n<p><span class=\"bg3wiki-info-blob\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Actions#Resources\" title=\"Actions\">Action</a></span><br>\n</p>\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Throw\" title=\"Throw\"><picture><source srcset=\"/w/images/thumb/e/e3/Throw_Icon.webp/25px-Throw_Icon.webp, /w/images/thumb/e/e3/Throw_Icon.webp/38px-Throw_Icon.webp 1.5x, /w/images/thumb/e/e3/Throw_Icon.webp/50px-Throw_Icon.webp 2x\"><img alt=\"Throw\" src=\"/w/images/thumb/e/e3/Throw_Icon.webp/25px-Throw_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e3/Throw_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Throw\" title=\"Throw\">Throw</a> the poison.\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/0/08/Range_Icon.png/25px-Range_Icon.png.webp, /w/images/thumb/0/08/Range_Icon.png/38px-Range_Icon.png.webp 1.5x, /w/images/0/08/Range_Icon.png 2x\"><img alt=\"Range: 18 m (60 ft)\" src=\"/w/images/thumb/0/08/Range_Icon.png/25px-Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/0/08/Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Range: 18 m (60 ft)</li>\n<li><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp, /w/images/thumb/d/d0/Aoe_Icon.png/38px-Aoe_Icon.png.webp 1.5x, /w/images/d/d0/Aoe_Icon.png 2x\"><img alt=\"Aoe Icon.png\" src=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/d/d0/Aoe_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span>Creates area: <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Poison_Cloud\" title=\"Poison Cloud\"><picture><source srcset=\"/w/images/thumb/7/79/Poison_Cloud_cloud_Icon.webp/25px-Poison_Cloud_cloud_Icon.webp, /w/images/thumb/7/79/Poison_Cloud_cloud_Icon.webp/38px-Poison_Cloud_cloud_Icon.webp 1.5x, /w/images/thumb/7/79/Poison_Cloud_cloud_Icon.webp/50px-Poison_Cloud_cloud_Icon.webp 2x\"><img alt=\"Poison Cloud\" src=\"/w/images/thumb/7/79/Poison_Cloud_cloud_Icon.webp/25px-Poison_Cloud_cloud_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/79/Poison_Cloud_cloud_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Poison_Cloud\" title=\"Poison Cloud\">Poison Cloud</a></li></ul></li></ul>\n<div style=\"clear: both;\"></div></div>\n<h2><span class=\"mw-headline\" id=\"Condition:_Coated_in_Basic_Poison\"> Condition: Coated in Basic Poison </span></h2>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\">\n<div class=\"bg3wiki-condition\"><strong><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Coated_in_Basic_Poison_(Condition)\" title=\"Coated in Basic Poison (Condition)\"><picture><source srcset=\"/w/images/thumb/f/f2/Coated_in_Basic_Poison_Condition_Icon.webp/30px-Coated_in_Basic_Poison_Condition_Icon.webp, /w/images/thumb/f/f2/Coated_in_Basic_Poison_Condition_Icon.webp/45px-Coated_in_Basic_Poison_Condition_Icon.webp 1.5x, /w/images/thumb/f/f2/Coated_in_Basic_Poison_Condition_Icon.webp/60px-Coated_in_Basic_Poison_Condition_Icon.webp 2x\"><img alt=\"Coated in Basic Poison\" src=\"/w/images/thumb/f/f2/Coated_in_Basic_Poison_Condition_Icon.webp/30px-Coated_in_Basic_Poison_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f2/Coated_in_Basic_Poison_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Coated_in_Basic_Poison_(Condition)\" title=\"Coated in Basic Poison (Condition)\">Coated in Basic Poison</a></strong><p><span class=\"bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp, /w/images/thumb/6/6a/Duration_Icons.png/38px-Duration_Icons.png.webp 1.5x, /w/images/thumb/6/6a/Duration_Icons.png/50px-Duration_Icons.png.webp 2x\"><img alt=\"Duration Icons.png\" src=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/6/6a/Duration_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Duration: 10  turns</p>\n<div>\n<ul><li>Targets must succeed a <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp, /w/images/e/e7/Saving_Throw_Icon.png 1.5x\"><img alt=\"DC&nbsp;11 Constitution Saving Throw\" src=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/e7/Saving_Throw_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dice_rolls#Save_DCs\" title=\"Dice rolls\">DC</a>&nbsp;11 <a href=\"/wiki/Constitution\" title=\"Constitution\">Constitution</a> <a href=\"/wiki/Saving_Throw\" class=\"mw-redirect\" title=\"Saving Throw\">Saving Throw</a> or become <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Poisoned_(Condition)\" title=\"Poisoned (Condition)\"><picture><source srcset=\"/w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/25px-Poisoned_Condition_Icon.webp, /w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/38px-Poisoned_Condition_Icon.webp 1.5x, /w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/50px-Poisoned_Condition_Icon.webp 2x\"><img alt=\"Poisoned\" src=\"/w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/25px-Poisoned_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e9/Poisoned_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Poisoned_(Condition)\" title=\"Poisoned (Condition)\">Poisoned</a>.</li>\n<li>On a successful save, target receives <a href=\"/wiki/Inoculated:_Basic_Poison_(Condition)\" title=\"Inoculated: Basic Poison (Condition)\">Inoculated: Basic Poison</a> for 2 turns.</li></ul>\n</div>\n </div>\n</div>   <h2><span class=\"mw-headline\" id=\"Area:_Poison_Cloud\"> Area: Poison Cloud </span></h2>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\">\n<span class=\"bg3wiki-condition\"><strong><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Poison_Cloud\" title=\"Poison Cloud\"><picture><source srcset=\"/w/images/thumb/7/79/Poison_Cloud_cloud_Icon.webp/30px-Poison_Cloud_cloud_Icon.webp, /w/images/thumb/7/79/Poison_Cloud_cloud_Icon.webp/45px-Poison_Cloud_cloud_Icon.webp 1.5x, /w/images/thumb/7/79/Poison_Cloud_cloud_Icon.webp/60px-Poison_Cloud_cloud_Icon.webp 2x\"><img alt=\"Poison Cloud\" src=\"/w/images/thumb/7/79/Poison_Cloud_cloud_Icon.webp/30px-Poison_Cloud_cloud_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/79/Poison_Cloud_cloud_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Poison_Cloud\" title=\"Poison Cloud\">Poison Cloud</a></strong><p><span class=\"bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp, /w/images/thumb/6/6a/Duration_Icons.png/38px-Duration_Icons.png.webp 1.5x, /w/images/thumb/6/6a/Duration_Icons.png/50px-Duration_Icons.png.webp 2x\"><img alt=\"Duration Icons.png\" src=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/6/6a/Duration_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Duration: 1 turn</p><p><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp, /w/images/thumb/d/d0/Aoe_Icon.png/38px-Aoe_Icon.png.webp 1.5x, /w/images/d/d0/Aoe_Icon.png 2x\"><img alt=\"AoE: 1 m (3 ft) Radius\" src=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/d/d0/Aoe_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> AoE: 1 m (3 ft) Radius</p>\n<div>\n<p>Chance to set Poisoned.\n</p>\n</div>\n<dl class=\"bg3wiki-property-list\">\n<dd><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/0/04/Condition_Type_Icon.webp/25px-Condition_Type_Icon.webp, /w/images/thumb/0/04/Condition_Type_Icon.webp/38px-Condition_Type_Icon.webp 1.5x, /w/images/0/04/Condition_Type_Icon.webp 2x\"><img alt=\"Condition Type Icon.png\" src=\"/w/images/thumb/0/04/Condition_Type_Icon.webp/25px-Condition_Type_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/0/04/Condition_Type_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Type: <a href=\"/wiki/Area#Cloud\" class=\"mw-redirect\" title=\"Area\">Cloud</a></dd>\n\n</dl><h3><span class=\"mw-headline\" id=\"Condition:_Poisoned\"> Condition: Poisoned </span></h3>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\">\n<div class=\"bg3wiki-condition\"><strong><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Poisoned_(Condition)\" title=\"Poisoned (Condition)\"><picture><source srcset=\"/w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/30px-Poisoned_Condition_Icon.webp, /w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/45px-Poisoned_Condition_Icon.webp 1.5x, /w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/60px-Poisoned_Condition_Icon.webp 2x\"><img alt=\"Poisoned\" src=\"/w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/30px-Poisoned_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e9/Poisoned_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Poisoned_(Condition)\" title=\"Poisoned (Condition)\">Poisoned</a></strong><p><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp, /w/images/e/e7/Saving_Throw_Icon.png 1.5x\"><img alt=\"CON Save (DC&nbsp;11)\" src=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/e7/Saving_Throw_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Constitution\" title=\"Constitution\">CON</a> <a href=\"/wiki/Saving_throws\" title=\"Saving throws\">Save</a> (<a href=\"/wiki/DC\" class=\"mw-redirect\" title=\"DC\">DC</a>&nbsp;11)</p>\n<div>\n<ul><li>Suffers <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Disadvantage\" title=\"Disadvantage\"><picture><source srcset=\"/w/images/thumb/b/b9/Disadvantage_Icon.png/27px-Disadvantage_Icon.png.webp, /w/images/thumb/b/b9/Disadvantage_Icon.png/41px-Disadvantage_Icon.png.webp 1.5x, /w/images/thumb/b/b9/Disadvantage_Icon.png/55px-Disadvantage_Icon.png.webp 2x\"><img alt=\"Disadvantage\" src=\"/w/images/thumb/b/b9/Disadvantage_Icon.png/27px-Disadvantage_Icon.png.webp\" decoding=\"async\" width=\"27\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b9/Disadvantage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Disadvantage\" class=\"mw-redirect\" title=\"Disadvantage\">Disadvantage</a> on <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp, /w/images/thumb/b/ba/Attack_Roll_Icon.png/38px-Attack_Roll_Icon.png.webp 1.5x, /w/images/thumb/b/ba/Attack_Roll_Icon.png/50px-Attack_Roll_Icon.png.webp 2x\"><img alt=\"Attack Roll\" src=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/b/ba/Attack_Roll_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Attack_Roll\" class=\"mw-redirect\" title=\"Attack Roll\">Attack Rolls</a> and <a href=\"/wiki/Checks\" class=\"mw-redirect\" title=\"Checks\">Ability Checks</a>.</li></ul>\n</div>\n </div>\n</div> </span>\n</div> <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>Obtainable from various merchants, enemies, and locations throughout the game</li>\n<li>Crafted via <a href=\"/wiki/Alchemy\" title=\"Alchemy\">Alchemy</a> by combining <span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Vitriol_of_Bonecap\" title=\"Vitriol of Bonecap\"><picture><source srcset=\"/w/images/thumb/d/da/Vitriol_of_Bonecap_Item_Icon.png/20px-Vitriol_of_Bonecap_Item_Icon.png.webp, /w/images/thumb/d/da/Vitriol_of_Bonecap_Item_Icon.png/30px-Vitriol_of_Bonecap_Item_Icon.png.webp 1.5x, /w/images/thumb/d/da/Vitriol_of_Bonecap_Item_Icon.png/40px-Vitriol_of_Bonecap_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/d/da/Vitriol_of_Bonecap_Item_Icon.png/20px-Vitriol_of_Bonecap_Item_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/da/Vitriol_of_Bonecap_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Vitriol_of_Bonecap\" title=\"Vitriol of Bonecap\">Vitriol of Bonecap</a> (procured from <span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Bonecap\" title=\"Bonecap\"><picture><source srcset=\"/w/images/thumb/4/49/Bonecap_Item_Icon.png/20px-Bonecap_Item_Icon.png.webp, /w/images/thumb/4/49/Bonecap_Item_Icon.png/30px-Bonecap_Item_Icon.png.webp 1.5x, /w/images/thumb/4/49/Bonecap_Item_Icon.png/40px-Bonecap_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/4/49/Bonecap_Item_Icon.png/20px-Bonecap_Item_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/49/Bonecap_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Bonecap\" title=\"Bonecap\">Bonecap</a>) and any <a href=\"/wiki/Alchemy#Extractions\" title=\"Alchemy\">Ashes</a></li></ul>\n</div>   <h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>If the <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Poisoned_(Condition)\" title=\"Poisoned (Condition)\"><picture><source srcset=\"/w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/25px-Poisoned_Condition_Icon.webp, /w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/38px-Poisoned_Condition_Icon.webp 1.5x, /w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/50px-Poisoned_Condition_Icon.webp 2x\"><img alt=\"Poisoned\" src=\"/w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/25px-Poisoned_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e9/Poisoned_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Poisoned_(Condition)\" title=\"Poisoned (Condition)\">Poisoned</a> condition is applied using a coated weapon, the condition has the following properties:\n<ul><li>In addition to the original save upon application, an additional save is made at the end of each turn.</li>\n<li>The condition lasts until a successful (DC 11) save is made.</li></ul></li>\n<li>Throwing this potion can cause two different kinds of Poisoned conditions:\n<ul><li>The Poison Cloud can cause Poisoned condition with duration 1 which loses duration at the beginning of the turn (using DC 11).</li>\n<li>The blast can cause similar Poisoned condition as hitting an enemy with a weapon coated with Basic Poison. In this case, battle log erroneously shows in calculations (but not in result) as if the character's DC was used. However, the result is always shown as 11, which is the correct value.</li>\n<li>Both conditions use the same icon, but the one from Poison Cloud shows also the duration number (1) and timer (brown arc around the icon), while the other does not.</li></ul></li>\n<li>Under most circumstances, purchasing the ingredients is substantially more expensive than purchasing the poison directly from a merchant.</li></ul>\n</div>   \n<h2><span class=\"mw-headline\" id=\"Passive_features\">Passive features</span></h2>\n<p>Basic Poison has 1 <a href=\"/wiki/Hit_points\" title=\"Hit points\">hit point</a>.\n</p>\n<table class=\"wikitable\" style=\"width: 62%;\">\n<caption>Resistances</caption>\n<tbody><tr><td><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Piercing\" title=\"Piercing\"><picture><source srcset=\"/w/images/thumb/0/0b/Piercing_Damage_Icon.png/20px-Piercing_Damage_Icon.png.webp, /w/images/thumb/0/0b/Piercing_Damage_Icon.png/30px-Piercing_Damage_Icon.png.webp 1.5x, /w/images/thumb/0/0b/Piercing_Damage_Icon.png/40px-Piercing_Damage_Icon.png.webp 2x\"><img alt=\"Piercing\" src=\"/w/images/thumb/0/0b/Piercing_Damage_Icon.png/20px-Piercing_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0b/Piercing_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Piercing\" title=\"Piercing\"><span class=\"bg3wiki-damage-type-piercing\">Piercing</span></a></td><td>Resistant</td></tr><tr><td><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Necrotic\" title=\"Necrotic\"><picture><source srcset=\"/w/images/thumb/3/39/Necrotic_Damage_Icon.png/20px-Necrotic_Damage_Icon.png.webp, /w/images/thumb/3/39/Necrotic_Damage_Icon.png/30px-Necrotic_Damage_Icon.png.webp 1.5x, /w/images/thumb/3/39/Necrotic_Damage_Icon.png/40px-Necrotic_Damage_Icon.png.webp 2x\"><img alt=\"Necrotic\" src=\"/w/images/thumb/3/39/Necrotic_Damage_Icon.png/20px-Necrotic_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/39/Necrotic_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Necrotic\" title=\"Necrotic\"><span class=\"bg3wiki-damage-type-necrotic\">Necrotic</span></a></td><td>Resistant</td></tr><tr><td><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Poison\" title=\"Poison\"><picture><source srcset=\"/w/images/thumb/5/55/Poison_Damage_Icon.png/20px-Poison_Damage_Icon.png.webp, /w/images/thumb/5/55/Poison_Damage_Icon.png/30px-Poison_Damage_Icon.png.webp 1.5x, /w/images/thumb/5/55/Poison_Damage_Icon.png/40px-Poison_Damage_Icon.png.webp 2x\"><img alt=\"Poison\" src=\"/w/images/thumb/5/55/Poison_Damage_Icon.png/20px-Poison_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/55/Poison_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Poison\" title=\"Poison\"><span class=\"bg3wiki-damage-type-poison\">Poison</span></a></td><td>Immune</td></tr><tr><td><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Psychic\" title=\"Psychic\"><picture><source srcset=\"/w/images/thumb/0/04/Psychic_Damage_Icon.png/20px-Psychic_Damage_Icon.png.webp, /w/images/thumb/0/04/Psychic_Damage_Icon.png/30px-Psychic_Damage_Icon.png.webp 1.5x, /w/images/thumb/0/04/Psychic_Damage_Icon.png/40px-Psychic_Damage_Icon.png.webp 2x\"><img alt=\"Psychic\" src=\"/w/images/thumb/0/04/Psychic_Damage_Icon.png/20px-Psychic_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/04/Psychic_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Psychic\" title=\"Psychic\"><span class=\"bg3wiki-damage-type-psychic\">Psychic</span></a></td><td>Immune</td></tr><tr><td><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Radiant\" title=\"Radiant\"><picture><source srcset=\"/w/images/thumb/7/78/Radiant_Damage_Icon.png/20px-Radiant_Damage_Icon.png.webp, /w/images/thumb/7/78/Radiant_Damage_Icon.png/30px-Radiant_Damage_Icon.png.webp 1.5x, /w/images/thumb/7/78/Radiant_Damage_Icon.png/40px-Radiant_Damage_Icon.png.webp 2x\"><img alt=\"Radiant\" src=\"/w/images/thumb/7/78/Radiant_Damage_Icon.png/20