humb/7/7d/Bludgeoning_Damage_Icon.png/40px-Bludgeoning_Damage_Icon.png.webp 2x\"><img alt=\"Bludgeoning\" src=\"/w/images/thumb/7/7d/Bludgeoning_Damage_Icon.png/20px-Bludgeoning_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/7d/Bludgeoning_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Bludgeoning\" title=\"Bludgeoning\"><span class=\"bg3wiki-damage-type-bludgeoning\">Bludgeoning</span></a></div></div></div></dd>\n<dt>Details</dt>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp, /w/images/e/e7/Saving_Throw_Icon.png 1.5x\"><img alt=\"DEX Save (DC&nbsp;16)\" src=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/e7/Saving_Throw_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dexterity\" title=\"Dexterity\">DEX</a> <a href=\"/wiki/Saving_throws\" title=\"Saving throws\">Save</a> (<a href=\"/wiki/DC\" class=\"mw-redirect\" title=\"DC\">DC</a>&nbsp;16)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/0/08/Range_Icon.png/25px-Range_Icon.png.webp, /w/images/thumb/0/08/Range_Icon.png/38px-Range_Icon.png.webp 1.5x, /w/images/0/08/Range_Icon.png 2x\"><img alt=\"Range: 14 m (47 ft)\" src=\"/w/images/thumb/0/08/Range_Icon.png/25px-Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/0/08/Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Range: 14 m (47 ft)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/23/Pull_Icon.png/25px-Pull_Icon.png.webp, /w/images/thumb/2/23/Pull_Icon.png/38px-Pull_Icon.png.webp 1.5x, /w/images/thumb/2/23/Pull_Icon.png/50px-Pull_Icon.png.webp 2x\"><img alt=\"Pulls: 11 m (37 ft)\" src=\"/w/images/thumb/2/23/Pull_Icon.png/25px-Pull_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/23/Pull_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Pulls: 11 m (37 ft)</dd></dl>\n</div>\n\n<div class=\"noexcerpt mw-collapsed mw-collapsible nomobile\">\n<h2><span class=\"mw-headline\" id=\"Technical_details\">Technical details <span class=\"mw-collapsible-toggle-placeholder\"></span></span></h2>\n<div class=\"mw-collapsible-content\"><div style=\"display: flex\">\n  <div><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> UID</div>\n  <div style=\"display: grid; grid-template-columns: min-content auto; grid-gap: 6px; margin-left: 6px;\">  \n  <code class=\"bg3wiki-uid-box\" style=\"margin:0 0 auto\">Target_SteelWatcher_Biped_RetrievingShot</code><div><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:Target_SteelWatcher_Biped_RetrievingShot\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:Target_SteelWatcher_Biped_RetrievingShot\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></div>\n  </div>\n</div><div style=\"display: flex; margin-top: 12px\">\n  <div style=\"margin-right:6px\"><span style=\"white-space:nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/8/88/Ico_Report.webp/25px-Ico_Report.webp, /w/images/thumb/8/88/Ico_Report.webp/38px-Ico_Report.webp 1.5x, /w/images/8/88/Ico_Report.webp 2x\"><img alt=\"Ico Report.webp\" src=\"/w/images/thumb/8/88/Ico_Report.webp/25px-Ico_Report.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/8/88/Ico_Report.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Spell flags</span></div>\n  <div><code><a href=\"/wiki/AddFallDamageOnLand_(spell_flag)\" title=\"AddFallDamageOnLand (spell flag)\">AddFallDamageOnLand</a></code>, <code><a href=\"/wiki/HasHighGroundRangeExtension_(spell_flag)\" title=\"HasHighGroundRangeExtension (spell flag)\">HasHighGroundRangeExtension</a></code>, <code><a href=\"/wiki/HasSomaticComponent_(spell_flag)\" title=\"HasSomaticComponent (spell flag)\">HasSomaticComponent</a></code>, <code><a href=\"/wiki/IsHarmful_(spell_flag)\" title=\"IsHarmful (spell flag)\">IsHarmful</a></code>, <code><a href=\"/w/index.php?title=RangeIgnoreVerticalThreshold_(spell_flag)&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"RangeIgnoreVerticalThreshold (spell flag) (page does not exist)\">RangeIgnoreVerticalThreshold</a></code></div>\n</div>\n</div>\n</div><div style=\"clear: both;\"></div></div><h2><span class=\"mw-headline\" id=\"How_to_learn\"> How to learn </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<p>Used by creatures:\n<a href=\"/wiki/Steel_Watcher\" title=\"Steel Watcher\">Steel Watcher</a>\n</p>\n</div><h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>Reposition Malefactor does not use an <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp, /w/images/thumb/b/ba/Attack_Roll_Icon.png/38px-Attack_Roll_Icon.png.webp 1.5x, /w/images/thumb/b/ba/Attack_Roll_Icon.png/50px-Attack_Roll_Icon.png.webp 2x\"><img alt=\"Attack Roll\" src=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/b/ba/Attack_Roll_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Attack_Roll\" class=\"mw-redirect\" title=\"Attack Roll\">Attack Roll</a> to determine if it hits.</li>\n<li>When used on an allied creature, Reposition Malefactor does not require a saving throw and does not deal any damage.</li></ul>\n</div>   \n<!-- \nNewPP limit report\nCached time: 20260715064736\nCache expiry: 86400\nReduced expiry: false\nComplications: [no‐toc]\nCPU time usage: 0.064 seconds\nReal time usage: 0.067 seconds\nPreprocessor visited node count: 2309/1000000\nPost‐expand include size: 40166/4194304 bytes\nTemplate argument size: 13187/4194304 bytes\nHighest expansion depth: 23/200\nExpensive parser function count: 3/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 4/5000000 bytes\nExtLoops count: 34/1000\nLua time usage: 0.018/7.000 seconds\nLua memory usage: 1179255/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%   55.468      1 -total\n 98.83%   54.817      1 Template:Feature_page\n 88.43%   49.049     35 Template:Trim\