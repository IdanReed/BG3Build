.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">MAG_BarbMonk_Offensive_Cloth</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:MAG_BarbMonk_Offensive_Cloth\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:MAG_BarbMonk_Offensive_Cloth\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">48215bcb-b4a2-48cb-bfbe-8b601e678032</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:48215bcb-b4a2-48cb-bfbe-8b601e678032\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:48215bcb-b4a2-48cb-bfbe-8b601e678032\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div> \n<h3><span class=\"mw-headline\" id=\"Special\">Special</span></h3>\n<p>The wearer of this item gains:\n\n</p>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Bull_Rush\" title=\"Bull Rush\"><picture><source srcset=\"/w/images/thumb/4/44/Charge_Minotaur_Icon.webp/40px-Charge_Minotaur_Icon.webp, /w/images/thumb/4/44/Charge_Minotaur_Icon.webp/60px-Charge_Minotaur_Icon.webp 1.5x, /w/images/thumb/4/44/Charge_Minotaur_Icon.webp/80px-Charge_Minotaur_Icon.webp 2x\"><img alt=\"Bull Rush\" src=\"/w/images/thumb/4/44/Charge_Minotaur_Icon.webp/40px-Charge_Minotaur_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/44/Charge_Minotaur_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Bull_Rush\" title=\"Bull Rush\">Bull Rush</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> + <span aria-label=\"Movement Speed\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/9/97/Movement_Speed_Icon.png/23px-Movement_Speed_Icon.png.webp, /w/images/9/97/Movement_Speed_Icon.png 1.5x\"><img alt=\"Movement Speed\" src=\"/w/images/thumb/9/97/Movement_Speed_Icon.png/23px-Movement_Speed_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/9/97/Movement_Speed_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Charge forward and possibly knock your foes back 3 m (10 ft). (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Per turn\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: Per turn.)</dd>\n</dl>\n<dl><dt><a href=\"/wiki/Bull%27s_Strength_(passive_feature)\" title=\"Bull's Strength (passive feature)\">Bull's Strength</a></dt><dd>You gain <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Bull%27s_Strength\" title=\"Bull's Strength\"><picture><source srcset=\"/w/images/thumb/c/c5/Bull%27s_Strength_Icon.webp/25px-Bull%27s_Strength_Icon.webp, /w/images/thumb/c/c5/Bull%27s_Strength_Icon.webp/38px-Bull%27s_Strength_Icon.webp 1.5x, /w/images/thumb/c/c5/Bull%27s_Strength_Icon.webp/50px-Bull%27s_Strength_Icon.webp 2x\"><img alt=\"Bull's Strength\" src=\"/w/images/thumb/c/c5/Bull%27s_Strength_Icon.webp/25px-Bull%27s_Strength_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c5/Bull%27s_Strength_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Bull%27s_Strength\" title=\"Bull's Strength\">Bull's Strength</a> and increase your <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Strength\" title=\"Strength\"><picture><source srcset=\"/w/images/thumb/4/43/Strength_Small_Icon.png/25px-Strength_Small_Icon.png.webp, /w/images/thumb/4/43/Strength_Small_Icon.png/38px-Strength_Small_Icon.png.webp 1.5x, /w/images/thumb/4/43/Strength_Small_Icon.png/50px-Strength_Small_Icon.png.webp 2x\"><img alt=\"Strength\" src=\"/w/images/thumb/4/43/Strength_Small_Icon.png/25px-Strength_Small_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/43/Strength_Small_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Strength\" title=\"Strength\">Strength</a> by 2, to a maximum of 20.</dd></dl><dl><dt><a href=\"/wiki/Unwavering_Bull\" title=\"Unwavering Bull\">Unwavering Bull</a></dt><dd>You cannot be pushed against your will and you have an <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Advantage\" title=\"Advantage\"><picture><source srcset=\"/w/images/thumb/f/fc/Advantage_Icon.png/28px-Advantage_Icon.png.webp, /w/images/thumb/f/fc/Advantage_Icon.png/42px-Advantage_Icon.png.webp 1.5x, /w/images/thumb/f/fc/Advantage_Icon.png/55px-Advantage_Icon.png.webp 2x\"><img alt=\"Advantage\" src=\"/w/images/thumb/f/fc/Advantage_Icon.png/28px-Advantage_Icon.png.webp\" decoding=\"async\" width=\"28\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/fc/Advantage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Advantage\" title=\"Advantage\">Advantage</a> on <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp, /w/images/e/e7/Saving_Throw_Icon.png 1.5x\"><img alt=\"Saving throw\" src=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></pictur