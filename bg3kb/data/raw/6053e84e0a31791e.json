umb/6/6a/Duration_Icons.png/38px-Duration_Icons.png.webp 1.5x, /w/images/thumb/6/6a/Duration_Icons.png/50px-Duration_Icons.png.webp 2x\"><img alt=\"Duration Icons.png\" src=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/6/6a/Duration_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Duration: 3  turns</p>\n<div>\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lava\" title=\"Lava\"><picture><source srcset=\"/w/images/thumb/4/4e/Lava_surface_Icon.webp/25px-Lava_surface_Icon.webp, /w/images/thumb/4/4e/Lava_surface_Icon.webp/38px-Lava_surface_Icon.webp 1.5x, /w/images/thumb/4/4e/Lava_surface_Icon.webp/50px-Lava_surface_Icon.webp 2x\"><img alt=\"Lava\" src=\"/w/images/thumb/4/4e/Lava_surface_Icon.webp/25px-Lava_surface_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/4e/Lava_surface_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Lava\" title=\"Lava\">Lava</a> pools in this creature's footsteps.</li></ul>\n</div>\n </div>\n</div><h2><span class=\"mw-headline\" id=\"Area:_Lava\"> Area: Lava </span></h2>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\">\n<span class=\"bg3wiki-condition\"><strong><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lava\" title=\"Lava\"><picture><source srcset=\"/w/images/thumb/4/4e/Lava_surface_Icon.webp/30px-Lava_surface_Icon.webp, /w/images/thumb/4/4e/Lava_surface_Icon.webp/45px-Lava_surface_Icon.webp 1.5x, /w/images/thumb/4/4e/Lava_surface_Icon.webp/60px-Lava_surface_Icon.webp 2x\"><img alt=\"Lava\" src=\"/w/images/thumb/4/4e/Lava_surfa