f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Actions#Resources\" title=\"Actions\">Action</a> </span>\n- <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Throw\" title=\"Throw\"><picture><source srcset=\"/w/images/thumb/e/e3/Throw_Icon.webp/25px-Throw_Icon.webp, /w/images/thumb/e/e3/Throw_Icon.webp/38px-Throw_Icon.webp 1.5x, /w/images/thumb/e/e3/Throw_Icon.webp/50px-Throw_Icon.webp 2x\"><img alt=\"Throw\" src=\"/w/images/thumb/e/e3/Throw_Icon.webp/25px-Throw_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e3/Throw_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Throw\" title=\"Throw\">Throw</a> a slime-covered bulb that explodes on impact\n</p>\n<dl><dd><ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/0/08/Range_Icon.png/25px-Range_Icon.png.webp, /w/images/thumb/0/08/Range_Icon.png/38px-Range_Icon.png.webp 1.5x, /w/images/0/08/Range_Icon.png 2x\"><img alt=\"Range: 18 m (60 ft)\" src=\"/w/images/thumb/0/08/Range_Icon.png/25px-Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/0/08/Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Range: 18 m (60 ft)</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp, /w/images/thumb/d/d0/Aoe_Icon.png/38px-Aoe_Icon.png.webp 1.5x, /w/images/d/d0/Aoe_Icon.png 2x\"><img alt=\"AoE: 1 m (3 ft) Radius\" src=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/d/d0/Aoe_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> AoE: 1 m (3 ft) Radius</li>\n<li><div class=\"bg3wiki-info-blob\"><span style=\"display: inline-block; width: 30px;\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/ff/D4_Fire.png/31px-D4_Fire.png.webp, /w/images/thumb/f/ff/D4_Fire.png/46px-D4_Fire.png.webp 1.5x, /w/images/thumb/f/ff/D4_Fire.png/62px-D4_Fire.png.webp 2x\"><img src=\"/w/images/thumb/f/ff/D4_Fire.png/31px-D4_Fire.png.webp\" decoding=\"async\" width=\"31\" height=\"30\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/ff/D4_Fire.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> </span> <span class=\"bg3wiki-damage-type-fire\">1d4 + 2 (3~6)  <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Fire\" title=\"Fire\"><picture><source srcset=\"/w/images/thumb/8/84/Fire_Damage_Icon.png/20px-Fire_Damage_Icon.png.webp, /w/images/thumb/8/84/Fire_Damage_Icon.png/30px-Fire_Damage_Icon.png.webp 1.5x, /w/images/thumb/8/84/Fire_Damage_Icon.png/40px-Fire_Damage_Icon.png.webp 2x\"><img alt=\"Fire\" src=\"/w/images/thumb/8/84/Fire_Damage_Icon.png/20px-Fire_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/84/Fire_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Fire\" title=\"Fire\"><span class=\"bg3wiki-damage-type-fire\">Fire</span></a></span> </div> damage</li>\n<li>Inflicts <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Burning_(Condition)\" title=\"Burning (Condition)\"><picture><source srcset=\"/w/images/thumb/c/c8/Burning_Condition_Icon.webp/25px-Burning_Condition_Icon.webp, /w/images/thumb/c/c8/Burning_Condition_Icon.webp/38px-Burning_Condition_Icon.webp 1.5x, /w/images/thumb/c/c8/Burning_Condition_Icon.webp/50px-Burning_Condition_Icon.webp 2x\"><img alt=\"Burning\" src=\"/w/images/thumb/c/c8/Burning_Condition_Icon.webp/25px-Burning_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c8/Burning_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Burning_(Condition)\" title=\"Burning (Condition)\">Burning</a> for <span class=\"bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp, /w/images/thumb/6/6a/Duration_Icons.png/38px-Duration_Icons.png.webp 1.5x, /w/images/thumb/6/6a/Duration_Icons.png/50px-Duration_Icons.png.webp 2x\"><img alt=\"Duration Icons.png\" src=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/6/6a/Duration_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Duration: 5 turns</li></ul></dd></dl>\n<div style=\"clear: both;\"></div></div>\n<h2><span class=\"mw-headline\" id=\"Condition:_Burning\"> Condition: Burning </span></h2>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\">\n<div class=\"bg3wiki-condition\"><strong><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Burning_(Condition)\" title=\"Burning (Condition)\"><picture><source srcset=\"/w/images/thumb/c/c8/Burning_Condition_Icon.webp/30px-Burning_Condition_Icon.webp, /w/images/thumb/c/c8/Burning_Condition_Icon.webp/45px-Burning_Condition_Icon.webp 1.5x, /w/images/thumb/c/c8/Burning_Condition_Icon.webp/60px-Burning_Condition_Icon.webp 2x\"><img alt=\"Burning\" src=\"/w/images/thumb/c/c8/Burning_Condition_Icon.webp/30px-Burning_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c8/Burning_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Burning_(Condition)\" title=\"Burning (Condition)\">Burning</a></strong><p><span class=\"bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp, /w/images/thumb/6/6a/Duration_Icons.png/38px-Duration_Icons.png.webp 1.5x, /w/images/thumb/6/6a/Duration_Icons.png/50px-Duration_Icons.png.webp 2x\"><img alt=\"Duration Icons.png\" src=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/6/6a/Duration_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Duration: 5  turns</p>\n<div>\n<ul><li>Takes <span class=\"bg3wiki-damage-type-fire\">1d4</span>⁠<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Fire\" title=\"Fire\"><picture><source srcset=\"/w/images/thumb/8/84/Fire_Damage_Icon.png/20px-Fire_Damage_Icon.png.webp, /w/images/thumb/8/84/Fire_Damage_Icon.png/30px-Fire_Damage_Icon.png.webp 1.5x, /w/images/thumb/8/84/Fire_Damage_Icon.png/40px-Fire_Damage_Icon.png.webp 2x\"><img alt=\"Fire\" src=\"/w/images/thumb/8/84/Fire_Damage_Icon.png/20px-Fire_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/84/Fire_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Fire\" title=\"Fire\"><span class=\"bg3wiki-damage-type-fire\">Fire</span></a> damage per turn.</li>\n<li>Can be removed with the <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Help\" title=\"Help\"><picture><source srcset=\"/w/images/thumb/8/89/Help_Icon.webp/25px-Help_Icon.webp, /w/images/thumb/8/89/Help_Icon.webp/38px-Help_Icon.webp 1.5x, /w/images/thumb/8/89/Help_Icon.webp/50px-Help_Icon.webp 2x\"><img alt=\"Help\" src=\"/w/images/thumb/8/89/Help_Icon.webp/25px-Help_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/89/Help_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Help\" title=\"Help\">Help</a> action, using a <a href=\"/wiki/Potion_of_Healing\" title=\"Potion of Healing\">Healing Potion</a> or gaining <a href=\"/wiki/Wet_(Condition)\" title=\"Wet (Condition)\">Wet</a>.</li>\n<li>Immune from if <a href=\"/wiki/Wet_(Condition)\" title=\"Wet (Condition)\">Wet</a>.</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Dip\" title=\"Dip\"><picture><source srcset=\"/w/images/thumb/a/a8/Dip_Icon.webp/25px-Dip_Icon.webp, /w/images/thumb/a/a8/Dip_Icon.webp/38px-Dip_Icon.webp 1.5x, /w/images/thumb/a/a8/Dip_Icon.webp/50px-Dip_Icon.webp 2x\"><img alt=\"Dip\" src=\"/w/images/thumb/a/a8/Dip_Icon.webp/25px-Dip_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a8/Dip_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dip\" title=\"Dip\">Dip</a> action can be used on Burning characters or objects.</li></ul>\n</div>\n </div>\n</div>    <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>Carried by <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Ochre_Jelly\" title=\"Ochre Jelly\"><picture><source srcset=\"/w/images/thumb/4/47/Portrait_Ochre_Jelly.png/25px-Portrait_Ochre_Jelly.png.webp, /w/images/thumb/4/47/Portrait_Ochre_Jelly.png/38px-Portrait_Ochre_Jelly.png.webp 1.5x, /w/images/thumb/4/47/Portrait_Ochre_Jelly.png/50px-Portrait_Ochre_Jelly.png.webp 2x\"><img alt=\"Ochre Jellies\" src=\"/w/images/thumb/4/47/Portrait_Ochre_Jelly.png/25px-Portrait_Ochre_Jelly.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/47/Portrait_Ochre_Jelly.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Ochre_Jelly\" title=\"Ochre Jelly\">Ochre Jellies</a></li>\n<li>Sold by some <a href=\"/wiki/Trader\" class=\"mw-redirect\" title=\"Trader\">merchants</a> later in the game</li></ul>\n</div>   <h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>Combine 3 of these to create a <span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Suspension_of_Ochre_Jelly\" title=\"Suspension of Ochre Jelly\"><picture><source srcset=\"/w/images/thumb/9/9d/Suspension_of_Ochre_Jelly_Item_Icon.png/20px-Suspension_of_Ochre_Jelly_Item_Icon.png.webp, /w/images/thumb/9/9d/Suspension_of_Ochre_Jelly_Item_Icon.png/30px-Suspension_of_Ochre_Jelly_Item_Icon.png.webp 1.5x, /w/images/thumb/9/9d/Suspension_of_Ochre_Jelly_Item_Icon.png/40px-Suspension_of_Ochre_Jelly_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/9/9d/Suspension_of_Ochre_Jelly_Item_Icon.png/20px-Suspension_of_Ochre_Jelly_Item_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/9d/Suspension_of_Ochre_Jelly_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> <a href=\"/wiki/Suspension_of_Ochre_Jelly\" title=\"Suspension of Ochre Jelly\">Suspension of Ochre Jelly</a>, which is used to make <span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-rare\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Elixir_of_Guileful_Movement\" title=\"Elixir of Guileful Movement\"><picture><source srcset=\"/w/images/thumb/6/66/ELX_Elixir_of_Guileful_Movement_Unfaded_Icon.png/20px-ELX_Elixir_of_Guileful_Movement_Unfaded_Icon.png.webp, /w/images/thumb/6/66/ELX_Elixir_of_Guileful_Movement_Unfaded_Icon.png/30px-ELX_Elixir_of_Guileful_Movement_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/6/66/ELX_Elixir_of_Guileful_Movement_Unfaded_Icon.png/40px-ELX_Elixir_of_Guileful_Movement_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/6/66/ELX_Elixir_of_Guileful_Movement_Unfaded_Icon.png/20px-ELX_Elixir_of_Guileful_Movement_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/66/ELX_Elixir_of_Guileful_Movement_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> <a href=\"/wiki/Elixir_of_Guileful_Movement\" title=\"Elixir of Guileful Movement\">Elixir of Guileful Movement</a>.</li></ul>\n</div>   \n<h2><span class=\"mw-headli