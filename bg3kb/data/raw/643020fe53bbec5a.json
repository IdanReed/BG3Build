-Poison_Immunity.png.webp 1.5x, /w/images/thumb/c/c0/Poison_Immunity.png/56px-Poison_Immunity.png.webp 2x\"><img alt=\"Immune to all Poison\" src=\"/w/images/thumb/c/c0/Poison_Immunity.png/28px-Poison_Immunity.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c0/Poison_Immunity.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li><li><span typeof=\"mw:File\"><span title=\"Vulnerable to Bludgeoning\"><picture><source srcset=\"/w/images/thumb/1/11/Bludgeoning_Vulnerability.png/28px-Bludgeoning_Vulnerability.png.webp, /w/images/thumb/1/11/Bludgeoning_Vulnerability.png/42px-Bludgeoning_Vulnerability.png.webp 1.5x, /w/images/thumb/1/11/Bludgeoning_Vulnerability.png/56px-Bludgeoning_Vulnerability.png.webp 2x\"><img alt=\"Vulnerable to Bludgeoning\" src=\"/w/images/thumb/1/11/Bludgeoning_Vulnerability.png/28px-Bludgeoning_Vulnerability.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/1/11/Bludgeoning_Vulnerability.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li><li><span typeof=\"mw:File\"><span title=\"Vulnerable to Lightning\"><picture><source srcset=\"/w/images/thumb/7/7d/Lightning_Vulnerability.png/28px-Lightning_Vulnerability.png.webp, /w/images/thumb/7/7d/Lightning_Vulnerability.png/42px-Lightning_Vulnerability.png.webp 1.5x, /w/images/thumb/7/7d/Lightning_Vulnerability.png/56px-Lightning_Vulnerability.png.webp 2x\"><img alt=\"Vulnerable to Lightning\" src=\"/w/images/thumb/7/7d/Lightning_Vulnerability.png/28px-Lightning_Vulnerability.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/7/7d/Lightning_Vulnerability.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li></ul></div>\n</div></section><section class=\"pi-item pi-group pi-border-color\"><h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Conditions</h2><div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"conditions\" data-item-name=\"conditions\">\n\t<div class=\"pi-data-value pi-font\"><ul><li><div class=\"bg3wiki-pi-creature-detail\"><div class=\"bg3wiki-pi-creature-detail-title\"><p><span class=\"bg3wiki-icontext-block\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Sturdy_(Condition)\" title=\"Sturdy (Condition)\"><picture><source srcset=\"/w/images/thumb/3/32/Sturdy_Condition_Icon.webp/25px-Sturdy_Condition_Icon.webp, /w/images/thumb/3/32/Sturdy_Condition_Icon.webp/38px-Sturdy_Condition_Icon.webp 1.5x, /w/images/thumb/3/32/Sturdy_Condition_Icon.webp/50px-Sturdy_Condition_Icon.webp 2x\"><img alt=\"Sturdy\" src=\"/w/images/thumb/3/32/Sturdy_Condition_Icon.webp/25px-Sturdy_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/32/Sturdy_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Sturdy_(Condition)\" title=\"Sturdy (Condition)\"><b>Sturdy</b></a></span></p></div><div class=\"bg3wiki-pi-creature-detail-text\"><ul><li>This material is rather strong. Only a hit that deals at least 10 damage can damage it.</li></ul></div></div></li></ul></div>\n</div></section></section>\n\t\t\t</div>\n\t</div>\n</section></aside>\nThe <b>Micromodron Force Curtain</b> is a device in <a href=\"/wiki/Wyrm%27s_Rock_Fortress\" title=\"Wyrm's Rock Fortress\">Wyrm's Rock Fortress</a>. \n<h2><span class=\"mw-headline\" id=\"Involvement\">Involvement</span></h2>\n<p>Micromodron Force Curtains can grant <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Enver_Gortash\" title=\"Enver Gortash\"><picture><source srcset=\"/w/images/thumb/5/59/Portrait_Enver_Gortash.png/25px-Portrait_Enver_Gortash.png.webp, /w/images/thumb/5/59/Portrait_Enver_Gortash.png/38px-Portrait_Enver_Gortash.png.webp 1.5x, /w/images/thumb/5/59/Portrait_Enver_Gortash.png/50px-Portrait_Enver_Gortash.png.webp 2x\"><img alt=\"Enver Gortash\" src=\"/w/images/thumb/5/59/Portrait_Enver_Gortash.png/25px-Portrait_Enver_Gortash.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/59/Portrait_Enver_Gortash.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Enver_Gortash\" title=\"Enver Gortash\">Enver Gortash</a> extra resistances, immunities, movement speed, and an additional bonus action. These devices only become active during combat.\n</p><p>After using <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Shell_of_Resistance\" title=\"Shell of Resistance\"><picture><source srcset=\"/w/images/thumb/d/d6/Generic_Buff_Icon.webp/25px-Generic_Buff_Icon.webp, /w/images/thumb/d/d6/Generic_Buff_Icon.webp/38px-Generic_Buff_Icon.webp 1.5x, /w/images/thumb/d/d6/Generic_Buff_Icon.webp/50px-Generic_Buff_Icon.webp 2x\"><img alt=\"Shell of Resistance\" src=\"/w/images/thumb/d/d6/Generic_Buff_Icon.webp/25px-Generic_Buff_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d6/Generic_Buff_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Shell_of_Resistance\" title=\"Shell of Resistance\">Shell of Resistance</a> on a target, the force curtain gains <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Recharging_(Condition)\" title=\"Recharging (Condition)\"><picture><source srcset=\"/w/images/thumb/8/81/Generic_Control_Condition_Icon.webp/25px-Generic_Control_Condition_Icon.webp, /w/images/thumb/8/81/Generic_Control_Condition_Icon.webp/38px-Generic_Control_Condition_Icon.webp 1.5x, /w/images/thumb/8/81/Generic_Control_Condition_Icon.webp/50px-Generic_Control_Condition_Icon.webp 2x\"><img alt=\"Recharging\" src=\"/w/images/thumb/8/81/Generic_Control_Condition_Icon.webp/25px-Generic_Control_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/81/Generic_Control_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Recharging_(Condition)\" title=\"Recharging (Condition)\">Recharging</a> and becomes disabled for 1 turn.\n</p>\n<h2><span class=\"mw-headline\" id=\"Combat\">Combat</span></h2>\n<h3><span class=\"mw-headline\" id=\"Attacks_and_actions\">Attacks and actions</span></h3>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\"><div class=\"bg3wiki-tooltip-box-image nomobile\"><figure class=\"mw-halign-right\" typeof=\"mw:File/Frameless\"><a href=\"/wiki/File:Generic_Buff.webp\" class=\"mw-file-description\"><picture><source srcset=\"/w/images/thumb/0/02/Generic_Buff.webp/100px-Generic_Buff.webp, /w/images/thumb/0/02/Generic_Buff.webp/150px-Generic_Buff.webp 1.5x, /w/images/thumb/0/02/Generic_Buff.webp/200px-Generic_Buff.webp 2x\"><img src=\"/w/images/thumb/0/02/Generic_Buff.webp/100px-Generic_Buff.webp\" decoding=\"async\" width=\"100\" height=\"100\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/02/Generic_Buff.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a><figcaption></figcaption></figure></div>\n<div class=\"bg3wiki-tooltip-box-header\"><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Shell_of_Resistance\" title=\"Shell of Resistance\"><picture><source srcset=\"/w/images/thumb/d/d6/Generic_Buff_Icon.webp/40px-Generic_Buff_Icon.webp, /w/images/thumb/d/d6/Generic_Buff_Icon.webp/60px-Generic_Buff_Icon.webp 1.5x, /w/images/thumb/d/d6/Generic_Buff_Icon.webp/80px-Generic_Buff_Icon.webp 2x\"><img alt=\"Shell of Resistance\" src=\"/w/images/thumb/d/d6/Generic_Buff_Icon.webp/40px-Generic_Buff_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d6/Generic_Buff_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Shell_of_Resistance\" title=\"Shell of Resistance\">Shell of Resistance</a></div>\n<div class=\"bg3wiki-tooltip-box-content\">\n<p>The Micromodron Force Curtain grants its target <a href=\"/wiki/Immunity\" class=\"mw-redirect\" title=\"Immunity\">immunity</a> to <span class=\"bg3wiki-icontext-icon-wrapper\" style=\"display: inline-flex; align-items: center; justify-content: center; min-width: 25px; height: 25px;\"><span class=\"bg3wiki-icontext-icon\" style=\"vertical-align: middle;\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Thunder\" title=\"Thunder\"><picture><source srcset=\"/w/images/thumb/8/87/Thunder_Damage_Icon.png/25px-Thunder_Damage_Icon.png.webp, /w/images/thumb/8/87/Thunder_Damage_Icon.png/38px-Thunder_Damage_Icon.png.webp 1.5x, /w/images/thumb/8/87/Thunder_Damage_Icon.png/50px-Thunder_Damage_Icon.png.webp 2x\"><img alt=\"Thunder\" src=\"/w/images/thumb/8/87/Thunder_Damage_Icon.png/25px-Thunder_Damage_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/87/Thunder_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span><span class=\"bg3wiki-after-icon\"></span></span></span><span class=\"bg3wiki-icontext-text\" style=\"\"><a href=\"/wiki/Thunder\" title=\"Thunder\"><span class=\"bg3wiki-damage-type-thunder\">Thunder</span></a></span> damage and <a href=\"/wiki/Resistance\" class=\"mw-redirect\" title=\"Resistance\">resistance</a> to elemental damage for one turn, along with an extra <span style=\"display: inline-block; height: 20px; width: 20px; margin-left: -3px; margin-top: -3px\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp, /w/images/thumb/c/c9/Bonus_Action_Icon.png/35px-Bonus_Action_Icon.png.webp 1.5x, /w/images/thumb/c/c9/Bonus_Action_Icon.png/46px-Bonus_Action_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c9/Bonus_Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Actions#Resources\" title=\"Actions\">Bonus Action</a> and 3 m / 10 ft extra <a href=\"/wiki/Movement_speed\" class=\"mw-redirect\" title=\"Movement speed\">movement speed</a>.\n</p>\n</div> \n<div class=\"bg3wiki-tooltip-box-footer\"><div class=\"bg3wiki-horizontlist\"> \n<dl><dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/0/08/Range_Icon.png/25px-Range_Icon.png.webp, /w/images/thumb/0/08/Range_Icon.png/38px-Range_Icon.png.webp 1.5x, /w/images/0/08/Range_Icon.png 2x\"><img alt=\"Range: 18 m (60 ft)\" src=\"/w/images/thumb/0/08/Range_Icon.png/25px-Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/0/08/Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Range: 18 m (60 ft)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Per turn\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: Per turn</dd></dl>\n    </div></div>\n<div style=\"clear: both;\"></div>\n</div>\n<!-- \nNewPP limit report\nCached time: 20260715014236\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.139 seconds\nReal time usage: 0.143 seconds\nPreprocessor visited node count: 5952/1000000\nPost‐expand include size: 61609/4194304 bytes\nTemplate argument size: 25066/4194304 bytes\nHighest expansion depth: 24/200\nExpensive parser function count: 1/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 10931/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.035/7.000 seconds\nLua memory usage: 1451032/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%  132.870      1 -total\n 80.02%  106.319      1 Template:Infobox_creature\n 55.29%   73.464      1 Template:Infobox_creature/internal\n 19.42%   25.805      1 Template:Hidden_code\n 12.47%   16.575      1 Template:Feature_box\n 10.50%   13.947     41 Template:Trim\n 10.02%   13.313      3 Template:Template_style\n  8.41%   11.175      7 Template:Icon_text\n  8.17%   10.852      1 Template:Feature_box/format\n  7.07%    9.388      5 Template:Icon_link\n-->\n\n<!-- Saved in parser cache with key bg3wiki:pcache:idhash:38009-0!canonical and ti