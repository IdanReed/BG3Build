GET ￼START_WIDGET&quot;'-f1eddc76899d3bd7END_WIDGET\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">BOOK_LOW_CountingHouse_Appointment</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:BOOK_LOW_CountingHouse_Appointment\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:BOOK_LOW_CountingHouse_Appointment\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">a5135547-918e-4d73-a61d-e078283b4b51</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:a5135547-918e-4d73-a61d-e078283b4b51\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:a5135547-918e-4d73-a61d-e078283b4b51\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div>   \n<div style=\"clear: both;\"></div></div>\n    <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>In the mailbox of the <a href=\"/wiki/Counting_House\" class=\"mw-redirect\" title=\"Counting House\">Counting House</a> in the <a href=\"/wiki/Lower_City\" title=\"Lower City\">Lower City</a> at <span class=\"bg3wiki-coordinates\">X:&nbsp;-103&nbsp;Y:&nbsp;-132</span></li></ul>\n</div>  <h2><span class=\"mw-headline\" id=\"Text\"> Text </span></h2>\n<div class=\"bg3wiki-book-text\">\n<p>To Whom it May Concern,\n</p><p><br>\nI would like to request an appointment during which I can discuss my request for an appointment with Mr. Glitterbeard.\n</p><p><br>\nThank you, Ammon Day\n</p>\n</div> <h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>See also:\n<ul><li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Invoice:_Flooding_Repairs\" title=\"Invoice: Flooding Repairs\"><picture><source srcset=\"/w/images/thumb/e/e3/Book_Note_H_Item_Icon.png/30px-Book_Note_H_Item_Icon.png.webp, /w/images/thumb/e/e3/Book_Note_H_Item_Icon.png/45px-Book_Note_H_Item_Icon.png.webp 1.5x, /w/images/thumb/e/e3/Book_Note_H_Item_Icon.png/60px-Book_Note_H_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/e/e3/Book_Note_H_Item_Icon.png/30px-Book_Note_H_Item_Icon.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e3/Book_Note_H_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Invoice:_Flooding_Repairs\" title=\"Invoice: Flooding Repairs\">Invoice: Flooding Repairs</a></span></li>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Private_Shipment\" title=\"Private Shipment\"><picture><source srcset=\"/w/images/thumb/7/76/Book_Note_D_Item_Icon.png/30px-Book_Note_D_Item_Icon.png.webp, /w/images/thumb/7/76/Book_Note_D_Item_Icon.png/45px-Book_Note_D_Item_Icon.png.webp 1.5x, /w/images/thumb/7