-Inflict_Wounds_Icon.webp 1.5x, /w/images/thumb/3/3d/Inflict_Wounds_Icon.webp/80px-Inflict_Wounds_Icon.webp 2x\"><img alt=\"Inflict Wounds\" src=\"/w/images/thumb/3/3d/Inflict_Wounds_Icon.webp/40px-Inflict_Wounds_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/3d/Inflict_Wounds_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Inflict_Wounds\" title=\"Inflict Wounds\">Inflict Wounds</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> + <span aria-label=\"Level 1 Spell Slot\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ef/Spell_Slot_Icon.png/20px-Spell_Slot_Icon.png.webp, /w/images/thumb/e/ef/Spell_Slot_Icon.png/30px-Spell_Slot_Icon.png.webp 1.5x, /w/images/e/ef/Spell_Slot_Icon.png 2x\"><img alt=\"Level 1 Spell Slot\" src=\"/w/images/thumb/e/ef/Spell_Slot_Icon.png/20px-Spell_Slot_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ef/Spell_Slot_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>)</dt>\n<dd>Putrefy a creature with <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Necrotic\" title=\"Necrotic\"><picture><source srcset=\"/w/images/thumb/3/39/Necrotic_Damage_Icon.png/20px-Necrotic_Damage_Icon.png.webp, /w/images/thumb/3/39/Necrotic_Damage_Icon.png/30px-Necrotic_Damage_Icon.png.webp 1.5x, /w/images/thumb/3/39/Necrotic_Damage_Icon.png/40px-Necrotic_Damage_Icon.png.webp 2x\"><img alt=\"Necrotic\" src=\"/w/images/thumb/3/39/Necrotic_Damage_Icon.png/20px-Necrotic_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/39/Necrotic_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Necrotic\" title=\"Necrotic\"><span class=\"bg3wiki-damage-type-necrotic\">Necrotic</span></a> energy filling your hands. </dd>\n</dl></div>\n<h2><span class=\"mw-headline\" id=\"Creatures_with_Retributive_Justice\">Creatures with Retributive Justice</span></h2>\n<div class=\"bg3wiki-condition-sources\"><ul>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Echo_of_Sendai\" title=\"Echo of Sendai\"><picture><source srcset=\"/w/images/thumb/1/15/Portrait_Echo_of_Sendai.png/30px-Portrait_Echo_of_Sendai.png.webp, /w/images/thumb/1/15/Portrait_Echo_of_Sendai.png/45px-Portrait_Echo_of_Sendai.png.webp 1.5x, /w/images/thumb/1/15/Portrait_Echo_of_Sendai.png/60px-Portrait_Echo_of_Sendai.png.webp 2x\"><img alt=\"Echo of Sendai\" src=\"/w/images/thumb/1/15/Portrait_Echo_of_Sendai.png/30px-Portrait_Echo_of_Sendai.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/15/Portrait_Echo_of_Sendai.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Echo_of_Sendai\" title=\"Echo of Sendai\">Echo of Sendai</a></li>\n</ul></div>\n<!