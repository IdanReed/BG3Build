umb/5/5e/Portrait_Zyrlak.png/38px-Portrait_Zyrlak.png.webp 1.5x, /w/images/thumb/5/5e/Portrait_Zyrlak.png/50px-Portrait_Zyrlak.png.webp 2x\"><img alt=\"Gate Master Zyrlak's\" src=\"/w/images/thumb/5/5e/Portrait_Zyrlak.png/25px-Portrait_Zyrlak.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/5e/Portrait_Zyrlak.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Zyrlak\" title=\"Zyrlak\">Gate Master Zyrlak's</a> astral rift:<sup id=\"cite_ref-db_1-1\" class=\"reference\"><a href=\"#cite_note-db-1\"><span class=\"cite-bracket\">[</span>1<span class=\"cite-bracket\">]</span></a></sup>\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Kharyk\" title=\"Kharyk\"><picture><source srcset=\"/w/images/thumb/9/9f/Portrait_Kharyk.png/30px-Portrait_Kharyk.png.webp, /w/images/thumb/9/9f/Portrait_Kharyk.png/45px-Portrait_Kharyk.png.webp 1.5x, /w/images/thumb/9/9f/Portrait_Kharyk.png/60px-Portrait_Kharyk.png.webp 2x\"><img alt=\"Raider Kharyk\" src=\"/w/images/thumb/9/9f/Portrait_Kharyk.png/30px-Portrait_Kharyk.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/9f/Portrait_Kharyk.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Kharyk\" title=\"Kharyk\">Raider Kharyk</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Ma%27aryk\" title=\"Ma'aryk\"><picture><source srcset=\"/w/images/thumb/0/03/Portrait_Ma%27aryk.png/30px-Portrait_Ma%27aryk.png.webp, /w/images/thumb/0/03/Portrait_Ma%27aryk.png/45px-Portrait_Ma%27aryk.png.webp 1.5x, /w/images/thumb/0/03/Portrait_Ma%27aryk.png/60px-Portrait_Ma%27aryk.png.webp 2x\"><img alt=\"W