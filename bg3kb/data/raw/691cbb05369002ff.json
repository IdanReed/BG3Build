/5f/Acid_Damage_Icon.png/50px-Acid_Damage_Icon.png.webp 2x\"><img alt=\"Acid\" src=\"/w/images/thumb/5/5f/Acid_Damage_Icon.png/25px-Acid_Damage_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/5f/Acid_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Acid\" title=\"Acid\"><span class=\"bg3wiki-damage-type-acid\">Acid</span></a> damage.</dd></dl>\n</td></tr>\n<tr>\n<td><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-rare\" style=\"width: 50px; height: 50px; display: inline-block; vertical-align: middle; overflow: hidden;\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Corrosive_Flail\" title=\"Corrosive Flail\"><picture><source srcset=\"/w/images/thumb/c/cd/Flail_PlusTwo_Unfaded_Icon.png/50px-Flail_PlusTwo_Unfaded_Icon.png.webp, /w/images/c/cd/Flail_PlusTwo_Unfaded_Icon.png 1.5x\"><img alt=\"\" src=\"/w/images/thumb/c/cd/Flail_PlusTwo_Unfaded_Icon.png/50px-Flail_PlusTwo_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"50\" height=\"50\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/cd/Flail_PlusTwo_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><br><a href=\"/wiki/Corrosive_Flail\" title=\"Corrosive Flail\"> <span style=\"color: #01BFFF ;\">Corrosive Flail</span> </a>\n</td>\n<td><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Main_Hand_Melee\" title=\"Main Hand Melee\"><picture><source srcset=\"/w/images/thumb/2/2b/Main_Hand_Melee_Weapon_Icon.png/25px-Main_Hand_Melee_Weapon_Icon.png.webp, /w/images/thumb/2/2b/Main_Hand_Melee_Weapon_Icon.png/38px-Main_Hand_Melee_Weapon_Icon.png.webp 1.5x, /w/images/thumb/2/2b/Main_Hand_Melee_Weapon_Icon.png/50px-Main_Hand_Melee_Weapon_Icon.png.webp 2x\"><img alt=\"Main Hand Melee\" src=\"/w/images/thumb/2/2b/Main_Hand_Melee_Weapon_Icon.png/25px-Main_Hand_Melee_Weapon_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/2b/Main_Hand_Melee_Weapon_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Main_Hand_Melee\" class=\"mw-redirect\" title=\"Main Hand Melee\">Main Hand Melee</a>&nbsp;(<a href=\"/wiki/Flails\" title=\"Flails\">Flail</a>)\n</td>\n<td><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Corrosive_Strike\" title=\"Corrosive Strike\"><picture><source srcset=\"/w/images/thumb/9/95/Corrosive_Strike_Icon.webp/40px-Corrosive_Strike_Icon.webp, /w/images/thumb/9/95/Corrosive_Strike_Icon.webp/60px-Corrosive_Strike_Icon.webp 1.5x, /w/images/thumb/9/95/Corrosive_Strike_Icon.webp/80px-Corrosive_Strike_Icon.webp 2x\"><img alt=\"Corrosive Strike\" src=\"/w/images/thumb/9/95/Corrosive_Strike_Icon.webp/40px-Corrosive_Strike_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/95/Corrosive_Strike_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Corrosive_Strike\" title=\"Corrosive Strike\">Corrosive Strike</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span>