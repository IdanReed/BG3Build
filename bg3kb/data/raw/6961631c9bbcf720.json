lie_Summon_Deva_Icon.webp/40px-Sights_of_the_Seelie_Summon_Deva_Icon.webp 2x\"><img alt=\"Sights of the Seelie: Summon Deva\" src=\"/w/images/thumb/d/d8/Sights_of_the_Seelie_Summon_Deva_Icon.webp/20px-Sights_of_the_Seelie_Summon_Deva_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d8/Sights_of_the_Seelie_Summon_Deva_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Sights_of_the_Seelie:_Summon_Deva\" title=\"Sights of the Seelie: Summon Deva\">Sights of the Seelie: Summon Deva</a> to be cast using a <span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ef/Spell_Slot_Icon.png/20px-Spell_Slot_Icon.png.webp, /w/images/thumb/e/ef/Spell_Slot_Icon.png/30px-Spell_Slot_Icon.png.webp 1.5x, /w/images/e/ef/Spell_Slot_Icon.png 2x\"><img alt=\"\" src=\"/w/images/thumb/e/ef/Spell_Slot_Icon.png/20px-Spell_Slot_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ef/Spell_Slot_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <a href=\"/wiki/Spells#Spell_slots\" title=\"Spells\">Level 6 Spell Slot</a> once per <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">short rest</a>.</li></ul>\n</div>   \n<!-- \nNewPP limit report\nCached time: 20260714195614\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.079 seconds\nReal time usage: 0.082 seconds\nPreprocessor visited node count: 2358/1000000\nPost‐expand include size: 39809/4194304 bytes\nTemplate argument size: 10369/4194304 bytes\nHighest expansion depth: 22/200\nExpensive parser function count: 0/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 2/5000000 bytes\nExtLoops count: 0/1000\nLua time 