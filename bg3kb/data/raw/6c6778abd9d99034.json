_Shot_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/9b/Mobile_Shot_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Mobile_Shot\" title=\"Mobile Shot\">Mobile Shot</a> (<span aria-label=\"Bonus Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp, /w/images/thumb/c/c9/Bonus_Action_Icon.png/35px-Bonus_Action_Icon.png.webp 1.5x, /w/images/thumb/c/c9/Bonus_Action_Icon.png/46px-Bonus_Action_Icon.png.webp 2x\"><img alt=\"Bonus Action\" src=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c9/Bonus_Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>After using <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Dash\" title=\"Dash\"><picture><source srcset=\"/w/images/thumb/c/cc/Dash_Icon.webp/20px-Dash_Icon.webp, /w/images/thumb/c/cc/Dash_Icon.webp/30px-Dash_Icon.webp 1.5x, /w/images/thumb/c/cc/Dash_Icon.webp/40px-Dash_Icon.webp 2x\"><img alt=\"Dash\" src=\"/w/images/thumb/c/cc/Dash_Icon.webp/20px-Dash_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/cc/Dash_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dash\" title=\"Dash\">Dash</a> or <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Disengage\" title=\"Disengage\"><picture><source srcset=\"/w/images/thumb/9/94/D