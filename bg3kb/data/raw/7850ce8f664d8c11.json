source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Gale\" title=\"Gale\">Gale</a>, <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Elminster\" title=\"Elminster\"><picture><source srcset=\"/w/images/thumb/6/69/Portrait_Elminster.png/25px-Portrait_Elminster.png.webp, /w/images/thumb/6/69/Portrait_Elminster.png/38px-Portrait_Elminster.png.webp 1.5x, /w/images/thumb/6/69/Portrait_Elminster.png/50px-Portrait_Elminster.png.webp 2x\"><img alt=\"Elminster Aumar\" src=\"/w/images/thumb/6/69/Portrait_Elminster.png/25px-Portrait_Elminster.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/69/Portrait_Elminster.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Elminster\" title=\"Elminster\">Elminster Aumar</a>, and the goddess <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Mystra\" title=\"Mystra\"><picture><source srcset=\"/w/images/thumb/e/ec/Mystra_Icon.webp/20px-Mystra_Icon.webp, /w/images/thumb/e/ec/Mystra_Icon.webp/30px-Mystra_Icon.webp 1.5x, /w/images/thumb/e/ec/Mystra_Icon.webp/40px-Mystra_Icon.webp 2x\"><img alt=\"Mystra\" src=\"/w/images/thumb/e/ec/Mystra_Icon.webp/20px-Mystra_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/ec/Mystra_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Mystra\" title=\"Mystra\">Mystra</a>.\n\n</p>\n<div style=\"font-size:110%; font-family:'Linux Libertine', 'Georgia', serif; display: flex; flex-wrap: wrap;\">\n<div style=\"opacity: 0.5; margin: 0.5em 0.5em 0.5em 0;\"><span typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/5/5b/Description_Icon.png/24px-Description_Icon.png.webp, /w/images/thumb/5/5b/Description_Icon.png/36px-Description_Icon.png.webp 1.5x, /w/images/5/5b/Description_Icon.png 2x\"><img src=\"/w/images/thumb/5/5b/Description_Icon.png/24px-Description_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/5/5b/Description_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n<div class=\"bg3wiki-blockquote-text\" style=\"width:100px; flex-grow: 1; font-style: italic;\">\n<p>This book is redolent with the enticing smell of paper and ink.\n</p>\n</div></div>\n<h2><span class=\"mw-headline\" id=\"Properties\"> Properties </span></h2>\n\n<div class=\"bg3wiki-property-list\">\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Books\" title=\"Books\"><picture><source srcset=\"/w/images/thumb/4/41/Books_Icon.png/25px-Books_Icon.png.webp, /w/images/thumb/4/41/Books_Icon.png/38px-Books_Icon.png.webp 1.5x, /w/images/thumb/4/41/Books_Icon.png/50px-Books_Icon.png.webp 2x\"><img alt=\"Books\" src=\"/w/images/thumb/4/41/Books_Icon.png/25px-Books_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/41/Books_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Books\" title=\"Books\">Books</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/5/5b/Journal_Icon.webp/25px-Journal_Icon.webp, /w/images/thumb/5/5b/Journal_Icon.webp/38px-Journal_Icon.webp 1.5x, /w/images/thumb/5/5b/Journal_Icon.webp/50px-Journal_Icon.webp 2x\"><img alt=\"Author: unknown\" src=\"/w/images/thumb/5/5b/Journal_Icon.webp/25px-Journal_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/5/5b/Journal_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Author: unknown</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ef/Rarity_Icon.png/25px-Rarity_Icon.png.webp, /w/images/thumb/e/ef/Rarity_Icon.png/38px-Rarity_Icon.png.webp 1.5x, /w/images/e/ef/Rarity_Icon.png 2x\"><img alt=\"Rarity: Common\" src=\"/w/images/thumb/e/ef/Rarity_Icon.png/25px-Rarity_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ef/Rarity_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Rarity: Common</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp, /w/images/thumb/e/ea/Weight_Icon.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 0.5 kg (1 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 0.5 kg (1 lb)</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 14 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  14  gp</li></ul>\n</div>   \n<div style=\"clear: both;\"></div></div>\n    <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>In the <a href=\"/wiki/Sorcerous_Sundries\" title=\"Sorcerous Sundries\">Sorcerous Sundries</a>, either for purchase from nearby vendors, or sometimes found by looting the bookshelves along the walls.</li></ul>\n</div>  <h2><span class=\"mw-headline\" id=\"Text\"> Text </span></h2>\n<div class=\"bg3wiki-book-text\">\n<p>In the years following Mystra's assassination, the planes of existence were in <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Era_of_Upheaval\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/images/thumb/6/68/FRWiki_Icon.png/44px-FRWiki_Icon.png.webp 2x\"><img alt=\"upheaval\" src=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/FRWiki_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <span class=\"bg3wiki-icontext-extlink\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Era_of_Upheaval\">upheaval</a></span>. <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Ao\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/images/thumb/6/68/FRWiki_Icon.png/44px-FRWiki_Icon.png.webp 2x\"><img alt=\"Lord Ao\" src=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/FRWiki_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <span class=\"bg3wiki-icontext-extlink\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Ao\">Lord Ao</a></span>, the Hidden One, overgod of all deities and mortals, sought to rebalance what had been thrown into disarray, by <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Second_Sundering\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/images/thumb/6/68/FRWiki_Icon.png/44px-FRWiki_Icon.png.webp 2x\"><img alt=\"renewing\" src=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/FRWiki_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <span class=\"bg3wiki-icontext-extlink\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Second_Sundering\">renewing</a></span> the <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Tablets_of_Fate\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/images/thumb/6/68/FRWiki_Icon.png/44px-FRWiki_Icon.png.webp 2x\"><img alt=\"Tablets of Fate\" src=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/FRWiki_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <span class=\"bg3wiki-icontext-extlink\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Tablets_of_Fate\">Tablets of Fate</a></span> - those most sacred of artefacts between order and chaos. The very portfolios of the gods were rewritten, and several who were thought lost found themselves returned to life and power. Heralded by the wizard, Elminster Aumar, Mystra found her magic restored, and portfolio returned to her. Once again, the rightful goddess of magic found herself to be custodian of the <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Weave\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/images/thumb/6/68/FRWiki_Icon.png/44px-FRWiki_Icon.png.webp 2x\"><img alt=\"Weave\" src=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/FRWiki_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <span class=\"bg3wiki-icontext-extlink\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Weave\">Weave</a></span>.\n</p>\n</div> <h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>The god \"Ao\" does not appear in-game, but in dialogue with Gale, AO is mentioned occasionally.</li>\n<li>\"Portfolio\", in the context of Mystra and other gods broadly refers to \"all of the things that the deity can do.\"</li>\n<li>See also:\n<ul><li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Magical_Histories,_Volume_1:_The_Origins_of_Mystra\" title=\"Magical Histories, Volume 1: The Origins of Mystra\"><picture><source srcset=\"/w/images/thumb/d/d0/Book_Tome_B_Item_Icon.png/30px-Book_Tome_B_Item_Icon.png.webp, /w/images/thumb/d/d0/Book_Tome_B_Item_Icon.png/45px-Book_Tome_B_Item_Icon.png.webp 1.5x, /w/images/thumb/d/d0/Book_Tome_B_Item_Icon.png/60px-Book_Tome_B_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/d/d0/Book_Tome_B_Item_Icon.png/30px-Book_Tome_B_Item_Icon.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d0/Book_Tome_B_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Magical_Histories,_Volume_1:_The_Origins_of_Mystra\" title=\"Magical Histories, Volume 1: The Origins of Mystra\">Magical Histories, Volume 1: The Origins of Mystra</a></span></li>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Magical_Histories,_Volume_2:_The_Spellplague\" title=\"Magical Histories, Volume 2: The Spellplague\"><picture><source srcset=\"/w/images/thumb/d/d0/Book_Tome_B_Item_Icon.png/30px-Book_Tome_B_Item_Icon.png.webp, /w/images/thumb/d/d0/Book_Tome_B_Item_Icon.png/45px-Book_Tome_B_Item_Icon.png.webp 1.5x, /w/images/thumb/d/d0/Book_Tome_B_Item_Icon.png/60px-Book_Tome_B_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/d/d0/Book_Tome_B_Item_Icon.png/30px-Book_Tome_B_Item_Icon.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d0/Book_Tome_B_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Magical_Histories,_Volume_2:_The_Spellplague\" title=\"Magical Histories, Volume 2: The Spellplague\">Magical Histories, Volume 2: The Spellplague</a></span></li>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Magical_Histories,_Volume_4:_The_Chosen_of_Mystra\" title=\"Magical Histories, Volume 4: The Chosen of Mystra\"><picture><source srcset=\"/w/images/thumb/e/e0/Book_Tome_O_Item_Icon.png/30px-Book_Tome_O_Item_Icon.png.webp, /w/images/thumb/e/e0/Book_Tome_O_Item_Icon.png/45px-Book_Tome_O_Item_Icon.png.webp 1.5x, /w/images/thumb/e/e0/Book_Tome_O_Item_Icon.png/60px-Book_Tome_O_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/e/e0/Book_Tome_O_Item_Icon.png/30px-Book_Tome_O_Item_Icon.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e0/Book_Tome_O_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Magical_Histories,_Volume_4:_The_Chosen_of_Mystra\" title=\"Magical Histories, Volume 4: The Chosen of Mystra\">Magical Histories, Volume 4: The Chosen of Mystra</a></span></li></ul></li></ul>\