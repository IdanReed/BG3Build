3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">BOOK_GLO_SharessCaress_SmutLibrary1</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:BOOK_GLO_SharessCaress_SmutLibrary1\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:BOOK_GLO_SharessCaress_SmutLibrary1\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">af35343a-7b7b-4cee-83d2-aa8991ca6a0d</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:af35343a-7b7b-4cee-83d2-aa8991ca6a0d\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:af35343a-7b7b-4cee-83d2-aa8991ca6a0d\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div>   \n<div style=\"clear: both;\"></div></div>\n    <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>Randomly spawned as part of the <a href=\"/wiki/Smut_Books_Table\" title=\"Smut Books Table\">Treasure Table</a> <code>GEN_Book_Smut</code>. Potential spawning locations include:\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Nansi_Gretta\" title=\"Nansi Gretta\"><picture><source srcset=\"/w/images/thumb/b/bc/Portrait_Nansi_Gretta.png/25px-Portrait_Nansi_Gretta.png.webp, /w/images/thumb/b/bc/Portrait_Nansi_Gretta.png/38px-Portrait_Nansi_Gretta.png.webp 1.5x, /w/images/thumb/b/bc/Portrait_Nansi_Gretta.png/50px-Portrait_Nansi_Gretta.png.webp 2x\"><img alt=\"Nansi Gretta's\" src=\"/w/images/thumb/b/bc/Portrait_Nansi_Gretta.png/25px-Portrait_Nansi_Gretta.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/bc/Portrait_Nansi_Gretta.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Nansi_Gretta\" title=\"Nansi Gretta\">Nansi Gretta's</a> trading interface</li>\n<li>A row of books in <a href=\"/wiki/Elminster%27s_Library\" title=\"Elminster's Library\">Elminster's Library</a> at <span class=\"bg3wiki-coordinates\">X:&nbsp;9&nbsp;Y:&nbsp;102</span>, <span class=\"bg3wiki-coordinates\">X:&nbsp;4&nbsp;Y:&nbsp;100</span>, or <span class=\"bg3wiki-coordinates\">X:&nbsp;-6&nbsp;Y:&nbsp;110</span></li>\n<li>In <a href=\"/wiki/Figaro%27s_Basement\" class=\"mw-redirect\" title=\"Figaro's Basement\">Figaro's Basement</a> at <span class=\"bg3wiki-coordinates\">X:&nbsp;-2332&nbsp;Y:&nbsp;1303</span></li></ul></li></ul>\n</div>  <h2><span class=\"mw-headline\" id=\"Text\"> Text </span></h2>\n<div class=\"bg3wiki-book-text\">\n<p>[The text written on the back of this smut advertises it.]\n</p><p>'A slow-paced enemies-to-lovers tale featuring a bitter Archwizard of <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Thay\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/images/thumb/6/68/FRWiki_Icon.png/44px-FRWiki_Icon.png.webp 2x\"><img alt=\"Thay\" src=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/FRWiki_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <span class=\"bg3wiki-icontext-extlink\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Thay\">Thay</a></span> and his nemesis, a pure-hearted, muscled berserker.'\n</p>\n</div> <h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>This book's title appears to be a play on the phrase <i>The one that got away</i>. It is known to have various meanings, and more on it can be read upon <a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://www.thehistoryofenglish.com/the-one-that-got-away-meaning-origin-usage\">here</a>.</li></ul>\n</div>   \n<!-- \nNewPP limit report\nCached time: 20260715070637\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.054 seconds\nReal time usage: 0.057 seconds\nPreprocessor visited node count: 1836/1000000\nPost‐expand include size: 30717/4194304 bytes\nTemplate argument size: 8840/4194304 bytes\nHighest expansion depth: 22/200\nExpensive parser function count: 2/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 2/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.010/7.000 seconds\nLua memory usage: 931307/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%   44.176      1 Template:MiscItemPage\n100.00%   44.176      1 -total\n 50.34%   22.238      8 Template:Icon_text\n 42.71%   18.866     19 Template:Trim\n 20.64%    9.119      2 Template:Uid\n 16.10%    7.114      3 Template:Icon_link\n 14.51%    6.409      1 Template:Main_only\n 12.07%    5.332