d_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/e/e7/Rhapsody_Unfaded_Icon.png/30px-Rhapsody_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e7/Rhapsody_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Rhapsody\" title=\"Rhapsody\">Rhapsody</a></span> </li>\n</ul>\n<p>This spell is a variation of:<br>\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Scarlet_Feast\" title=\"Scarlet Feast\"><picture><source srcset=\"/w/images/thumb/5/51/Scarlet_Feast_Icon.webp/40px-Scarlet_Feast_Icon.webp, /w/images/thumb/5/51/Scarlet_Feast_Icon.webp/60px-Scarlet_Feast_Icon.webp 1.5x, /w/images/thumb/5/51/Scarlet_Feast_Icon.webp/80px-Scarlet_Feast_Icon.webp 2x\"><img alt=\"Scarlet Feast\" src=\"/w/images/thumb/5/51/Scarlet_Feast_Icon.webp/40px-Scarlet_Feast_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/51/Scarlet_Feast_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Scarlet_Feast\" title=\"Scarlet Feast\">Scarlet Feast</a></span>\n</p>\n</div><h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>This ability requires an <span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Actions#Resources\" title=\"Actions\">Action</a> unlike the other variants of <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Scarlet_Feast\" title=\"Scarlet Feast\"><picture><source srcset=\"/w/images/thumb/5/51/Scarlet_Feast_Icon.webp/20px-Scarlet_Feast_Icon.webp, /w/images/thumb/5/51/Scarlet_Feast_Icon.webp/30px-Scarlet_Feast_Icon.webp 1.5x, /w/images/thumb/5/51/Scarlet_Feast_Icon.webp/40px-Scarlet_Feast_Icon.webp 2x\"><img alt=\"Scarlet Feast\" src=\"/w/images/thumb/5/51/Scarlet_Feast_Icon.webp/20px-Scarlet_Feast_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/51/Scarlet_Feast_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Scarlet_Feast\" title=\"Scarlet Feast\">Scarlet Feast</a> which use <span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp, /w/images/thumb/c/c9/Bonus_Action_Icon.png/35px-Bonus_Action_Icon.png.webp 1.5x, /w/images/thumb/c/c9/Bonus_Action_Icon.png/46px-Bonus_Action_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c9/Bonus_Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Actions#Resources\" title=\"Actions\">Bonus Actions</a>.</li></ul>\n</div>   \n<!-- \nNewPP limit report\nCached time: 20260715063030\n