26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  14  gp</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"￼START_WIDGET&quot;'-3baa98a0908852bbEND_WIDGET ￼START_WIDGET&quot;'-fd410efeba33d845END_WIDGET\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">BOOK_LOW_JaheirasHouse_KhalidLetter</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:BOOK_LOW_JaheirasHouse_KhalidLetter\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:BOOK_LOW_JaheirasHouse_KhalidLetter\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">df4686e9-7356-4b24-89b2-0e553f4f2b12</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:df4686e9-7356-4b24-89b2-0e553f4f2b12\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:df4686e9-7356-4b24-89b2-0e553f4f2b12\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div>   \n<div style=\"clear: both;\"></div></div>\n    <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>In the basement of <a href=\"/wiki/Elerrathin%27s_Home\" title=\"Elerrathin's Home\">Elerrathin's Home</a> at <span class=\"bg3wiki-coordinates\">X:&nbsp;-1554&nbsp;Y:&nbsp;981</span></li></ul>\n</div>  <h2><span class=\"mw-headline\" id=\"Text\"> Text </span></h2>\n<div class=\"bg3wiki-book-text\">\n<p>Since you've forbidden the writing of poems, I had to get creative this year. I tracked down a retired <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Cormyr\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/images/thumb/6/68/FRWiki_Icon.png/44px-FRWiki_Icon.png.webp 2x\"><img alt=\"Cormyrian\" src=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/FRWiki_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <span class=\"bg3wiki-icontext-extlink\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Cormyr\">Cormyrian</a></span> war wizard with a magical method of transferring mental imagery to parchment. The art is... imperfect, and perhaps better suited to espionage than nameday gifts.\n</p><p><br>\nWith all my love, and from a safe distance,\n</p><p><br>\n<a href=\"/wiki/Khalid\" title=\"Khalid\">Khalid</a>\n</p><p><br>\n[Beneath the note, a small inked picture of a smiling couple. Their mouths gape far too widely, their joints twisting ever so slightly, but beneath distorted brows you can just about make out a much younger Jaheira and a bearded man wearing a <a href=\"/wiki/Harper\" class=\"mw-redirect\" title=\"Harper\">Harper</a> pin.]\n</p>\n</div>    \n<!-- \nNewPP limit report\nCached time: 20260714230911\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.053 seconds\nReal time usage: 0.056 seconds\nPreprocessor visited node count: 1794/1000000\nPost‐expand include size: 33204/4194304 bytes\nTemplate argument size: 9606/4194304 bytes\nHighest expansion depth: 29/200\nExpensive parser function count: 2/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 2/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.011/7.000 seconds\nLua memory usage: 936278/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%   43.721      1 Template:MiscItemPage\n100.00%   43.721      1 -total\n 56.85%   24.855      8 Template:Icon_text\n 50.37%   22.021     19 Template:Trim\n 22.06%    9.644      2 Template:Uid\n 15.63%    6.835      3 Template:Icon_link\n 14.46%    6.324      1 Template:Main_only\n 12.07%    5.276      2 Template:Template_style\n  9.94%    4.345      1 Template:Ifexist\n  9.94%    4.345      8 Template:Ifempty\n-->\n\n<!-- Saved in parser cache with key bg3wiki:pcache:idhash:31689-0!canonical and timestamp 20260714230911 and revision id 396695. Rendering was triggered because: unknown\n -->\n</div>"}