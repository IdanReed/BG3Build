y.png/56px-Radiant_Immunity.png.webp 2x\"><img alt=\"Immune to all Radiant\" src=\"/w/images/thumb/c/ca/Radiant_Immunity.png/28px-Radiant_Immunity.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/ca/Radiant_Immunity.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li><li><span typeof=\"mw:File\"><span title=\"Immune to all Poison\"><picture><source srcset=\"/w/images/thumb/c/c0/Poison_Immunity.png/28px-Poison_Immunity.png.webp, /w/images/thumb/c/c0/Poison_Immunity.png/42px-Poison_Immunity.png.webp 1.5x, /w/images/thumb/c/c0/Poison_Immunity.png/56px-Poison_Immunity.png.webp 2x\"><img alt=\"Immune to all Poison\" src=\"/w/images/thumb/c/c0/Poison_Immunity.png/28px-Poison_Immunity.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c0/Poison_Immunity.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li><li><span typeof=\"mw:File\"><span title=\"Immune to all Psychic\"><picture><source srcset=\"/w/images/thumb/4/4f/Psychic_Immunity.png/28px-Psychic_Immunity.png.webp, /w/images/thumb/4/4f/Psychic_Immunity.png/42px-Psychic_Immunity.png.webp 1.5x, /w/images/thumb/4/4f/Psychic_Immunity.png/56px-Psychic_Immunity.png.webp 2x\"><img alt=\"Immune to all Psychic\" src=\"/w/images/thumb/4/4f/Psychic_Immunity.png/28px-Psychic_Immunity.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/4/4f/Psychic_Immunity.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li><li><span typeof=\"mw:File\"><span title=\"Immune to all Fire\"><picture><source srcset=\"/w/images/thumb/7/7e/Fire_Immunity.png/28px-Fire_Immunity.png.webp, /w/images/thumb/7/7e/Fire_Immunity.png/42px-Fire_Immunity.png.webp 1.5x, /w/images/thumb/7/7e/Fire_Immunity.png/56px-Fire_Immunity.png.webp 2x\"><img alt=\"Immune to all Fire\" src=\"/w/images/thumb/7/7e/Fire_Immunity.png/28px-Fire_Immunity.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/7/7e/Fire_Immunity.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li></ul></div>\n</div></section></section>\n\t\t\t</div>\n\t</div>\n</section></aside>\n<b>Nightlight</b> are non-hazardous mushrooms in the <a href=\"/wiki/Underdark\" title=\"Underdark\">Underdark</a>.\n\n<center class=\"noexcerpt\">\n<table style=\"background: none;\">\n\n\n<tbody><tr>\n<td style=\"color: #C1A878; font-size: 3.3em; font-family: serif; font-weight: bold; padding: 4px 2px 2px; width: 0.5em; vertical-align: top;\">“\n</td>\n<td><blockquote style=\"margin: 0; font-style: italic\">A glowing fungus that responds to touch, these mushrooms are a rare comfort for travellers lost in the Underdark</blockquote>\n</td>\n<td style=\"color: #C1A878; font-size: 3.3em; font-family: serif; font-weight: bold; padding: 4px 2px 2px; width: 0.5em; vertical-align: bottom;\">„\n</td></tr></tbody></table></center>\n<p><br>\n</p>\n<h2><span class=\"mw-headline\" id=\"Involvement\">Involvement</span></h2>\n<p>A rather brightly glowing mushroom, it lights a small area around itself. When interacting with a Nightlight, any party member automatically rolls <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/1/13/D20.png/20px-D20.png.webp, /w/images/thumb/1/13/D20.png/30px-D20.png.webp 1.5x, /w/images/thumb/1/13/D20.png/40px-D20.png.webp 2x\"><img alt=\"DC&nbsp;12 Nature Check\" src=\"/w/images/thumb/1/13/D20.png/20px-D20.png.webp\" decoding=\"async\" width=\"20\" height=\"22\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/1/13/D20.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> DC&nbsp;12 <a href=\"/wiki/Nature\" title=\"Nature\">Nature</a> <a href=\"/wiki/Ability_check\" class=\"mw-redirect\" title=\"Ability check\">Check</a>. If successful, they obtain a <span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Nightlight_Frond\" title=\"Nightlight Frond\"><picture><source srcset=\"/w/images/thumb/f/f0/Nightlight_Frond_Item_Icon.png/20px-Nightlight_Frond_Item_Icon.png.webp, /w/images/thumb/f/f0/Nightlight_Frond_Item_Icon.png/30px-Nightlight_Frond_Item_Icon.png.webp 1.5x, /w/images/thumb/f/f0/Nightlight_Frond_Item_Icon.png/40px-Nightlight_Frond_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/f/f0/Nightlight_Frond_Item_Icon.png/20px-Nightlight_Frond_Item_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f0/Nightlight_Frond_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> <a href=\"/wiki/Nightlight_Frond\" title=\"Nightlight Frond\">Nightlight Frond</a> - an alchemical ingredient used to make <span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Hearthlight_Bomb\" title=\"Hearthlight Bomb\"><picture><source srcset=\"/w/images/thumb/5/5e/GRN_Hearthlight_Bomb_Unfaded_Icon.png/20px-GRN_Hearthlight_Bomb_Unfaded_Icon.png.webp, /w/images/thumb/5/5e/GRN_Hearthlight_Bomb_Unfaded_Icon.png/30px-GRN_Hearthlight_Bomb_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/5/5e/GRN_Hearthlight_Bomb_Unfaded_Icon.png/40px-GRN_Hearthlight_Bomb_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/5/5e/GRN_Hearthlight_Bomb_Unfaded_Icon.png/20px-GRN_Hearthlight_Bomb_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/5e/GRN_Hearthlight_Bomb_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> <a href=\"/wiki/Hearthlight_Bomb\" title=\"Hearthlight Bomb\">Heartlight Bombs</a>.\n</p><p>After interacting, the Nightlight stalk's light goes out, regardless of the roll result.\n</p>\n<h2><span class=\"mw-headline\" id=\"Loot\">Loot</span></h2>\n<ul><li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Nightlight_Frond\" title=\"Nightlight Frond\"><picture><source srcset=\"/w/images/thumb/f/f0/Nightlight_Frond_Item_Icon.png/30px-Nightlight_Frond_Item_Icon.png.webp, /w/images/thumb/f/f0/Nightlight_Frond_Item_Icon.png/45px-Nightlight_Frond_Item_Icon.png.webp 1.5x, /w/images/thumb/f/f0/Nightlight_Frond_Item_Icon.png/60px-Nightlight_Frond_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/f/f0/Nightlight_Frond_Item_Icon.png/30px-Nightlight_Frond_Item_Icon.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f0/Nightlight_Frond_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Nightlight_Frond\" title=\"Nightlight Frond\">Nightlight Frond</a></span>, on successful check</li></ul>\n<h2><span class=\"mw-headline\" id=\"External_links\">External links</span></h2>\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Nightlight\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/