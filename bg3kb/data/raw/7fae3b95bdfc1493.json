ource image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Flame_of_Wrath\" title=\"Flame of Wrath\">Flame of Wrath</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Frost_of_Dark_Winter\" title=\"Frost of Dark Winter\"><picture><source srcset=\"/w/images/thumb/e/e1/Protection_from_Energy_Cold_Icon.webp/40px-Protection_from_Energy_Cold_Icon.webp, /w/images/thumb/e/e1/Protection_from_Energy_Cold_Icon.webp/60px-Protection_from_Energy_Cold_Icon.webp 1.5x, /w/images/thumb/e/e1/Protection_from_Energy_Cold_Icon.webp/80px-Protection_from_Energy_Cold_Icon.webp 2x\"><img alt=\"Frost of Dark Winter\" src=\"/w/images/thumb/e/e1/Protection_from_Energy_Cold_Icon.webp/40px-Protection_from_Energy_Cold_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e1/Protection_from_Energy_Cold_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Frost_of_Dark_Winter\" title=\"Frost of Dark Winter\">Frost of Dark Winter</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Sizzling_Cataclysm\" title=\"Sizzling Cataclysm\"><picture><source srcset=\"/w/images/thumb/1/11/Protection_from_Energy_Acid_Icon.webp/40px-Protection_from_Energy_Acid_Icon.webp, /w/images/thumb/1/11/Protection_from_Energy_Acid_Icon.webp/60px-Protection_from_Energy_Acid_Icon.webp 1.5x, /w/images/thumb/1/11/Protection_from_Energy_Acid_Icon.webp/80px-Protection_from_Energy_Acid_Icon.webp 2x\"><img alt=\"Sizzling Cataclysm\" src=\"/w/images/thumb/1/11/Protection_from_Energy_Acid_Icon.webp/40px-Protection_from_Energy_Acid_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/11/Protection_from_Energy_Acid_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Sizzling_Cataclysm\" title=\"Sizzling Cataclysm\">Sizzling Cataclysm</a></li>\n</ul>\n</div><h2><span class=\"mw-headline\" id=\"How_to_learn\"> How to learn </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<p>Granted by items:\n</p>\n<ul>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-legendary\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Markoheshkir\" title=\"Markoheshkir\"><picture><source srcset=\"/w/images/thumb/1/1c/Markoheshkir_Unfaded_Icon.png/30px-Markoheshkir_Unfaded_Icon.png.webp, /w/images/thumb/1/1c/Markoheshkir_Unfaded_Icon.png/45px-Markoheshkir_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/1/1c/Markoheshkir_Unfaded_Icon.png/60px-Markoheshkir_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/1/1c/Markoheshkir_Unfaded_Icon.png/30px-Markoheshkir_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/1c/Markoheshkir_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Markoheshkir\" title=\"Markoheshkir\">Markoheshkir</a></span> (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>)</li>\n</ul>\n</div><h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>There is an associated variant of this spell for each elemental damage type. They boost their respective elemental damage by the wielder's <a href=\"/wiki/Proficiency_bonus\" class=\"mw-redirect\" title=\"Proficiency bonus\">proficiency bonus</a> and grant two spells that can be cast once per short rest and do not use spell slots. The different variants are summarized below.</li></ul>\n<div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(20em, 1fr));\"><div>  <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Bolts_of_Doom\" title=\"Bolts of Doom\"><picture><source srcset=\"/w/images/thumb/6/6d/Protection_from_Energy_Lightning_Icon.webp/40px-Protection_from_Energy_Lightning_Icon.webp, /w/images/thumb/6/6d/Protection_from_Energy_Lightning_Icon.webp/60px-Protection_from_Energy_Lightning_Icon.webp 1.5x, /w/images/thumb/6/6d/Protection_from_Energy_Lightning_Icon.webp/80px-Protection_from_Energy_Lightning_Icon.webp 2x\"><img alt=\"Bolts of Doom\" src=\"/w/images/thumb/6/6d/Protection_from_Energy_Lightning_Icon.webp/40px-Protection_from_Energy_Lightning_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/6d/Protection_from_Energy_Lightning_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Bolts_of_Doom\" title=\"Bolts of Doom\">Bolts of Doom</a>\n<ul><li>Boosts <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lightning\" title=\"Lightning\"><picture><source srcset=\"/w/images/thumb/3/31/Lightning_Damage_Icon.png/20px-Lightning_Damage_Icon.png