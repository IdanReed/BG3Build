images/3/3b/Icon_Djinni.webp 1.5x\"><img src=\"/w/images/thumb/3/3b/Icon_Djinni.webp/120px-Icon_Djinni.webp\" decoding=\"async\" width=\"120\" height=\"120\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/3b/Icon_Djinni.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n<div style=\"width: 160px; height: 160px; position: absolute\"><span typeof=\"mw:File\"><a href=\"/wiki/Djinni\" title=\"Djinni\"><picture><source srcset=\"/w/images/thumb/1/14/Portrait_Frame.png/160px-Portrait_Frame.png.webp, /w/images/thumb/1/14/Portrait_Frame.png/240px-Portrait_Frame.png.webp 1.5x, /w/images/thumb/1/14/Portrait_Frame.png/320px-Portrait_Frame.png.webp 2x\"><img src=\"/w/images/thumb/1/14/Portrait_Frame.png/160px-Portrait_Frame.png.webp\" decoding=\"async\" width=\"160\" height=\"160\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/14/Portrait_Frame.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n</div>\n<table class=\"bg3wiki-attrblock-table\"><tbody><tr class=\"bg3wiki-attrblock-score-row\">\n\t\t<td>\n\t\t<p><a href=\"/wiki/Strength\" title=\"Strength\">STR</a></p>\n\t\t<div><b><span>21</span></b></div> <span>(+5)</span>\n</td>\n\n<td>\n\t\t<p><a href=\"/wiki/Dexterity\" title=\"Dexterity\">DEX</a></p>\n\t\t<div><b><span>15</span></b></div> <span>(+2)</span>\n</td>\n\n<td>\n\t\t<p><a href=\"/wiki/Constitution\" title=\"Constitution\">CON</a></p>\n\t\t<div><b><span>22</span></b></div> <span>(+6)</span>\n</td>\n\n\t\t<td>\n\t\t<p><a href=\"/wiki/Intelligence\" title=\"Intelligence\">INT</a></p>\n\t\t<div><b><span>15</span></b></div> <span>(+2)</span>\n</td>\n\n\t\t<td>\n\t\t<p><a href=\"/wiki/Wisdom\" title=\"Wisdom\">WIS</a></p>\n\t\t<div><b><span>16</span></b></div> <span>(+3)</span>\n</td>\n\n\t\t<td>\n\t\t<p><a href=\"/wiki/Charisma\" title=\"Charisma\">CHA</a></p>\n\t\t<div><b><span>20</span></b>\n<b></b></div><b> <span>(+5)</span></b>\n</td>\n\t</tr><tr><td colspan=\"100%\" class=\"bg3wiki-attrblock-divider\"><hr></td></tr><tr class=\"bg3wiki-attrblock-stat-row\">\n\t<td colspan=\"3\"><p><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><span><picture><source srcset=\"/w/images/thumb/7/75/Duration_Icon.png/24px-Duration_Icon.png.webp, /w/images/thumb/7/75/Duration_Icon.png/36px-Duration_Icon.png.webp 1.5x, /w/images/thumb/7/75/Duration_Icon.png/48px-Duration_Icon.png.webp 2x\"><img src=\"/w/images/thumb/7/75/Duration_Icon.png/24px-Duration_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/7/75/Duration_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Duration</p></td>\n\t<td colspan=\"3\"><p>Until long rest</p></td>\n</tr><tr class=\"bg3wiki-attrblock-stat-row\">\n\t<td colspan=\"3\"><p><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><span><picture><source srcset=\"/w/images/thumb/2/25/HP_Icon.png/24px-HP_Icon.png.webp, /w/images/thumb/2/25/HP_Icon.png/36px-HP_Icon.png.webp 1.5x, /w/images/2/25/HP_Icon.png 2x\"><img src=\"/w/images/thumb/2/25/HP_Icon.png/24px-HP_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/25/HP_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Hit Points</p></td>\n\t<td colspan=\"3\"><p>161</p></td>\n</tr><tr class=\"bg3wiki-attrblock-stat-row\">\n\t<td colspan=\"3\"><p><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><span><picture><source srcset=\"/w/images/thumb/b/b0/Creature_AC_Icon.png/24px-Creature_AC_Icon.png.webp, /w/images/thumb/b/b0/Creature_AC_Icon.png/36px-Creature_AC_Icon.png.webp 1.5x, /w/images/b/b0/Creature_AC_Icon.png 2x\"><img src=\"/w/images/thumb/b/b0/Creature_AC_Icon.png/24px-Creature_AC_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/b/b0/Creature_AC_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Armour Class</p></td>\n\t<td colspan=\"3\"><p>19</p></td>\n</tr></tbody></table><div style=\"clear: both;\"></div>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Main_Hand_Attack\" title=\"Main Hand Attack\"><picture><source srcset=\"/w/images/thumb/c/ca/Main_Hand_Attack_Icon.webp/40px-Main_Hand_Attack_Icon.webp, /w/images/thumb/c/ca/Main_Hand_Attack_Icon.webp/60px-Main_Hand_Attack_Icon.webp 1.5x, /w/images/thumb/c/ca/Main_Hand_Attack_Icon.webp/80px-Main_Hand_Attack_Icon.webp 2x\"><img alt=\"Main Hand Attack\" src=\"/w/images/thumb/c/ca/Main_Hand_Attack_Icon.webp/40px-Main_Hand_Attack_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/ca/Main_Hand_Attack_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Main_Hand_Attack\" title=\"Main Hand Attack\">Main Hand Attack</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Make a melee attack with your equipped weapon. </dd>\n</dl>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Drunken_Inhale\" title=\"Drunken Inhale\"><picture><source srcset=\"/w/images/thumb/d/dc/Drunken_Inhale_Icon.webp/40px-Drunken_Inhale_Icon.webp, /w/images/thumb/d/dc/Drunken_Inhale_Icon.webp/60px-Drunken_Inhale_Icon.webp 1.5x, /w/images/thumb/d/dc/Drunken_Inhale_Icon.webp/80px-Drunken_Inhale_Icon.webp 2x\"><img alt=\"Drunken Inhale\" src=\"/w/images/thumb/d/dc/Drunken_Inhale_Icon.webp/40px-Drunken_Inhale_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/dc/Drunken_Inhale_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Drunken_Inhale\" title=\"Drunken Inhale\">Drunken Inhale</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Compel foes toward you with an intoxicating wind that makes them <span class=\"bg3wiki-icontext-icon-wrapper\" style=\"display: inline-flex; align-items: center; justify-content: center; min-width: 25px; height: 25px;\"><span class=\"bg3wiki-icontext-icon\" style=\"vertical-align: middle;\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Drunk_(Condition)\" title=\"Drunk (Condition)\"><picture><source srcset=\"/w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/25px-Alcohol_Condition_Icon.webp, /w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/38px-Alcohol_Condition_Icon.webp 1.5x, /w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/50px-Alcohol_Condition_Icon.webp 2x\"><img alt=\"Drunk\" src=\"/w/images/thumb/0/0a/Alcohol_Condition_Icon.webp/25px-Alcohol_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0a/Alcohol_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span><span class=\"bg3wiki-after-icon\"></span></span></span>&nbsp;<span class=\"bg3wiki-icontext-text\" style=\"\"><a href=\"/wiki/Drunk_(Condition)\" title=\"Drunk (Condition)\">Drunk</a></span>. </dd>\n</dl>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Misty_Step\" title=\"Misty Step\"><picture><source srcset=\"/w/images/thumb/1/1f/Misty_Step_Icon.webp/40px-Misty_Step_Icon.webp, /w/images/thumb/1/1f/Misty_Step_Icon.webp/60px-Misty_Step_Icon.webp 1.5x, /w/images/thumb/1/1f/Misty_Step_Icon.webp/80px-Misty_Step_Icon.webp 2x\"><img alt=\"Misty Step\" src=\"/w/images/thumb/1/1f/Misty_Step_Icon.webp/40px-Misty_Step_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/1f/Misty_Step_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Misty_Step\" title=\"Misty Step\">Misty Step</a> (<span aria-label=\"Bonus Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp, /w/images/thumb/c/c9/Bonus_Action_Icon.png/35px-Bonus_Action_Icon.png.webp 1.5x, /w/images/thumb/c/c9/Bonus_Action_Icon.png/46px-Bonus_Action_Icon.png.webp 2x\"><img alt=\"Bonus Action\" src=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c9/Bonus_Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Surrounded by silver mist, you teleport to an unoccupied space you can see. </dd>\n</dl>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Sweetplum_Gales\" title=\"Sweetplum Gales\"><picture><source srcset=\"/w/images/thumb/9/93/Sweetplum_Gales_Icon.webp/40px-Sweetplum_Gales_Icon.webp, /w/images/thumb/9/93/Sweetplum_Gales_Icon.webp/60px-Sweetplum_Gales_Icon.webp 1.5x, /w/images/thumb/9/93/Sweetplum_Gales_Icon.webp/80px-Sweetplum_Gales_Icon.webp 2x\"><img alt=\"Sweetplum Gales\" src=\"/w/images/thumb/9/93/Sweetplum_Gales_Icon.webp/40px-Sweetplum_Gales_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/93/Sweetplum_Gales_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Sweetplum_Gales\" title=\"Sweetplum Gales\">Sweetplum Gales</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Coalesce the air in a fragrant but vicious whirlwind that <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Restrained_(Condition)\" title=\"Restrained (Condition)\"><picture><source srcset=\"/w/images/thumb/2/20/Restrained_Condition_Icon.webp/25px-Restrained_Condition_Icon.webp, /w/images/thumb/2/20/Restrained_Condition_Icon.webp/38px-Restrained_Condition_Icon.webp 1.5x, /w/images/thumb/2/20/Restrained_Condition_Icon.webp/50px-Restrained_Condition_Icon.webp 2x\"><img alt=\"Restrains\" src=\"/w/images/thumb/2/20/Restrained_Condition_Icon.webp/25px-Restrained_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/20/Restrained_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Restrained_(Condition)\" title=\"Restrained (Condition)\">Restrains</a> those within. </dd>\n</dl>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Thunderwave\" title=\"Thunderwave\"><picture><source srcset=\"/w/images/thumb/0/04/Thunderwave_Icon.webp/40px-Thunderwave_Icon.webp, /w/images/thumb/0/04/Thunderwave_Icon.webp/60px-Thunderwave_Icon.webp 1.5x, /w/images/thumb/0/04/Thunderwave_Icon.webp/80px-Thunderwave_Icon.webp 2x\"><img alt=\"Thunderwave\" src=\"/w/images/thumb/0/04/Thunderwave_Icon.webp/40px-Thunderwave_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/04/Thunderwave_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Thunderwave\" title=\"Thunderwave\">Thunderwave</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Cast as a level 4 spell at will.</dd>\n</dl>\n</div><h2><span class=\"mw-headline\" id=\"How_to_learn\"> How to learn </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<p>This spell is a variation of:<br>\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Planar_Ally\" title=\"Planar Ally\"><picture><source srcset=\"/w/images/thumb/f/f3/Planar_Ally_Icon.webp/40px-Planar_Ally_Icon.webp, /w/images/thumb/f/f3/Planar_Ally_Icon.webp/60px-Planar_Ally_Icon.webp 1.5x, /w/images/thumb/f/f3/Planar_Ally_Icon.webp/80px-Planar_Ally_Icon.webp 2x\"><img alt=\"Planar Ally\" src=\"/w/images/thumb/f/f3/Planar_Ally_Icon.webp/40px-Planar_Ally_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f3/Planar_Ally_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Planar_Ally\" title=\"Planar Ally\">Planar Ally</a></span>\n</p>\n</div><h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>The Djinni excels at area control - <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Thunderwave\" title=\"Thunderwave\"><picture><source srcset=\"/w/images/thumb/0/04/Thunderwave_Icon.webp/25px-Thunderwave_Icon.webp, /w/images/thumb/0/04/Thunderwave_Icon.webp/38px-Thunderwave_Icon.webp 1.5x, /w/images/thumb/0/04/Thunderwave_Icon.webp/50px-Thunderwave_Icon.webp 2x\"><img alt=\"Thunderwave\" src=\"/w/images/thumb/0/04/Thunderwave_Icon.webp/25px-Thunderwave_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/04/Thunderwave_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Thunderwave\" title=\"Thunderwave\">Thunderwave</a> can push enemies away and <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Sweetplum_Gales\" title=\"Sweetplum Gales\"><picture><source srcset=\"/w/images/thumb/9/93/Sweetplum_Gales_Icon.webp/25px-Sweetplum_Gales_Icon.webp, /w/images/thumb/9/93/Sweetplum_Gales_Icon.webp/38px-Sweetplum_Gales_Icon.webp 1.5x, /w/images/thumb/9/93/Sweetplum_Gales_Icon.webp/50px-Sweetplum_Gales_Icon.webp 2x\"><img alt=\"Sweetplum Gales\" src=\"/w/images/thumb/9/93/Sweetplum_Gales_Icon.webp/25px-Sweetplum_Gales_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/93/Sweetplum_Gales_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Sweetplum_Gales\" title=\"Sweetplum Gales\">Sweetplum Gales</a> can rob enemies of their movement.</li>\n<li>Djinni do not have <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Flight\" title=\"Flight\"><picture><source srcset=\"/w/images/thumb/f/f3/Fly_Icon.webp/25px-Fly_Icon.webp, /w/images/thumb/f/f3/Fly_Icon.webp/38px-Fly_Icon.webp 1.5x, /w/images/thumb/f/f3/Fly_Icon.webp/50px-Fly_Icon.webp 2x\"><img alt=\"Flight\" src=\"/w/images/thumb/f/f3/Fly_Icon.webp/25px-Fly_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f3/Fly_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Flight\" class=\"mw-redirect\" title=\"Flight\">Flight</a> or <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Jump\" title=\"Jump\"><picture><source srcset=\"/w/images/thumb/2/28/Jump_Icon.webp/25px-Jump_Icon.webp, /w/images/thumb/2/28/Jump_Icon.webp/38px-Jump_Icon.webp 1.5x, /w/images/thumb/2/28/Jump_Icon.webp/50px-Jump_Icon.webp 2x\"><img alt=\"Jump\" src=\"/w/images/thumb/2/28/Jump_Icon.webp/25px-Jump_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/28/Jump_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Jump\" title=\"Jump\">Jump</a>. This can result in them being left behind if the party jumps gaps or cliffs; one must manually have them use <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Shifting_Winds\" title=\"Shifting Winds\"><picture><source srcset=\"/w/images/thumb/4/4d/Shifting_Winds_Icon.webp/25px-Shifting_Winds_Icon.webp, /w/images/thumb/4/4d/Shifting_Winds_Icon.webp/38px-Shifting_Winds_Icon.webp 1.5x, /w/images/thumb/4/4d/Shifting_Winds_Icon.webp/50px-Shifting_Winds_Icon.webp 2x\"><img alt=\"Shifting Winds\" src=\"/w/images/thumb/4/4d/Shifting_Winds_Icon.webp/25px-Shifting_Winds_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/4d/Shifting_Winds_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Shifting_Winds\" title=\"Shifting Winds\">Shifting Winds</a> in such circumstances to have them stay with the party.</li></ul>\n</div>   \n<h2><span class=\"mw-headline\" id=\"External_links\">External links</span></h2>\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Planar_ally\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/images/thumb/6/68/FRWiki_Icon.png/44px-FRWiki_Icon.png.webp 2x\"><img alt=\"Planar ally\" src=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/FRWiki_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <span class=\"bg3wiki-icontext-extlink\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Planar_ally\">Planar ally</a></span> on the <a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Main_Page\">Forgotten Realms Wiki</a></li></ul>\n<!-- \nNewPP limit report\nCached time: 20260715035737\nCache expiry: 86400\nReduced expiry: false\nComplications: [no‐toc]\nCPU time usage: 0.125 seconds\nReal time usage: 0.131 seconds\nPreprocessor visited node count: 5795/1000000\nPost‐expand include size: 100768/4194304 bytes\nTemplate argument size: 40444/4194304 bytes\nHighest expansion depth: 29/200\nExpensive parser function count: 3/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 4/5000000 bytes\nExtLoops count: 35/1000\nLua time usage: 0.023/7.000 seconds\nLua memory usage: 1638436/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n138.42%  145.398     53 Templat