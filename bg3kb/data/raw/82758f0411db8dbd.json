idth=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0e/Book_Generic_G_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Healer%27s_Log\" title=\"Healer's Log\">Healer's Log</a></span></li>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Moonhaven_Logbook\" title=\"Moonhaven Logbook\"><picture><source srcset=\"/w/images/thumb/0/0e/Book_Generic_G_Item_Icon.png/30px-Book_Generic_G_Item_Icon.png.webp, /w/images/thumb/0/0e/Book_Generic_G_Item_Icon.png/45px-Book_Generic_G_Item_Icon.png.webp 1.5x, /w/images/thumb/0/0e/Book_Generic_G_Item_Icon.png/60px-Book_Generic_G_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/0/0e/Book_Generic_G_Item_Icon.png/30px-Book_Generic_G_Item_Icon.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0e/Book_Generic_G_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Moonhaven_Logbook\" title=\"Moonhaven Logbook\">Moonhaven Logbook</a></span></li>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Research_Notes_(Apothecary)\" title=\"Research Notes (Apothecary)\"><picture><source srcset=\"/w/images/thumb/d/d1/Book_Note_K_Item_Icon.png/30px-Book_Note_K_Item_Icon.png.webp, /w/images/thumb/d/d1/Book_Note_K_Item_Icon.png/45px-Book_Note_K_Item_Icon.png.webp 1.5x, /w/images/thumb/d/d1/Book_Note_K_Item_Icon.png/60px-Book_Note_K_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/d/d1/Book_Note_K_Ite