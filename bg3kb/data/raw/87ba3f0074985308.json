n.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 0.05 kg (0.1 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 0.05 kg (0.1 lb)</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 14 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  14  gp</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"￼START_WIDGET&quot;'-1e1d8a806283c701END_WIDGET ￼START_WIDGET&quot;'-08bffc63ee5ed12dEND_WIDGET\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">S_EPI_Letter_Nocturne</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:S_EPI_Letter_Nocturne\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:S_EPI_Letter_Nocturne\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">e3d81d8e-0d72-4e80-81c8-9e92da12fce9</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:e3d81d8e-0d72-4e80-81c8-9e92da12fce9\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:e3d81d8e-0d72-4e80-81c8-9e92da12fce9\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"￼START_WIDGET&quot;'-d5e3e5c34b86fb86END_WIDGET ￼START_WIDGET&quot;'-7c5ebe4609a8547fEND_WIDGET\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">S_EPI_Letter_NocturneTurnedFrom</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:S_EPI_Letter_NocturneTurnedFrom\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:S_EPI_Letter_NocturneTurnedFrom\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">d6bc1f90-611b-4d3a-a054-4e94879f519a</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:d6bc1f90-611b-4d3a-a054-4e94879f519a\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:d6bc1f90-611b-4d3a-a054-4e94879f519a\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div>   \n<div style=\"clear: both;\"></div></div>\n    <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>Within the <span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Chest_of_Grateful_Words\" title=\"Chest of Grateful Words\"><picture><source srcset=\"/w/images/thumb/8/8a/Jeweled_Chest_A_Unfaded_Icon.webp/20px-Jeweled_Chest_A_Unfaded_Icon.webp, /w/images/thumb/8/8a/Jeweled_Chest_A_Unfaded_Icon.webp/30px-Jeweled_Chest_A_Unfaded_Icon.webp 1.5x, /w/images/thumb/8/8a/Jeweled_Chest_A_Unfaded_Icon.webp/40px-Jeweled_Chest_A_Unfaded_Icon.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/8/8a/Jeweled_Chest_A_Unfaded_Icon.webp/20px-Jeweled_Chest_A_Unfaded_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/8a/Jeweled_Chest_A_Unfaded_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> <a href=\"/wiki/Chest_of_Grateful_Words\" title=\"Chest of Grateful Words\">Chest of Grateful Words</a></li></ul>\n</div>  <h2><span class=\"mw-headline\" id=\"Text\"> Text </span></h2>\n<div class=\"bg3wiki-book-text\">\n<dl><dd><i>If Shadowheart abandoned Shar</i> (<details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">S_EPI_Letter_Nocturne</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:S_EPI_Letter_Nocturne\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:S_EPI_Letter_Nocturne\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> / <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">e3d81d8e-0d72-4e80-81c8-9e92da12fce9</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:e3d81d8e-0d72-4e80-81c8-9e92da12fce9\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:e3d81d8e-0d72-4e80-81c8-9e92da12fce9\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span>):</dd></dl>\n<p>Dear Shadowheart,\n</p><p><br>\nI hope that you are happy and well. I must keep this short, as I remain surrounded by Shar's followers at almost every waking moment in my new enclave. I dearly wish for you to enjoy your night spent with old friends, and I hope that you and I shall share such a reunion. I know it must seem strange for me to dwell on such heretical thoughts, yet I cannot help myself. Perhaps one day I shall find some measure of the bravery that you did, and walk away from this life. Until then, I shall keep safe, and hold memories of you as my one ember of light amid an ocean of darkness.\n</p><p><br>\nUntil we find each other once again.\n</p><p><br>\nYours always, \n</p><p>Nocturne\n</p>\n<dl><dd><i>If Shadowheart became a Dark Justiciar, sacrificed her parents, and leads the Cloister of Sombre Embrace</i> (<details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">S_EPI_Letter_NocturneTurnedFrom</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:S_EPI_Letter_NocturneTurnedFrom\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:S_EPI_Letter_NocturneTurnedFrom\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> / <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">d6bc1f90-611b-4d3a-a054-4e94879f519a</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:d6bc1f90-611b-4d3a-a054-4e94879f519a\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:d6bc1f90-611b-4d3a-a054-4e94879f519a\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span>):</dd></dl>\n<p>Dear Acquaintance,\n</p><p><br>\nThough expressions of gratitude are contrary to the teachings of Lady Shar, I must seize this opportunity to thank you for all you did. Not only did you return my dear friend Shadowheart to me, but you also aided her in seizing the destiny that the former Mother Superior sought to keep out of her reach. I am honoured to have her as leader, teacher, and when discretion affords us the chance, my closest and dearest friend.\n</p><p><br>\nThank you also for your invitation, but pressing matters in the service of the Dark Lady must come first. Even Shadowheart herself could not compel me to turn from my duties at a time when the Cloister of Sombre Embrace is filled with new recruits in need of guidance. I shall tend to her followers while she makes time for old friends.\n</p><p><br>\nLady Shar's blessings be upon you,\n</p><p>Nocturne\n</p>\n</div> <h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>Contingent on:\n<ul><li>siding against <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Viconia_DeVir\" title=\"Viconia DeVir\"><picture><source srcset=\"/w/images/thumb/c/cd/Portrait_Viconia_DeVir.png/25px-Portrait_Viconia_DeVir.png.webp, /w/images/thumb/c/cd/Portrait_Viconia_DeVir.png/38px-Portrait_Viconia_DeVir.png.webp 1.5x, /w/images/thumb/c/cd/Portrait_Viconia_DeVir.png/50px-Portrait_Viconia_DeVir.png.webp 2x\"><img alt=\"Viconia DeVir\" src=\"/w/images/thumb/c/cd/Portrait_Viconia_DeVir.png/25px-Portrait_Viconia_DeVir.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/cd/Portrait_Viconia_DeVir.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Viconia_DeVir\" title=\"Viconia DeVir\">Viconia DeVir</a> when completing <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Investigate_the_House_of_Grief\" title=\"Investigate the House of Grief\"><picture><source srcset=\"/w/images/thumb/6/69/Quest_Map_Icon.png/22px-Quest_Map_Icon.png.webp, /w/images/thumb/6/69/Quest_Map_Icon.png/33px-Quest_Map_Icon.png.webp 1.5x, /w/images/thumb/6/69/Quest_Map_Icon.png/44px-Quest_Map_Icon.png.webp 2x\"><img alt=\"Investigate the House of Grief\" src=\"/w/images/thumb/6/69/Quest_Map_Icon.png/22px-Quest_Map_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/69/Quest_Map_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Investigate_the_House_of_Grief\" title=\"Investigate the House of Grief\">Investigate the House of Grief</a></li>\n<li>completing <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Daughter_of_Darkness\" title=\"Daughter of Darkness\"><picture><source srcset=\"/w/images/thumb/6/69/Quest_Map_Icon.png/22px-Quest_Map_Icon.png.webp, /w/images/thumb/6/69/Quest_Map_Icon.png/33px-Quest_Map_Icon.png.webp 1.5x, /w/images/thumb/6/69/Quest_Map_Icon.png/44px-Quest_Map_Icon.png.webp 2x\"><img alt=\"Daughter of Darkness\" src=\"/w/images/thumb/6/69/Quest_Map_Icon.png/22px-Quest_Map_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/69/Quest_Map_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Daughter_of_Darkness\" title=\"Daughter of Darkness\">Daughter of Darkness</a></li></ul></li>\n<li>It is possible to receive this letter without feeding the <span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-story\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Noblestalk\" title=\"Noblestalk\"><picture><source srcset=\"/w/images/thumb/1/10/Noblestalk_Unfaded_Icon.png/20px-Noblestalk_Unfaded_Icon.png.webp, /w/images/thumb/1/10/Noblestalk_Unfaded_Icon.png/30px-Noblestalk_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/1/10/Noblestalk_Unfaded_Icon.png/40px-Noblestalk_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/1/10/Noblestalk_Unfaded_Icon.png/20px-Noblestalk_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Noblestalk_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> <a href=\"/wiki/Noblestalk\" title=\"Noblestalk\">Noblestalk</a> to Shadowheart, or even without meeting<sup class=\"noexcerpt navigation-not-searchable\">[<a href=\"/wiki/bg3wiki:Verification\" title=\"bg3wiki:Verification\"><span aria-label=\"Needs verification.\" tabindex=\"0\" class=\"bg3wiki-help-tooltip\"><i>verify</i></span></a>]</sup> Nocturne entirely.</li></ul>\n</div>   \n<!-- \nNewPP limit report\nCached time: 20260714234327\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.088 seconds\nReal time usage: 0.094 seconds\nPreprocessor visited node count: 4196/1000000\nPost‐expand include size: 80797/4194304 bytes\nTemplate argument size: 30654/4194304 bytes\nHighest expansion depth: 29/200\nExpensive parser function count: 5/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 2/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.025/7.000 seconds\nLua memory usage: 1300076/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%   74.987      1 Template:MiscItemPage\n100.00%   74.987      1 -total\n 50.36%   37.763     14 Template:Icon_text\n 47.39%   35.533     49 Template:Trim\n 25.05%   18.782      1 Template:PageSeo\n 24.72%   18.540      2 Template:Hidden_code\n 23.58%   17.679      8 Template:Uid\n 23.26%   17.445      8 Template:Icon_link\n 16.50%   12.373      3 Template:CharLink\n 15.95%   11.957     18 Template:Ifempty\n-->\n\n<!-- Saved in parser cache with key bg3wiki:pcache:idhash:30059-0!canonical and timestamp 20260714234327 and revision id 343622. Rendering was triggered because: unknown\n -->\n</div>"}