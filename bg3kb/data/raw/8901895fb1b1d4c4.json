Gauntlet_Unfaded_Icon.png/45px-Netherstone-Studded_Gauntlet_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/8/88/Netherstone-Studded_Gauntlet_Unfaded_Icon.png/60px-Netherstone-Studded_Gauntlet_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/8/88/Netherstone-Studded_Gauntlet_Unfaded_Icon.png/30px-Netherstone-Studded_Gauntlet_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/88/Netherstone-Studded_Gauntlet_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Netherstone-Studded_Gauntlet\" title=\"Netherstone-Studded Gauntlet\">Netherstone-Studded Gauntlet</a></span> (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Long rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Long_rest\" class=\"mw-redirect\" title=\"Long rest\">Long rest</a>)</li>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-rare\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Salty_Scimitar(rrr)\" title=\"Salty Scimitar(rrr)\"><picture><source srcset=\"/w/images/thumb/9/94/Scimitar_PlusTwo_Unfaded_Icon.png/30px-Scimitar_PlusTwo_Unfaded_Icon.png.webp, /w/images/thumb/9/94/Scimitar_PlusTwo_Unfaded_Icon.png/45px-Scimitar_PlusTwo_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/9/94/Scimitar_PlusTwo_Unfaded_Icon.png/60px-Scimitar_PlusTwo_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/9/94/Scimitar_PlusTwo_Unfaded_Icon.png/30px-Scimitar_PlusTwo_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/94/Scimitar_PlusTwo_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Salty_Scimitar(rrr)\" title=\"Salty Scimitar(rrr)\">Salty Scimitar(rrr)</a></span> (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Long rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Long_rest\" class=\"mw-redirect\" title=\"Long rest\">Long rest</a>)</li>\n</ul>\n</div><h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>A creature will not obey a command that is directly harmful, such as <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Command:_Approach\" title=\"Command: Approach\"><picture><source srcset=\"/w/images/thumb/2/24/Command_Approach_Icon.webp/20px-Command_Approach_Icon.webp, /w/images/thumb/2/24/Command_Approach_Icon.webp/30px-Command_Approach_Icon.webp 1.5x, /w/images/thumb/2/24/Command_Approach_Icon.webp/40px-Command_Approach_Icon.webp 2x\"><img alt=\"Command: Approach\" src=\"/w/images/thumb/2/24/Command_Approach_Icon.webp/20px-Command_Approach_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/24/Command_Approach_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Command:_Approach\" title=\"Command: Approach\">Command: Approach</a> through a damaging surface. However, a creature will obey <i>indirectly</i> harmful commands, such as <a href=\"/wiki/Command:_Approach\" title=\"Command: Approach\">Command: Approach</a> causing <a href=\"/wiki/Opportunity_Attack\" title=\"Opportunity Attack\">Opportunity Attacks</a> as the creature leaves the threat range of melee creatures. This can cause a creature to take massive damage when surrounded.</li>\n<li>Arguably one of the most useful spells in the game, this spell does not require <a href=\"/wiki/Concentration\" title=\"Concentration\">concentration</a> and can be used immediately, while on the <a href=\"/wiki/Nautiloid\" title=\"Nautiloid\">Nautiloid</a> in the <a href=\"/wiki/Prologue\" class=\"mw-redirect\" title=\"Prologue\">Prologue</a> – and throughout all three Acts of the game – to temporarily disable (most) opponents or force them to <a href=\"/wiki/Command:_Drop\" title=\"Command: Drop\">drop</a> their weapon, often to highly advantageous effect.</li>\n<li>A <a href=\"/wiki/Sorcerer\" title=\"Sorcerer\">sorcerer</a> can double the length of Command using <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Metamagic:_Extended_Spell\" title=\"Metamagic: Extended Spell\"><picture><source srcset=\"/w/images/thumb/9/96/Metamagic_Extended_Spell_Icon.webp/20px-Metamagic_Extended_Spell_Icon.webp, /w/images/thumb/9/96/Metamagic_Extended_Spell_Icon.webp/30px-Metamagic_Extended_Spell_Icon.webp 1.5x, /w/images/thumb/9/96/Metamagic_Extended_Spell_Icon.webp/40px-Metamagic_Extended_Spell_Icon.webp 2x\"><img alt=\"Metamagic: Extended Spell\" src=\"/w/images/thumb/9/96/Metamagic_Extended_Spell_Icon.webp/20px-Metamagic_Extended_Spell_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/96/Metamagic_Extended_Spell_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Metamagic:_Extended_Spell\" title=\"Metamagic: Extended Spell\">Metamagic: Extended Spell</a>. Notably, targets are only given the chance to roll a saving throw when the spell is initially cast; if they fail, they are effectively disabled for two turns without the opportunity to roll again.</li></ul>\n</div>   \n<h2><span class=\"mw-headline\" id=\"External_links\">External links</span></h2>\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Command\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/images/thumb/6/68/FRWiki_Icon.png/44px-FRWiki_Icon.png.webp 2x\"><img alt=\"Command\" src=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/FRWiki_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <span class=\"bg3wiki-icontext-extlink\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Command\">Command</a></span> on the <a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Main_Page\">Forgotten Realms Wiki</a></li></ul