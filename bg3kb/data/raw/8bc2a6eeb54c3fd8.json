b/ba/Attack_Roll_Icon.png/50px-Attack_Roll_Icon.png.webp 2x\"><img alt=\"Attack Roll\" src=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/b/ba/Attack_Roll_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Attack_Roll\" class=\"mw-redirect\" title=\"Attack Roll\">Attack Rolls</a> and <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp, /w/images/e/e7/Saving_Throw_Icon.png 1.5x\"><img alt=\"Saving Throw\" src=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/e7/Saving_Throw_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Saving_Throw\" class=\"mw-redirect\" title=\"Saving Throw\">Saving Throws</a>.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Lieges_of_the_Underdark_Blessing\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lieges_of_the_Underdark_Blessing_(Condition)\" title=\"Lieges of the Underdark Blessing (Condition)\"><picture><source srcset=\"/w/images/thumb/8/87/Bless_Condition_Icon.webp/30px-Bless_Condition_Icon.webp, /w/images/thumb/8/87/Bless_Condition_Icon.webp/45px-Bless_Condition_Icon.webp 1.5x, /w/images/thumb/8/87/Bless_Condition_Icon.webp/60px-Bless_Condition_Icon.webp 2x\"><img alt=\"Lieges of the Underdark Blessing\" src=\"/w/images/thumb/8/87/Bless_Condition_Icon.webp/30px-Bless_Condition_Icon.webp\" decoding=\