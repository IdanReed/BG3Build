nk for Crawlers --></a></span></span></span><div><div style=\"white-space:nowrap\"><span class=\"bg3wiki-damage-type-slashing\">1d10</span><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Slashing\" title=\"Slashing\"><picture><source srcset=\"/w/images/thumb/f/f0/Slashing_Damage_Icon.png/20px-Slashing_Damage_Icon.png.webp, /w/images/thumb/f/f0/Slashing_Damage_Icon.png/30px-Slashing_Damage_Icon.png.webp 1.5x, /w/images/thumb/f/f0/Slashing_Damage_Icon.png/40px-Slashing_Damage_Icon.png.webp 2x\"><img alt=\"Slashing\" src=\"/w/images/thumb/f/f0/Slashing_Damage_Icon.png/20px-Slashing_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f0/Slashing_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Slashing\" title=\"Slashing\"><span class=\"bg3wiki-damage-type-slashing\">Slashing</span></a></div></div></div></dd>\n  </div>\n<div style=\"margin-top: 10px; margin-left: 20px\">\n<b>Properties</b><div class=\"bg3wiki-horizontlist\">\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Glaives\" title=\"Glaives\"><picture><source srcset=\"/w/images/thumb/6/6a/Glaives_Icon.png/25px-Glaives_Icon.png.webp, /w/images/thumb/6/6a/Glaives_Icon.png/38px-Glaives_Icon.png.webp 1.5x, /w/images/thumb/6/6a/Glaives_Icon.png/50px-Glaives_Icon.png.webp 2x\"><img alt=\"Glaives\" src=\"/w/images/thumb/6/6a/Glaives_Icon.png/25px-Glaives_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/6a/Glaives_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Glaives\" title=\"Glaives\">Glaives</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><s