x-Polymorphed_Condition_Icon.webp 1.5x, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/60px-Polymorphed_Condition_Icon.webp 2x\"><img alt=\"Alternate Form: Dire Wolf\" src=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Polymorphed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a class=\"mw-selflink selflink\">Alternate Form: Dire Wolf</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Transformed into a Dire Wolf in all the ways that matter.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Alternate_Form:_Minotaur\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Alternate_Form:_Minotaur_(Condition)\" title=\"Alternate Form: Minotaur (Condition)\"><picture><source srcset=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/45px-Polymorphed_Condition_Icon.webp 1.5x, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/60px-Polymorphed_Condition_Icon.webp 2x\"><img alt=\"Alternate Form: Minotaur\" src=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Polymorphed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Alternate_Form:_Minotaur_(Condition)\" title=\"Alternate Form: Minotaur (Condition)\">Alternate Form: Minotaur</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Transformed into a Minotaur in all the ways that matter.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Alternate_Form:_Phase_Spider\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Alternate_Form:_Phase_Spider_(Condition)\" title=\"Alternate Form: Phase Spider (Condition)\"><picture><source srcset=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/45px-Polymorphed_Condition_Icon.webp 1.5x, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/60px-Polymorphed_Condition_Icon.webp 2x\"><img alt=\"Alternate Form: Phase Spider\" src=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Polymorphed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Alternate_Form:_Phase_Spider_(Condition)\" title=\"Alternate Form: Phase Spider (Condition)\">Alternate Form: Phase Spider</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Transformed into a Phase Spider in all the ways that matter.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Alternate_Form:_Shadow_Mastiff\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Alternate_Form:_Shadow_Mastiff_(Condition)\" title=\"Alternate Form: Shadow Mastiff (Condition)\"><picture><source srcset=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/45px-Polymorphed_Condition_Icon.webp 1.5x, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/60px-Polymorphed_Condition_Icon.webp 2x\"><img alt=\"Alternate Form: Shadow Mastiff\" src=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Polymorphed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Alternate_Form:_Shadow_Mastiff_(Condition)\" title=\"Alternate Form: Shadow Mastiff (Condition)\">Alternate Form: Shadow Mastiff</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Transformed into a Shadow Mastiff in all the ways that matter.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Big_Pig\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Big_Pig_(Condition)\" title=\"Big Pig (Condition)\"><picture><source srcset=\"/w/images/thumb/7/75/Big_Pig_Condition_Icon.webp/30px-Big_Pig_Condition_Icon.webp, /w/images/thumb/7/75/Big_Pig_Condition_Icon.webp/45px-Big_Pig_Condition_Icon.webp 1.5x, /w/images/thumb/7/75/Big_Pig_Condition_Icon.webp/60px-Big_Pig_Condition_Icon.webp 2x\"><img alt=\"Big Pig\" src=\"/w/images/thumb/7/75/Big_Pig_Condition_Icon.webp/30px-Big_Pig_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/75/Big_Pig_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Big_Pig_(Condition)\" title=\"Big Pig (Condition)\">Big Pig</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Pigs are smart and pigs are fun - that's why Dolly made you one!</li></ul>\n</td>\n\n</tr>\n<tr id=\"Cattle_Prattle\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Cattle_Prattle_(Condition)\" title=\"Cattle Prattle (Condition)\"><picture><source srcset=\"/w/images/thumb/a/a1/Cattle_Prattle_Condition_Icon.webp/30px-Cattle_Prattle_Condition_Icon.webp, /w/images/thumb/a/a1/Cattle_Prattle_Condition_Icon.webp/45px-Cattle_Prattle_Condition_Icon.webp 1.5x, /w/images/thumb/a/a1/Cattle_Prattle_Condition_Icon.webp/60px-Cattle_Prattle_Condition_Icon.webp 2x\"><img alt=\"Cattle Prattle\" src=\"/w/images/thumb/a/a1/Cattle_Prattle_Condition_Icon.webp/30px-Cattle_Prattle_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a1/Cattle_Prattle_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Cattle_Prattle_(Condition)\" title=\"Cattle Prattle (Condition)\">Cattle Prattle</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Want to converse like a cow? Dolly Thrice will show you how.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Polymorph\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Polymorph_(Condition)\" title=\"Polymorph (Condition)\"><picture><source srcset=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/45px-Polymorphed_Condition_Icon.webp 1.5x, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/60px-Polymorphed_Condition_Icon.webp 2x\"><img alt=\"Polymorph\" src=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Polymorphed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Polymorph_(Condition)\" title=\"Polymorph (Condition)\">Polymorph</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>You are now a particularly ripe wheel of cheese, unpleasant to the nostril.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Polymorph_Self\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Polymorph_Self_(Condition)\" title=\"Polymorph Self (Condition)\"><picture><source srcset=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/45px-Polymorphed_Condition_Icon.webp 1.5x, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/60px-Polymorphed_Condition_Icon.webp 2x\"><img alt=\"Polymorph Self\" src=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Polymorphed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Polymorph_Self_(Condition)\" title=\"Polymorph Self (Condition)\">Polymorph Self</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Transformed into a blue jay, able to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Fly_(class_action)\" title=\"Fly (class action)\"><picture><source srcset=\"/w/images/thumb/f/f3/Fly_Icon.webp/25px-Fly_Icon.webp, /w/images/thumb/f/f3/Fly_Icon.webp/38px-Fly_Icon.webp 1.5x, /w/images/thumb/f/f3/Fly_Icon.webp/50px-Fly_Icon.webp 2x\"><img alt=\"Fly\" src=\"/w/images/thumb/f/f3/Fly_Icon.webp/25px-Fly_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f3/Fly_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Fly_(class_action)\" title=\"Fly (class action)\">Fly</a> for 5 rounds.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Polymorphed\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Polymorphed_(Condition)\" title=\"Polymorphed (Condition)\"><picture><source srcset=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/45px-Polymorphed_Condition_Icon.webp 1.5x, /w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/60px-Polymorphed_Condition_Icon.webp 2x\"><img alt=\"Polymorphed\" src=\"/w/images/thumb/1/10/Polymorphed_Condition_Icon.webp/30px-Polymorphed_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Polymorphed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Polymorphed_(Condition)\" title=\"Polymorphed (Condition)\">Polymorphed</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Creature is turned into a harmless sheep with 3 <a href=\"/wiki/Hit_Points\" class=\"mw-redirect\" title=\"Hit Points\">Hit Points</a> for 5 turns.</li>\n<li>If the sheep's Hit Points are reduced to 0, the creature reverts to its original form with its original Hit Points.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Polymorphed\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Polymorphed_(Tressym)_(Condition)\" title=\"Polymorphed (Tressym) (Condition)\"><picture><source srcset=\"/w/images/thumb/5/58/Polymorphed_Tressym_Condition_Icon.webp/30px-Polymorphed_Tressym_Condition_Icon.webp, /w/images/thumb/5/58/Polymorphed_Tressym_Condition_Icon.webp/45px-Polymorphed_Tressym_Condition_Icon.webp 1.5x, /w/images/thumb/5/58/Polymorphed_Tressym_Condition_Icon.webp/60px-Polymorphed_Tressym_Condition_Icon.webp 2x\"><img alt=\"Polymorphed\" src=\"/w/images/thumb/5/58/Polymorphed_Tressym_Condition_Icon.webp/30px-Polymorphed_Tressym_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/58/Polymorphed_Tressym_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Polymorphed_(Tressym)_(Condition)\" title=\"Polymorphed (Tressym) (Condition)\">Polymorphed</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Changed into a beast.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Toad_Mode\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Toad_Mode_(Condition)\" title=\"Toad Mode (Condition)\"><picture><source srcset=\"/w/images/thumb/4/4c/Toad_Mode_Condition_Icon.webp/30px-Toad_Mode_Condition_Icon.webp, /w/images/thumb/4/4c/Toad_Mode_Condition_Icon.webp/45px-Toad_Mode_Condition_Icon.webp 1.5x, /w/images/thumb/4/4c/Toad_Mode_Condition_Icon.webp/60px-Toad_Mode_Condition_Icon.webp 2x\"><img alt=\"Toad Mode\" src=\"/w/images/thumb/4/4c/Toad_Mode_Condition_Icon.webp/30px-Toad_Mode_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/4c/Toad_Mode_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Toad_Mode_(Condition)\" title=\"Toad Mode (Condition)\">Toad Mode</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>If you do not want to think, Dolly Thrice will make you shrink.</li></ul>\n</td>\n\n</tr>\n</tbody></table>\n<!-- \nNewPP limit report\nCached time: 20260714212629\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.147 seconds\nReal time usage: 0.159 seconds\nPreprocessor visited node count: 4955/1000000\nPost‐expand include size: 72320/4194304 bytes\nTemplate argument size: 12618/4194304 bytes\nHighest expansion depth: 26/200\nExpensive parser function count: 0/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 0/5000000 bytes\nExtLoops count: 4/1000\nLua time usage: 0.080/7.000 seconds\nLua memory usage: 1579028/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%  127.614      1 Template:Condition_page\n100.00%  127.614      1 -total\n 30.24%   38.587      2 Template:Hidden_code\n 25.68%   32.766     17 Template:Icon_text\n 23.95%   30.564     15 Template:Icon_link\n 21.33%   27.218     44 Template:Trim\n 17.60%   22.465      2 Template:Condition_sources\n 14.92%   19.046     11 Template:Condition_inline/format\n 13.66%   17.433      1 Template:Creature\n 13.54%   17.285      4 Template:Template_style\n-->\n\n<!-- Saved in parser cache with key bg3wiki:pcache:idhash:44941-0!canonical and timestamp 20260714212629 and revision id 378739. Rendering was triggered because: page-view\n -->\n</div>"}