t=\"/w/images/thumb/b/ba/Handedness_Icon.png/25px-Handedness_Icon.png.webp, /w/images/thumb/b/ba/Handedness_Icon.png/38px-Handedness_Icon.png.webp 1.5x, /w/images/b/ba/Handedness_Icon.png 2x\"><img alt=\"Versatile\" src=\"/w/images/thumb/b/ba/Handedness_Icon.png/25px-Handedness_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/ba/Handedness_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Versatile\" title=\"Versatile\">Versatile</a></dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Dippable\" title=\"Dippable\"><picture><source srcset=\"/w/images/thumb/0/0a/Dippable_Icon.png/25px-Dippable_Icon.png.webp, /w/images/thumb/0/0a/Dippable_Icon.png/38px-Dippable_Icon.png.webp 1.5x, /w/images/0/0a/Dippable_Icon.png 2x\"><img alt=\"Dippable\" src=\"/w/images/thumb/0/0a/Dippable_Icon.png/25px-Dippable_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0a/Dippable_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dippable\" class=\"mw-redirect\" title=\"Dippable\">Dippable</a></dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/2a/Melee_Range_Icon.png/25px-Melee_Range_Icon.png.webp, /w/images/thumb/2/2a/Melee_Range_Icon.png/38px-Melee_Range_Icon.png.webp 1.5x, /w/images/2/2a/Melee_Range_Icon.png 2x\"><img alt=\"Melee: 1.5 m (5 ft)\" src=\"/w/images/thumb/2/2a/Melee_Range_Icon.png/25px-Melee_Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2a/Melee_Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Melee: 1.5 m (5 ft)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp, /w/images/thumb/e/ea/Weight_Icon.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 1.8 kg (3.6 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 1.8 kg (3.6 lb)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 640 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  640  gp</dd>\n<dd><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">MAG_TheChromatic_Staff</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:MAG_TheChromatic_Staff\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:MAG_TheChromatic_Staff\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">7e39ad11-f8c3-421a-940c-05348c420c7d</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:7e39ad11-f8c3-421a-940c-05348c420c7d\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:7e39ad11-f8c3-421a-940c-05348c420c7d\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>Stats</summary>\n<code class=\"bg3wiki-uid-box\">MAG_TheChromatic_Staff</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:MAG_TheChromatic_Staff+type:stat\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:MAG_TheChromatic_Staff+type:stat\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></dd></dl>\n</div> \n<h3><span class=\"mw-headline\" id=\"Special\"> Special </span></h3>\n<p><b>The holder of this item gains:</b>\n\n</p>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Kereska%27s_Favour\" title=\"Kereska's Favour\"><picture><source srcset=\"/w/images/thumb/1/15/Protection_from_Energy_Icon.webp/40px-Protection_from_Energy_Icon.webp, /w/images/thumb/1/15/Protection_from_Energy_Icon.webp/60px-Protection_from_Energy_Icon.webp 1.5x, /w/images/thumb/1/15/Protection_from_Energy_Icon.webp/80px-Protection_from_Energy_Icon.webp 2x\"><img alt=\"Kereska's Favour\" src=\"/w/images/thumb/1/15/Protection_from_Energy_Icon.webp/40px-Protection_from_Energy_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/15/Protection_from_Energy_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Kereska%27s_Favour\" title=\"Kereska's Favour\">Kereska's Favour</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Imbue yourself with elemental energy sourced from the draconic goddess, Kereska. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl>\n<dl><dt><a href=\"/wiki/Arcane_Enchantment_(%2B1)\" title=\"Arcane Enchantment (+1)\">Arcane Enchantment</a></dt><dd>You gain a +1 bonus to <a href=\"/wiki/Spell_Save_DC\" class=\"mw-redirect\" title=\"Spell Save DC\">Spell Save DC</a> and <a href=\"/wiki/Spell_Attack\" class=\"mw-redirect\" title=\"Spell Attack\">Spell Attack</a> rolls.</dd></dl><dl><dt><span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Arcane_Battery\" title=\"Arcane Battery\"><picture><source srcset=\"/w/images/thumb/a/ac/Arcane_Battery_Passive_Feature_Icon.webp/40px-Arcane_Battery_Passive_Feature_Icon.webp, /w/images/thumb/a/ac/Arcane_Battery_Passive_Feature_Icon.webp/60px-Arcane_Battery_Passive_Feature_Icon.webp 1.5x, /w/images/thumb/a/ac/Arcane_Battery_Passive_Feature_Icon.webp/80px-Arcane_Battery_Passive_Feature_Icon.webp 2x\"><img alt=\"Arcane Battery\" src=\"/w/images/thumb/a/ac/Arcane_Battery_Passive_Feature_Icon.webp/40px-Arcane_Battery_Passive_Feature_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/ac/Arcane_Battery_Passive_Feature_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Arcane_Battery\" title=\"Arcane Battery\">Arcane Battery</a></span></dt><dd>Alleviate the arcane burden of spellcasting with the power of this staff. The next spell you cast doesn't cost a <a href=\"/wiki/Spell_Slot\" class=\"mw-redirect\" title=\"Spell Slot\">spell slot</a>.</dd></dl>\n<h3><span class=\"mw-headline\" id=\"Weapon_actions\"> Weapon actions </span></h3>\n<p><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp, /w/images/2/2d/Proficiency_Icon.png 1.5x\"><img alt=\"Proficiency Icon.png\" src=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2d/Proficiency_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <i>If you have <a href=\"/wiki/Proficiency\" title=\"Proficiency\">proficiency</a>, equip in <strong>main hand</strong> to gain:</i>\n</p>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Topple\" title=\"Topple\"><picture><source srcset=\"/w/images/thumb/c/c8/Topple_Icon.webp/40px-Topple_Icon.webp, /w/images/thumb/c/c8/Topple_Icon.webp/60px-Topple_Icon.webp 1.5x, /w/images/thumb/c/c8/Topple_Icon.webp/80px-Topple_Icon.webp 2x\"><img alt=\"Topple\" src=\"/w/images/thumb/c/c8/Topple_Icon.webp/40px-Topple_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c8/Topple_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Topple\" title=\"Topple\">Topple</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Swipe at a creature to knock it <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Prone_(Condition)\" title=\"Prone (Condition)\"><picture><source srcset=\"/w/images/thumb/8/8e/Prone_Condition_Icon.webp/20px-Prone_Condition_Icon.webp, /w/images/thumb/8/8e/Prone_Condition_Icon.webp/30px-Prone_Condition_Icon.webp 1.5x, /w/images/thumb/8/8e/Prone_Condition_Icon.webp/40px-Prone_Condition_Icon.webp 2x\"><img alt=\"Prone\" src=\"/w/images/thumb/8/8e/Prone_Condition_Icon.webp/20px-Prone_Condition_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/8e/Prone_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Prone_(Condition)\" title=\"Prone (Condition)\">Prone</a>. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl></div> \n<h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li><a href=\"/wiki/Ramazith%27s_Tower\" title=\"Ramazith's Tower\">Ramazith's Tower</a> <span class=\"bg3wiki-coordinates\">X:&nbsp;4970&nbsp;Y:&nbsp;705</span>: in a <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Globe_of_Invulnerability\" title=\"Globe of Invulnerability\"><picture><source srcset=\"/w/images/thumb/7/7a/Globe_of_Invulnerability_Icon.webp/20px-Globe_of_Invulnerability_Icon.webp, /w/images/thumb/7/7a/Globe_of_Invulnerability_Icon.webp/30px-Globe_of_Invulnerability_Icon.webp 1.5x, /w/images/thumb/7/7a/Globe_of_Invulnerability_Icon.webp/40px-Globe_of_Invulnerability_Icon.webp 2x\"><img alt=\"Globe of Invulnerability\" src=\"/w/images/thumb/7/7a/Globe_of_Invulnerability_Icon.webp/20px-Globe_of_Invulnerability_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/7a/Globe_of_Invulnerability_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Globe_of_Invulnerability\" title=\"Globe of Invulnerability\">Globe of Invulnerability</a></li></ul>\n</div> \n<h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>A party member must use <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/See_Invisibility\" title=\"See Invisibility\"><picture><source srcset=\"/w/images/thumb/c/c3/See_Invisibility_Icon.webp/20px-See_Invisibility_Icon.webp, /w/images/thumb/c/c3/See_Invisibility_Icon.webp/30px-See_Invisibility_Icon.webp 1.5x, /w/images/thumb/c/c3/See_Invisibility_Icon.webp/40px-See_Invisibility_Icon.webp 2x\"><img alt=\"See Invisibility\" src=\"/w/images/thumb/c/c3/See_Invisibility_Icon.webp/20px-See_Invisibility_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c3/See_Invisibility_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/See_Invisibility\" title=\"See Invisibility\">See Invisibility</a> to see the lever and then pass a <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/1/13/D20.png/20px-D20.png.webp, /w/images/thumb/1/13/D20.png/30px-D20.png.webp 1.5x, /w/images/thumb/1/13/D20.png/40px-D20.png.webp 2x\"><img alt=\"DC&nbsp;20 Arcana Check\" src=\"/w/images/thumb/1/13/D20.png/20px-D20.png.webp\" decoding=\"async\" width=\"20\" height=\"22\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/1/13/D20.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> DC&nbsp;20 <a href=\"/wiki/Arcana\" title=\"Arcana\">Arcana</a> <a href=\"/wiki/Ability_check\" class=\"mw-redirect\" title=\"Ability check\">Check</a>, which disables the globe.</li>\n<li>Unequipping the staff after casting Kereska's Favour removes the spell. Re-equipping the staff does not restore the buff while Kereska's Favour is still on cooldown.</li></ul>\n\n</div> \n<h2><span class=\"mw-headline\" id=\"Bugs\"> Bugs </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n\n<p><i>Regarding Arcane Battery:</i></p>\n<ul><li>The <a href=\"/wiki/Resting#Long_rest\" title=\"Resting\">long rest</a> cooldown restriction on Arcane Battery is per <i>character</i>, rather than per <i>item</i>. As such, Arcane Battery can be used repeatedly by passing the weapon possessing this feature to different characters, activating it once on each.</li>\n<li>Arcane Battery is still consumed if active when the character casts a cantrip, despite cantrips not being highlighted in the character's cast bar.</li>\n<li>Toggling Arcane Battery highlights some abilities and items that do not consume spell slots, such as <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Danse_Macabre\" title=\"Danse Macabre\"><picture><source srcset=\"/w/images/thumb/9/92/Danse_Macabre_Icon.webp/20px-Danse_Macabre_Icon.webp, /w/images/thumb/9/92/Danse_Macabre_Icon.webp/30px-Danse_Macabre_Icon.webp 1.5x, /w/images/thumb/9/92/Danse_Macabre_Icon.webp/40px-Danse_Macabre_Icon.webp 2x\"><img alt=\"Danse Macabre\" src=\"/w/images/thumb/9/92/Danse_Macabre_Icon.webp/20px-Danse_Macabre_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/92/Danse_Macabre_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Danse_Macabre\" title=\"Danse Macabre\">Danse Macabre</a> and <a href=\"/wiki/Scrolls\" title=\"Scrolls\">spell scrolls</a>; these abilities and items activate properly, but are still consumed (along with Arcane Battery) in the process.</li></ul>\n</div>    \n<h2><span class=\"mw-headline\" id=\"Gallery\">Gallery</span></h2>\n<ul class=\"gallery mw-gallery-packed\">\n\t\t<li class=\"gallerybox\" style=\"width: 162px\">\n\t\t\t<div class=\"thumb\" style=\"width: 160px;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Daniil-shashenkov-forild-staff2-2.jpg\" class=\"mw-file-description\" title=\"Model and render by Daniil Shashenkov &quot;Forild&quot;\"><picture><source srcset=\"/w/images/thumb/6/65/Daniil-shashenkov-forild-staff2-2.jpg/240px-Daniil-shashenkov-forild-staff2-2.jpg.webp, /w/images/thumb/6/65/Daniil-shashenkov-forild-staff2-2.jpg/360px-Daniil-shashenkov-forild-staff2-2.jpg.webp 1.5x, /w/images/thumb/6/65/Daniil-shashenkov-forild-staff2-2.jpg/480px-Daniil-shashenkov-forild-staff2-2.jpg.webp 2x\"><img alt=\"Model and render by Daniil Shashenkov &quot;Forild&quot;\" src=\"/w/images/thumb/6/65/Daniil-shashenkov-forild-staff2-2.jpg/240px-Daniil-shashenkov-forild-staff2-2.jpg.webp\" decoding=\"async\" width=\"160\" height=\"200\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/65/Daniil-shashenkov-forild-staff2-2.jpg\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n\t\t\t<div class=\"gallerytext\">Model and render by Daniil Shashenkov \"Forild\"</div>\n\t\t</li>\n</ul>\n<!-- \nNewPP limit report\nCached time: 20260714195148\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.135 seconds\nReal time usage: 0.142 seconds\nPreprocessor visited node count: 5242/1000000\nPost‐expand include size: 78549/4194304 bytes\nTemplate argument size: 20208/4194304 bytes\nHighest expansion depth: 29/200\nExpensive parser function count: 0/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 1219/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.040/7.000 seconds\nLua memory usage: 1757570/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%  116.557      1 Template:WeaponPage\n100.00%  116.557      1 -total\n 27.06%   31.540     56 Template:Trim\n 26.41%   30.778     18 Template:Icon_text\n 14.61%   17.029      9 Template:Icon_link\n 11.81%   13.767      1 Template:SpellAction\n 11.21%   13.070      2 Template:Spell_action/format\n 10.37%   12.092      3 Template:Uid\n  8.46%    9.863     19 Template:Ifempty\n  8.07%    9.407      9 Template:Main_namespace_only\n-->\n\n<!-- Saved in parser cache with key bg3wiki:pcache:idhash:8052-0!canonical and timestamp 20260714195148 and revision id 394696. Rendering was triggered because: unknown\n -->\n</div>"}