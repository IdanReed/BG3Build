_Condition_Icon.webp/50px-Prone_Condition_Icon.webp 2x\"><img alt=\"Prone\" src=\"/w/images/thumb/8/8e/Prone_Condition_Icon.webp/25px-Prone_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/8e/Prone_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Prone_(Condition)\" title=\"Prone (Condition)\">Prone</a>. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Concussive_Smash\" title=\"Concussive Smash\"><picture><source srcset=\"/w/images/thumb/5/57/Concussive_Smash_Icon.webp/40px-Concussive_Smash_Icon.webp, /w/images/thumb/5/57/Concussive_Smash_Icon.webp/60px-Concussive_Smash_Icon.webp 1.5x, /w/images/thumb/5/57/Concussive_Smash_Icon.webp/80px-Concussive_Smash_Icon.webp 2x\"><img alt=\"Concussive Smash\" src=\"/w/images/thumb/5/57/Concussive_Smash_Icon.webp/40px-Concussive_Smash_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/57/Concussive_Smash_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Concussive_Smash\" title=\"Concussive Smash\">Concussive Smash</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Hit an enemy with all your might to deal damage and possibly <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Dazed_(Condition)\" title=\"Dazed (Condition)\"><picture><source srcset=\"/w/images/thumb/a/a2/Dazed_Condition_Icon.webp/25px-Dazed_Condition_Icon.webp, /w/images/thumb/a/a2/Dazed_Condition_Icon.webp/38px-Dazed_Condition_Icon.webp 1.5x, /w/images/thumb/a/a2/Dazed_Condition_Icon.webp/50px-Dazed_Condition_Icon.webp 2x\"><img alt=\"Daze\" src=\"/w/images/thumb/a/a2/Dazed_Condition_Icon.webp/25px-Dazed_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a2/Dazed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dazed_(Condition)\" title=\"Dazed (Condition)\">Daze</a> them. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.w