humb/e/e2/Water_A_Unfaded_Icon.png/30px-Water_A_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e2/Water_A_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Water\" title=\"Water\">Water</a></span></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/The_Water_Caller\" title=\"The Water Caller\"><picture><source srcset=\"/w/images/thumb/a/a9/Generic_Feature_Icon.webp/30px-Generic_Feature_Icon.webp, /w/images/thumb/a/a9/Generic_Feature_Icon.webp/45px-Generic_Feature_Icon.webp 1.5x, /w/images/thumb/a/a9/Generic_Feature_Icon.webp/60px-Generic_Feature_Icon.webp 2x\"><img alt=\"The Water Caller\" src=\"/w/images/thumb/a/a9/Generic_Feature_Icon.webp/30px-Generic_Feature_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a9/Generic_Feature_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/The_Water_Caller\" title=\"The Water Caller\">The Water Caller</a></li>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 5px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Create_Water\" title=\"Create Water\"><picture><source srcset=\"/w/images/thumb/d/d1/Create_Water_Icon.webp/30px-Create_Water_Icon.webp, /w/images/thumb/d/d1/Create_Water_Icon.webp/45px-Create_Water_Icon.webp 1.5x, /w/images/thumb/d/d1/Create_Water_Icon.webp/60px-Create_Water_Icon.webp 2x\"><img alt=\"Create Water\" src=\"/w/images/thumb/d/d1/Create_Water_Icon.webp/30px-Create_Water_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d1/Create_Water_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Create_Water\" title=\"Create Water\">Create Water</a></span></li>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 5px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Create_Water_(variant)\" title=\"Create Water (variant)\"><picture><source srcset=\"/w/images/thumb/d/d1/Create_Water_Icon.webp/30px-Create_Water_Icon.webp, /w/images/thumb/d/d1/Create_Water_Icon.webp/45px-Create_Water_Icon.webp 1.5x, /w/images/thumb/d/d1/Create_Water_Icon.webp/60px-Create_Water_Icon.webp 2x\"><img alt=\"Create Water (variant)\" src=\"/w/images/thumb/d/d1/Create_Water_Icon.webp/30px-Create_Water_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d1/Create_Water_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Create_Water_(variant)\" title=\"Create Water (variant)\">Create Water (variant)</a></span></li>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 5px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Incongruent_Splash\" title=\"Incongruent Splash\"><picture><source srcset=\"/w/images/thumb/c/cf/Burning_Hands_Icon.webp/30px-Burning_Hands_Icon.webp, /w/images/thumb/c/cf/Burning_Hands_Icon.webp/45px-Burning_Hands_Icon.webp 1.5x, /w/images/thumb/c/cf/Burning_Hands_Icon.webp/60px-Burning_Hands_Icon.webp 2x\"><img alt=\"Incongruent Splash\" src=\"/w/images/thumb/c/cf/Burning_Hands_Icon.webp/30px-Burning_Hands_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/cf/Burning_Hands_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Incongruent_Splash\" title=\"Incongruent Splash\">Incongruent Splash</a></span></li>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 5px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Minor_Conjuration:_Create_Water\" title=\"Minor Conjuration: Create Water\"><picture><source srcset=\"/w/images/thumb/d/d1/Create_Water_Icon.webp/30px-Create_Water_Icon.webp, /w/images/thumb/d/d1/Create_Water_Icon.webp/45px-Create_Water_Icon.webp 1.5x, /w/images/thumb/d/d1/Create_Water_Icon.webp/60px-Create_Water_Icon.webp 2x\"><img alt=\"Minor Conjuration: Create Water\" src=\"/w/images/thumb/d/d1/Create_Water_Icon.webp/30px-Create_Water_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d1/Create_Water_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Minor_Conjuration:_Create_Water\" title=\"Minor Conjuration: Create Water\">Minor Conjuration: Create Water</a></span></li>\n</ul></div>\n<h2><span class=\"mw-headline\" id=\"Conditions_with_the_same_stack_ID\"> Conditions with the same stack ID </span></h2>\nConditions with the <a href=\"/wiki/Stack_ID\" class=\"mw-redirect\" title=\"Stack ID\">stack ID</a> <code>WET</code>, only one of these can be applied at the same time:<table class=\"wikitable sortable\" style=\"width:100%;\">\n<tbody><tr>\n  <th>Condition</th>\n  <th>Effects</th>\n</tr>\n<tr id=\"Corrosive_Spit:_Dissolved\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Corrosive_Spit:_Dissolved_(Condition)\" title=\"Corrosive Spit: Dissolved (Condition)\"><picture><source srcset=\"/w/images/thumb/5/57/Generic_Acid_Condition_Icon.webp/30px-Generic_Acid_Condition_Icon.webp, /w/images/thumb/5/57/Generic_Acid_Condition_Icon.webp/45px-Generic_Acid_Condition_Icon.webp 1.5x, /w/images/thumb/5/57/Generic_Acid_Condition_Icon.webp/60px-Generic_Acid_Condition_Icon.webp 2x\"><img alt=\"Corrosive Spit: Dissolved\" src=\"/w/images/thumb/5/57/Generic_Acid_Condition_Icon.webp/30px-Generic_Acid_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/57/Generic_Acid_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Corrosive_Spit:_Dissolved_(Condition)\" title=\"Corrosive Spit: Dissolved (Condition)\">Corrosive Spit: Dissolved</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Affected entity's <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Armour_Class\" title=\"Armour Class\"><picture><source srcset=\"/w/images/thumb/a/ae/Armour_Class_Icon.png/25px-Armour_Class_Icon.png.webp, /w/images/thumb/a/ae/Armour_Class_Icon.png/38px-Armour_Class_Icon.png.webp 1.5x, /w/images/a/ae/Armour_Class_Icon.png 2x\"><img alt=\"Armour Class\" src=\"/w/images/thumb/a/ae/Armour_Class_Icon.png/25px-Armour_Class_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/ae/Armour_Class_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Armour_Class\" title=\"Armour Class\">Armour Class</a> has been reduced by 5. The spit can be removed with water.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Corrosive_Spit:_Dissolving\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Corrosive_Spit:_Dissolving_(Condition)\" title=\"Corrosive Spit: Dissolving (Condition)\"><picture><source srcset=\"/w/images/thumb/5/57/Generic_Acid_Condition_Icon.webp/30px-Generic_Acid_Condition_Icon.webp, /w/images/thumb/5/57/Generic_Acid_Condition_Icon.webp/45px-Generic_Acid_Condition_Icon.webp 1.5x, /w/images/thumb/5/57/Generic_Acid_Condition_Icon.webp/60px-Generic_Acid_Condition_Icon.webp 2x\"><img alt=\"Corrosive Spit: Dissolving\" src=\"/w/images/thumb/5/57/Generic_Acid_Condition_Icon.webp/30px-Generic_Acid_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/57/Generic_Acid_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Corrosive_Spit:_Dissolving_(Condition)\" title=\"Corrosive Spit: Dissolving (Condition)\">Corrosive Spit: Dissolving</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Takes <span class=\"bg3wiki-damage-type-acid\">1d10</span>⁠<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Acid\" title=\"Acid\"><picture><source srcset=\"/w/images/thumb/5/5f/Acid_Damage_Icon.png/20px-Acid_Damage_Icon.png.webp, /w/images/thumb/5/5f/Acid_Damage_Icon.png/30px-Acid_Damage_Icon.png.webp 1.5x, /w/images/thumb/5/5f/Acid_Damage_Icon.png/40px-Acid_Damage_Icon.png.webp 2x\"><img alt=\"Acid\" src=\"/w/images/thumb/5/5f/Acid_Damage_Icon.png/20px-Acid_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/5f/Acid_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Acid\" title=\"Acid\"><span class=\"bg3wiki-damage-type-acid\">Acid</span></a> damage per turn.</li>\n<li>Affected entity's <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Armour_Class\" title=\"Armour Class\"><picture><source srcset=\"/w/images/thumb/a/ae/Armour_Class_Icon.png/25px-Armour_Class_Icon.png.webp, /w/images/thumb/a/ae/Armour_Class_Icon.png/38px-Armour_Class_Icon.png.webp 1.5x, /w/images/a/ae/Armour_Class_Icon.png 2x\"><img alt=\"Armour Class\" src=\"/w/images/thumb/a/ae/Armour_Class_Icon.png/25px-Armour_Class_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/ae/Armour_Class_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Armour_Class\" title=\"Armour Class\">Armour Class</a> has been reduced by 1. The spit will keep eating away at its defences, further reducing its Armour Class, unless it is washed away with water.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Drenched\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Drenched_(Condition)\" title=\"Drenched (Condition)\"><picture><source srcset=\"/w/images/thumb/9/9d/Wet_Condition_Icon.webp/30px-Wet_Condition_Icon.webp, /w/images/thumb/9/9d/Wet_Condition_Icon.webp/45px-Wet_Condition_Icon.webp 1.5x, /w/images/thumb/9/9d/Wet_Condition_Icon.webp/60px-Wet_Condition_Icon.webp 2x\"><img alt=\"Drenched\" src=\"/w/images/thumb/9/9d/Wet_Condition_Icon.webp/30px-Wet_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/9d/Wet_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Drenched_(Condition)\" title=\"Drenched (Condition)\">Drenched</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Your melee attacks inflict <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Wet_(Condition)\" title=\"Wet (Conditi