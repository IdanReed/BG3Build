div>\n<table class=\"bg3wiki-attrblock-table\"><tbody><tr class=\"bg3wiki-attrblock-score-row\">\n\t\t<td>\n\t\t<p><a href=\"/wiki/Strength\" title=\"Strength\">STR</a></p>\n\t\t<div><b><span>6</span></b></div> <span>(-2)</span>\n</td>\n\n<td>\n\t\t<p><a href=\"/wiki/Dexterity\" title=\"Dexterity\">DEX</a></p>\n\t\t<div><b><span>17</span></b></div> <span>(+3)</span>\n</td>\n\n<td>\n\t\t<p><a href=\"/wiki/Constitution\" title=\"Constitution\">CON</a></p>\n\t\t<div><b><span>13</span></b></div> <span>(+1)</span>\n</td>\n\n\t\t<td>\n\t\t<p><a href=\"/wiki/Intelligence\" title=\"Intelligence\">INT</a></p>\n\t\t<div><b><span>11</span></b></div> \n</td>\n\n\t\t<td>\n\t\t<p><a href=\"/wiki/Wisdom\" title=\"Wisdom\">WIS</a></p>\n\t\t<div><b><span>12</span></b></div> <span>(+1)</span>\n</td>\n\n\t\t<td>\n\t\t<p><a href=\"/wiki/Charisma\" title=\"Charisma\">CHA</a></p>\n\t\t<div><b><span>14</span></b>\n<b></b></div><b> <span>(+2)</span></b>\n</td>\n\t</tr><tr><td colspan=\"100%\" class=\"bg3wiki-attrblock-divider\"><hr></td></tr><tr class=\"bg3wiki-attrblock-stat-row\">\n\t<td colspan=\"3\"><p><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><span><picture><source srcset=\"/w/images/thumb/2/25/HP_Icon.png/24px-HP_Icon.png.webp, /w/images/thumb/2/25/HP_Icon.png/36px-HP_Icon.png.webp 1.5x, /w/images/2/25/HP_Icon.png 2x\"><img src=\"/w/images/thumb/2/25/HP_Icon.png/24px-HP_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/25/HP_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Hit Points</p></td>\n\t<td colspan=\"3\"><p>10</p></td>\n</tr><tr class=\"bg3wiki-attrblock-stat-row\">\n\t<td colspan=\"3\"><p><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><span><picture><source srcset=\"/w/images/thumb/b/b0/Creature_AC_Icon.png/24px-Creature_AC_Icon.png.webp, /w/images/thumb/b/b0/Creature_AC_Icon.png/36px-Creature_AC_Icon.png.webp 1.5x, /w/images/b/b0/Creature_AC_Icon.png 2x\"><img src=\"/w/images/thumb/b/b0/Creature_AC_Icon.png/24px-Creature_AC_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/b/b0/Creature_AC_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Armour Class</p></td>\n\t<td colspan=\"3\"><p>13</p></td>\n</tr><tr class=\"bg3wiki-attrblock-stat-row\">\n\t<td colspan=\"3\"><p><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><span><picture><source srcset=\"/w/images/thumb/4/4b/Creature_Size_Icon.png/24px-Creature_Size_Icon.png.webp, /w/images/thumb/4/4b/Creature_Size_Icon.png/36px-Creature_Size_Icon.png.webp 1.5x, /w/images/4/4b/Creature_Size_Icon.png 2x\"><img src=\"/w/images/thumb/4/4b/Creature_Size_Icon.png/24px-Creature_Size_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/4/4b/Creature_Size_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Size</p></td>\n\t<td colspan=\"3\"><p>Small</p></td>\n</tr></tbody></table><div style=\"clear: both;\"></div>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Claws_(Imp)\" title=\"Claws (Imp)\"><picture><source srcset=\"/w/images/thumb/0/0e/Claws_Imp_Icon.webp/40px-Claws_Imp_Icon.webp, /w/images/thumb/0/0e/Claws_Imp_Icon.webp/60px-Claws_Imp_Icon.webp 1.5x, /w/images/thumb/0/0e/Claws_Imp_Icon.webp/80px-Claws_Imp_Icon.webp 2x\"><img alt=\"Claws\" src=\"/w/images/thumb/0/0e/Claws_Imp_Icon.webp/40px-Claws_Imp_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0e/Claws_Imp_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Claws_(Imp)\" title=\"Claws (