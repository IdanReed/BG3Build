px-Darkvision_Icon.webp 2x\"><img alt=\"Darkvision\" src=\"/w/images/thumb/0/0d/Darkvision_Icon.webp/25px-Darkvision_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0d/Darkvision_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Darkvision\" title=\"Darkvision\"><b>Darkvision</b></a></span></p></div><div class=\"bg3wiki-pi-creature-detail-text\"><p>Can see in the dark up to a certain distance.</p></div></div></li><li><div class=\"bg3wiki-pi-creature-detail\"><div class=\"bg3wiki-pi-creature-detail-title\"><p><span class=\"bg3wiki-icontext-block\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Opportunity_Attack\" title=\"Opportunity Attack\"><picture><source srcset=\"/w/images/thumb/3/35/Opportunity_Attack_Icon.webp/25px-Opportunity_Attack_Icon.webp, /w/images/thumb/3/35/Opportunity_Attack_Icon.webp/38px-Opportunity_Attack_Icon.webp 1.5x, /w/images/thumb/3/35/Opportunity_Attack_Icon.webp/50px-Opportunity_Attack_Icon.webp 2x\"><img alt=\"Opportunity Attack\" src=\"/w/images/thumb/3/35/Opportunity_Attack_Icon.webp/25px-Opportunity_Attack_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/35/Opportunity_Attack_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Opportunity_Attack\" title=\"Opportunity Attack\"><b>Opportunity Attack</b></a></span></p></div><div class=\"bg3wiki-pi-creature-detail-text\"><p>Attack an enemy moving out of reach.</p></div></div></li></ul></div>\n</div></section></section>\n\t\t\t</div>\n\t</div>\n</section><section class=\"pi-item pi-group pi-border-color pi-collapse pi-collapse-closed\"><h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Technical</h2><div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"uid\">\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"bg3wiki-tech-label\">UID</div></h3>\n\t<div class=\"pi-data-value pi-font\"><div class=\"bg3wiki-tech-data\"><code>S_SHA_Necromancer_NereZombie</code> <span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:S_SHA_Necromancer_NereZombie+type:localcharacter%2Cglobalcharacter%2Ccharactertemplate\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:S_SHA_Necromancer_NereZombie+type:localcharacter%2Cglobalcharacter%2Ccharactertemplate\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></div></div>\n</div><div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"uuid\">\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"bg3wiki-tech-label\">UUID</div></h3>\n\t<div class=\"pi-data-value pi-font\"><div class=\"bg3wiki-tech-data\"><code>7e0ee67a-d2a4-48d2-bca0-a9ae373f4f75</code> <span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:7e0ee67a-d2a4-48d2-bca0-a9ae373f4f75\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:7e0ee67a-d2a4-48d2-bca0-a9ae373f4f75\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></div></div>\n</div><div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"stats\">\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"bg3wiki-tech-label\">Stats</div></h3>\n\t<div class=\"pi-data-value pi-font\"><div class=\"bg3wiki-tech-data\"><code>SHA_Ghoul_Medic</code> <span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:SHA_Ghoul_Medic+type:statscharacter\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:SHA_Ghoul_Medic+type:statscharacter\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></div></div>\n</div></section></aside>\n<b>Nere (Zombie)</b> is a version of <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Nere\" title=\"Nere\"><picture><source srcset=\"/w/images/thumb/9/96/Portrait_Nere.png/25px-Portrait_Nere.png.webp, /w/images/thumb/9/96/Portrait_Nere.png/38px-Portrait_Nere.png.webp 1.5x, /w/images/thumb/9/96/Portrait_Nere.png/50px-Portrait_Nere.png.webp 2x\"><img alt=\"Nere\" src=\"/w/images/thumb/9/96/Portrait_Nere.png/25px-Portrait_Nere.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/96/Portrait_Nere.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Nere\" title=\"Nere\">Nere</a> who is killed by <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Balthazar\" title=\"Balthazar\"><picture><source srcset=\"/w/images/thumb/7/74/Portrait_Balthazar.png/25px-Portrait_Balthazar.png.webp, /w/images/thumb/7/74/Portrait_Balthazar.png/38px-Portrait_Balthazar.png.webp 1.5x, /w/images/thumb/7/74/Portrait_Balthazar.png/50px-Portrait_Balthazar.png.webp 2x\"><img alt=\"Balthazar\" src=\"/w/images/thumb/7/74/Portrait_Balthazar.png/25px-Portrait_Balthazar.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/74/Portrait_Balthazar.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Balthazar\" title=\"Balthazar\">Balthazar</a> and resurrected as zombie.\n\n<h2><span class=\"mw-headline\" id=\"Involvement\">Involvement</span></h2>\n<h2><span class=\"mw-headline\" id=\"Act_One\">Act One</span></h2>\n<p>If Nere is saved and he remains loyal to the <a href=\"/wiki/Absolute\" title=\"Absolute\">Absolute</a> in <a href=\"/wiki/Act_One\" title=\"Act One\">Act One</a> he is moved to this state in <a href=\"/wiki/Act_Two\" title=\"Act Two\">Act Two</a>. Nere (Zombie) is resurrected by <a href=\"/wiki/Balthazar\" title=\"Balthazar\">Balthazar</a> to serve the <a href=\"/wiki/Absolute\" title=\"Absolute\">Absolute</a> as a mindless <a href=\"/wiki/Zombie\" title=\"Zombie\">Zombie</a>. He is in the <a href=\"/wiki/Gauntlet_of_Shar\" title=\"Gauntlet of Shar\">Gauntlet of Shar</a>, and is being used by Balthazar for his experiments.\n</p>\n<h2><span class=\"mw-headline\" id=\"Attacks_and_actions\">Attacks and actions</span></h2>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\"><div class=\"bg3wiki-tooltip-box-image nomobile\"><figure class=\"mw-halign-right\" typeof=\"mw:File/Frameless\"><a href=\"/wiki/File:Generic_Physical.webp\" class=\"mw-file-description\"><picture><source srcset=\"/w/images/thumb/e/ed/Generic_Physical.webp/100px-Generic_Physical.webp, /w/images/thumb/e/ed/Generic_Physical.webp/150px-Generic_Physical.webp 1.5x, /w/images/thumb/e/ed/Generic_Physical.webp/200px-Generic_Physical.webp 2x\"><img src=\"/w/images/thumb/e/ed/Generic_Physical.webp/100px-Generic_Physical.webp\" decoding=\"async\" width=\"100\" height=\"100\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/ed/Generic_Physical.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a><figcaption></figcaption></figure></div>\n<div class=\"bg3wiki-tooltip-box-header\"><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Claws_(Ghoul)\" title=\"Claws (Ghoul)\"><picture><source srcset=\"/w/images/thu