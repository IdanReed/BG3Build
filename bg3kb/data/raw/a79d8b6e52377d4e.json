3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">MAG_Fire_FireDamage_Quarterstaff</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:MAG_Fire_FireDamage_Quarterstaff\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:MAG_Fire_FireDamage_Quarterstaff\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">8aaf86a8-c884-4368-bcc5-1f91fd210624</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:8aaf86a8-c884-4368-bcc5-1f91fd210624\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:8aaf86a8-c884-4368-bcc5-1f91fd210624\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>Stats</summary>\n<code class=\"bg3wiki-uid-box\">MAG_Fire_FireDamage_Quarterstaff</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:MAG_Fire_FireDamage_Quarterstaff+type:stat\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:MAG_Fire_FireDamage_Quarterstaff+type:stat\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></dd></dl>\n</div> \n<h3><span class=\"mw-headline\" id=\"Special\"> Special </span></h3>\n<p><b>The holder of this item gains:</b>\n\n</p>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Fire_Bolt\" title=\"Fire Bolt\"><picture><source srcset=\"/w/images/thumb/2/23/Fire_Bolt_Icon.webp/40px-Fire_Bolt_Icon.webp, /w/images/thumb/2/23/Fire_Bolt_Icon.webp/60px-Fire_Bolt_Icon.webp 1.5x, /w/images/thumb/2/23/Fire_Bolt_Icon.webp/80px-Fire_Bolt_Icon.webp 2x\"><img alt=\"Fire Bolt\" src=\"/w/images/thumb/2/23/Fire_Bolt_Icon.webp/40px-Fire_Bolt_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/23/Fire_Bolt_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Fire_Bolt\" title=\"Fire Bolt\">Fire Bolt</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Cast as a cantrip at will.</dd>\n</dl>\n<h3><span class=\"mw-headline\" id=\"Weapon_actions\"> Weapon actions </span></h3>\n<p><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp, /w/images/2/2d/Proficiency_Icon.png 1.5x\"><img alt=\"Proficiency Icon.png\" src=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2d/Proficiency_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <i>If you have <a href=\"/wiki/Proficiency\" title=\"Proficiency\">proficiency</a>, equip in <strong>main hand</strong> to gain:</i>\n</p>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Topple\" title=\"Topple\"><picture><source srcset=\"/w/images/thumb/c/c8/Topple_Icon.webp/40px-Topple_Icon.webp, /w/images/thumb/c/c8/Topple_Icon.webp/60px-Topple_Icon.webp 1.5x, /w/images/thumb/c/c8/Topple_Icon.webp/80px-Topple_Icon.webp 2x\"><img alt=\"Topple\" src=\"/w/images/thumb/c/c8/Topple_Icon.webp/40px-Topple_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c8/Topple_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Topple\" title=\"Topple\">Topple</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Swipe at a creature to knock it <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Prone_(Condition)\" title=\"Prone (Condition)\"><picture><source srcset=\"/w/images/thumb/8/8e/Prone_Condition_Icon.webp/20px-Prone_Condition_Icon.webp, /w/images/thumb/8/8e/Prone_Condition_Icon.webp/30px-Prone_Condition_Icon.webp 1.5x, /w/images/thumb/8/8e/Prone_Condition_Icon.webp/40px-Prone_Condition_Icon.webp 2x\"><img alt=\"Prone\" src=\"/w/images/thumb/8/8e/Prone_Condition_Icon.webp/20px-Prone_Condition_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/8e/Prone_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Prone_(Condition)\" title=\"Prone (Condition)\">Prone</a>. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl></div> \n<h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li><a href=\"/wiki/Shattered_Sanctum\" title=\"Shattered Sanctum\">Shattered Sanctum</a> <span class=\"bg3wiki-coordinates\">X:&nbsp;272&nbsp;Y:&nbsp;-31</span>: Sold by <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Roah_Moonglow\" title=\"Roah Moonglow\"><picture><source srcset=\"/w/images/thumb/e/e7/Portrait_Roah_Moonglow.png/25px-Portrait_Roah_Moonglow.png.webp, /w/images/thumb/e/e7/Portrait_Roah_Moonglow.png/38px-Portrait_Roah_Moonglow.png.webp 1.5x, /w/images/thumb/e/e7/Portrait_Roah_Moonglow.png/50px-Portrait_Roah_Moonglow.png.webp 2x\"><img alt=\"Roah Moonglow\" src=\"/w/images/thumb/e/e7/Portrait_Roah_Moonglow.png/25px-Portrait_Roah_Moonglow.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e7/Portrait_Roah_Moonglow.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Roah_Moonglow\" title=\"Roah Moonglow\">Roah Moonglow</a>, to the left beyond the sanctum entrance</li>\n<li><a href=\"/wiki/Sorcerous_Sundries\" title=\"Sorcerous Sundries\">Sorcerous Sundries</a> <span class=\"bg3wiki-coordinates\">X:&nbsp;-2&nbsp;Y:&nbsp;-66</span>: On a pedestal beneath the stained glass window behind the lava and water elementals on the ground floor</li></ul>\n</div> \n<h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>Despite being dippable, dipping this staff in surfaces such as fire or poison does not actually apply a damage buff to the weapon. Similarly, <a href=\"/wiki/Coatings\" title=\"Coatings\">coatings</a> also have no effect.</li></ul>\n</div>     \n<h2><span class=\"mw-headline\" id=\"Gallery\">Gallery</span></h2>\n<ul class=\"gallery mw-gallery-packed\">\n\t\t<li class=\"gallerybox\" style=\"width: 302px\">\n\t\t\t<div class=\"thumb\" style=\"width: 300px;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Gold_Wyrmling_Staff_ingame.pn