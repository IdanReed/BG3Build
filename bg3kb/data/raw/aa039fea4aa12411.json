x-Medium_Armour_Icon.png.webp 2x\"><img alt=\"Medium Armour\" src=\"/w/images/thumb/7/73/Medium_Armour_Icon.png/25px-Medium_Armour_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/73/Medium_Armour_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Medium_Armour\" class=\"mw-redirect\" title=\"Medium Armour\">Medium Armour</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ef/Rarity_Icon.png/25px-Rarity_Icon.png.webp, /w/images/thumb/e/ef/Rarity_Icon.png/38px-Rarity_Icon.png.webp 1.5x, /w/images/e/ef/Rarity_Icon.png 2x\"><img alt=\"Rarity: Common\" src=\"/w/images/thumb/e/ef/Rarity_Icon.png/25px-Rarity_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ef/Rarity_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Rarity: Common</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp, /w/images/thumb/e/ea/Weight_Icon.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 1 kg (2 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 1 kg (2 lb)</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 40 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  40  gp</li>\n<li><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">UNI_HAG_SwampedHero_OldFancyHelmet</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:UNI_HAG_SwampedHero_OldFancyHelmet\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:UNI_HAG_SwampedHero_OldFancyHelmet\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">910ed403-38b3-4128-b07b-0de5d14da8f8</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:910ed403-38b3-4128-b07b-0de5d14da8f8\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:910ed403-38b3-4128-b07b-0de5d14da8f8\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div> \n<h3><span class=\"mw-headline\" id=\"Special\">Special</span></h3>\n<p>The wearer of this item gains:\n\n</p>\n<ul><li><a href=\"/wiki/Constitution\" title=\"Constitution\">Constitution</a> <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp, /w/images/e/e7/Saving_Throw_Icon.png 1.5x\"><img alt=\"Saving Throw\" src=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/e7/Saving_Throw_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Saving_Throw\" class=\"mw-redirect\" title=\"Saving Throw\">Saving Throws</a> +1</li></ul>\n<div style=\"clear: both;\"></div></div>    \n<h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>In the swamp north of <a href=\"/wiki/Riverside_Teahouse\" class=\"mw-redirect\" title=\"Riverside Teahouse\">Riverside Teahouse</a>, <a href=\"/wiki/Sunlit_Wetlands\" title=\"Sunlit Wetlands\">Sunlit Wetlands</a> at <span class=\"bg3wiki-coordinates\">X:&nbsp;-4&nbsp;Y:&nbsp;277</span></li></ul>\n</div> \n<h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>This helmet can be found next to the <a href=\"/wiki/Reinforced_Greatsword\" title=\"Reinforced Greatsword\">Reinforced Greatsword</a>.</li>\n<li>Upon a successful perception roll, if <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Karlach\" title=\"Karlach\"><picture><source srcset=\"/w/images/thumb/b/b2/Portrait_Karlach.png/25px-Portrait_Karlach.png.webp, /w/images/thumb/b/b2/Portrait_Karlach.png/38px-Portrait_Karlach.png.webp 1.5x, /w/images/thumb/b/b2/Portrait_Karlach.png/50px-Portrait_Karlach.png.webp 2x\"><img alt=\"Karlach\" src=\"/w/images/thumb/b/b2/Portrait_Karlach.png/25px-Portrait_Karlach.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b2/Portrait_Karlach.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Karlach\" title=\"Karlach\">Karlach</a> is in the party, she will say. \"Nice sword. Jaunty hat. Karlach like.\"</li></ul>\n</div>  \n<!-- \nNewPP limit report\nCached time: 20260714214816\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.059 seconds\nReal time usage: 0.061 seconds\nPreprocessor visited node count: 1909/1000000\nPost‐expand include size: 21318/4194304 bytes\nTemplate argument size: 5011/4194304 bytes\nHighest expansion depth: 21/200\nExpensive parser function count: 1/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 2/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.013/7.000 seconds\nLua memory usage: 1160923/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%   50.263      1 Template:EquipmentPage\n100.00%   50.263      1 -total\n 33.39%   16.785      7 Template:Icon_text\n 28.78%   14.467     18 Template:Trim\n 23.70%   11.913      3 Template:Icon_link\n 21.56%   10.838      2 Template:WeaponType\n 19.58%    9.841      2 Template:Uid\n 18.96%    9.529      8 Template:Ifempty\n 12.27%    6.169      4 Template:Main_namespace_only\n 10.72%    5.388      2 Template:Template_style\n-->\n\n<!-- Saved in parser cache with ke