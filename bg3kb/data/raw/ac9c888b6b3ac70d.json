x-Melee_Range_Icon.png.webp, /w/images/thumb/2/2a/Melee_Range_Icon.png/38px-Melee_Range_Icon.png.webp 1.5x, /w/images/2/2a/Melee_Range_Icon.png 2x\"><img alt=\"Melee: 1.5 m (5 ft)\" src=\"/w/images/thumb/2/2a/Melee_Range_Icon.png/25px-Melee_Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2a/Melee_Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Melee: 1.5 m (5 ft)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp, /w/images/thumb/e/ea/Weight_Icon.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 0.9 kg (1.8 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 0.9 kg (1.8 lb)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 280 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  280  gp</dd>\n<dd><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">WPN_GOB_PainPriest_Handaxe</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:WPN_GOB_PainPriest_Handaxe\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:WPN_GOB_PainPriest_Handaxe\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">5c996c03-99e9-40c1-8acf-d761550d26f5</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:5c996c03-99e9-40c1-8acf-d761550d26f5\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:5c996c03-99e9-40c1-8acf-d761550d26f5\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>Stats</summary>\n<code class=\"bg3wiki-uid-box\">GOB_PainPriest_Handaxe</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:GOB_PainPriest_Handaxe+type:stat\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:GOB_PainPriest_Handaxe+type:stat\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></dd></dl>\n</div> \n<h3><span class=\"mw-headline\" id=\"Special\"> Special </span></h3>\n<p><b>The holder of this item gains:</b>\n\n</p>\n<dl><dt><a href=\"/wiki/The_Scourge_Mistress%27_Bane\" title=\"The Scourge Mistress' Bane\">The Scourge Mistress' Bane</a></dt><dd>Chance to inflict upon the target a 1d4 penalty to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp, /w/images/thumb/b/ba/Attack_Roll_Icon.png/38px-Attack_Roll_Icon.png.webp 1.5x, /w/images/thumb/b/ba/Attack_Roll_Icon.png/50px-Attack_Roll_Icon.png.webp 2x\"><img alt=\"Attack Roll\" src=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/b/ba/Attack_Roll_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Attack_Roll\" class=\"mw-redirect\" title=\"Attack Roll\">Attack Rolls</a> and <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp, /w/images/e/e7/Saving_Throw_Icon.png 1.5x\"><img alt=\"Saving Throw\" src=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/e7/Saving_Throw_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Saving_Throw\" class=\"mw-redirect\" title=\"Saving Throw\">Saving Throws</a>. If the attacker still has 50% or more <a href=\"/wiki/Hit_Points\" class=\"mw-redirect\" title=\"Hit Points\">hit points</a>, they take <span class=\"bg3wiki-damage-type-piercing\">1d6</span>⁠<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Piercing\" title=\"Piercing\"><picture><source srcset=\"/w/images/thumb/0/0b/Piercing_Damage_Icon.png/20px-Piercing_Damage_Icon.png.webp, /w/images/thumb/0/0b/Piercing_Damage_Icon.png/30px-Piercing_Damage_Icon.png.webp 1.5x, /w/images/thumb/0/0b/Piercing_Damage_Icon.png/40px-Piercing_Damage_Icon.png.webp 2x\"><img alt=\"Piercing\" src=\"/w/images/thumb/0/0b/Piercing_Damage_Icon.png/20px-Piercing_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0b/Piercing_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Piercing\" title=\"Piercing\"><span class=\"bg3wiki-damage-type-piercing\">Piercing</span></a> themselves.</dd></dl>\n<h3><span class=\"mw-headline\" id=\"Weapon_actions\"> Weapon actions </span></h3>\n<p><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp, /w/images/2/2d/Proficiency_Icon.png 1.5x\"><img alt=\"Proficiency Icon.png\" src=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2d/Proficiency_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <i>If you have <a href=\"/wiki/Proficiency\" title=\"Proficiency\">proficiency</a>, equip in <strong>main hand</strong> to gain:</i>\n</p>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lacerate\" title=\"Lacerate\"><picture><source srcset=\"/w/images/thumb/a/af/Lacerate_Icon.webp/40px-Lacerate_Icon.webp, /w/images/thumb/a/af/Lacerate_Icon.webp/60px-Lacerate_Icon.webp 1.5x, /w/images/thumb/a/af/Lacerate_Icon.webp/80px-Lacerate_Icon.webp 2x\"><img alt=\"Lacerate\" src=\"/w/images/thumb/a/af/Lacerate_Icon.webp/40px-Lacerate_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/af/Lacerate_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Lacerate\" title=\"Lacerate\">Lacerate</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Slash at your target's vital points to make it <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Bleeding_(Condition)\" title=\"Bleeding (Condition)\"><picture><source srcset=\"/w/images/thumb/2/25/Bleeding_Condition_Icon.webp/20px-Bleeding_Condition_Icon.webp, /w/images/thumb/2/25/Bleeding_Condition_Icon.webp/30px-Bleeding_Condition_Icon.webp 1.5x, /w/images/thumb/2/25/Bleeding_Condition_Icon.webp/40px-Bleeding_Condition_Icon.webp 2x\"><img alt=\"Bleed\" src=\"/w/images/thumb/2/25/Bleeding_Condition_Icon.webp/20px-Bleeding_Condition_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/25/Bleeding_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Bleeding_(Condition)\" title=\"Bleeding (Condition)\">Bleed</a>. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl></div> \n<h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li><a href=\"/wiki/Shattered_Sanctum\" title=\"Shattered Sanctum\">Shattered Sanctum</a> <span class=\"bg3wiki-coordinates\">X:&nbsp;338&nbsp;Y:&nbsp;-26</span>: on the table next to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Abdirak\" title=\"Abdirak\"><picture><source srcset=\"/w/images/thumb/1/10/Portrait_Abdirak.png/25px-Portrait_Abdirak.png.webp, /w/images/thumb/1/10/Portrait_Abdirak.png/38px-Portrait_Abdirak.png.webp 1.5x, /w/images/thumb/1/10/Portrait_Abdirak.png/50px-Portrait_Abdirak.png.webp 2x\"><img alt=\"Abdirak\" src=\"/w/images/thumb/1/10/Portrait_Abdirak.png/25px-Portrait_Abdirak.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Portrait_Abdirak.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Abdirak\" title=\"Abdirak\">Abdirak</a></li></ul>\n</div> \n<h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n\n<p><i>Regarding The Scourge Mistress' Bane:</i></p>\n<ul><li>The <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Bane_(Condition)\" title=\"Bane (Condition)\"><picture><source srcset=\"/w/images/thumb/2/2f/Bane_Condition_Icon.webp/20px-Bane_Condition_Icon.webp, /w/images/thumb/2/2f/Bane_Condition_Icon.webp/30px-Bane_Condition_Icon.webp 1.5x, /w/images/thumb/2/2f/Bane_Condition_Icon.webp/40px-Bane_Condition_Icon.webp 2x\"><img alt=\"Bane\" src=\"/w/images/thumb/2/2f/Bane_Condition_Icon.webp/20px-Bane_Condition_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/2f/Bane_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Bane_(Condition)\" title=\"Bane (Condition)\">Bane</a> condition applied by this weapon is the same as the <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Bane_(spell)\" title=\"Bane (spell)\"><picture><source srcset=\"/w/images/thumb/1/19/Bane_spell_Icon.webp/20px-Bane_spell_Icon.webp, /w/images/thumb/1/19/Bane_spell_Icon.webp/30px-Bane_spell_Icon.webp 1.5x, /w/images/thumb/1/19/Bane_spell_Icon.webp/40px-Bane_spell_Icon.webp 2x\"><img alt=\"Bane\" src=\"/w/images/thumb/1/19/Bane_spell_Icon.webp/20px-Bane_spell_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/19/Bane_spell_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Bane_(spell)\" title=\"Bane (spell)\">Bane</a> <span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Concentration\" title=\"Concentration\"><picture><source srcset=\"/w/images/thumb/8/83/Concentration_Icon.png/16px-Concentration_Icon.png.webp, /w/images/thumb/8/83/Concentration_Icon.png/24px-Concentration_Icon.png.webp 1.5x, /w/images/thumb/8/83/Concentration_Icon.png/32px-Concentration_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/8/83/Concentration_Icon.png/16px-Concentration_Icon.png.webp\" decoding=\"async\" width=\"16\" height=\"16\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/83/Concentration_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> spell and does not stack.</li>\n<li>Because of the bug listed below, the Battle Master Fighter's <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Sweeping_Attack\" title=\"Sweeping Attack\"><picture><source srcset=\"/w/images/thumb/d/d5/Sweeping_Attack_Icon.webp/20px-Sweeping_Attack_Icon.webp, /w/images/thumb/d/d5/Sweeping_Attack_Icon.webp/30px-Sweeping_Attack_Icon.webp 1.5x, /w/images/thumb/d/d5/Sweeping_Attack_Icon.webp/40px-Sweeping_Attack_Icon.webp 2x\"><img alt=\"Sweeping Attack\" src=\"/w/images/thumb/d/d5/Sweeping_Attack_Icon.webp/20px-Sweeping_Attack_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d5/Sweeping_Attack_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Sweeping_Attack\" title=\"Sweeping Attack\">Sweeping Attack</a> applies this debuff to every target within the cone's area of effect, hit or miss.</li>\n<li>Many situations increase the self-damage dealt by this passive feature:\n<ul><li>The <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Savage_Attacker\" title=\"Savage Attacker\"><picture><source srcset=\"/w/images/thumb/2/24/Savage_Attacker_Icon.webp/20px-Savage_Attacker_Icon.webp, /w/images/thumb/2/24/Savage_Attacker_Icon.webp/30px-Savage_Attacker_Icon.webp 1.5x, /w/images/thumb/2/24/Savage_Attacker_Icon.webp/40px-Savage_Attacker_Icon.webp 2x\"><img alt=\"Savage Attacker\" src=\"/w/images/thumb/2/24/Savage_Attacker_Icon.webp/20px-Savage_Attacker_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/24/Savage_Attacker_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Savage_Attacker\" title=\"Savage Attacker\">Savage Attacker</a> feat results in secondary damage being re-rolled higher.</li>\n<li>A critical hit with this axe doubles the self-damage.</li>\n<li>Some damage riders such as <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lightning_Charges_(Condition)\" title=\"Lightning Charges (Condition)\"><picture><source srcset=\"/w/images/thumb/4/47/Lightning_Charges_Condition_Icon.webp/20px-Lightning_Charges_Condition_Icon.webp, /w/images/thumb/4/47/Lightning_Charges_Condition_Icon.webp/30px-Lightning_Charges_Condition_Icon.webp 1.5x, /w/images/thumb/4/47/Lightning_Charges_Condition_Icon.webp/40px-Lightning_Charges_Condition_Icon.webp 2x\"><img alt=\"Lightning Charges\" src=\"/w/images/thumb/4/47/Lightning_Charges_Condition_Icon.webp/20px-Lightning_Charges_Condition_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/47/Lightning_Charges_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Lightning_Charges_(Condition)\" title=\"Lightning Charges (Condition)\">Lightning Charges</a>, radiant damage from the <span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-uncommon\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Callous_Glow_Ring\" title=\"Callous Glow Ring\"><picture><source srcset=\"/w/images/thumb/5/51/Ring_E_Gold_A_1_Unfaded_Icon.png/20px-Ring_E_Gold_A_1_Unfaded_Icon.png.webp, /w/images/thumb/5/51/Ring_E_Gold_A_1_Unfaded_Icon.png/30px-Ring_E_Gold_A_1_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/5/51/Ring_E_Gold_A_1_Unfaded_Icon.png/40px-Ring_E_Gold_A_1_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/5/51/Ring_E_Gold_A_1_Unfaded_Icon.png/20px-Ring_E_Gold_A_1_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/51/Ring_E_Gold_A_1_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> <a href=\"/wiki/Callous_Glow_Ring\" title=\"Callous Glow Ring\">Callous Glow Ring</a> and <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Psionic_Overload\" title=\"Psionic Overload\"><picture><source srcset=\"/w/images/thumb/a/af/Psionic_Overload_Icon.webp/20px-Psionic_Overload_Icon.webp, /w/images/thumb/a/af/Psionic_Overload_Icon.webp/30px-Psionic_Overload_Icon.webp 1.5x, /w/images/thumb/a/af/Psionic_Overload_Icon.webp/40px-Psionic_Overload_Icon.webp 2x\"><img alt=\"Psionic Overload\" src=\"/w/images/thumb/a/af/Psionic_Overload_Icon.webp/20px-Psionic_Overload_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/af/Psionic_Overload_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Psionic_Overload\" title=\"Psionic Overload\">Psionic Overload</a> increase the self-damage.</li></ul></li>\n<li>Effects which reduce incoming piercing damage reduce the self-inflicted damage.\n<ul><li>However, as the self-damage is classified as magical, <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Heavy_Armour_Master\" title=\"Heavy Armour Master\"><picture><source srcset=\"/w/images/thumb/8/8d/Heavy_Armour_Master_Icon.webp/20px-Heavy_Armour_Master_Icon.webp, /w/images/thumb/8/8d/Heavy_Armour_Master_Icon.webp/30px-Heavy_Armour_Master_Icon.webp 1.5x, /w/images/thumb/8/8d/Heavy_Armour_Master_Icon.webp/40px-Heavy_Armour_Master_Icon.webp 2x\"><img alt=\"Heavy Armour Master\" src=\"/w/images/thumb/8/8d/Heavy_Armour_Master_Icon.webp/20px-Heavy_Armour_Master_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/8d/Heavy_Armour_Master_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Heavy_Armour_Master\" title=\"Heavy Armour Master\">Heavy Armour Master</a> damage reduction does not apply.</li></ul></li>\n<li>If at 50% health or higher, the wielder suffers self-damage even if the target dies from the axe blow.</li></ul>\n</div> \n<h2><span class=\"mw-headline\" id=\"Bugs\"> Bugs </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n\n<p><i>Regarding The Scourge Mistress' Bane:</i></p>\n<ul><li>While the item description says 'chance,' <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Bane_(spell)\" title=\"Bane (spell)\"><picture><source srcset=\"/w/images/thumb/1/19/Bane_spell_Icon.webp/25px-Bane_spell_Icon.webp, /w/images/thumb/1/19/Bane_spell_Icon.webp/38px-Bane_spell_Icon.webp 1.5x, /w/images/thumb/1/19/Bane_spell_Icon.webp/50px-Bane_spell_Icon.webp 2x\"><img alt=\"Bane\" src=\"/w/images/thumb/1/19/Bane_spell_Icon.webp/25px-Bane_spell_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/19/Bane_spell_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Bane_(spell)\" title=\"Bane (spell)\">Bane</a> is always inflicted on a hit.</li>\n<li>If the wielder of this axe is at 50% health or higher and they use <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Non-Lethal_Damage_(Condition)\" title=\"Non-Lethal Damage (Condition)\"><picture><source srcset=\"/w/images/thumb/3/3e/Non-Lethal_Damage_Condition_Icon.webp/20px-Non-Lethal_Damage_Condition_Icon.webp, /w/images/thumb/3/3e/Non-Lethal_Damage_Condition_Icon.webp/30px-Non-Lethal_Damage_Condition_Icon.webp 1.5x, /w/images/thumb/3/3e/Non-Lethal_Damage_Condition_Icon.webp/40px-Non-Lethal_Damage_Condition_Icon.webp 2x\"><img alt=\"Non-Lethal Damage\" src=\"/w/images/thumb/3/3e/Non-Lethal_Damage_Condition_Icon.webp/20px-Non-Lethal_Damage_Condition_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/3e/Non-Lethal_Damage_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Non-Lethal_Damage_(Condition)\" title=\"Non-Lethal Damage (Condition)\">Non-Lethal Damage</a> to knock out an enemy with it, they will also be knocked out, even if at full HP.</li></ul>\n</div>    \n<!-- \nNewPP limit report\nCached time: 20260714201736\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.128 seconds\nReal time usage: 0.135 seconds\nPreprocessor visited node count: 4466/1000000\nPost‐expand include size: 84632/4194304 bytes\nTemplate argument size: 17874/4194304 bytes\nHighest expansion depth: 28/200\nExpensive parser function count: 2/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 4/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.040/7.000 seconds\nLua memory usage: 1704707/52428800 bytes\n-->\n<