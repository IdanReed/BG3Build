c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"￼START_WIDGET&quot;'-78c4ada8518e3cc5END_WIDGET ￼START_WIDGET&quot;'-bc4d0bdae7bc6420END_WIDGET\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">BOOK_GEN_Races_HalflingRhymes1</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:BOOK_GEN_Races_HalflingRhymes1\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:BOOK_GEN_Races_HalflingRhymes1\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">59a92135-4427-4fcd-99bc-c60e705626fa</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:59a92135-4427-4fcd-99bc-c60e705626fa\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:59a92135-4427-4fcd-99bc-c60e705626fa\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div>   \n<div style=\"clear: both;\"></div></div>\n    <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>In <a href=\"/wiki/The_Hollow\" title=\"The Hollow\">The Hollow</a> at <span class=\"bg3wiki-coordinates\">X:&nbsp;181&nbsp;Y:&nbsp;538</span></li></ul>\n</div>  <h2><span class=\"mw-headline\" id=\"Text\"> Text </span></h2>\n<div class=\"bg3wiki-book-text\">\n<p>One foot, two feet\n</p><p>Well met! We'll meet\n</p><p>Two drakes, one mink\n</p><p>One draught, two drinks.\n</p><p><br>\n</p><p>One bear, three beers\n</p><p>Come join! Drink here.\n</p><p>One foot, two feet\n</p><p>Well met! We'll meet.\n</p><p><br>\n</p><p>---\n</p><p><br>\n</p><p><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Yondalla\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/images/thumb/6/68/FRWiki_Icon.png/44px-FRWiki_Icon.png.webp 2x\"><img alt=\"Yondalla\" src=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/FRWiki_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <span class=\"bg3wiki-icontext-extlink\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Yondalla\">Yondalla</a></span> and <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Garl_Glittergold\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/images/thumb/6/68/FRWiki_Icon.png/44px-FRWiki_Icon.png.webp 2x\"><img alt=\"Garl\" src=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/FRWiki_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <span class=\"bg3wiki-icontext-extlink\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Garl_Glittergold\">Garl</a></span>\n</p><p>Shared twixt them a farl\n</p><p>All covered in butter\n</p><p>And they liked each other.\n</p><p><br>\n</p><p>Along came a fly\n</p><p>Who flew in with a cry\n</p><p>to the buttery farl\n</p><p>of <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Yondalla\" title=\"Yondalla\"><picture><source srcset=\"/w/images/thumb/a/a9/Yondalla_Icon.webp/16px-Yondalla_Icon.webp, /w/images/thumb/a/a9/Yondalla_Icon.webp/25px-Yondalla_Icon.webp 1.5x, /w/images/thumb/a/a9/Yondalla_Icon.webp/33px-Yondalla_Icon.webp 2x\"><img alt=\"Yondalla\" src=\"/w/images/thumb/a/a9/Yondalla_Icon.webp/16px-Yondalla_Icon.webp\" decoding=\"async\" width=\"16\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a9/Yondalla_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Yondalla\" class=\"mw-redirect\" title=\"Yondalla\">Yondalla</a> and <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Garl_Glittergold\" title=\"Garl Glittergold\"><picture><source srcset=\"/w/images/thumb/c/ce/Garl_Glittergold_Icon.webp/20px-Garl_Glittergold_Icon.webp, /w/images/thumb/c/ce/Garl_Glittergold_Icon.webp/30px-Garl_Glittergold_Icon.webp 1.5x, /w/images/thumb/c/ce/Garl_Glittergold_Icon.webp/40px-Garl_Glittergold_Icon.webp 2x\"><img alt=\"Garl\" src=\"/w/images/thumb/c/ce/Garl_Glittergold_Icon.webp/20px-Garl_Glittergold_Icon.webp\" decoding=\"async\" width=\"20\" height=\"18\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/ce/Garl_Glittergold_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Garl_Glittergold\" class=\"mw-redirect\" title=\"Garl Glittergold\">Garl</a>.\n</p><p><br>\n</p><p>When Garl took a bite,\n</p><p>Yondalla shrieked with fright!\n</p><p>'Don't eat that, oh my!\n</p><p>That's a butterfly!'\n</p><p><br>\n</p><p>---\n</p><p><br>\n</p><p>There was an old man named Elmûn.\n</p><p>Who made the best buns in <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Faer%C3%BBn\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/images/thumb/6/68/FRWiki_Icon.png/44px-FRWiki_Icon.png.webp 2x\"><img alt=\"Faerûn\" src=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/FRWiki_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <span class=\"bg3wiki-icontext-extlink\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Faer%C3%BBn\">Faerûn</a></span>.\n</p><p>The Elders did scold him whenever he sold them, saying,\n</p><p>'Elm, bring those buns to OUR room!'\n</p>\n</div> <h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li><b>One Foot, Two Feet, Well Met, We'll Meet</b> may be a reference to the book <b>One Fish, Two Fish, Red Fish, Blue Fish</b>.</li></ul>\n</div>   \n<!-- \nNewPP limit report\nCached time: 20260714202737\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.061 seconds\nReal time usage: 0.06