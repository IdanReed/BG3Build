e_Icon.webp/20px-Condition_Type_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/0/04/Condition_Type_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Incapacitated_(status_group)\" title=\"Incapacitated (status group)\">Incapacitated</a></span>\n</p>\n<h2><span class=\"mw-headline\" id=\"Properties\">Properties</span></h2>\n<div class=\"noexcerpt navigation-not-searchable\">\n<p><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span>UID: <code class=\"bg3wiki-uid-box\">PETRIFIED</code> <span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:PETRIFIED+type:status\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:PETRIFIED+type:status\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span>\n</p><p><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Status_groups\" title=\"Status groups\"><picture><source srcset=\"/w/images/thumb/4/4b/Plus_Icon.png/25px-Plus_Icon.png.webp, /w/images/thumb/4/4b/Plus_Icon.png/38px-Plus_Icon.png.webp 1.5x, /w/images/4/4b/Plus_Icon.png 2x\"><img alt=\"Status groups\" src=\"/w/images/thumb/4/4b/Plus_Icon.png/25px-Plus_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/4b/Plus_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Status_groups\" title=\"Status groups\">Status groups</a>: <a href=\"/wiki/SG_Incapacitated\" class=\"mw-redirect\" title=\"SG Incapacitated\">SG_Incapacitated</a>, <a href=\"/wiki/SG_Condition\" title=\"SG Condition\">SG_Condition</a>, <a href=\"/wiki/SG_Petrified\" class=\"mw-redirect\" title=\"SG Petrified\">SG_Petrified</a>\n</p><p><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Conditions#Duration\" title=\"Conditions\"><picture><source srcset=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp, /w/images/thumb/6/6a/Duration_Icons.png/38px-Duration_Icons.png.webp 1.5x, /w/images/thumb/6/6a/Duration_Icons.png/50px-Duration_Icons.png.webp 2x\"><img alt=\"Loses duration\" src=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/6a/Duration_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Conditions#Duration\" title=\"Conditions\">Loses duration</a>: N/A\n</p>\n<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Status_properties\" title=\"Status properties\"><picture><source srcset=\"/w/images/thumb/f/fe/Options_Icon.png/25px-Options_Icon.png.webp, /w/images/f/fe/Options_Icon.png 1.5x\"><img alt=\"More properties\" src=\"/w/images/thumb/f/fe/Options_Icon.png/25px-Options_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/fe/Options_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Status_properties\" class=\"mw-redirect\" title=\"Status properties\">More properties</a>: <ul>\n<li><a href=\"/wiki/Status_properties/InitiateCombat\" title=\"Status properties/InitiateCombat\">InitiateCombat</a></li>\n<li><a href=\"/wiki/Status_properties/IgnoreResting\" title=\"Status properties/IgnoreResting\">IgnoreResting</a></li>\n</ul></div>\n</div> \n<h2><span class=\"mw-headline\" id=\"Notes\">Notes</span></h2>\n<ul><li>Petrified creatures additionally:\n<ul><li>Are <a href=\"/wiki/Resistant\" class=\"mw-redirect\" title=\"Resistant\">resistant</a> to all damage types</li>\n<li>Are immune to all <span class=\"bg3wiki-condition-type\"><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/0/04/Condition_Type_Icon.webp/20px-Condition_Type_Icon.webp, /w/images/thumb/0/04/Condition_Type_Icon.webp/30px-Condition_Type_Icon.webp 1.5x, /w/images/thumb/0/04/Condition_Type_Icon.webp/40px-Condition_Type_Icon.webp 2x\"><img alt=\"Poisoned\" src=\"/w/images/thumb/0/04/Condition_Type_Icon.webp/20px-Condition_Type_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/0/04/Condition_Type_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Poisoned_(status_group)\" title=\"Poisoned (status group)\">Poisoned</a></span> conditions</li>\n<li>Have all attacks against them made with <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Advantage\" title=\"Advantage\"><picture><source srcset=\"/w/images/thumb/f/fc/Advantage_Icon.png/28px-Advantage_Icon.png.webp, /w/images/thumb/f/fc/Advantage_Icon.png/42px-Advantage_Icon.png.webp 1.5x, /w/images/thumb/f/fc/Advantage_Icon.png/55px-Advantage_Icon.png.webp 2x\"><img alt=\"Advantage\" src=\"/w/images/thumb/f/fc/Advantage_Icon.png/28px-Advantage_Icon.png.webp\" decoding=\"async\" width=\"28\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/fc/Advantage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Advantage\" title=\"Advantage\">Advantage</a></li>\n<li>Automatically fail <a href=\"/wiki/Strength\" title=\"Strength\">Strength</a> and <a href=\"/wiki/Dexterity\" title=\"Dexterity\">Dexterity</a> saving throws</li>\n<li>Cannot detect crimes such as theft and murder<sup class=\"noexcerpt navigation-not-searchable\">[<a href=\"/wiki/bg3wiki:Verification\" title=\"bg3wiki:Verification\"><span aria-label=\"I think that's what Detec...\" tabindex=\"0\" class=\"bg3wiki-help-tooltip\"><i>verify</i></span></a>]</sup></li>\n<li>Cannot be <a href=\"/wiki/Pickpocket\" class=\"mw-redirect\" title=\"Pickpocket\">pickpocketed</a></li>\n<li>Cannot be <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Downed_(Condition)\" title=\"Downed (Condition)\"><picture><source srcset=\"/w/images/thumb/6/66/Downed_Condition_Icon.webp/20px-Downed_Condition_Icon.webp, /w/images/thumb/6/66/Downed_Condition_Icon.webp/30px-Downed_Condition_Icon.webp 1.5x, /w/images/thumb/6/66/Downed_Condition_Icon.webp/40px-Downed_Condition_Icon.webp 2x\"><img alt=\"Downed\" src=\"/w/images/thumb/6/66/Downed_Condition_Icon.webp/20px-Downed_Condition_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/66/Downed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Downed_(Condition)\" title=\"Downed (Condition)\">Downed</a>, and instead disintegrate upon reaching 0 HP</li>\n<li>Are immune to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Weapon_Dropped!_(Condition)\" title=\"Weapon Dropped! (Condition)\"><picture><source srcset=\"/w/images/thumb/3/39/Weapon_Dropped%21_Condition_Icon.webp/20px-Weapon_Dropped%21_Condition_Icon.webp, /w/images/thumb/3/39/Weapon_Dropped%21_Condition_Icon.webp/30px-Weapon_Dropped%21_Condition_Icon.webp 1.5x, /w/images/thumb/3/39/Weapon_Dropped%21_Condition_Icon.webp/40px-Weapon_Dropped%21_Condition_Icon.webp 2x\"><img alt=\"Weapon Dropped!\" src=\"/w/images/thumb/3/39/Weapon_Dropped%21_Condition_Icon.webp/20px-Weapon_Dropped%21_Condition_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/39/Weapon_Dropped%21_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Weapon_Dropped!_(Condition)\" title=\"Weapon Dropped! (Condition)\">Weapon Dropped!</a></li>\n<li>Cannot speak or participate in dialogue</li>\n<li>Lose <a href=\"/wiki/Concentration\" title=\"Concentration\">concentration</a></li></ul></li>\n<li>Petrified can be cured by:\n<ul><li><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Basilisk_Oil\" title=\"Basilisk Oil\"><picture><source srcset=\"/w/images/thumb/d/d9/POT_Basilisk_Oil_Unfaded_Icon.png/25px-POT_Basilisk_Oil_Unfaded_Icon.png.webp, /w/images/thumb/d/d9/POT_Basilisk_Oil_Unfaded_Icon.png/38px-POT_Basilisk_Oil_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/d/d9/POT_Basilisk_Oil_Unfaded_Icon.png/50px-POT_Basilisk_Oil_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/d/d9/POT_Basilisk_Oil_Unfaded_Icon.png/25px-POT_Basilisk_Oil_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d9/POT_Basilisk_Oil_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> <a href=\"/wiki/Basilisk_Oil\" title=\"Basilisk Oil\">Basilisk Oil</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Greater_Restoration\" title=\"Greater Restoration\"><picture><source srcset=\"/w/images/thumb/e/ee/Greater_Restoration_Icon.webp/25px-Greater_Restoration_Icon.webp, /w/images/thumb/e/ee/Greater_Restoration_Icon.webp/38px-Greater_Restoration_Icon.webp 1.5x, /w/images/thumb/e/ee/Greater_Restoration_Icon.webp/50px-Greater_Restoration_Icon.webp 2x\"><img alt=\"Greater Restoration\" src=\"/w/images/thumb/e/ee/Greater_Restoration_Icon.webp/25px-Greater_Restoration_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/ee/Greater_Restoration_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Greater_Restoration\" title=\"Greater Restoration\">Greater Restoration</a></li></ul></li></ul>\n<h2><span class=\"mw-headline\" id=\"Sources_of_Petrified\">Sources of Petrified</span></h2>\n<div class=\"bg3wiki-condition-sources\"><ul>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"min-width: 30px;\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Flesh_to_Stone:_Restrained_Stage_3_(Condition)\" title=\"Flesh to Stone: Restrained Stage 3 (Condition)\"><picture><source srcset=\"/w/images/thumb/6/61/Flesh_to_Stone_Condition_Icon.webp/30px-Flesh_to_Stone_Condition_Icon.webp, /w/images/thumb/6/61/Flesh_to_Stone_Condition_Icon.webp/45px-Flesh_to_Stone_Condition_Icon.webp 1.5x, /w/images/thumb/6/61/Flesh_to_Stone_Condition_Icon.webp/60px-Flesh_to_Stone_Condition_Icon.webp 2x\"><img alt=\"Flesh to Stone: Restrained Stage 3\" src=\"/w/images/thumb/6/61/Flesh_to_Stone_Condition_Icon.webp/30px-Flesh_to_Stone