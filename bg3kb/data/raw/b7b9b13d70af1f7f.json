_Gold_Condition_Icon.webp/25px-Turned_to_Gold_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/98/Turned_to_Gold_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Turned_to_Gold_(Condition)\" title=\"Turned to Gold (Condition)\">gold</a>.</li></ul>\n</div> \n<h2><span class=\"mw-headline\" id=\"Sources_of_Legendary_Action:_Sublimation\">Sources of Legendary Action: Sublimation</span></h2>\n<div class=\"bg3wiki-condition-sources\"><ul>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Legendary_Action:_Sublimation\" title=\"Legendary Action: Sublimation\"><picture><source srcset=\"/w/images/thumb/a/a3/Legendary_Action_Crowd_Control_Icon.webp/30px-Legendary_Action_Crowd_Control_Icon.webp, /w/images/thumb/a/a3/Legendary_Action_Crowd_Control_Icon.webp/45px-Legendary_Action_Crowd_Control_Icon.webp 1.5x, /w/images/thumb/a/a3/Legendary_Action_Crowd_Control_Icon.webp/60px-Legendary_Action_Crowd_Control_Icon.webp 2x\"><img alt=\"Legendary Action: Sublimation\" src=\"/w/images/thumb/a/a3/Legendary_Action_Crowd_Control_Icon.webp/30px-Legendary_Action_Crowd_Control_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a3/Legendary_Action_Crowd_Control_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Legendary_Action:_Sublimation\" title=\"Legendary Action: Sublimation\">Legendary Action: Sublimation</a></li>\n</ul></div>\n<h2><span class=\"mw-headline\" id=\"Creatures_with_Legendary_Action:_Sublimation\">Creatures with Legendary Action: Sublimation</span></h2>\n<div class=\"bg3wiki-condition-sources\"><ul>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon bg3wiki-round-ima