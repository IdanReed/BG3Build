-Portrait_Malus_Thorm.png.webp 1.5x, /w/images/thumb/0/05/Portrait_Malus_Thorm.png/50px-Portrait_Malus_Thorm.png.webp 2x\"><img alt=\"Malus Thorm\" src=\"/w/images/thumb/0/05/Portrait_Malus_Thorm.png/25px-Portrait_Malus_Thorm.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/05/Portrait_Malus_Thorm.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Malus_Thorm\" title=\"Malus Thorm\">Malus Thorm</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ef/Rarity_Icon.png/25px-Rarity_Icon.png.webp, /w/images/thumb/e/ef/Rarity_Icon.png/38px-Rarity_Icon.png.webp 1.5x, /w/images/e/ef/Rarity_Icon.png 2x\"><img alt=\"Rarity: Common\" src=\"/w/images/thumb/e/ef/Rarity_Icon.png/25px-Rarity_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ef/Rarity_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Rarity: Common</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp, /w/images/thumb/e/ea/Weight_Icon.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 0.5 kg (1 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 0.5 kg (1 lb)</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 14 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  14  gp</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"￼START_WIDGET&quot;'-174fe220bc245d8aEND_WIDGET ￼START_WIDGET&quot;'-2c3166755abe5980END_WIDGET\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">S_TWN_Hospital_SurgeonResearch</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:S_TWN_Hospital_SurgeonResearch\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:S_TWN_Hospital_SurgeonResearch\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">4933e2e7-01b3-4055-99ae-1a9cd81f11c6</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:4933e2e7-01b3-4055-99ae-1a9cd81f11c6\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:4933e2e7-01b3-4055-99ae-1a9cd81f11c6\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div>   \n<div style=\"clear: both;\"></div></div>\n    <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>In the Morgue Laboratory on a desk, in the back of <a href=\"/wiki/House_of_Healing_Morgue\" class=\"mw-redirect\" title=\"House of Healing Morgue\">House of Healing Morgue</a> at <span class=\"bg3wiki-coordinates\">X:&nbsp;16&nbsp;Y:&nbsp;-988</span></li></ul>\n</div> <h2><span class=\"mw-headline\" id=\"Usage\"> Usage </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>Reading the book grants the inspiration <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Sage#Hippocratic_No_More\" title=\"Sage\"><picture><source srcset=\"/w/images/thumb/8/85/Inspiration_Icon.png/25px-Inspiration_Icon.png.webp, /w/images/thumb/8/85/Inspiration_Icon.png/38px-Inspiration_Icon.png.webp 1.5x, /w/images/thumb/8/85/Inspiration_Icon.png/50px-Inspiration_Icon.png.webp 2x\"><img alt=\"Hippocratic No More\" src=\"/w/images/thumb/8/85/Inspiration_Icon.png/25px-Inspiration_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/85/Inspiration_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Sage#Hippocratic_No_More\" title=\"Sage\">Hippocratic No More</a> to party members with the <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Sage\" title=\"Sage\"><picture><source srcset=\"/w/images/thumb/2/2e/Background_Sage_Icon.png/20px-Background_Sage_Icon.png.webp, /w/images/thumb/2/2e/Background_Sage_Icon.png/30px-Background_Sage_Icon.png.webp 1.5x, /w/images/thumb/2/2e/Background_Sage_Icon.png/40px-Background_Sage_Icon.png.webp 2x\"><img alt=\"Sage\" src=\"/w/images/thumb/2/2e/Background_Sage_Icon.png/20px-Background_Sage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/2e/Background_Sage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Sage\" title=\"Sage\">Sage</a> background.</li></ul>\n</div> <h2><span class=\"mw-headline\" id=\"Text\"> Text </span></h2>\n<div class=\"bg3wiki-book-text\">\n<p>I discovered all too late that I was making things much harder on myself than necessary. There was no need for such complex chemical experimentation; no, foolish me! I ought to have turned to that which has already been perfected by nature. Fortunately my research led me to the carapace of the <a href=\"/wiki/Carrion_crawler\" class=\"mw-redirect\" title=\"Carrion crawler\">Carrion crawler</a>, which contains a paralytic agent so powerful I must be quite cautious not to breathe it in during the refinement process, lest I fall asleep at my workbench.\n</p>\n</div>    \n<!-- \nNewPP limit report\nCached time: 20260714200042\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.060 seconds\nReal time usage: 0.062 seconds\nPreprocessor visited node count: 2447/1000000\nPost‐expand include size: 33073/4194304 bytes\nTemplate argument size: 8999/4194304 bytes\nHighest expansion depth: 29/200\nExpensive parser function count: 2/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 2/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.011/7.000 s