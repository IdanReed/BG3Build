n.webp/45px-Self_Immolation_Icon.webp 1.5x, /w/images/thumb/7/70/Self_Immolation_Icon.webp/60px-Self_Immolation_Icon.webp 2x\"><img alt=\"Self Immolation\" src=\"/w/images/thumb/7/70/Self_Immolation_Icon.webp/30px-Self_Immolation_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/70/Self_Immolation_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Self_Immolation\" title=\"Self Immolation\">Self Immolation</a></span></li>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 5px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Smouldering_Touch\" title=\"Smouldering Touch\"><picture><source srcset=\"/w/images/thumb/2/21/Smouldering_Touch_Icon.webp/30px-Smouldering_Touch_Icon.webp, /w/images/thumb/2/21/Smouldering_Touch_Icon.webp/45px-Smouldering_Touch_Icon.webp 1.5x, /w/images/thumb/2/21/Smouldering_Touch_Icon.webp/60px-Smouldering_Touch_Icon.webp 2x\"><img alt=\"Smouldering Touch\" src=\"/w/images/thumb/2/21/Smouldering_Touch_Icon.webp/30px-Smouldering_Touch_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/21/Smouldering_Touch_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Smouldering_Touch\" title=\"Smouldering Touch\">Smouldering Touch</a></span></li>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 5px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Sphere_of_Elemental_Balance:_Fire\" title=\"Sphere of Elemental Balance: Fire\"><picture><source srcset=\"/w/images/thumb/1/1e/Chromatic_Orb_Fire_Icon.webp/30px-Chromatic_Orb_Fire_Icon.webp, /w/images/thumb/1/1e/Chromatic_Orb_Fire_Icon.webp/45px-Chromatic_Orb_Fire_Icon.webp 1.5x, /w/images/thumb/1/1e/Chromatic_Orb_Fire_Icon.webp/60px-Chromatic_Orb_Fire_Icon.webp 2x\"><img alt=\"Sphere of Elemental Balance: Fire\" src=\"/w/images/thumb/1/1e/Chromatic_Orb_Fire_Icon.webp/30px-Chromatic_Orb_Fire_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/1e/Chromatic_Orb_Fire_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Sphere_of_Elemental_Balance:_Fire\" title=\"Sphere of Elemental Balance: Fire\">Sphere of Elemental Balance: Fire</a></span></li>\n</ul></div>\n<h2><span class=\"mw-headline\" id=\"Interactions\">Interactions</span></h2>\n<p><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Dippable\" title=\"Dippable\"><picture><source srcset=\"/w/images/thumb/0/0a/Dippable_Icon.png/25px-Dippable_Icon.png.webp, /w/images/thumb/0/0a/Dippable_Icon.png/38px-Dippable_Icon.png.webp 1.5x, /w/images/0/0a/Dippable_Icon.png 2x\"><img alt=\"Dippable\" src=\"/w/images/thumb/0/0a/Dippable_Icon.png/25px-Dippable_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0a/Dippable_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dippable\" class=\"mw-redirect\" title=\"Dippable\">Dippable</a>\n</p><p>A Fire surface can also be created by:\n</p>\n<ul><li>Exploding a <a href=\"/wiki/Oil_Barrel\" title=\"Oil Barrel\">Oil</a>, <a href=\"/wiki/Smokepowder_Barrel\" title=\"Smokepowder Barrel\">Smokepowder</a> and/or <a href=\"/wiki/Firewine_Barrel\" title=\"Firewine Barrel\">Firewine Barrel</a>.</li>\n<li>Igniting an <a href=\"/wiki/Oil\" title=\"Oil\">Oil</a>, <a href=\"/wiki/Smokepowder_(surface)\" title=\"Smokepowder (surface)\">Smokepowder</a>, <a href=\"/wiki/Grease_(surface)\" title=\"Grease (surface)\">Grease</a>, <a href=\"/wiki/Unstable_Blood_(surface)\" title=\"Unstable Blood (surface)\">Unstable Blood</a>, and/or <a href=\"/wiki/Alcohol_(surface)\" title=\"Alcohol (surface)\">Alcohol</a>.</li></ul>\n<p>When the fire burns out, it leaves behind an <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Ash\" title=\"Ash\"><picture><source srcset=\"/w/images/thumb/6/6b/Ash_surface_Icon.webp/25px-Ash_surface_Icon.webp, /w/images/thumb/6/6b/Ash_surface_Icon.webp/38px-Ash_surface_Icon.webp 1.5x, /w/images/thumb/6/6b/Ash_surface_Icon.webp/50px-Ash_surface_Icon.webp 2x\"><img alt=\"Ash\" src=\"/w/images/thumb/6/6b/Ash_surface_Icon.webp/25px-Ash_surface_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/6b/Ash_surface_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Ash\" title=\"Ash\">Ash</a> surface.\n</p>\n<ul><li>Turns into a <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Steam_Cloud\" title=\"Steam Cloud\"><picture><source srcset=\"/w/images/thumb/4/4a/Steam_Cloud_cloud_Icon.webp/25px-Steam_Cloud_cloud_Icon.webp, /w/images/thumb/4/4a/Steam_Cloud_cloud_Icon.webp/38px-Steam_Cloud_cloud_Icon.webp 1.5x, /w/images/thumb/4/4a/Steam_Cloud_cloud_Icon.webp/50px-Steam_Cloud_cloud_Icon.webp 2x\"><img alt=\"Steam Cloud\" src=\"/w/images/thumb/4/4a/Steam_Cloud_cloud_Icon.webp/25px-Steam_Cloud_cloud_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/4a/Steam_Cloud_cloud_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Steam_Cloud\" title=\"Steam Cloud\">Steam Cloud</a> for <span class=\"bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp, /w/images/thumb/6/6a/Duration_Icons.png/38px-Duration_Icons.png.webp 1.5x, /w/images/thumb/6/6a/Duration_Icons.png/50px-Duration_Icons.png.webp 2x\"><img alt=\"Duration Icons.png\" src=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/6/6a/Duration_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Duration: 10 turns after being exposed to water surface.</li></ul>\n\n<h2><span class=\"mw-headline\" id=\"Gallery\">Gallery</span></h2>\n<ul class=\"gallery mw-gallery-packed\">\n\t\t<li class=\"gallerybox\" style=\"width: 258px\">\n\t\t\t<div class=\"thumb\" style=\"width: 256px;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Fire_Surface_Screenshot.png\" class=\"mw-file-description\" title=\"Tav standing beside a fire surface.\"><picture><source srcset=\"/w/images/thumb/3/3a/Fire_Surface_Screenshot.png/384px-Fire_Surface_Screenshot.png.webp, /w/images/thumb/3/3a/Fire_Surface_Screenshot.png/577px-Fire_Surface_Screenshot.png.webp 1.5x, /w/images/thumb/3/3a/Fire_Surface_Screenshot.png/768px-Fire_Surface_Screenshot.png.webp 2x\"><img alt=\"Tav standing beside a fire surface.\" src=\"/w/images/thumb/3/3a/Fire_Surface_Screenshot.png/384px-Fire_Surface_Screenshot.png.webp\" decoding=\"async\" width=\"256\" height=\"250\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/3a/Fire_Surface_Screenshot.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n\t\t\t<div class=\"gallerytext\">Tav standing beside a fire surface.</div>\n\t\t</li>\n</ul>\n<!-- \nNewPP limit report\nCached time: 20260714195148\nCache expiry: 86400\nReduced expiry: false\nComplications: [no‐toc]\nCPU time usage: 