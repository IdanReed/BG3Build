c_Resistance_Full.png/42px-Necrotic_Resistance_Full.png.webp 1.5x, /w/images/thumb/c/cc/Necrotic_Resistance_Full.png/56px-Necrotic_Resistance_Full.png.webp 2x\"><img alt=\"Resistant to all Necrotic\" src=\"/w/images/thumb/c/cc/Necrotic_Resistance_Full.png/28px-Necrotic_Resistance_Full.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/cc/Necrotic_Resistance_Full.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li><li><span typeof=\"mw:File\"><span title=\"Immune to all Poison\"><picture><source srcset=\"/w/images/thumb/c/c0/Poison_Immunity.png/28px-Poison_Immunity.png.webp, /w/images/thumb/c/c0/Poison_Immunity.png/42px-Poison_Immunity.png.webp 1.5x, /w/images/thumb/c/c0/Poison_Immunity.png/56px-Poison_Immunity.png.webp 2x\"><img alt=\"Immune to all Poison\" src=\"/w/images/thumb/c/c0/Poison_Immunity.png/28px-Poison_Immunity.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c0/Poison_Immunity.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li><li><span typeof=\"mw:File\"><span title=\"Immune to all Psychic\"><picture><source srcset=\"/w/images/thumb/4/4f/Psychic_Immunity.png/28px-Psychic_Immunity.png.webp, /w/images/thumb/4/4f/Psychic_Immunity.png/42px-Psychic_Immunity.png.webp 1.5x, /w/images/thumb/4/4f/Psychic_Immunity.png/56px-Psychic_Immunity.png.webp 2x\"><img alt=\"Immune to all Psychic\" src=\"/w/images/thumb/4/4f/Psychic_Immunity.png/28px-Psychic_Immunity.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/4/4f/Psychic_Immunity.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li><li><span typeof=\"mw:File\"><span title=\"Resistant to all Radiant\"><picture><source srcset=\"/w/images/thumb/4/4f/Radiant_Resistance_Full.png/28px-Radiant_Resistance_Full.png.webp, /w/images/thumb/4/4f/Radiant_Resistance_Full.png/42px-Radiant_Resistance_Full.png.webp 1.5x, /w/images/thumb/4/4f/Radiant_Resistance_Full.png/56px-Radiant_Resistance_Full.png.webp 2x\"><img alt=\"Resistant to all Radiant\" src=\"/w/images/thumb/4/4f/Radiant_Resistance_Full.png/28px-Radiant_Resistance_Full.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/4/4f/Radiant_Resistance_Full.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li></ul></div>\n</div></section></section>\n\t\t\t</div>\n\t</div>\n</section></aside>\n<b>Barrelstalk</b> are a kind of mushroom in the <a href=\"/wiki/Underdark\" title=\"Underdark\">Underdark</a>, mostly non-hazardous.\n\n<style data-mw-deduplicate=\"TemplateStyles:r356266\">.mw-parser-output .bg3wiki-fancy-quote{display:grid;margin:10px 4px}.mw-parser-output .bg3wiki-fancy-quote-blockquote-left,.mw-parser-output .bg3wiki-fancy-quote-blockquote-right{padding:8px 16px;margin:auto}@media screen and (max-width:779px){.mw-parser-output .bg3wiki-fancy-quote-blockquote-left,.mw-parser-output .bg3wiki-fancy-quote-blockquote-right{margin-top:10px;padding:8px 2px;border-left:0!important;grid-row:2;grid-column:2}.mw-parser-output .bg3wiki-fancy-quote-image-right,.mw-parser-output .bg3wiki-fancy-quote-image-left{margin:auto;grid-row:1;grid-column:2}.mw-parser-output .bg3wiki-fancy-quote-author{grid-row:3;grid-column:2}.mw-parser-output .bg3wiki-fancy-quote{justify-content:center!important}}@media screen and (min-width:780px){.mw-parser-output .bg3wiki-fancy-quote-blockquote-left{margin-left:10px;border-left:2px solid #3d3d3d!important;grid-row:1;grid-column:2}.mw-parser-output .bg3wiki-fancy-quote-blockquote-right{margin-right:10px;border-left:0!important;border-right:2px solid #3d3d3d;grid-row:1;grid-column:2}.mw-parser-output .bg3wiki-fancy-quote-image-right{margin:auto 0;grid-row:1;grid-column:3}.mw-parser-output .bg3wiki-fancy-quote-image-left{margin:auto 0;grid-row:1;grid-column:1}.mw-parser-output .bg3wiki-fancy-quote-author{grid-row:2;grid-column:2}}.mw-parser-output .bg3wiki-fancy-quote-author{margin-left:auto;margin-right:32px;font-size:smaller;font-weight:bold}.mw-parser-output .bg3wiki-fancy-quote-begin,.mw-parser-output .bg3wiki-fancy-quote-end{font-size:300%;font-family:serif;color:#3d3d3d;line-height:1em}.mw-parser-output .bg3wiki-fancy-quote-begin{margin-bottom:auto;margin-right:8px}.mw-parser-output .bg3wiki-fancy-quote-end{margin-top:auto;margin-left:8px}.mw-parser-output .bg3wiki-fancy-quote-text{font-style:italic}</style><div class=\"bg3wiki-fancy-quote\" style=\"justify-content: center\"><span class=\"bg3wiki-fancy-quote-image-left\" style=\"display: inline-block; height: calc(70px + 2*4px); width: calc(70px + 2*4px); clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%); background: black;\"><span style=\"display: inline-block; margin: 4px; width: 70px; height: 70px; clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);\"><span typeof=\"mw:File\"><a href=\"/wiki/Gale\" title=\"Gale\"><picture><source srcset=\"/w/images/thumb/1/11/Portrait_Gale.png/70px-Portrait_Gale.png.webp, /w/images/thumb/1/11/Portrait_Gale.png/105px-Portrait_Gale.png.webp 1.5x, /w/images/thumb/1/11/Portrait_Gale.png/140px-Portrait_Gale.png.webp 2x\"><img src=\"/w/images/thumb/1/11/Portrait_Gale.png/70px-Portrait_Gale.png.webp\" decoding=\"async\" width=\"70\" height=\"70\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/11/Portrait_Gale.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><blockquote style=\"font-size: 100%\" class=\"bg3wiki-fancy-quote-blockquote-left\">\n  <div style=\"display: flex; align-items: center\">\n     <div class=\"bg3wiki-fancy-quote-begin\">“</div>\n     <div class=\"bg3wiki-fancy-quote-text\">These barrelstalks are full of poison - ready to be released by the myconids if they feel threatened</div>\n     <div class=\"bg3wiki-fancy-quote-end\">„</div>\n  </div>\n</blockquote><div class=\"bg3wiki-fancy-quote-author\">— <a href=\"/wiki/Gale\" title=\"Gale\">Gale</a>, on successful Nature check</div><div style=\"grid-column:3\"></div></div>\n<h2><span class=\"mw-headline\" id=\"Involvement\">Involvement</span></h2>\n<p>Barrelstalk are huge, bulbous fungi in the Myconid colony in <a href=\"/wiki/Ebonlake_Grotto\" title=\"Ebonlake Grotto\">Ebonlake Grotto</a> in the Underdark. One is also in <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Auntie_Ethel\" title=\"Auntie Ethel\"><picture><source srcset=\"/w/images/thumb/6/6b/Portrait_Ethel.png/25px-Portrait_Ethel.png.webp, /w/images/thumb/6/6b/Portrait_Ethel.png/38px-Portrait_Ethel.png.webp 1.5x, /w/images/thumb/6/6b/Portrait_Ethel.png/50px-Portrait_Ethel.png.webp 2x\"><img alt=\"Auntie Ethel\" src=\"/w/images/thumb/6/6b/Portrait_Ethel.png/25px-Portrait_Ethel.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/6b/Portrait_Ethel.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Auntie_Ethel\" title=\"Auntie Ethel\">Auntie Ethel</a>'s lair in <a href=\"/wiki/Act_Three\" title=\"Act Three\">Act Three</a>. These mushrooms grow along the paths in the grotto, emitting clouds of spores in the air. Passing through such cloud instills <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Haste_Spores_(Condition)\" title=\"Haste Spores (Condition)\"><picture><source srcset=\"/w/images/thumb/7/7d/Haste_Spores_Condition_Icon.webp/25px-Haste_Spores_Condition_Icon.webp, /w/images/thumb/7/7d/Haste_Spores_Condition_Icon.webp/38px-Haste_Spores_Condition_Icon.webp 1.5x, /w/images/thumb/7/7d/Haste_Spores_Condition_Icon.webp/50px-Haste_Spores_Condition_Icon.webp 2x\"><img alt=\"Haste Spores\" src=\"/w/images/thumb/7/7d/Haste_Spores_Condition_Icon.webp/25px-Haste_Spores_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/7d/Haste_Spores_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Haste_Spores_(Condition)\" title=\"Haste Spores (Condition)\">Haste Spores</a> on any character for one turn.\n</p><p>All Barrelstalks in the Myconid colony are red-outlined, and interacting with them openly is considered a transgression by both colony members and spore-animated servants. However, doing this with the help of any concealment (like <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Fog_Cloud\" title=\"Fog Cloud\"><picture><source srcset=\"/w/images/thumb/c/c0/Fog_Cloud_Icon.webp/25px-Fog_Cloud_Icon.webp, /w/images/thumb/c/c0/Fog_Cloud_Icon.webp/38px-Fog_Cloud_Icon.webp 1.5x, /w/images/thumb/c/c0/Fog_Cloud_Icon.webp/50px-Fog_Cloud_Icon.webp 2x\"><img alt=\"Fog Cloud\" src=\"/w/images/thumb/c/c0/Fog_Cloud_Icon.webp/25px-Fog_Cloud_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c0/Fog_Cloud_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Fog_Cloud\" title=\"Fog Cloud\">Fog Cloud</a>) prompts a <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/1/13/D20.png/20px-D20.png.webp, /w/images/thumb/1/13/D20.png/30px-D20.png.webp 1.5x, /w/images/thumb/1/13/D20.png/40px-D20.png.webp 2x\"><img alt=\"DC&nbsp;10 Nature Check\" src=\"/w/images/thumb/1/13/D20.png/20px-D20.png.webp\" decoding=\"async\" width=\"20\" height=\"22\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/1/13/D20.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> DC&nbsp;10 <a href=\"/wiki/Nature\" title=\"Nature\">Nature</a> <a href=\"/wiki/Ability_check\" class=\"mw-redirect\" title=\"Ability check\">Check</a>. Success allows any party member to find out that these fungi are not only helpful, but are also poisonous and as such can also serve as a means of defense.\n</p><p>If destroyed, a Barrelstalk emits a cloud of <a href=\"/wiki/Noxious_Fumes\" title=\"Noxious Fumes\">Noxious Fumes</a>, but too small and ephemeral to deal any damage. The ruined Barrelstalk is still available to examine (and roll aforementioned Nature check), and is still red-outlined.\n</p>\n<h2><span class=\"mw-headline\" id=\"Gallery\">Gallery</span></h2>\n<ul class=\"gallery mw-gallery-packed\">\n\t\t<li class=\"gallerybox\" style=\"width: 294.66666666667px\">\n\t\t\t<div class=\"thumb\" style=\"width: 292.66666666667px;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Barrelstalk_spores.png\" class=\"mw-file-description\" title=\"A Barrelstalk emitting a Haste spore cloud\"><picture><source srcset=\"/w/images/thumb/a/af/Barrelstalk_spores.png/439px-Barrelstalk_spores.png.webp, /w/images/thumb/a/af/Barrelstalk_spores.png/659px-Barrelstalk_spores.png.webp 1.5x, /w/images/a/af/Barrelstalk_spores.png 2x\"><img alt=\"A Barrelstalk emitting a Haste spore cloud\" src=\"/w/images/thumb/a/af/Barrelstalk_spores.png/439px-Barrelstalk_spores.png.webp\" decoding=\"async\" width=\"293\" height=\"230\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/af/Barrelstalk_spores.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n\t\t\t<div class=\"gallerytext\">A Barrelstalk emitting a Haste spore cloud</div>\n\t\t</li>\n</ul>\n<!-- \nNewPP limit