m: translate(-50%, -50%);\"><span typeof=\"mw:File\"><a href=\"/wiki/Flying_Ghoul\" title=\"Flying Ghoul\"><picture><source srcset=\"/w/images/thumb/8/81/Portrait_Flying_Ghoul.png/120px-Portrait_Flying_Ghoul.png.webp, /w/images/8/81/Portrait_Flying_Ghoul.png 1.5x\"><img src=\"/w/images/thumb/8/81/Portrait_Flying_Ghoul.png/120px-Portrait_Flying_Ghoul.png.webp\" decoding=\"async\" width=\"120\" height=\"120\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/81/Portrait_Flying_Ghoul.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n<div style=\"width: 160px; height: 160px; position: absolute\"><span typeof=\"mw:File\"><a href=\"/wiki/Flying_Ghoul\" title=\"Flying Ghoul\"><picture><source srcset=\"/w/images/thumb/1/14/Portrait_Frame.png/160px-Portrait_Frame.png.webp, /w/images/thumb/1/14/Portrait_Frame.png/240px-Portrait_Frame.png.webp 1.5x, /w/images/thumb/1/14/Portrait_Frame.png/320px-Portrait_Frame.png.webp 2x\"><img src=\"/w/images/thumb/1/14/Portrait_Frame.png/160px-Portrait_Frame.png.webp\" decoding=\"async\" width=\"160\" height=\"160\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/14/Portrait_Frame.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n</div>\n<table class=\"bg3wiki-attrblock-table\"><tbody><tr class=\"bg3wiki-attrblock-score-row\">\n\t\t<td>\n\t\t<p><a href=\"/wiki/Strength\" title=\"Strength\">STR</a></p>\n\t\t<div><b><span>16</span></b></div> <span>(+3)</span>\n</td>\n\n<td>\n\t\t<p><a href=\"/wiki/Dexterity\" title=\"Dexterity\">DEX</a></p>\n\t\t<div><b><span>17</span></b></div> <span>(+3)</span>\n</td>\n\n<td>\n\t\t<p><a href=\"/wiki/Constitution\" title=\"Constitution\">CON</a></p>\n\t\t<div><b><span>10</span></b></div> \n</td>\n\n\t\t<td>\n\t\t<p><a href=\"/wiki/Intelligence\" title=\"Intelligence\">INT</a></p>\n\t\t<div><b><span>11</span></b></div> \n</td>\n\n\t\t<td>\n\t\t<p><a href=\"/wiki/Wisdom\" title=\"Wisdom\">WIS</a></p>\n\t\t<div><b><span>10</span></b></div> \n</td>\n\n\t\t<td>\n\t\t<p><a href=\"/wiki/Charisma\" title=\"Charisma\">CHA</a></p>\n\t\t<div><b><span>8</span></b>\n<b></b></div><b> <span>(-1)</span></b>\n</td>\n\t</tr><tr><td colspan=\"100%\" class=\"bg3wiki-attrblock-divider\"><hr></td></tr><tr class=\"bg3wiki-attrblock-stat-row\">\n\t<td colspan=\"3\"><p><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><span><picture><source srcset=\"/w/images/thumb/7/75/Duration_Icon.png/24px-Duration_Icon.png.webp, /w/images/thumb/7/75/Duration_Icon.png/36px-Duration_Icon.png.webp 1.5x, /w/images/thumb/7/75/Duration_Icon.png/48px-Duration_Icon.png.webp 2x\"><img src=\"/w/images/thumb/7/75/Duration_Icon.png/24px-Duration_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/7/75/Duration_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Duration</p></td>\n\t<td colspan=\"3\"><p>Until long rest</p></td>\n</tr><tr class=\"bg3wiki-attrblock-stat-row\">\n\t<td colspan=\"3\"><p><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><span><picture><source srcset=\"/w/images/thumb/2/25/HP_Icon.png/24px-HP_Icon.png.webp, /w/images/thumb/2/25/HP_Icon.png/36px-HP_Icon.png.webp 1.5x, /w/images/2/25/HP_Icon.png 2x\"><img src=\"/w/images/thumb/2/25/HP_Icon.png/24px-HP_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/25/HP_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Hit Points</p></td>\n\t<td colspan=\"3\"><p>30</p></td>\n</tr><tr class=\"bg3wiki-attrblock-stat-row\">\n\t<td colspan=\"3\"><p><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><span><picture><source srcset=\"/w/images/thumb/b/b0/Creature_AC_Icon.png/24px-Creature_AC_Icon.png.webp, /w/images/thumb/b/b0/Creature_AC_Icon.png/36px-Creature_AC_Icon.png.webp 1.5x, /w/images/b/b0/Creature_AC_Icon.png 2x\"><img src=\"/w/images/thumb/b/b0/Creature_AC_Icon.png/24px-Creature_AC_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/b/b0/Creature_AC_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Armour Class</p></td>\n\t<td colspan=\"3\"><p>15</p></td>\n</tr><tr class=\"bg3wiki-attrblock-stat-row bg3wiki-attrblock-nowrap\">\n\t<td colspan=\"3\"><p><span class=\"mw-default-size\" typeof=\"mw:File/Frameless\"><span><picture><source srcset=\"/w/images/thumb/5/5f/Creature_Speed_Icon.png/24px-Creature_Speed_Icon.png.webp, /w/images/thumb/5/5f/Creature_Speed_Icon.png/36px-Creature_Speed_Icon.png.webp 1.5x, /w/images/5/5f/Creature_Speed_Icon.png 2x\"><img src=\"/w/images/thumb/5/5f/Creature_Speed_Icon.png/24px-Creature_Speed_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/5/5f/Creature_Speed_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Movement Speed</p></td>\n\t<td colspan=\"3\"><p>12 m (40 ft)</p></td>\n</tr></tbody></table><div style=\"clear: both;\"></div>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Claws_(Flying_Ghoul)\" title=\"Claws (Flying Ghoul)\"><picture><source srcset=\"/w/images/thumb/3/34/Generic_Physical_Icon.webp/40px-Generic_Physical_Icon.webp, /w/images/thumb/3/34/Generic_Physical_Icon.webp/60px-Generic_Physical_Icon.webp 1.5x, /w/images/thumb/3/34/Generic_Physical_Icon.webp/80px-Generic_Physical_Icon.webp 2x\"><img alt=\"Claws\" src=\"/w/images/thumb/3/34/Generic_Physical_Icon.webp/40px-Generic_Physical_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/34/Generic_Physical_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Claws_(Flying_Ghoul)\" title=\"Claws (Flying Ghoul)\">Claws</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>An affected creature can lash out with deadly claws and possibly <span class=\"bg3wiki-icontext\"><span class=\"bg3wiki-icontext-icon\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Paralysed_(Condition)\" title=\"Paralysed (Condition)\"><picture><source srcset=\"/w/images/thumb/0/09/Paralysed_Condition_Icon.webp/25px-Paralysed_Condition_Icon.webp, /w/images/thumb/0/09/Paralysed_Condition_Icon.webp/38px-Paralysed_Condition_Icon.webp 1.5x, /w/images/thumb/0/09/Paralysed_Condition_Icon.webp/50px-Paralysed_Condition_Icon.webp 2x\"><img alt=\"Paralyse\" src=\"/w/images/thumb/0/09/Paralysed_Condition_Icon.webp/25px-Paralysed_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/09/Paralysed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>&nbsp;<span class=\"bg3wiki-icontext-text\"><a href=\"/wiki/Paralysed_(Condition)\" title=\"Paralysed (Condition)\">Paralyse</a></span></span> the target. </dd>\n</dl>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Devour_(Animate_Dead_Ghoul)\" title=\"Devour (Animate Dead Ghoul)\"><picture><source srcset=\"/w/images/thumb/c/c1/Generic_Damage_Icon.webp/40px-Generic_Damage_Icon.webp, /w/images/thumb/c/c1/Generic_Damage_Icon.webp/60px-Generic_Damage_Icon.webp 1.5x, /w/images/thumb/c/c1/Generic_Damage_Icon.webp/80px-Generic_Damage_Icon.webp 2x\"><img alt=\"Devour\" src=\"/w/images/thumb/c/c1/Generic_Damage_Icon.webp/40px-Generic_Damage_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c1/Generic_Damage_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Devour_(Animate_Dead_Ghoul)\" title=\"Devour (Animate Dead Ghoul)\">Devour</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Bite a knocked down, prone, or sleeping target, and deal <span class=\"bg3wiki-damage-type-slashing\">3d10 + Strength Modifier</span>⁠<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Slashing\" title=\"Slashing\"><picture><source srcset=\"/w/images/thumb/f/f0/Slashing_Damage_Icon.png/20px-Slashing_Damage_Icon.png.webp, /w/image