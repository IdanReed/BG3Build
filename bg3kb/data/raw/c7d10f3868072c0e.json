x-Melee_Range_Icon.png.webp, /w/images/thumb/2/2a/Melee_Range_Icon.png/38px-Melee_Range_Icon.png.webp 1.5x, /w/images/2/2a/Melee_Range_Icon.png 2x\"><img alt=\"Melee: 1.5 m (5 ft)\" src=\"/w/images/thumb/2/2a/Melee_Range_Icon.png/25px-Melee_Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2a/Melee_Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Melee: 1.5 m (5 ft)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp, /w/images/thumb/e/ea/Weight_Icon.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 1.8 kg (3.6 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 1.8 kg (3.6 lb)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 100 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  100  gp</dd>\n<dd><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">UNI_RepeatStaff</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:UNI_RepeatStaff\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:UNI_RepeatStaff\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">48b4f49b-2937-4664-ac87-7db2c64d09c9</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:48b4f49b-2937-4664-ac87-7db2c64d09c9\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:48b4f49b-2937-4664-ac87-7db2c64d09c9\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>Stats</summary>\n<code class=\"bg3wiki-uid-box\">UNI_RepeatStaff</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:UNI_RepeatStaff+type:stat\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:UNI_RepeatStaff+type:stat\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></dd></dl>\n</div> \n<h3><span class=\"mw-headline\" id=\"Special\"> Special </span></h3>\n<p><b>The holder of this item gains:</b>\n\n</p>\n<dl><dt><a href=\"/wiki/Natural_Pugilist\" title=\"Natural Pugilist\">Natural Pugilist</a></dt><dd>You gain a +1 bonus to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp, /w/images/thumb/b/ba/Attack_Roll_Icon.png/38px-Attack_Roll_Icon.png.webp 1.5x, /w/images/thumb/b/ba/Attack_Roll_Icon.png/50px-Attack_Roll_Icon.png.webp 2x\"><img alt=\"Melee Unarmed Attack Roll\" src=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/b/ba/Attack_Roll_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Melee Unarmed <a href=\"/wiki/Attack_Roll\" class=\"mw-redirect\" title=\"Attack Roll\">Attack Rolls</a> and damage.</dd></dl><dl><dt><a href=\"/wiki/Unhampered_Resistance\" title=\"Unhampered Resistance\">Unhampered Resistance</a></dt><dd>While the wielder is not wearing armour, they receive a +2 bonus to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp, /w/images/e/e7/Saving_Throw_Icon.png 1.5x\"><img alt=\"Saving Throw\" src=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/e7/Saving_Throw_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Saving_Throw\" class=\"mw-redirect\" title=\"Saving Throw\">Saving Throws</a>.</dd></dl>\n<h3><span class=\"mw-headline\" id=\"Weapon_actions\"> Weapon actions </span></h3>\n<p><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp, /w/images/2/2d/Proficiency_Icon.png 1.5x\"><img alt=\"Proficiency Icon.png\" src=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2d/Proficiency_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <i>If you have <a href=\"/wiki/Proficiency\" title=\"Proficiency\">proficiency</a>, equip in <strong>main hand</strong> to gain:</i>\n</p>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Topple\" title=\"Topple\"><picture><source srcset=\"/w/images/thumb/c/c8/Topple_Icon.webp/40px-Topple_Icon.webp, /w/images/thumb/c/c8/Topple_Icon.webp/60px-Topple_Icon.webp 1.5x, /w/images/thumb/c/c8/Topple_Icon.webp/80px-Topple_Icon.webp 2x\"><img alt=\"Topple\" src=\"/w/images/thumb/c/c8/Topple_Icon.webp/40px-Topple_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c8/Topple_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Topple\" title=\"Topple\">Topple</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Swipe at a creature to knock it <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Prone_(Condition)\" title=\"Prone (Condition)\"><picture><source srcset=\"/w/images/thumb/8/8e/Prone_Condition_Icon.webp/20px-Prone_Condition_Icon.webp, /w/images/thumb/8/8e/Prone_Condition_Icon.webp/30px-Prone_Condition_Icon.webp 1.5x, /w/images/thumb/8/8e/Prone_Condition_Icon.webp/40px-Prone_Condition_Icon.webp 2x\"><img alt=\"Prone\" src=\"/w/images/thumb/8/8e/Prone_Condition_Icon.webp/20px-Prone_Condition_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/8e/Prone_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Prone_(Condition)\" title=\"Prone (Condition)\">Prone</a>. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl></div> \n<h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li><a href=\"/wiki/The_Hollow\" title=\"The Hollow\">The Hollow</a> <span class=\"bg3wiki-coordinates\">X:&nbsp;192&nbsp;Y:&nbsp;546</span>: Sold by <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Auntie_Ethel\" title=\"Auntie Ethel\"><picture><source srcset=\"/w/images/thumb/6/6b/Portrait_Ethel.png/25px-Portrait_Ethel.png.webp, /w/images/thumb/6/6b/Portrait_Ethel.png/38px-Portrait_Ethel.png.webp 1.5x, /w/images/thumb/6/6b/Portrait_Ethel.png/50px-Portrait_Ethel.png.webp 2x\"><img alt=\"Auntie Ethel\" src=\"/w/images/thumb/6/6b/Portrait_Ethel.png/25px-Portrait_Ethel.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/6b/Portrait_Ethel.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Auntie_Ethel\" title=\"Auntie Ethel\">Auntie Ethel</a> in the Hollow in the <a href=\"/wiki/Emerald_Grove\" title=\"Emerald Grove\">Emerald Grove</a></li></ul>\n</div> \n<h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n\n<p><i>Regarding Natural Pugilist:</i></p>\n<ul><li>Unarmed attack bonuses granted by Natural Pugilist are still useful if a <a href=\"/wiki/Monk\" title=\"Monk\">monk</a> is equipped with <a class=\"mw-selflink selflink\">Corellon's Grace</a>, since monks can perform various unarmed attack actions (e.g., <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Unarmed_Strike_(Monk)\" title=\"Unarmed Strike (Monk)\"><picture><source srcset=\"/w/images/thumb/c/ca/Unarmed_Strike_Monk_Icon.webp/20px-Unarmed_Strike_Monk_Icon.webp, /w/images/thumb/c/ca/Unarmed_Strike_Monk_Icon.webp/30px-Unarmed_Strike_Monk_Icon.webp 1.5x, /w/images/thumb/c/ca/Unarmed_Strike_Monk_Icon.webp/40px-Unarmed_Strike_Monk_Icon.webp 2x\"><img alt=\"Unarmed Strike (Monk)\" src=\"/w/images/thumb/c/ca/Unarmed_Strike_Monk_Icon.webp/20px-Unarmed_Strike_Monk_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/ca/Unarmed_Strike_Monk_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Unarmed_Strike_(Monk)\" title=\"Unarmed Strike (Monk)\">Unarmed Strike (Monk)</a>, <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Flurry_of_Blows\" title=\"Flurry of Blows\"><picture><source srcset=\"/w/images/thumb/e/ef/Flurry_of_Blows_Icon.webp/20px-Flurry_of_Blows_Icon.webp, /w/images/thumb/e/ef/Flurry_of_Blows_Icon.webp/30px-Flurry_of_Blows_Icon.webp 1.5x, /w/images/thumb/e/ef/Flurry_of_Blows_Icon.webp/40px-Flurry_of_Blows_Icon.webp 2x\"><img alt=\"Flurry of Blows\" src=\"/w/images/thumb/e/ef/Flurry_of_Blows_Icon.webp/20px-Flurry_of_Blows_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/ef/Flurry_of_Blows_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Flurry_of_Blows\" title=\"Flurry of Blows\">Flurry of Blows</a>, and <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Ki_Resonation:_Punch\" title=\"Ki Resonation: Punch\"><picture><source srcset=\"/w/images/thumb/6/63/Ki_Resonation_Punch_Icon.webp/20px-Ki_Resonation_Punch_Icon.webp, /w/images/thumb/6/63/Ki_Resonation_Punch_Icon.webp/30px-Ki_Resonation_Punch_Icon.webp 1.5x, /w/images/thumb/6/63/Ki_Resonation_Punch_Icon.webp/40px-Ki_Resonation_Punch_Icon.webp 2x\"><img alt=\"Ki Resonation: Punch\" src=\"/w/images/thumb/6/63/Ki_Resonation_Punch_Icon.webp/20px-Ki_Resonation_Punch_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/63/Ki_Resonation_Punch_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Ki_Resonation:_Punch\" title=\"Ki Resonation: Punch\">Ki Resonation: Punch</a>) even when equipped with a melee weapon, as long as it is a <a href=\"/wiki/Monk_weapon\" class=\"mw-redirect\" title=\"Monk weapon\">monk weapon</a>.</li>\n<li>When using an <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Improvised_Melee_Weapon\" title=\"Improvised Melee Weapon\"><picture><source srcset=\"/w/images/thumb/5/52/Improvised_Melee_Weapon_Icon.webp/20px-Improvised_Melee_Weapon_Icon.webp, /w/images/thumb/5/52/Improvised_Melee_Weapon_Icon.webp/30px-Improvised_Melee_Weapon_Icon.webp 1.5x, /w/images/thumb/5/52/Improvised_Melee_Weapon_Icon.webp/40px-Improvised_Melee_Weapon_Icon.webp 2x\"><img alt=\"Improvised Melee Weapon\" src=\"/w/images/thumb/5/52/Improvised_Melee_Weapon_Icon.webp/20px-Improvised_Melee_Weapon_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/52/Improvised_Melee_Weapon_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Improvised_Melee_Weapon\" title=\"Improvised Melee Weapon\">Improvised Melee Weapon</a>, which is considered an unarmed melee attack, Natural Pugilist grants the bonus to the attack roll but not to the damage roll.</li></ul>\n<p><i>Regarding Unhampered Resistance:</i></p>\n<ul><li>Unhampered Resistance works even if the wielder is holding a <a href=\"/wiki/Shields_(equipment)\" title=\"Shields (equipment)\">shield</a>.</li></ul>\n</div> \n<h2><span class=\"mw-headline\" id=\"Bugs\"> Bugs </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n\n<p><i>Regarding Unhampered Resistance:</i></p>\n<ul><li><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-legendary\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Helldusk_Armour\" title=\"Helldusk Armour\"><picture><source srcset=\"/w/images/thumb/a/ae/Helldusk_Armour_Unfaded_Icon.png/20px-Helldusk_Armour_Unfaded_Icon.png.webp, /w/images/thumb/a/ae/Helldusk_Armour_Unfaded_Icon.png/30px-Helldusk_Armour_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/a/ae/Helldusk_Armour_Unfaded_Icon.png/40px-Helldusk_Armour_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/a/ae/Helldusk_Armour_Unfaded_Icon.png/20px-Helldusk_Armour_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/ae/Helldusk_Armour_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> <a href=\"/wiki/Helldusk_Armour\" title=\"Helldusk Armour\">Helldusk Armour</a> and <span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-rare\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Elven_Chain\" title=\"Elven Chain\"><picture><source srcset=\"/w/images/thumb/e/e6/Elven_Chain_Unfaded_Icon.png/20px-Elven_Chain_Unfaded_Icon.png.webp, /w/images/thumb/e/e6/Elven_Chain_Unfaded_Icon.png/30px-Elven_Chain_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/e/e6/Elven_Chain_Unfaded_Icon.png/40px-Elven_Chain_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/e/e6/Elven_Chain_Unfaded_Icon.png/20px-Elven_Chain_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e6/Elven_Chain_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> <a href=\"/wiki/Elven_Chain\" title=\"Elven Chain\">Elven Chain</a> lack an <a href=\"/wiki/Armour_proficiency\" class=\"mw-redirect\" title=\"Armour proficiency\">armour proficiency</a> group, and so can be worn by any character without incurring the normal penalties for lacking proficiency. Because they lack a proficiency group, both armours are not seen as armour proper by Unhampered Resistance and can therefore be used in combination with it.</li></ul>\n</div>    \n<h2><span class=\"mw-headline\" id=\"External_links\">External links</span></h2>\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Corellon%27s_Grace\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/images/thumb/6/68/FRWiki_Icon.png/44px-FRWiki_Icon.png.webp 2x\"><img alt=\"Corellon's Grace\" src=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/FRWiki_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <span class=\"bg3wiki-icontext-extlink\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Corellon%27s_Grace\">Corellon's Grace</a></span> on the <a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Main_Page\">Forgotten Realms Wiki</a></li></ul>\n<!-- \nNewPP limit report\nCached time: 20260714195827\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.136 seconds\nReal time usage: 0.147 seconds\nPreprocessor visited node count: 4609/1000000\nPost‐expand include size: 79390/4194304 bytes\nTemplate argument size: 17800/4194304 bytes\nHighest expansion dept