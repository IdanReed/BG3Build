a/Melee_Range_Icon.png/38px-Melee_Range_Icon.png.webp 1.5x, /w/images/2/2a/Melee_Range_Icon.png 2x\"><img alt=\"Melee: 1.5 m (5 ft)\" src=\"/w/images/thumb/2/2a/Melee_Range_Icon.png/25px-Melee_Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2a/Melee_Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Melee: 1.5 m (5 ft)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp, /w/images/thumb/e/ea/Weight_Icon.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 4.5 kg (9 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 4.5 kg (9 lb)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 65 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  65  gp</dd>\n<dd><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">MAG_Poison_Greatclub</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:MAG_Poison_Greatclub\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:MAG_Poison_Greatclub\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">fddc251b-22d8-4036-a9fb-85fba8635cf0</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:fddc251b-22d8-4036-a9fb-85fba8635cf0\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:fddc251b-22d8-4036-a9fb-85fba8635cf0\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>Stats</summary>\n<code class=\"bg3wiki-uid-box\">MAG_Poison_Greatclub</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:MAG_Poison_Greatclub+type:stat\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:MAG_Poison_Greatclub+type:stat\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></dd></dl>\n</div> \n<h3><span class=\"mw-headline\" id=\"Weapon_actions\"> Weapon actions </span></h3>\n<p><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp, /w/images/2/2d/Proficiency_Icon.png 1.5x\"><img alt=\"Proficiency Icon.png\" src=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2d/Proficiency_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <i>If you have <a href=\"/wiki/Proficiency\" title=\"Proficiency\">proficiency</a>, equip in <strong>main hand</strong> to gain:</i>\n</p>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Concussive_Smash\" title=\"Concussive Smash\"><picture><source srcset=\"/w/images/thumb/5/57/Concussive_Smash_Icon.webp/40px-Concussive_Smash_Icon.webp, /w/images/thumb/5/57/Concussive_Smash_Icon.webp/60px-Concussive_Smash_Icon.webp 1.5x, /w/images/thumb/5/57/Concussive_Smash_Icon.webp/80px-Concussive_Smash_Icon.webp 2x\"><img alt=\"Concussive Smash\" src=\"/w/images/thumb/5/57/Concussive_Smash_Icon.webp/40px-Concussive_Smash_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/57/Concussive_Smash_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Concussive_Smash\" title=\"Concussive Smash\">Concussive Smash</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Hit an enemy with all your might to deal damage and possibly <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Dazed_(Condition)\" title=\"Dazed (Condition)\"><picture><source srcset=\"/w/images/thumb/a/a2/Dazed_Condition_Icon.webp/25px-Dazed_Condition_Icon.webp, /w/images/thumb/a/a2/Dazed_Condition_Icon.webp/38px-Dazed_Condition_Icon.webp 1.5x, /w/images/thumb/a/a2/Dazed_Condition_Icon.webp/50px-Dazed_Condition_Icon.webp 2x\"><img alt=\"Daze\" src=\"/w/images/thumb/a/a2/Dazed_Condition_Icon.webp/25px-Dazed_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a2/Dazed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dazed_(Condition)\" title=\"Dazed (Condition)\">Daze</a> them. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Backbreaker\" title=\"Backbreaker\"><picture><source srcset=\"/w/images/thumb/e/e0/Backbreaker_Icon.webp/40px-Backbreaker_Icon.webp, /w/images/thumb/e/e0/Backbreaker_Icon.webp/60px-Backbreaker_Icon.webp 1.5x, /w/images/thumb/e/e0/Backbreaker_Icon.webp/80px-Backbreaker_Icon.webp 2x\"><img alt=\"Backbreaker\" src=\"/w/images/thumb/e/e0/Backbreaker_Icon.webp/40px-Backbreaker_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e0/Backbreaker_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Backbreaker\" title=\"Backbreaker\">Backbreaker</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Put extra force behind your strike to possibly knock your enemy <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Prone_(Condition)\" title=\"Prone (Condition)\"><picture><source srcset=\"/w/images/thumb/8/8e/Prone_Condition_Icon.webp/25px-Prone_Condition_Icon.webp, /w/images/thumb/8/8e/Prone_Condition_Icon.webp/38px-Prone_Condition_Icon.webp 1.5x, /w/images/thumb/8/8e/Prone_Condition_Icon.webp/50px-Prone_Condition_Icon.webp 2x\"><img alt=\"Prone\" src=\"/w/images/thumb/8/8e/Prone_Condition_Icon.webp/25px-Prone_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/8e/Prone_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Prone_(Condition)\" title=\"Prone (Condition)\">Prone</a>. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Tenacity\" title=\"Tenacity\"><picture><source srcset=\"/w/images/thumb/8/86/Tenacity_Icon.webp/40px-Tenacity_Icon.webp, /w/images/thumb/8/86/Tenacity_Icon.webp/60px-Tenacity_Icon.webp 1.5x, /w/images/thumb/8/86/Tenacity_Icon.webp/80px-Tenacity_Icon.webp 2x\"><img alt=\"Tenacity\" src=\"/w/images/thumb/8/86/Tenacity_Icon.webp/40px-Tenacity_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/86/Tenacity_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Tenacity\" title=\"Tenacity\">Tenacity</a> (<span aria-label=\"Reaction\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/c/c1/Reaction_Icon.png/23px-Reaction_Icon.png.webp, /w/images/thumb/c/c1/Reaction_Icon.png/35px-Reaction_Icon.png.webp 1.5x, /w/images/thumb/c/c1/Reaction_Icon.png/46px-Reaction_Icon.png.webp 2x\"><img alt=\"Reaction\" src=\"/w/images/thumb/c/c1/Reaction_Icon.png/23px-Reaction_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c1/Reaction_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>When you miss an attack, deal <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Bludgeoning\" title=\"Bludgeoning\"><picture><source srcset=\"/w/images/thumb/7/7d/Bludgeoning_Damage_Icon.png/20px-Bludgeoning_Damage_Icon.png.webp, /w/images/thumb/7/7d/Bludgeoning_Damage_Icon.png/30px-Bludgeoning_Damage_Icon.png.webp 1.5x, /w/images/thumb/7/7d/Bludgeoning_Damage_Icon.png/40px-Bludgeoning_Damage_Icon.png.webp 2x\"><img alt=\"Bludgeoning\" src=\"/w/images/thumb/7/7d/Bludgeoning_Damage_Icon.png/20px-Bludgeoning_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/7d/Bludgeoning_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Bludgeoning\" title=\"Bludgeoning\"><span class=\"bg3wiki-damage-type-bludgeoning\">Bludgeoning</span></a> damage equal to your <a href=\"/wiki/Strength\" title=\"Strength\">Strength</a> <a href=\"/wiki/Ability_scores#Ability_score_modifiers\" class=\"mw-redirect\" title=\"Ability scores\">modifier</a> anyway (minimum of 1). </dd>\n</dl>\n<h3><span class=\"mw-headline\" id=\"Special_weapon_actions\"> Special weapon actions </span></h3>\n<p>This weapon also grants the following:\n</p>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Poison_Mist\" title=\"Poison Mist\"><picture><source srcset=\"/w/images/thumb/c/cb/Poison_Mist_Icon.webp/40px-Poison_Mist_Icon.webp, /w/images/thumb/c/cb/Poison_Mist_Icon.webp/60px-Poison_Mist_Icon.webp 1.5x, /w/images/thumb/c/cb/Poison_Mist_Icon.webp/80px-Poison_Mist_Icon.webp 2x\"><img alt=\"Poison Mist\" src=\"/w/images/thumb/c/cb/Poison_Mist_Icon.webp/40px-Poison_Mist_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/cb/Poison_Mist_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Poison_Mist\" title=\"Poison Mist\">Poison Mist</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>On a hit, deal extra <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Poison\" title=\"Poison\"><picture><source srcset=\"/w/images/thumb/5/55/Poison_Damage_Icon.png/20px-Poison_Damage_Icon.png.webp, /w/images/thumb/5/55/Poison_Damage_Icon.png/30px-Poison_Damage_Icon.png.webp 1.5x, /w/images/thumb/5/55/Poison_Damage_Icon.png/40px-Poison_Damage_Icon.png.webp 2x\"><img alt=\"Poison\" src=\"/w/images/thumb/5/55/Poison_Damage_Icon.png/20px-Poison_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/55/Poison_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Poison\" title=\"Poison\"><span class=\"bg3wiki-damage-type-poison\">Poison</span></a> damage equal to your <a href=\"/wiki/Proficiency_bonus\" class=\"mw-redirect\" title=\"Proficiency bonus\">proficiency bonus</a> and surround the target in a <a href=\"/wiki/Poison_Cloud\" title=\"Poison Cloud\">noxious cloud</a> that possibly <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Poisoned_(Condition)\" title=\"Poisoned (Condition)\"><picture><source srcset=\"/w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/20px-Poisoned_Condition_Icon.webp, /w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/30px-Poisoned_Condition_Icon.webp 1.5x, /w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/40px-Poisoned_Condition_Icon.webp 2x\"><img alt=\"Poisons\" src=\"/w/images/thumb/e/e9/Poisoned_Condition_Icon.webp/20px-Poisoned_Condition_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e9/Poisoned_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Poisoned_(Condition)\" title=\"Poisoned (Condition)\">Poisons</a> those within it. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl></div> \n<h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li><a href=\"/wiki/Moonrise_Towers\" title=\"Moonrise Towers\">Moonrise Towers</a> <span class=\"bg3wiki-coordinates\">X:&nbsp;-196&nbsp;Y:&nbsp;-195</span>: Carried by <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Mig\" title=\"Mig\"><picture><source srcset=\"/w/images/thumb/3/38/Portrait_Mig.png/25px-Portrait_Mig.png.webp, /w/images/thumb/3/38/Portrait_Mig.png/38px-Portrait_Mig.png.webp 1.5x, /w/images/thumb/3/38/Portrait_Mig.png/50px-Portrait_Mig.png.webp 2x\"><img alt=\"Mig\" src=\"/w/images/thumb/3/38/Portrait_Mig.png/25px-Portrait_Mig.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/38/Portrait_Mig.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Mig\" title=\"Mig\">Mig</a> on the main floor</li></ul>\n</div> \n<h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n\n<p><i>Regarding Poison Mist:</i></p>\n<ul><li>Targets inside the <a href=\"/wiki/Poison_Cloud\" title=\"Poison Cloud\">Poison Cloud</a> created by Poison Mist roll their saving throws against your <a href=\"/wiki/Spell_save_DC\" class=\"mw-redirect\" title=\"Spell save DC\">spell save DC</a> rather than your <a href=\"/wiki/Weapon_action_DC\" class=\"mw-redirect\" title=\"Weapon action DC\">weapon action DC</a>.</li>\n<li>This action is actually an AoE attack. After striking the main target, an additional attack is made against <i>every</i> creature and object within the 1.5 m (5 ft) cloud radius around that target, including allies. Additional poison clouds are then spawned for each creature and object struck this way.</li></ul>\n</div>     \n<h2><span class=\"mw-headline\" id=\"Gallery\">Gallery</span></h2>\n<ul class=\"gallery mw-gallery-packed\">\n\t\t<li class=\"gallerybox\" style=\"width: 302px\">\n\t\t\t<div class=\"thumb\" style=\"width: 300px;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Argument_Solver_ingame.png\" class=\"mw-file-description\" title=\"Appearance in game\"><picture><source srcset=\"/w/images/thumb/9/95/Argument_Solver_ingame.png/450px-Argument_Solver_ingame.png.webp, /w/images/thumb/9/95/Argument_Solver_ingame.png/675px-Argument_Solver_ingame.png.webp 1.5x, /w/images/9/95/Argument_Solver_ingame.png 2x\"><img alt=\"Appearance in game\" src=\"/w/images/thumb/9/95/Argument_Solver_ingame.png/450px-Argument_Solver_ingame.png.webp\" decoding=\"async\" width=\"300\" height=\"300\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/95/Argument_Solver_ingame.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n\t\t\t<div class=\"gallerytext\">Appearance in game</div>\n\t\t</li>\n</ul>\n<h2><span class=\"mw-headline\" id=\"External_links\">External links</span></h2>\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Argument_Solver\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FR