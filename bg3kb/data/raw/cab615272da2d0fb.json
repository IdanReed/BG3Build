stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">UNI_UND_SocietyOfBrilliance_MagicMissileNecklace</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:UNI_UND_SocietyOfBrilliance_MagicMissileNecklace\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:UNI_UND_SocietyOfBrilliance_MagicMissileNecklace\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">4a9f0479-954f-486c-9534-d7d72c11f919</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:4a9f0479-954f-486c-9534-d7d72c11f919\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:4a9f0479-954f-486c-9534-d7d72c11f919\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>Stats</summary>\n<code class=\"bg3wiki-uid-box\">UND_SocietyOfBrilliance_MagicMissileNecklace</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:UND_SocietyOfBrilliance_MagicMissileNecklace+type:stat\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:UND_SocietyOfBrilliance_MagicMissileNecklace+type:stat\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div> \n<h3><span class=\"mw-headline\" id=\"Special\">Special</span></h3>\n<p>The wearer of this item gains:\n\n</p>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Magic_Missile\" title=\"Magic Missile\"><picture><source srcset=\"/w/images/thumb/d/d4/Magic_Missile_Icon.webp/40px-Magic_Missile_Icon.webp, /w/images/thumb/d/d4/Magic_Missile_Icon.webp/60px-Magic_Missile_Icon.webp 1.5x, /w/images/thumb/d/d4/Magic_Missile_Icon.webp/80px-Magic_Missile_Icon.webp 2x\"><img alt=\"Magic Missile\" src=\"/w/images/thumb/d/d4/Magic_Missile_Icon.webp/40px-Magic_Missile_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d4/Magic_Missile_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Magic_Missile\" title=\"Magic Missile\">Magic Missile</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Cast as a level 1 spell (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Long rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Long_rest\" class=\"mw-redirect\" title=\"Long rest\">Long rest</a>.)</dd>\n</dl>\n<dl><dt><a href=\"/wiki/Psychic_Missiles\" title=\"Psychic Missiles\">Psychic Missiles</a></dt><dd>Shoot an additional dart whenever you cast <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Magic_Missile\" title=\"Magic Missile\"><picture><source srcset=\"/w/images/thumb/d/d4/Magic_Missile_Icon.webp/25px-Magic_Missile_Icon.webp, /w/images/thumb/d/d4/Magic_Missile_Icon.webp/38px-Magic_Missile_Icon.webp 1.5x, /w/images/thumb/d/d4/Magic_Missile_Icon.webp/50px-Magic_Missile_Icon.webp 2x\"><img alt=\"Magic Missile\" src=\"/w/images/thumb/d/d4/Magic_Missile_Icon.webp/25px-Magic_Missile_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d4/Magic_Missile_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Magic_Missile\" title=\"Magic Missile\">Magic Missile</a>.</dd></dl>\n<div style=\"clear: both;\"></div></div>    \n<h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li><a href=\"/wiki/Ebonlake_Grotto\" title=\"Ebonlake Grotto\">Ebonlake Grotto</a> <span class=\"bg3wiki-coordinates\">X:&nbsp;111&nbsp;Y:&nbsp;-89</span>: Sold by <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Blurg\" title=\"Blurg\"><picture><source srcset=\"/w/images/thumb/b/b7/Portrait_Blurg.png/25px-Portrait_Blurg.png.webp, /w/images/thumb/b/b7/Portrait_Blurg.png/38px-Portrait_Blurg.png.webp 1.5x, /w/images/thumb/b/b7/Portrait_Blurg.png/50px-Portrait_Blurg.png.webp 2x\"><img alt=\"Blurg\" src=\"/w/images/thumb/b/b7/Portrait_Blurg.png/25px-Portrait_Blurg.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b7/Portrait_Blurg.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Blurg\" title=\"Blurg\">Blurg</a></li></ul>\n</div> \n<h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n\n<p><i>Regarding Psychic Missiles:</i></p>\n<ul><li>Psychic Missiles applies when the wearer casts <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Magic_Missile\" title=\"Magic Missile\"><picture><source srcset=\"/w/images/thumb/d/d4/Magic_Missile_Icon.webp/20px-Magic_Missile_Icon.webp, /w/images/thumb/d/d4/Magic_Missile_Icon.webp/30px-Magic_Missile_Icon.webp 1.5x, /w/images/thumb/d/d4/Magic_Missile_Icon.webp/40px-Magic_Missile_Icon.webp 2x\"><img alt=\"Magic Missile\" src=\"/w/images/thumb/d/d4/Magic_Missile_Icon.webp/20px-Magic_Missile_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d4/Magic_Missile_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Magic_Missile\" title=\"Magic Missile\">Magic Missile</a> via any means, not just the once-per-long-rest usage granted by the item.</li>\n<li>During early access, this passive caused Magic Missile to deal an additional 1d4 Psychic damage per missile.</li></ul>\n</div>  \n<h3><span class=\"mw-headline\" id=\"External_links\">External links</span></h3>\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://forgottenrealms.fandom.com/wiki/Psychic_Spark\" target=\"_blank\" rel=\"noreferrer noopener\"><picture><source srcset=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp, /w/images/thumb/6/68/FRWiki_Icon.png/33px-FRWiki_Icon.png.webp 1.5x, /w/images/thumb/6/68/FRWiki_Icon.png/44px-FRWiki_Icon.png.webp 2x\"><img alt=\"Psychic Spark\" src=\"/w/images/thumb/6/68/FRWiki_Icon.png/22px-FRWiki_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"22\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/68/FRWiki_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <span class=\"bg3wiki-icontext-extlink\"><a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Psychic_Spark\">Psychic Spark</a></span> on the <a target=\"_blank\" rel=\"noreferrer noopener\" class=\"external text\" href=\"https://forgottenrealms.fandom.com/wiki/Main_Page\">Forgotten Realms Wiki</a></li></ul>\n<!-- \nNewPP limit report\nCached time: 20260714195513\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.092 seconds\nReal time usage: 0.100 seconds\nPreprocessor visited node count: 3028/1000000\nPost‐expand include size: 41541/4194304 bytes\nTemplate argument size: 10663/4194304 bytes\nHighest expansion depth: 26/200\nExpensive parser function count: 2/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 4/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.021/7.000 seconds\nLua memory usage: 1462334/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%   83.092      1 -total\n 97.20%   80.766      1 Template:EquipmentPage\n 26.81