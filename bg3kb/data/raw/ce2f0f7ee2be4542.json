Poison_Immunity.png/28px-Poison_Immunity.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c0/Poison_Immunity.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li><li><span typeof=\"mw:File\"><span title=\"Immune to all Psychic\"><picture><source srcset=\"/w/images/thumb/4/4f/Psychic_Immunity.png/28px-Psychic_Immunity.png.webp, /w/images/thumb/4/4f/Psychic_Immunity.png/42px-Psychic_Immunity.png.webp 1.5x, /w/images/thumb/4/4f/Psychic_Immunity.png/56px-Psychic_Immunity.png.webp 2x\"><img alt=\"Immune to all Psychic\" src=\"/w/images/thumb/4/4f/Psychic_Immunity.png/28px-Psychic_Immunity.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/4/4f/Psychic_Immunity.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li><li><span typeof=\"mw:File\"><span title=\"Immune to all Thunder\"><picture><source srcset=\"/w/images/thumb/7/7f/Thunder_Immunity.png/28px-Thunder_Immunity.png.webp, /w/images/thumb/7/7f/Thunder_Immunity.png/42px-Thunder_Immunity.png.webp 1.5x, /w/images/thumb/7/7f/Thunder_Immunity.png/56px-Thunder_Immunity.png.webp 2x\"><img alt=\"Immune to all Thunder\" src=\"/w/images/thumb/7/7f/Thunder_Immunity.png/28px-Thunder_Immunity.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/7/7f/Thunder_Immunity.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li><li><span typeof=\"mw:File\"><span title=\"Vulnerable to Radiant\"><picture><source srcset=\"/w/images/thumb/c/c3/Radiant_Vulnerability.png/28px-Radiant_Vulnerability.png.webp, /w/images/thumb/c/c3/Radiant_Vulnerability.png/42px-Radiant_Vulnerability.png.webp 1.5x, /w/images/thumb/c/c3/Radiant_Vulnerability.png/56px-Radiant_Vulnerability.png.webp 2x\"><img alt=\"Vulnerable to Radiant\" src=\"/w/images/thumb/c/c3/Radiant_Vulnerability.png/28px-Radiant_Vulnerability.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c3/Radiant_Vulnerability.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li></ul></div>\n</div></section><section class=\"pi-item pi-group pi-border-color\"><h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Conditions</h2><div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"conditions\" data-item-name=\"conditions\">\n\t<div class=\"pi-data-value pi-font\"><ul><li><div class=\"bg3wiki-pi-creature-detail\"><div class=\"bg3wiki-pi-creature-detail-title\"><p><span class=\"bg3wiki-icontext-block\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Umbral_Tremor_(Condition)\" title=\"Umbral Tremor (Condition)\"><picture><source srcset=\"/w/images/thumb/7/76/Generic_Info_Condition_Icon.webp/25px-Generic_Info_Condition_Icon.webp, /w/images/thumb/7/76/Generic_Info_Condition_Icon.webp/38px-Generic_Info_Condition_Icon.webp 1.5x, /w/images/thumb/7/76/Generic_Info_Condition_Icon.webp/50px-Generic_Info_Condition_Icon.webp 2x\"><img alt=\"Umbral Tremor\" src=\"/w/images/thumb/7/76/Generic_Info_Condition_Icon.webp/25px-Generic_Info_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/76/Generic_Info_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Umbral_Tremor_(Condition)\" title=\"Umbral Tremor (Condition)\"><b>Umbral Tremor</b></a></span></p></div><div class=\"bg3wiki-pi-creature-detail-text\"><ul><li>The Umbral Tremor is about to open - unleashing the Nightsinger's fell hordes.</li></ul></div></div></li></ul></div>\n</div></section></section>\n\t\t\t</div>\n\t</div>\n</section><section class=\"pi-item pi-group pi-border-color pi-collapse pi-collapse-closed\"><h2 class=\"pi-item pi-header pi-secondary-font pi-item-spacing pi-secondary-background\">Technical</h2><div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"uid\">\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"bg3wiki-tech-label\">UID</div></h3>\n\t<div class=\"pi-data-value pi-font\"><div class=\"bg3wiki-tech-data\"><code>PUZ_SHA_Shadowquake_Character</code> <span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:PUZ_SHA_Shadowquake_Character+type:localcharacter%2Cglobalcharacter%2Ccharactertemplate\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:PUZ_SHA_Shadowquake_Character+type:localcharacter%2Cglobalcharacter%2Ccharactertemplate\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></div></div>\n</div><div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"uuid\">\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"bg3wiki-tech-label\">UUID</div></h3>\n\t<div class=\"pi-data-value pi-font\"><div class=\"bg3wiki-tech-data\"><code>10c407cd-1d75-4832-8e0a-9354b3d5919f</code> <span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:10c407cd-1d75-4832-8e0a-9354b3d5919f\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:10c407cd-1d75-4832-8e0a-9354b3d5919f\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></div></div>\n</div><div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"stats\">\n\t\t<h3 class=\"pi-data-label pi-secondary-font\"><div class=\"bg3wiki-tech-label\">Stats</div></h3>\n\t<div class=\"pi-data-value pi-font\"><div class=\"bg3wiki-tech-data\"><code>SHA_Shadowquake_Character</code> <span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:SHA_Shadowquake_Character+type:statscharacter\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:SHA_Shadowquake_Character+type:statscharacter\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></div></div>\n</div></section></aside>\n<b>Umbral Tremors</b> are environmental entities found in <a href=\"/wiki/Act_Two\" title=\"Act Two\">Act Two</a>.\n\n<h2><span class=\"mw-headline\" id=\"Involvement\">Involvement</span></h2>\n<h3><span class=\"mw-headline\" id=\"Act_Two\">Act Two</span></h3>\n<p>Umbral tremors are rumbling portals of darkness that serve as the first line of defense in the <a href=\"/wiki/Gauntlet_of_Shar\" title=\"Gauntlet of Shar\">Gauntlet of Shar</a>. They summon <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Dark_Justiciar\" title=\"Dark Justiciar\"><picture><source srcset=\"/w/images/thumb/0/02/Portrait_Lyrthindor.png/25px-Portrait_Lyrthindor.png.webp, /w/images/thumb/0/02/Portrait_Lyrthindor.png/38px-Portrait_Lyrthindor.png.webp 1.5x, /w/images/thumb/0/02/Portrait_Lyrthindor.png/50px-Portrait_Lyrthindor.png.webp 2x\"><img alt=\"Dark Justiciar\" src=\"/w/images/thumb/0/02/Portrait_Lyrthindor.png/25px-Portrait_Lyrthindor.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/02/Portrait_Lyrthindor.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dark_Justiciar\" title=\"Dark Justiciar\">Dark Justiciars</a> to battle against invaders.\n</p>\n<h2><span class=\"mw-headline\" id=\"Combat\">Combat</span></h2>\n<h3><span class=\"mw-headline\" id=\"Attacks_and_actions\">Attacks and actions</span></h3>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\"><div class=\"bg3wiki-tooltip-box-image nomobile\"><figure class=\"mw-halign-right\" typeof=\"mw:File/Frameless\"><a href=\"/wiki/File:Generic_Summon.webp\" class=\"mw-file-description\"><picture><source srcset=\"/w/images/thumb/2/26/Generic_Summon.webp/100px-Generic_Summon.webp, /w/images/thumb/2/26/Generic_Summon.webp/150px-Generic_Summon.webp 1.5x, /w/images/thumb/2/26/Generic_Summon.webp/200px-Generic_Summon.webp 2x\"><img src=\"/w/images/thumb/2/26/Generic_Summon.webp/100px-Generic_Summon.webp\" decoding=\"async\" width=\"100\" height=\"100\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/26/Generic_Summon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a><figcaption></figcaption></figure></div>\n<div class=\"bg3wiki-tooltip-box-header\"><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Permit_Passage\" title=\"Permit Passage\"><picture><source srcset=\"/w/images/thumb/b/b0/Generic_Summon_Icon.webp/40px-Generic_Summon_Icon.webp, /w/images/thumb/b/b0/Generic_Summon_Icon.webp/60px-Generic_Summon_Icon.webp 1.5x, /w/images/thumb/b/b0/Generic_Summon_Icon.webp/80px-Generic_Summon_Icon.webp 2x\"><img alt=\"Permit Passage\" src=\"/w/images/thumb/b/b0/Generic_Summon_Icon.webp/40px-Generic_Summon_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b0/Generic_Summon_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Permit_Passage\" title=\"Permit Passage\">Permit Passage</a> (<span aria-label=\"Bonus Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp, /w/images/thumb/c/c9/Bonus_Action_Icon.png/35px-Bonus_Action_Icon.png.webp 1.5x, /w/images/thumb/c/c9/Bonus_Action_Icon.png/46px-Bonus_Action_Icon.png.webp 2x\"><img alt=\"Bonus Action\" src=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c9/Bonus_Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</div>\n<div class=\"bg3wiki-tooltip-box-content\">\n<p>The Umbral Tremor has opened, letting through a <a href=\"/wiki/Dark_Justiciar\" title=\"Dark Justiciar\">Dark Justiciar</a>\n</p>\n</div> \n<div class=\"bg3wiki-tooltip-box-footer\"><div class=\"bg3wiki-horizontlist\"> \n<dl><dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Per turn\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: Per turn</dd></dl>\n    </div></div>\n<div style=\"clear: both;\"></div>\n</div>\n<h3><span class=\"mw-headline\" id=\"Tactics\">Tactics</span></h3>\n<ul><li><a href=\"/wiki/NPC\" class=\"mw-redirect\" title=\"NPC\">NPCs</a> attack Umbral Tremors with the lowest priority, ignoring it until all other enemies are already defeated, and even then occasionally skipping their turns instead of attacking.</li>\n<li>One umbral tremor is an exception, the <b>Deep Umbral Tremor</b>, spawning in at <span class=\"bg3wiki-coordinates\">X:&nbsp;-820&nbsp;Y:&nbsp;-786</span> during the final wave of the scripted battle outside of <a href=\"/wiki/Gauntlet_of_Shar#Balthazar's_Outpost\" title=\"Gauntlet of Shar\">Balthazar's Outpost</a> in the <a href=\"/wiki/Gauntlet_of_Shar\" title=\"Gauntlet of Shar\">Gauntlet of Shar</a>. This tremor has twice as much health and summons a single <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Justiciar_Crusader\" title=\"Justiciar Crusader\"><picture><source srcset=\"/w/images/thumb/8/8d/Portrait_Justiciar_Crusader.png/25px-Portrait_Justiciar_Crusader.png.webp, /w/images/thumb/8/8d/Portrait_Justiciar_Crusader.png/38px-Portrait_Justiciar_Crusader.png.webp 1.5x, /w/images/thumb/8/8d/Portrait_Justiciar_Crusader.png/50px-Portrait_Justiciar_Crusader.png.webp 2x\"><img alt=\"Justiciar Crusader\" src=\"/w/images/thumb/8/8d/Portrait_Justiciar_Crusader.png/25px-Portrait_Justiciar_Crusader.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/8d/Portrait_Justiciar_Crusader.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Justiciar_Crusader\" title=\"Justiciar Crusader\">Justiciar Crusader</a> before dissipating.</li>\n<li>Since the Tremors themselves do not award <a href=\"/wiki/Experience\" title=\"Experience\">XP</a> for killing them, but the Justiciars they summon do, it may be worthwhile to exhaust them instead of closing them prematurely.</li>\n<li>Each Umbral Tremor (except the Deep Umbral Tremor) can summon up to three <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Dark_Justiciar\" title=\"Dark Justiciar\"><picture><source srcset=\"/w/images/thumb/0/02/Portrait_Lyrthindor.png/25px-Portrait_Lyrthindor.png.webp, /w/images/thumb/0/02/Portrait_Lyrthindor.png/38px-Portrait_Lyrthindor.png.webp 1.5x, /w/images/thumb/0/02/Portrait_Lyrthindor.png/50px-Portrait_Lyrthindor.png.webp 2x\"><img alt=\"Dark Justiciar\" src=\"/w/images/thumb/0/02/Portrait_Lyrthindor.png/25px-Portrait_Lyrthindor.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/02/Portrait_Lyrthindor.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dark_Justiciar\" title=\"Dark Justiciar\">Dark Justiciars</a> before disappearing.</li></ul>\n<!-- \nNewPP limit report\nCached time: 20260714231409\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.145 seconds\nReal time usage: 0.150 seconds\nPreprocessor visited node count: 6028/1000000\nPost‐expand include size: 56564/4194304 bytes\nTemplate argument size: 22513/4194304 bytes\nHighest expansion depth: 23/200\nExpensive parser function count: 2/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 14067/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.038/7.000 seconds\nLua memory usage: 1535452/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%  139.126      1 -total\n 82.58%  114.884      1 Template:Infobox_creature\n 59.57%   82.879      1 Template:Infobox_creature/internal\n 17.99%   25.027      1 Template:Hidden_code\n 14.43%   20.077     44 Template:Trim\n 12.51%   17.404      1 Template:Feature_box\n  9.25%   12.872      3 Template:Template_style\n  9.17%   12.753      1 Template:Feature_box/format\n  7.14%    9.932      6 Template:Icon_text\n  6.67%    9.285      1 Template:Tooltip_box\n-->\n\n<!-- Saved in parser cache with key bg3wiki:pcache:idhash:31731-0!canonical and timestamp 20260714231409 and revisi