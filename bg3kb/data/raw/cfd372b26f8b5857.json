/ALCH_Esmeltar_Red_Unfaded_Icon.png 2x\"><img alt=\"\" src=\"/w/images/thumb/3/3f/ALCH_Esmeltar_Red_Unfaded_Icon.png/40px-ALCH_Esmeltar_Red_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/3f/ALCH_Esmeltar_Red_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Drink_Supply_Table\" title=\"Drink Supply Table\">Drink Supply Table</a></span> </th>\n<td style=\"text-align:center\">1</td>\n<td style=\"text-align:center\">Always</td></tr>\n</tbody></table>\n<h4><span class=\"mw-headline\" id=\"Supply_pack\">Supply pack</span></h4>\n<p><i>Always drops 1 Supply Pack, worth 40 supplies.</i>\n</p>\n<table class=\"wikitable sortable\">\n\n<tbody><tr>\n  <th colspan=\"2\">Item</th>\n  <th>Quantity</th>\n  <th>Chance</th>\n</tr>\n\n<tr>\n\n\n<th style=\"text-align: left; padding: 0.4rem\" colspan=\"2\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 6px\"><span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Supply_Pack\" title=\"Supply Pack\"><picture><source srcset=\"/w/images/thumb/0/08/Supply_Pack_Unfaded_Icon.png/40px-Supply_Pack_Unfaded_Icon.png.webp, /w/images/thumb/0/08/Supply_Pack_Unfaded_Icon.png/60px-Supply_Pack_Unfaded_Icon.png.webp 1.5x, /w/images/0/08/Supply_Pack_Unfaded_Icon.png 2x\"><img alt=\"\" src=\"/w/images/thumb/0/08/Supply_Pack_Unfaded_Icon.png/40px-Supply_Pack_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/08/Supply_Pack_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span><a href=\"/wiki/Supply_Pack\" title=\"Supply Pack\">Supply Pack</a></span> </th>\n<td style=\"text-align:center\">1</td>\n<td style=\"tex