_Zevlor.png/60px-Portrait_Zevlor.png.webp 2x\"><img alt=\"Zevlor\" src=\"/w/images/thumb/e/e7/Portrait_Zevlor.png/30px-Portrait_Zevlor.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e7/Portrait_Zevlor.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Zevlor\" title=\"Zevlor\">Zevlor</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Zira\" title=\"Zira\"><picture><source srcset=\"/w/images/thumb/a/a0/Portrait_Zira.png/30px-Portrait_Zira.png.webp, /w/images/thumb/a/a0/Portrait_Zira.png/45px-Portrait_Zira.png.webp 1.5x, /w/images/thumb/a/a0/Portrait_Zira.png/60px-Portrait_Zira.png.webp 2x\"><img alt=\"Zira\" src=\"/w/images/thumb/a/a0/Portrait_Zira.png/30px-Portrait_Zira.png.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a0/Portrait_Zira.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Zira\" title=\"Zira\">Zira</a></li>\n</ul></div>\n<h2><span class=\"mw-headline\" id=\"Conditions_with_the_same_stack_ID\"> Conditions with the same stack ID </span></h2>\nConditions with the <a href=\"/wiki/Stack_ID\" class=\"mw-redirect\" title=\"Stack ID\">stack ID</a> <code>AURA_OF_PROTECTION</code>, only one of these can be applied at the same time:<table class=\"wikitable sortable\" style=\"width:100%;\">\n<tbody><tr>\n  <th>Condition</th>\n  <th>Effects</th>\n</tr>\n<tr id=\"Aura_of_Protection\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Aura_of_Protection_(Aura)_(Condition)\" title=\"Aura of Protection (Aura) (Condition)\"><picture><source srcset=\"/w/images/thumb/3/3a/Aura_of_Protection_Condition_Icon.webp/30px-Aura_of_Protection_Condition_Icon.webp, /w/images/thumb/3/3a/Aura_of_Protection_Condition_Icon.webp/45px-Aura_of_Protection_Condition_Icon.webp 1.5x, /w/images/thumb/3/3a/Aura_of_Protection_Condition_Icon.webp/60px-Aura_of_Protection_Condition_Icon.webp 2x\"><img alt=\"Aura of Protection\" src=\"/w/images/thumb/3/3a/Aura_of_Protection_Condition_Icon.webp/30px-Aura_of_Protection_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/3a/Aura_of_Protection_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a class=\"mw-selflink selflink\">Aura of Protection</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>The creature and its allies within 3 m (10 ft) gain the creature's <a href=\"/wiki/Charisma\" title=\"Charisma\">charisma modifier</a> as a bonus to their <a href=\"/wiki/Saving_throw\" class=\"mw-redirect\" title=\"Saving throw\">saving throws</a>.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Aura_of_Protection\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Aura_of_Protection_(Condition)\" title=\"Aura of Protection (Condition)\"><picture><source srcset=\"/w/images/thumb/3/3a/Aura_of_Protection_Condition_Icon.webp/30px-Aura_of_Protection_Condition_Icon.webp, /w/images/thumb/3/3a/Aura_of_Protection_Condition_Icon.webp/45px-Aura_of_Protection_Condition_Icon.webp 1.5x, /w/images/thumb/3/3a/Aura_of_Protection_Condition_Icon.webp/60px-Aura_of_Protection_Condition_Icon.webp 2x\"><img alt=\"Aura of Protection\" src=\"/w/images/thumb/3/3a/Aura_of_Protection_Condition_Icon.webp/30px-Aura_of_Protection_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/3a/Aura_of_Protection_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Aura_of_Protection_(Condition)\" title=\"Aura of Protection (Condition)\">Aura of Protection</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Gains a bonus to <a href=\"/wiki/Saving_throw\" class=\"mw-redirect\" title=\"Saving throw\">saving throws</a> equal to the <a href=\"/wiki/Charisma\" title=\"Charisma\">charisma modifier</a> of the creature emanating the aura.</li></ul>\n</td>\n\n</tr>\n</tbody></table><div class=\"bg3wiki-preview-only\">\n\n<h2><span class=\"mw-headline\" id=\"Brief_preview\"> Brief preview </span></h2>\n<div class=\"bg3wiki-tooltip-box\">The creature and its allies within 3 m (10 ft) gain the creature's <a href=\"/wiki/Charisma\" title=\"Charisma\">charisma modifier</a> as a bonus to their <a href=\"/wiki/Saving_throw\" class=\"mw-redirect\" title=\"Saving throw\">saving throws</a>.</div>\n</div>\n<!-- \nNewPP limit report\nCached time: 20260714202353\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.220 seconds\nReal time usage: 0.230 seconds\nPreprocessor visited node count: 14482/1000000\nPost‐expand include size: 231775/4194304 bytes\nTemplate argument size: 62754/4194304 bytes\nHighest expansion depth: 28/200\nExpensive parser function count: 40/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 0/5000000 bytes\nExtLoops count: 4/1000\nLua time usage: 0.134/7.000 seconds\nLua memory usage: 1297534/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%  190.994      1 Template:Condition_page\n100.00%  190.994      1 -total\n 80.05%  152.893      3 Template:Hidden_code\n 72.76%  138.960      2 Template:Condition_sources\n 63.39%  121.064     41 Template:Condition_sources/format\n 58.86%  112.411     40 Template:MdCharLink\n 42.