ge_Icon.png/38px-Range_Icon.png.webp 1.5x, /w/images/0/08/Range_Icon.png 2x\"><img alt=\"Range: 18 m (60 ft)\" src=\"/w/images/thumb/0/08/Range_Icon.png/25px-Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/0/08/Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Range: 18 m (60 ft)</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp, /w/images/thumb/d/d0/Aoe_Icon.png/38px-Aoe_Icon.png.webp 1.5x, /w/images/d/d0/Aoe_Icon.png 2x\"><img alt=\"AoE: 1 m (3 ft) Radius\" src=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/d/d0/Aoe_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> AoE: 1 m (3 ft) Radius</li></ul></li></ul>\n<div style=\"clear: both;\"></div></div>\n<h2><span class=\"mw-headline\" id=\"Condition:_Invisible\"> Condition: Invisible </span></h2>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\">\n<div class=\"bg3wiki-condition\"><strong><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Invisible_(Condition)\" title=\"Invisible (Condition)\"><picture><source srcset=\"/w/images/thumb/d/d7/Invisible_Condition_Icon.webp/30px-Invisible_Condition_Icon.webp, /w/images/thumb/d/d7/Invisible_Condition_Icon.webp/45px-Invisible_Condition_Icon.webp 1.5x, /w/images/thumb/d/d7/Invisible_Condition_Icon.webp/60px-Invisible_Condition_Icon.webp 2x\"><img alt=\"Invisible\" src=\"/w/images/thumb/d/d7/Invisible_Condition_Icon.webp/30px-Invisible_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d7/Invisible_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Invisible_(Condition)\" title=\"Invisible (Condition)\">Invisible</a></strong><p><span class=\"bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp, /w/images/thumb/6/6a/Duration_Icons.png/38px-Duration_Icons.png.webp 1.5x, /w/images/thumb/6/6a/Duration_Icons.png/50px-Duration_Icons.png.webp 2x\"><img alt=\"Duration Icons.png\" src=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/6/6a/Duration_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Duration: 10  turns</p>\n<div>\n<ul><li>Has <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Advantage\" title=\"Advantage\"><picture><source srcset=\"/w/images/thumb/f/fc/Advantage_Icon.png/28px-Advantage_Icon.png.webp, /w/images/thumb/f/fc/Advantage_Icon.png/42px-Advantage_Icon.png.webp 1.5x, /w/images/thumb/f/fc/Advantage_Icon.png/55px-Advantage_Icon.png.webp 2x\"><img alt=\"Advantage\" src=\"/w/images/thumb/f/fc/Advantage_Icon.png/28px-Advantage_Icon.png.webp\" decoding=\"async\" width=\"28\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/fc/Advantage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Advantage\" title=\"Advantage\">Advantage</a> on <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp, /w/images/thumb/b/ba/Attack_Roll_Icon.png/38px-Attack_Roll_Icon.png.webp 1.5x, /w/images/thumb/b/ba/Attack_Roll_Icon.png/50px-Attack_Roll_Icon.png.webp 2x\"><img alt=\"Attack Roll\" src=\"/w/images/thumb/b/ba/Attack_Roll_Icon.png/25px-Attack_Roll_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/b/ba/Attack_Roll_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Attack_Roll\" class=\"mw-redirect\" title=\"Attack Roll\">Attack Rolls</a> and imposes <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Disadvantage\" title=\"Disadvantage\"><picture><source srcset=\"/w/images/thumb/b/b9/Disadvantage_Icon.png/27px-Disadvantage_Icon.png.webp, /w/images/thumb/b/b9/Disadvantage_Icon.png/41px-Disadvantage_Icon.png.webp 1.5x, /w/images/thumb/b/b9/Disadvantage_Icon.png/55px-Disadvantage_Icon.png.webp 2x\"><img alt=\"Disadvantage\" src=\"/w/images/thumb/b/b9/Disadvantage_Icon.png/27px-Disadvantage_Icon.png.webp\" decoding=\"async\" width=\"27\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b9/Disadvantage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Disadvantage\" class=\"mw-redirect\" title=\"Disadvantage\">Disadvantage</a> on enemy Attack Rolls.</li></ul>\n<p><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Prerequisite_Icon.png/25px-Prerequisite_Icon.png.webp, /w/images/thumb/f/fd/Prerequisite_Icon.png/38px-Prerequisite_Icon.png.webp 1.5x, /w/images/f/fd/Prerequisite_Icon.png 2x\"><img alt=\"Prerequisite Icon.png\" src=\"/w/images/thumb/f/fd/Prerequisite_Icon.png/25px-Prerequisite_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Prerequisite_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span><span class=\"bg3wiki-prereq\">Invisibility ends early if the invisible entity attacks, casts another spell, interacts with an object, becomes wet, takes an action or bonus action, or is damaged.</span>\n</p>\n</div>\n </div>\n</div>    <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>Sold by various <a href=\"/wiki/Traders\" title=\"Traders\">merchants</a> throughout the game (provided the player character is of high enough level, often 6+), including:\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Auntie_Ethel\" title=\"Auntie Ethel\"><picture><source srcset=\"/w/images/thumb/6/6b/Portrait_Ethel.png/25px-Portrait_Ethel.png.webp, /w/images/thumb/6/6b/Portrait_Ethel.png/38px-Portrait_Ethel.png.webp 1.5x, /w/images/thumb/6/6b/Portrait_Ethel.png/50px-Portrait_Ethel.png.webp 2x\"><img alt=\"Auntie Ethel\" src=\"/w/images/thumb/6/6b/Portrait_Ethel.png/25px-Portrait_Ethel.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/6/6b/Portrait_Ethel.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Auntie_Ethel\" title=\"Auntie Ethel\">Auntie Ethel</a> in the <a href=\"/wiki/Druid_Grove\" class=\"mw-redirect\" title=\"Druid Grove\">Druid Grove</a> or the <a href=\"/wiki/Riverside_Teahouse\" class=\"mw-redirect\" title=\"Riverside Teahouse\">Riverside Teahouse</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Brem\" title=\"Brem\"><picture><source srcset=\"/w/images/thumb/2/2b/Portrait_Brem.png/25px-Portrait_Brem.png.webp, /w/images/thumb/2/2b/Portrait_Brem.png/38px-Portrait_Brem.png.webp 1.5x, /w/images/thumb/2/2b/Portrait_Brem.png/50px-Portrait_Brem.png.webp 2x\"><img alt=\"Brem\" src=\"/w/images/thumb/2/2b/Portrait_Brem.png/25px-Portrait_Brem.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/2b/Portrait_Brem.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Brem\" title=\"Brem\">Brem</a> in the <a href=\"/wiki/Zhentarim_Hideout\" class=\"mw-redirect\" title=\"Zhentarim Hideout\">Zhentarim Hideout</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Derryth_Bonecloak\" title=\"Derryth Bonecloak\"><picture><source srcset=\"/w/images/thumb/7/7e/Portrait_Derryth_Bonecloak.png/25px-Portrait_Derryth_Bonecloak.png.webp, /w/images/thumb/7/7e/Portrait_Derryth_Bonecloak.png/38px-Portrait_Derryth_Bonecloak.png.webp 1.5x, /w/images/thumb/7/7e/Portrait_Derryth_Bonecloak.png/50px-Portrait_Derryth_Bonecloak.png.webp 2x\"><img alt=\"Derryth Bonecloak\" src=\"/w/images/thumb/7/7e/Portrait_Derryth_Bonecloak.png/25px-Portrait_Derryth_Bonecloak.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/7e/Portrait_Derryth_Bonecloak.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Derryth_Bonecloak\" title=\"Derryth Bonecloak\">Derryth Bonecloak</a> in the <a href=\"/wiki/Myconid_Colony\" class=\"mw-redirect\" title=\"Myconid Colony\">Myconid Colony</a></li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Roah_Moonglow\" title=\"Roah Moonglow\"><picture><source srcset=\"/w/images/thumb/e/e7/Portrait_Roah_Moonglow.png/25px-Portrait_Roah_Moonglow.png.webp, /w/images/thumb/e/e7/Portrait_Roah_Moonglow.png/38px-Portrait_Roah_Moonglow.png.webp 1.5x, /w/images/thumb/e/e7/Portrait_Roah_Moonglow.png/50px-Portrait_Roah_Moonglow.png.webp 2x\"><img alt=\"Roah Moonglow\" src=\"/w/images/thumb/e/e7/Portrait_Roah_Moonglow.png/25px-Portrait_Roah_Moonglow.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e7/Portrait_Roah_Moonglow.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Roah_Moonglow\" title=\"Roah Moonglow\">Roah Moonglow</a> in the <a href=\"/wiki/Shattered_Sanctum\" title=\"Shattered Sanctum\">Shattered Sanctum</a> or on the main floor or <a href=\"/wiki/Moonrise_Towers\" title=\"Moonrise Towers\">Moonrise Towers</a></li></ul></li>\n<li>Crafted via <a href=\"/wiki/Alchemy\" title=\"Alchemy\">Alchemy</a> by combining<span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Ashes_of_Imp_Patagium\" title=\"Ashes of Imp Patagium\"><picture><source srcset=\"/w/images/thumb/7/7f/Extract_Ashes_Pink_Item_Icon.png/20px-Extract_Ashes_Pink_Item_Icon.png.webp, /w/images/thumb/7/7f/Extract_Ashes_Pink_Item_Icon.png/30px-Extract_Ashes_Pink_Item_Icon.png.webp 1.5x, /w/images/thumb/7/7f/Extract_Ashes_Pink_Item_Icon.png/40px-Extract_Ashes_Pink_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/7/7f/Extract_Ashes_Pink_Item_Icon.png/20px-Extract_Ashes_Pink_Item_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/7f/Extract_Ashes_Pink_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Ashes_of_Imp_Patagium\" title=\"Ashes of Imp Patagium\">Ashes of Imp Patagium</a> (procured from<span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Imp_Patagium\" title=\"Imp Patagium\"><picture><source srcset=\"/w/images/thumb/1/10/Imp_Patagium_Item_Icon.png/20px-Imp_Patagium_Item_Icon.png.webp, /w/images/thumb/1/10/Imp_Patagium_Item_Icon.png/30px-Imp_Patagium_Item_Icon.png.webp 1.5x, /w/images/thumb/1/10/Imp_Patagium_Item_Icon.png/40px-Imp_Patagium_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/1/10/Imp_Patagium_Item_Icon.png/20px-Imp_Patagium_Item_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/1/10/Imp_Patagium_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Imp_Patagium\" title=\"Imp Patagium\">Imp Patagium</a>) and any <a href=\"/wiki/Alchemy#Extractions\" title=\"Alchemy\">Essence</a></li></ul>\n</div>      \n<!-- \nNewPP limit report\nCached time: 20260714194714\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.112 seconds\nReal time usage: 0.118 seconds\nPreprocessor visited node count: 4909/1000000\nPost‐expand include size: 63197/4194304 bytes\nTemplate argument size: 17680/4194304 bytes\nHighest expansion depth: 27/200\nExpensive parser function count: 4/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 2/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.025/7.000 seconds\nLua memory usage: 1458089/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%   93.870      1 Template:Misc_item_page\n100.00%   93.870      1 -total\n 44.01%   41.314     17 Template:Icon_text\n 40.25%   37.787     53 Template:Trim\n 22.66%   21.270     10 Template:Icon_link\n 21.93%   20.587      3 Template:Cond\n 20.63%   19.370      1 Template:PageSeo\n 20.54%   19.280      2 Template:Hidden_code\n 15.13%   14.207     21 Template:Ifempty\n 12.59%   11.816      3 Template:Cond