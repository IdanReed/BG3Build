n.webp/60px-Wet_Condition_Icon.webp 2x\"><img alt=\"Wet\" src=\"/w/images/thumb/9/9d/Wet_Condition_Icon.webp/30px-Wet_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/9d/Wet_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Wet_(Condition)\" title=\"Wet (Condition)\">Wet</a></strong>\n<div>\n<ul><li><a href=\"/wiki/Immune\" class=\"mw-redirect\" title=\"Immune\">Immune</a> to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Burning_(Condition)\" title=\"Burning (Condition)\"><picture><source srcset=\"/w/images/thumb/c/c8/Burning_Condition_Icon.webp/25px-Burning_Condition_Icon.webp, /w/images/thumb/c/c8/Burning_Condition_Icon.webp/38px-Burning_Condition_Icon.webp 1.5x, /w/images/thumb/c/c8/Burning_Condition_Icon.webp/50px-Burning_Condition_Icon.webp 2x\"><img alt=\"Burning\" src=\"/w/images/thumb/c/c8/Burning_Condition_Icon.webp/25px-Burning_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c8/Burning_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Burning_(Condition)\" title=\"Burning (Condition)\">Burning</a> and <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Wild_Magic:_Burning_(Condition)\" title=\"Wild Magic: Burning (Condition)\"><picture><source srcset=\"/w/images/thumb/3/34/Wild_Magic_Burning_Condition_Icon.webp/25px-Wild_Magic_Burning_Condition_Icon.webp, /w/images/thumb/3/34/Wild_Magic_Burning_Condition_Icon.webp/38px-Wild_Magic_Burning_Condition_Icon.webp 1.5x, /w/images/thumb/3/34/Wild_Magic_Burning_Condition_Icon.webp/50px-Wild_Magic_Burning_Condition_Icon.webp 2x\"><img alt=\"Wild Magic: Burning\" src=\"/w/images/thumb/3/34/Wild_Magic_Burning_Condition_Icon.webp/25px-Wild_Magic_Burning_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/34/Wild_Magic_Burning_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Wild_Magic:_Burning_(Condition)\" title=\"Wild Magic: Burning (Condition)\">Wild Magic: Burning</a>.</li>\n<li><a href=\"/wiki/Resistant\" class=\"mw-redirect\" title=\"Resistant\">Resistant</a> to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Fire\" title=\"Fire\"><picture><source srcset=\"/w/images/thumb/8/84/Fire_Damage_Icon.png/20px-Fire_Damage_Icon.png.webp, /w/images/thumb/8/84/Fire_Damage_Icon.png/30px-Fire_Damage_Icon.png.webp 1.5x, /w/images/thumb/8/84/Fire_Damage_Icon.png/40px-Fire_Damage_Icon.png.webp 2x\"><img alt=\"Fire\" src=\"/w/images/thumb/8/84/Fire_Damage_Icon.png/20px-Fire_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/84/Fire_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Fire\" title=\"Fire\"><span class=\"bg3wiki-damage-type-fire\">Fire</span></a> damage.</li>\n<li><a href=\"/wiki/Vulnerable\" class=\"mw-redirect\" title=\"Vulnerable\">Vulnerable</a> to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lightning\" title=\"Lightning\"><picture><source srcset=\"/w/images/thumb/3/31/Lightning_Damage_Icon.png/20px-Lightning_Damage_Icon.png.webp, /w/images/thumb/3/31/Lightning_Damage_Icon.png/30px-Lightning_Damage_Icon.png.webp 1.5x, /w/images/thumb/3/31/Lightning_Damage_Icon.png/40px-Lightning_Damage_Icon.png.webp 2x\"><img alt=\"Lightning\" src=\"/w/images/thumb/3/31/Lightning_Damage_Icon.png/20px-Lightning_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/31/Lightning_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Lightning\" title=\"Lightning\"><span class=\"bg3wiki-damage-type-lightning\">Lightning</span></a> and <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Cold\" title=\"Cold\"><picture><source srcset=\"/w/images/thumb/0/05/Cold_Damage_Icon.png/20px-Cold_Damage_Icon.png.webp, /w/images/thumb/0/05/Cold_Damage_Icon.png/29px-Cold_Damage_Icon.png.webp 1.5x, /w/images/thumb/0/05/Cold_Damage_Icon.png/39px-Cold_Damage_Icon.png.webp 2x\"><img alt=\"Cold\" src=\"/w/images/thumb/0/05/Cold_Damage_Icon.png/20px-Cold_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/05/Cold_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Cold\" title=\"Cold\"><span class=\"bg3wiki-damage-type-cold\">Cold</span></a> damage.</li></ul>\n</div>\n </div>\n</div>  \n<h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li><a href=\"/wiki/Circus_of_the_Last_Days\" title=\"Circus of the Last Days\">Circus of the Last Days</a> <span class=\"bg3wiki-coordinates\">X:&nbsp;-68&nbsp;Y:&nbsp;-73</span>: Given as a consolation prize by <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Akabi\" title=\"Akabi\"><picture><source srcset=\"/w/images/thumb/b/b4/Portrait_Akabi.png/25px-Portrait_Akabi.png.webp, /w/images/thumb/b/b4/Portrait_Akabi.png/38px-Portrait_Akabi.png.webp 1.5x, /w/images/thumb/b/b4/Portrait_Akabi.png/50px-Portrait_Akabi.png.webp 2x\"><img alt=\"Akabi\" src=\"/w/images/thumb/b/b4/Portrait_Akabi.png/25px-Portrait_Akabi.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b4/Portrait_Akabi.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Akabi\" title=\"Akabi\">Akabi</a> after failing to win the jackpot at the <a href=\"/wiki/Circus_of_the_Last_Days#Layout\" title=\"Circus of the Last Days\">Wheel of Fortune</a></li></ul>\n</div> \n<h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li><a href=\"/wiki/Act_Three\" title=\"Act Three\">Act Three</a>: Although referenced by the tooltip quote, the in-game tooltip omits informing that the wearer becomes (and remains) <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Wet_(Condition)\" title=\"Wet (Condition)\"><picture><source srcset=\"/w/images/thumb/9/9d/Wet_Condition_Icon.webp/25px-Wet_Condition_Icon.webp, /w/images/thumb/9/9d/Wet_Condition_Icon.webp/38px-Wet_Condition_Icon.webp 1.5x, /w/images/thumb/9/9d/Wet_Condition_Icon.webp/50px-Wet_Condition_Icon.webp 2x\"><img alt=\"Wet\" src=\"/w/images/thumb/9/9d/Wet_Condition_Icon.webp/25px-Wet_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/9d/Wet_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Wet_(Condition)\" title=\"Wet (Condition)\">Wet</a> while wearing this item.</li>\n<li>If worn before <a href=\"/wiki/Rest\" class=\"mw-redirect\" title=\"Rest\">resting</a> the <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Wet_(Condition)\" title=\"Wet (Condition)\"><picture><source srcset=\"/w/images/thumb/9/9d/Wet_Condition_Icon.webp/25px-Wet_Condition_Icon.webp, /w/images/thumb/9/9d/Wet_Condition_Icon.webp/38px-Wet_Condition_Icon.webp 1.5x, /w/images/thumb/9/9d/Wet_Condition_Icon.webp/50px-Wet_Condition_Icon.webp 2x\"><img alt=\"Wet\" src=\"/w/images/thumb/9/9d/Wet_Condition_Icon.webp/25px-Wet_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/9/9d/Wet_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Wet_(Condition)\" title=\"Wet (Condition)\">Wet</a> condition is removed from the wearer until taken off and re-equipped.</li></ul>\n</div>  \n<h2><span class=\"mw-headline\" id=\"Gallery\">Gallery</span></h2>\n<ul class=\"gallery mw-gallery-packed\">\n\t\t<li class=\"gallerybox\" style=\"width: 341.33333333333px\">\n\t\t\t<div class=\"thumb\" style=\"width: 339.33333333333px;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Reverse_rain_cloak.png\" class=\"mw-file-description\" title=\"Dyed variations\"><picture><source srcset=\"/w/images/thumb/7/75/Reverse_rain_cloak.png/509px-Reverse_rain_cloak.png.webp, /w/images/thumb/7/75/Reverse_rain_cloak.png/764px-Reverse_rain_cloak.png.webp 1.5x, /w/images/thumb/7/75/Reverse_rain_cloak.png/1018px-Reverse_rain_cloak.png.webp 2x\"><img alt=\"Dyed variations\" src=\"/w/images/thumb/7/75/Reverse_rain_cloak.png/509px-Reverse_rain_cloak.png.webp\" decoding=\"async\" width=\"340\" height=\"400\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/75/Reverse_rain_cloak.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n\t\t\t<div class=\"gallerytext\"><a href=\"/wiki/Dye\" class=\"mw-redirect\" title=\"Dye\">Dyed</a> variations</div>\n\t\t</li>\n</ul>\n<!-- \nNewPP limit report\nCached time: 20260714195734\nCache expiry: 8640