19afe-f4c3-4c87-89bf-e3e81fc77ca3\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:50819afe-f4c3-4c87-89bf-e3e81fc77ca3\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div>   \n<div style=\"clear: both;\"></div></div>\n    <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>On a desk in Isobel's room at the <a href=\"/wiki/Last_Light_Inn\" title=\"Last Light Inn\">Last Light Inn</a> at <span class=\"bg3wiki-coordinates\">X:&nbsp;-70&nbsp;Y:&nbsp;162</span></li></ul>\n</div>  <h2><span class=\"mw-headline\" id=\"Text\"> Text </span></h2>\n<div class=\"bg3wiki-book-text\">\n<p>Ever since I returned, there's been a filth in me. I feel it in my very lungs. I cannot get it out - it will never out, this death that reeks within me. There are some things even the <a href=\"/wiki/Sel%C3%BBne\" title=\"Selûne\">Moonmaiden</a> cannot heal. There are some things she would never accept in her devoted. I should never have come back.\n</p>\n</div>    \n<!-- \nNewPP limit report\nCached time: 20260714202119\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.051 seconds\nReal time usage: 0.053 seconds\nPreprocessor visited node count: 1604/1000000\nPost‐expand include size: 27236/4194304 bytes\nTemplate argument size: 6329/4194304 bytes\nHighest expansion depth: 29/200\nExpensive parser function count: 2/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 2/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.010/7.000 seconds\nLua memory usage: 936618/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%   41.218      1 Template:MiscItemPage\n100.00%   41.218      1 -total\n 56.89%   23.450      7 Template:Icon_text\n 50.84%   20.955     17 Template:Trim\n 2