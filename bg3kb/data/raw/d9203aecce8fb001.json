c/c0/Poison_Immunity.png/56px-Poison_Immunity.png.webp 2x\"><img alt=\"Immune to all Poison\" src=\"/w/images/thumb/c/c0/Poison_Immunity.png/28px-Poison_Immunity.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c0/Poison_Immunity.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li><li><span typeof=\"mw:File\"><span title=\"Resistant to all Radiant\"><picture><source srcset=\"/w/images/thumb/4/4f/Radiant_Resistance_Full.png/28px-Radiant_Resistance_Full.png.webp, /w/images/thumb/4/4f/Radiant_Resistance_Full.png/42px-Radiant_Resistance_Full.png.webp 1.5x, /w/images/thumb/4/4f/Radiant_Resistance_Full.png/56px-Radiant_Resistance_Full.png.webp 2x\"><img alt=\"Resistant to all Radiant\" src=\"/w/images/thumb/4/4f/Radiant_Resistance_Full.png/28px-Radiant_Resistance_Full.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/4/4f/Radiant_Resistance_Full.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li><li><span typeof=\"mw:File\"><span title=\"Vulnerable to Force\"><picture><source srcset=\"/w/images/thumb/b/b1/Force_Vulnerability.png/28px-Force_Vulnerability.png.webp, /w/images/thumb/b/b1/Force_Vulnerability.png/42px-Force_Vulnerability.png.webp 1.5x, /w/images/thumb/b/b1/Force_Vulnerability.png/56px-Force_Vulnerability.png.webp 2x\"><img alt=\"Vulnerable to Force\" src=\"/w/images/thumb/b/b1/Force_Vulnerability.png/28px-Force_Vulnerability.png.webp\" decoding=\"async\" width=\"28\" height=\"42\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/b/b1/Force_Vulnerability.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></li></ul></div>\n</div></section></section>\n\t\t\t</div>\n\t</div>\n</section></aside>\n<b>Brain Jar</b>, also called Mind Sanctuary, is a type of set dressing on the <a href=\"/wiki/Nautiloid\" title=\"Nautiloid\">Nautiloid</a>. It has a few visual variants. When destroyed, it creates a <a href=\"/wiki/Surface\" class=\"mw-redirect\" title=\"Surface\">surface</a> of <a href=\"/wiki/Caustic_Brine\" title=\"Caustic Brine\">Caustic Brine</a>.\n\n<div style=\"font-size:110%; font-family:'Linux Libertine', 'Georgia', serif; display: flex; flex-wrap: wrap;\">\n<div style=\"opacity: 0.5; margin: 0.5em 0.5em 0.5em 0;\"><span typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/5/5b/Description_Icon.png/24px-Description_Icon.png.webp, /w/images/thumb/5/5b/Description_Icon.png/36px-Description_Icon.png.webp 1.5x, /w/images/5/5b/Description_Icon.png 2x\"><img src=\"/w/images/thumb/5/5b/Description_Icon.png/24px-Description_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/5/5b/Description_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n<div class=\"bg3wiki-blockquote-text\" style=\"width:100px; flex-grow: 1; font-style: italic;\">\n<p>A humanoid brain - alive and in perfect condition - suspended in cerebrospinal fluid.\n</p>\n</div></div>\n<div style=\"font-size:110%; font-family:'Linux Libertine', 'Georgia', serif; display: flex; flex-wrap: wrap;\">\n<div style=\"opacity: 0.5; margin: 0.5em 0.5em 0.5em 0;\"><span typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/5/5b/Description_Icon.png/24px-Description_Icon.png.webp, /w/images/thumb/5/5b/Description_Icon.png/36px-Description_Icon.png.webp 1.5x, /w/images/5/5b/Description_Icon.png 2x\"><img src=\"/w/images/thumb/5/5b/Description_Icon.png/24px-Description_Icon.png.webp\" decoding=\"async\" width=\"24\" height=\"24\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/5/5b/Description_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n<div class=\"bg3wiki-blockquote-text\" style=\"width:100px; flex-grow: 1; font-style: italic;\">\n<p>Several brains are trapped in this device, gently kept afloat in cerebrospinal fluid.\n</p>\n</div></div>\n<h2><span class=\"mw-headline\" id=\"See_also\">See also</span></h2>\n<ul><li><a href=\"/wiki/Brine_Bulb\" title=\"Brine Bulb\">Brine Bulb</a></li>\n<li><a href=\"/wiki/Caustic_Bulb\" title=\"Caustic Bulb\">Caustic Bulb</a></li></ul>\n<!-- \nNewPP limit report\nCached time: 20260715045149\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.099 seconds\nReal time usage: 0.106 seconds\nPreprocessor visited node count: 3856/1000000\nPost‐expand include size: 36152/4194304 bytes\nTemplate argument size: 16283/4194304 bytes\nHighest expansion depth: 15/200\nExpensive parser function count: 0/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 9381/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.024/7.000 seconds\nLua memory usage: 955051/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%   96.952      1 -total\n 96.53%   93.590      1 Template:Infobox_creature\n 62.44%   60.532      1 Template:Infobox_creature/internal\n 29.66%   28.757      2 Template:Hidden_code\n 11.08%   10.738      1 Template:Template_style\n  6.36%    6.169     52 Template:Plus_if_pos\n  4.86%    4.712      8 Template:Resistance\n  4.12%    3.997      2 Template:Credits\n  3.26%    3.163     18 Template:Trim\n  2.97%    2.878      1 Template:PageSeo\n-->\n\n<!-- Saved in parser cache with key bg3wiki:pcache:idhash:38214-0!canonical and timestamp 20260715045149 and revision id 401522. Rendering was triggered because: page-view\n -->\n</div>"}