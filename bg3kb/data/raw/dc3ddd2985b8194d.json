x-Bonus_Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c9/Bonus_Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Actions#Resources\" title=\"Actions\">Bonus Action</a> </span>\n</p>\n<ul><li>You are <a href=\"/wiki/Proficient\" class=\"mw-redirect\" title=\"Proficient\">Proficient</a> in Sleight of Hand <a href=\"/wiki/Ability_check\" class=\"mw-redirect\" title=\"Ability check\">Checks</a></li>\n<li>Can cast <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Knock\" title=\"Knock\"><picture><source srcset=\"/w/images/thumb/a/a4/Knock_Icon.webp/25px-Knock_Icon.webp, /w/images/thumb/a/a4/Knock_Icon.webp/38px-Knock_Icon.webp 1.5x, /w/images/thumb/a/a4/Knock_Icon.webp/50px-Knock_Icon.webp 2x\"><img alt=\"Knock\" src=\"/w/images/thumb/a/a4/Knock_Icon.webp/25px-Knock_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a4/Knock_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Knock\" title=\"Knock\">Knock</a> once until your next <a href=\"/wiki/Long_Rest\" class=\"mw-redirect\" title=\"Long Rest\">Long Rest</a></li></ul>\n<div style=\"clear: both;\"></div></div>\n<h2><span class=\"mw-headline\" id=\"Condition:_Gnomish_Ingenuity\"> Condition: Gnomish Ingenuity </span></h2>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\">\n<div class=\"bg3wiki-condition\"><strong><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Gnomish_Ingenuity_(Condition)\" title=\"Gnomish Ingenuity (Condition)\"><picture><source srcset=\"/w/images/thumb/8/8e/Blood_Elixir_Condition_Icon.webp/30px-Blood_Elixir_Condition_Icon.webp, /w/images/thumb/8/8e/Blood_Elixir_Condition_Icon.webp/45px-Blood_Elixir_Condition_Icon.webp 1.5x, /w/images/thumb/8/8e/Blood_Elixir_Condition_Icon.webp/60px-Blood_Elixir_Condition_Icon.webp 2x\"><img alt=\"Gnomish Ingenuity\" src=\"/w/images/thumb/8/8e/Blood_Elixir_Condition_Icon.webp/30px-Blood_Elixir_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/8e/Blood_Elixir_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Gnomish_Ingenuity_(Condition)\" title=\"Gnomish Ingenuity (Condition)\">Gnomish Ingenuity</a></strong><p><span class=\"bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp, /w/images/thumb/6/6a/Duration_Icons.png/38px-Duration_Icons.png.webp 1.5x, /w/images/thumb/6/6a/Duration_Icons.png/50px-Duration_Icons.png.webp 2x\"><img alt=\"Duration Icons.png\" src=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/6/6a/Duration_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Duration: Until <a href=\"/wiki/Long_rest\" class=\"mw-redirect\" title=\"Long rest\">Long rest</a></p>\n<div>\n<ul><li>Affected entity is <a href=\"/wiki/Proficient\" class=\"mw-redirect\" title=\"Proficient\">Proficient</a> in Sleight of Hand <a href=\"/wiki/Ability_Check\" class=\"mw-redirect\" title=\"Ability Check\">Checks</a> and can cast <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Knock\" title=\"Knock\"><picture><source srcset=\"/w/images/thumb/a/a4/Knock_Icon.webp/25px-Knock_Icon.webp, /w/images/thumb/a/a4/Knock_Icon.webp/38px-Knock_Icon.webp 1.5x, /w/images/thumb/a/a4/Knock_Icon.webp/50px-Knock_Icon.webp 2x\"><img alt=\"Knock\" src=\"/w/images/thumb/a/a4/Knock_Icon.webp/25px-Knock_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a4/Knock_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Knock\" title=\"Knock\">Knock</a> until it takes a <a href=\"/wiki/Long_Rest\" class=\"mw-redirect\" title=\"Long Rest\">Long Rest</a>.</li></ul>\n</div>\n </div>\n</div>    <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<p>Given by <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Araj_Oblodra\" title=\"Araj Oblodra\"><picture><source srcset=\"/w/images/thumb/3/3f/Portrait_Araj_Oblodra.png/25px-Portrait_Araj_Oblodra.png.webp, /w/images/thumb/3/3f/Portrait_Araj_Oblodra.png/38px-Portrait_Araj_Oblodra.png.webp 1.5x, /w/images/thumb/3/3f/Portrait_Araj_Oblodra.png/50px-Portrait_Araj_Oblodra.png.webp 2x\"><img alt=\"Araj Oblodra\" src=\"/w/images/thumb/3/3f/Portrait_Araj_Oblodra.png/25px-Portrait_Araj_Oblodra.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/3f/Portrait_Araj_Oblodra.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Araj_Oblodra\" title=\"Araj Oblodra\">Araj Oblodra</a> in <a href=\"/wiki/Moonrise_Towers\" title=\"Moonrise Towers\">Moonrise Towers</a> and later in <a href=\"/wiki/Lower_City\" title=\"Lower City\">Lower City</a> in exchange for gnomish blood\n</p>\n</div>   <h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>Araj's elixirs function independently of other elixirs, stacking with them and each other.</li></ul>\n</div>   \n<!-- \nNewPP limit report\nCached time: 20260714202018\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.075 seconds\nReal time usage: 0.079 seconds\nPreprocessor visited node count: 2656/1000000\nPost‐expand include size: 41453/4194304 bytes\nTemplate argument size: 10208/4194304 bytes\nHighest expansion depth: 25/200\nExpensive parser function count: 1/750\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 2/5000000 bytes\nExtLoops count: 0/1000\nLua time usage: 0.015/7.000 seconds\nLua memory usage: 1206314/52428800 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%   63.798      1 Template:MiscItemPage\n100.00%   63.798      1 -total\n 52.81%   33.693     10 Template:Icon_text\n 48.24%   30.775     27 Template:Trim\n 29.15%   18.594      1 Template:PageSeo\n 29.03%   18.523      2 Template:Hidden_code\n 25.75%   16.428      5 Template:Icon_link\n 19.51%   12.447      2 Template:SAI\n 18.24%   11.636     10 Template:Ifempty\n 17.13%   10.927      3 Template:Uid\n-->\n\n<!-- Saved in parser cache with key bg3wiki:pcache:idhash:26343-0!canonical and timestamp 20260714202018 and revision id 396229. Rendering was triggered because: unknown\n -->\n</div>"}