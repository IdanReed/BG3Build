0_Physical.png/44px-D10_Physical.png.webp 1.5x, /w/images/thumb/0/0d/D10_Physical.png/58px-D10_Physical.png.webp 2x\"><img src=\"/w/images/thumb/0/0d/D10_Physical.png/29px-D10_Physical.png.webp\" decoding=\"async\" width=\"29\" height=\"30\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/0/0d/D10_Physical.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> </span> <span class=\"bg3wiki-damage-type-bludgeoning\">1d10 (1~10) + <a href=\"/wiki/Damage_Roll#Modifiers\" class=\"mw-redirect\" title=\"Damage Roll\">Strength modifier</a> <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Bludgeoning\" title=\"Bludgeoning\"><picture><source srcset=\"/w/images/thumb/7/7d/Bludgeoning_Damage_Icon.png/20px-Bludgeoning_Damage_Icon.png.webp, /w/images/thumb/7/7d/Bludgeoning_Damage_Icon.png/30px-Bludgeoning_Damage_Icon.png.webp 1.5x, /w/images/thumb/7/7d/Bludgeoning_Damage_Icon.png/40px-Bludgeoning_Damage_Icon.png.webp 2x\"><img alt=\"Bludgeoning\" src=\"/w/images/thumb/7/7d/Bludgeoning_Damage_Icon.png/20px-Bludgeoning_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/7d/Bludgeoning_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Bludgeoning\" title=\"Bludgeoning\"><span class=\"bg3wiki-damage-type-bludgeoning\">Bludgeoning</span></a></span> </div></dd>\n<dt>Extra damage</dt>\n<dd><div class=\"bg3wiki-info-blob\"><span style=\"display: inline-block; width: 30px;\"><span class=\"mw-default-size\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/9/96/D6_Fire.png/27px-D6_Fire.png.webp, /w/images/thumb/9/96/D6_Fire.png/40px-D6_Fire.png.webp 1.5x, /w/images/thumb/9/96/D6_Fire.png/54px-D6_Fire.png.webp 2x\"><img src=\"/w/images/thumb/9/96/D6_Fire.png/27px-D6_Fire.png.webp\" decodi