a/Melee_Range_Icon.png 2x\"><img alt=\"Melee: 1.5 m (5 ft)\" src=\"/w/images/thumb/2/2a/Melee_Range_Icon.png/25px-Melee_Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2a/Melee_Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Melee: 1.5 m (5 ft)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp, /w/images/thumb/e/ea/Weight_Icon.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 3.15 kg (6.3 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 3.15 kg (6.3 lb)</dd>\n<dd><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 130 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  130  gp</dd>\n<dd><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">UNI_UND_DuergarRaft_PestKillerAxe</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:UNI_UND_DuergarRaft_PestKillerAxe\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:UNI_UND_DuergarRaft_PestKillerAxe\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">6e05319b-d8c4-4dbc-b0f4-cea561810fa6</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:6e05319b-d8c4-4dbc-b0f4-cea561810fa6\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:6e05319b-d8c4-4dbc-b0f4-cea561810fa6\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>Stats</summary>\n<code class=\"bg3wiki-uid-box\">UND_DuergarRaft_PestKillerAxe</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:UND_DuergarRaft_PestKillerAxe+type:stat\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:UND_DuergarRaft_PestKillerAxe+type:stat\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></dd></dl>\n</div> \n<h3><span class=\"mw-headline\" id=\"Special\"> Special </span></h3>\n<p><b>The holder of this item gains:</b>\n\n</p>\n<dl><dt><a href=\"/wiki/Scourge_of_Pests\" title=\"Scourge of Pests\">Scourge of Pests</a></dt><dd>Deals an additional <span class=\"bg3wiki-damage-type-fire\">1d6</span>⁠<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Fire\" title=\"Fire\"><picture><source srcset=\"/w/images/thumb/8/84/Fire_Damage_Icon.png/25px-Fire_Damage_Icon.png.webp, /w/images/thumb/8/84/Fire_Damage_Icon.png/38px-Fire_Damage_Icon.png.webp 1.5x, /w/images/thumb/8/84/Fire_Damage_Icon.png/50px-Fire_Damage_Icon.png.webp 2x\"><img alt=\"Fire\" src=\"/w/images/thumb/8/84/Fire_Damage_Icon.png/25px-Fire_Damage_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/8/84/Fire_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Fire\" title=\"Fire\"><span class=\"bg3wiki-damage-type-fire\">Fire</span></a> damage to <a href=\"/wiki/Plant\" title=\"Plant\">Plants</a>, <a href=\"/wiki/Myconid\" title=\"Myconid\">Myconids</a><sup><i>[<a href=\"/wiki/Scourge_of_Pests#Bugs\" title=\"Scourge of Pests\">See: Bugs</a>]</i></sup>, and <a href=\"/wiki/Small\" class=\"mw-redirect\" title=\"Small\">Small</a> creatures.</dd></dl>\n<h3><span class=\"mw-headline\" id=\"Weapon_actions\"> Weapon actions </span></h3>\n<p><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp, /w/images/2/2d/Proficiency_Icon.png 1.5x\"><img alt=\"Proficiency Icon.png\" src=\"/w/images/thumb/2/2d/Proficiency_Icon.png/22px-Proficiency_Icon.png.webp\" decoding=\"async\" width=\"22\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/2d/Proficiency_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <i>If you have <a href=\"/wiki/Proficiency\" title=\"Proficiency\">proficiency</a>, equip in <strong>main hand</strong> to gain:</i>\n</p>\n<dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Cleave\" title=\"Cleave\"><picture><source srcset=\"/w/images/thumb/a/a7/Cleave_Icon.webp/40px-Cleave_Icon.webp, /w/images/thumb/a/a7/Cleave_Icon.webp/60px-Cleave_Icon.webp 1.5x, /w/images/thumb/a/a7/Cleave_Icon.webp/80px-Cleave_Icon.webp 2x\"><img alt=\"Cleave\" src=\"/w/images/thumb/a/a7/Cleave_Icon.webp/40px-Cleave_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/a7/Cleave_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Cleave\" title=\"Cleave\">Cleave</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Swing your weapon in a large arc to attack up to 3 enemies at once. They each take half the damage your weapon usually deals. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lacerate\" title=\"Lacerate\"><picture><source srcset=\"/w/images/thumb/a/af/Lacerate_Icon.webp/40px-Lacerate_Icon.webp, /w/images/thumb/a/af/Lacerate_Icon.webp/60px-Lacerate_Icon.webp 1.5x, /w/images/thumb/a/af/Lacerate_Icon.webp/80px-Lacerate_Icon.webp 2x\"><img alt=\"Lacerate\" src=\"/w/images/thumb/a/af/Lacerate_Icon.webp/40px-Lacerate_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/a/af/Lacerate_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Lacerate\" title=\"Lacerate\">Lacerate</a> (<span aria-label=\"Action\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"Action\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Slash at your target's vital points to make it <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Bleeding_(Condition)\" title=\"Bleeding (Condition)\"><picture><source srcset=\"/w/images/thumb/2/25/Bleeding_Condition_Icon.webp/20px-Bleeding_Condition_Icon.webp, /w/images/thumb/2/25/Bleeding_Condition_Icon.webp/30px-Bleeding_Condition_Icon.webp 1.5x, /w/images/thumb/2/25/Bleeding_Condition_Icon.webp/40px-Bleeding_Condition_Icon.webp 2x\"><img alt=\"Bleed\" src=\"/w/images/thumb/2/25/Bleeding_Condition_Icon.webp/20px-Bleeding_Condition_Icon.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/25/Bleeding_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Bleeding_(Condition)\" title=\"Bleeding (Condition)\">Bleed</a>. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl><dl>\n<dt><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Prepare\" title=\"Prepare\"><picture><source srcset=\"/w/images/thumb/3/3c/Prepare_Icon.webp/40px-Prepare_Icon.webp, /w/images/thumb/3/3c/Prepare_Icon.webp/60px-Prepare_Icon.webp 1.5x, /w/images/thumb/3/3c/Prepare_Icon.webp/80px-Prepare_Icon.webp 2x\"><img alt=\"Prepare\" src=\"/w/images/thumb/3/3c/Prepare_Icon.webp/40px-Prepare_Icon.webp\" decoding=\"async\" width=\"40\" height=\"40\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/3c/Prepare_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Prepare\" title=\"Prepare\">Prepare</a> (<span aria-label=\"Movement Speed\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/9/97/Movement_Speed_Icon.png/23px-Movement_Speed_Icon.png.webp, /w/images/9/97/Movement_Speed_Icon.png 1.5x\"><img alt=\"Movement Speed\" src=\"/w/images/thumb/9/97/Movement_Speed_Icon.png/23px-Movement_Speed_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/9/97/Movement_Speed_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span>)</dt>\n<dd>Spend 6 m (20 ft) of your <a href=\"/wiki/Movement_Speed\" class=\"mw-redirect\" title=\"Movement Speed\">movement</a> to deal an additional <span class=\"bg3wiki-damage-type-physical\">Strength modifier</span>⁠<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Physical\" title=\"Physical\"><picture><source srcset=\"/w/images/thumb/f/f0/Slashing_Damage_Icon.png/20px-Slashing_Damage_Icon.png.webp, /w/images/thumb/f/f0/Slashing_Damage_Icon.png/30px-Slashing_Damage_Icon.png.webp 1.5x, /w/images/thumb/f/f0/Slashing_Damage_Icon.png/40px-Slashing_Damage_Icon.png.webp 2x\"><img alt=\"Physical\" src=\"/w/images/thumb/f/f0/Slashing_Damage_Icon.png/20px-Slashing_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f0/Slashing_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Physical\" class=\"mw-redirect\" title=\"Physical\"><span class=\"bg3wiki-damage-type-physical\">Physical</span></a><abbr title=\"Damage Rider As Source\" class=\"bg3wiki-damage-rider-source\"><a href=\"/wiki/Damage_rider_as_source\" class=\"mw-redirect\" title=\"Damage rider as source\">DRS</a></abbr> damage (minimum 1) on each successful melee weapon attack for the rest of the turn. (<span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp, /w/images/thumb/f/fd/Recharge_Icons.png/38px-Recharge_Icons.png.webp 1.5x, /w/images/f/fd/Recharge_Icons.png 2x\"><img alt=\"Recharge: Short rest\" src=\"/w/images/thumb/f/fd/Recharge_Icons.png/25px-Recharge_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/fd/Recharge_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Recharge: <a href=\"/wiki/Short_rest\" class=\"mw-redirect\" title=\"Short rest\">Short rest</a>.)</dd>\n</dl></div> \n<h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li><a href=\"/wiki/Decrepit_Village\" title=\"Decrepit Village\">Decrepit Village</a> <span class=\"bg3wiki-coordinates\">X:&nbsp;14&nbsp;Y:&nbsp;-196</span>: Carried by <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Gekh_Coal\" title=\"Gekh Coal\"><picture><source srcset=\"/w/images/thumb/d/d0/Portrait_Gekh_Coal.png/25px-Portrait_Gekh_Coal.png.webp, /w/images/thumb/d/d0/Portrait_Gekh_Coal.png/38px-Portrait_Gekh_Coal.png.webp 1.5x, /w/images/thumb/d/d0/Portrait_Gekh_Coal.png/50px-Portrait_Gekh_Coal.png.webp 2x\"><img alt=\"Gekh Coal\" src=\"/w/images/thumb/d/d0/Portrait_Gekh_Coal.png/25px-Portrait_Gekh_Coal.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d0/Portrait_Gekh_Coal.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Gekh_Coal\" title=\"Gekh Coal\">Gekh Coal</a></li></ul>\n</div>  \n<h2><span class=\"mw-headline\" id=\"Bugs\"> Bugs </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n\n<p><i>Regarding Scourge of Pests:</i></p>\n<ul><li>The in-game tooltip for Scourge of Pests says it grants bonus damage against insects, but instead it grants bonus damage against Myconids instead.</li></ul>\n</div>    \n<h2><span class=\"mw-headline\" id=\"Gallery\">Gallery</span></h2>\n<ul class=\"gallery mw-gallery-packed\">\n\t\t<li class=\"gallerybox\" style=\"width: 302px\">\n\t\t\t<div class=\"thumb\" style=\"width: 300px;\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Exterminator%27s_Axe.png\" class=\"mw-file-description\" title=\"Appearance in game.\"><picture><source srcset=\"/w/images/thumb/4/4f/Exterminator%27s_Axe.png/450px-Exterminator%27s_Axe.png.webp, /w/images/thumb/4/4f/Exterminator%27s_Axe.png/675px-Exterminator%27s_Axe.png.webp 1.5x, /w/images/thumb/4/4f/Exterminator%27s_Axe.png/900px-Exterminator%27s_Axe.png.webp 2x\"><img alt=\"Appearance in game.\" src=\"/w/images/thumb/4/4f/Exterminator%27s_Axe.png/450px-Exterminator%27s_Axe.png.webp\" decoding=\"async\" width=\"300\" height=\"300\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/4f/Exterminator%27s_Axe.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></div>\n\t\t\t<div class=\"gallerytext\">Appearance in g