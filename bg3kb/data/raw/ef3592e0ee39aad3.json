x-Feather_Fall_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d6/Feather_Fall_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Feather_Fall_(Condition)\" title=\"Feather Fall (Condition)\">Feather Fall</a></li></ul>\n<p><span class=\"bg3wiki-info-blob\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Actions#Resources\" title=\"Actions\">Action</a></span>\n</p>\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Throw\" title=\"Throw\"><picture><source srcset=\"/w/images/thumb/e/e3/Throw_Icon.webp/25px-Throw_Icon.webp, /w/images/thumb/e/e3/Throw_Icon.webp/38px-Throw_Icon.webp 1.5x, /w/images/thumb/e/e3/Throw_Icon.webp/50px-Throw_Icon.webp 2x\"><img alt=\"Throw\" src=\"/w/images/thumb/e/e3/Throw_Icon.webp/25px-Throw_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e3/Throw_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Throw\" title=\"Throw\">Throw</a> the potion to grant <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Feather_Fall_(Condition)\" title=\"Feather Fall (Condition)\"><picture><source srcset=\"/w/images/thumb/d/d6/Feather_Fall_Condition_Icon.webp/25px-Feather_Fall_Condition_Icon.webp, /w/images/thumb/d/d6/Feather_Fall_Condition_Icon.webp/38px-Feather_Fall_Condition_Icon.webp 1.5x, /w/images/thumb/d/d6/Feather_Fall_Condition_Icon.webp/50px-Feather_Fall_Condition_Icon.webp 2x\"><img alt=\"Feather Fall\" src=\"/w/images/thumb/d/d6/Feather_Fall_Condition_Icon.webp/25px-Feather_Fall_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d6/Feather_Fall_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Feather_Fall_(Condition)\" title=\"Feather Fall (Condition)\">Feather Fall</a> to all creatures in an area\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/0/08/Range_Icon.png/25px-Range_Icon.png.webp, /w/images/thumb/0/08/Range_Icon.png/38px-Range_Icon.png.webp 1.5x, /w/images/0/08/Range_Icon.png 2x\"><img alt=\"Range: 18 m (60 ft)\" src=\"/w/images/thumb/0/08/Range_Icon.png/25px-Range_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/0/08/Range_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Range: 18 m (60 ft)</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp, /w/images/thumb/d/d0/Aoe_Icon.png/38px-Aoe_Icon.png.webp 1.5x, /w/images/d/d0/Aoe_Icon.png 2x\"><img alt=\"AoE: 1 m (3 ft) Radius\" src=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/d/d0/Aoe_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> AoE: 1 m (3 ft) Radius</li></ul></li></ul>\n<div style=\"clear: both;\"></div></div>\n<h2><span class=\"mw-headline\" id=\"Condition:_Feather_Fall\"> Condition: Feather Fall </span></h2>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\">\n<div class=\"bg3wiki-condition\"><strong><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Feather_Fall_(Condition)\" title=\"Feather Fall (Condition)\"><picture><source srcset=\"/w/images/thumb/d/d6/Feather_Fall_Condition_Icon.webp/30px-Feather_Fall_Condition_Icon.webp, /w/images/thumb/d/d6/Feather_Fall_Condition_Icon.webp/45px-Feather_Fall_Condition_Icon.webp 1.5x, /w/images/thumb/d/d6/Feather_Fall_Condition_Icon.webp/60px-Feather_Fall_Condition_Icon.webp 2x\"><img alt=\"Feather Fall\" src=\"/w/images/thumb/d/d6/Feather_Fall_Condition_Icon.webp/30px-Feather_Fall_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d6/Feather_Fall_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Feather_Fall_(Condition)\" title=\"Feather Fall (Condition)\">Feather Fall</a></strong><p><span class=\"bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp, /w/images/thumb/6/6a/Duration_Icons.png/38px-Duration_Icons.png.webp 1.5x, /w/images/thumb/6/6a/Duration_Icons.png/50px-Duration_Icons.png.webp 2x\"><img alt=\"Duration Icons.png\" src=\"/w/images/thumb/6/6a/Duration_Icons.png/25px-Duration_Icons.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/6/6a/Duration_Icons.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> Duration: 10  turns</p>\n<div>\n<ul><li>Rate of falling is slowed, granting <a href=\"/wiki/Damage_Types#Immunity\" class=\"mw-redirect\" title=\"Damage Types\">Immunity</a> to <a href=\"/wiki/Falling_damage\" title=\"Falling damage\">Falling damage</a>.</li></ul>\n</div>\n </div>\n</div>    <h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>Obtainable from various merchants, enemies, and locations throughout the game</li>\n<li>Crafted via <a href=\"/wiki/Alchemy\" title=\"Alchemy\">Alchemy</a> by combining<span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Sublimate_of_Autumn_Crocus\" title=\"Sublimate of Autumn Crocus\"><picture><source srcset=\"/w/images/thumb/4/4a/Sublimate_of_Autumn_Crocus_Item_Icon.png/20px-Sublimate_of_Autumn_Crocus_Item_Icon.png.webp, /w/images/thumb/4/4a/Sublimate_of_Autumn_Crocus_Item_Icon.png/30px-Sublimate_of_Autumn_Crocus_Item_Icon.png.webp 1.5x, /w/images/thumb/4/4a/Sublimate_of_Autumn_Crocus_Item_Icon.png/40px-Sublimate_of_Autumn_Crocus_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/4/4a/Sublimate_of_Autumn_Crocus_Item_Icon.png/20px-Sublimate_of_Autumn_Crocus_Item_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/4/4a/Sublimate_of_Autumn_Crocus_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Sublimate_of_Autumn_Crocus\" title=\"Sublimate of Autumn Crocus\">Sublimate of Autumn Crocus</a> (procured from<span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Autumncrocus\" title=\"Autumncrocus\"><picture><source srcset=\"/w/images/thumb/c/cb/Autumncrocus_Item_Icon.png/20px-Autumncrocus_Item_Icon.png.webp, /w/images/thumb/c/cb/Autumncrocus_Item_Icon.png/30px-Autumncrocus_Item_Icon.png.webp 1.5x, /w/images/thumb/c/cb/Autumncrocus_Item_Icon.png/40px-Autumncrocus_Item_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/c/cb/Autumncrocus_Item_Icon.png/20px-Autumncrocus_Item_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/cb/Autumncrocus_Item_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Autumncrocus\" title=\"Autumncrocus\">Autumncrocus</a>) and any <a href=\"/wiki/Alchemy#Extractions\" title=\"Alchemy\">Essence</a></li></ul>\n</div>      \n<h2><span class=\"mw-headline\" id=\"Passive_features\">Passive features</span></h2>\n<p>Potion of Feather Fall has 1 <a href=\"/wiki/Hit_points\" title=\"Hit points\">hit point</a>.\n</p>\n<table class=\"wikitable\" style=\"width: 62%;\">\n<caption>Resistances</caption>\n<tbody><tr><td><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Bludgeoning\" title=\"Bludgeoning\"><picture><source srcset=\"/w/images/thumb/7/7d/Bludgeoning_Damage_Icon.png/20px-Bludgeoning_Damage_Icon.png.webp, /w/images/thumb/7/7d/Bludgeoning_Damage_Icon.png/30px-Bludgeoning_Damage_Icon.png.webp 1.5x, /w/images/thumb/7/7d/Bludgeoning_Damage_Icon.png/40px-Bludgeoning_Damage_Icon.png.webp 2x\"><img alt=\"Bludgeoning\" src=\"/w/images/thumb/7/7d/Bludgeoning_Damage_Icon.png/20px-Bludgeoning_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/7d/Bludgeoning_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Bludgeoning\" title=\"Bludgeoning\"><span class=\"bg3wiki-damage-type-bludgeoning\">Bludgeoning</s