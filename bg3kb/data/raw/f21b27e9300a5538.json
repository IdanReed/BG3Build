con.png.webp, /w/images/thumb/e/ea/Weight_Icon.png/38px-Weight_Icon.png.webp 1.5x, /w/images/e/ea/Weight_Icon.png 2x\"><img alt=\"Weight: 1 kg (2 lb)\" src=\"/w/images/thumb/e/ea/Weight_Icon.png/25px-Weight_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/ea/Weight_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Weight: 1 kg (2 lb)</li>\n<li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp, /w/images/2/26/Gold_Icon.png 1.5x\"><img alt=\"Price: 300 gp\" src=\"/w/images/thumb/2/26/Gold_Icon.png/25px-Gold_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/2/26/Gold_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> Price:  300  gp</li>\n<li><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp, /w/images/thumb/3/3c/Ico_stats.png/38px-Ico_stats.png.webp 1.5x, /w/images/3/3c/Ico_stats.png 2x\"><img alt=\"Ico stats.png\" src=\"/w/images/thumb/3/3c/Ico_stats.png/25px-Ico_stats.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/3/3c/Ico_stats.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span> <details class=\"bg3wiki-uid\">\n<summary>UID</summary>\n<code class=\"bg3wiki-uid-box\">QUEST_HAV_InfernalReward_002</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:QUEST_HAV_InfernalReward_002\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:QUEST_HAV_InfernalReward_002\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">6d60fcbb-e7a5-47ad-9cca-44565cbc0856</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:6d60fcbb-e7a5-47ad-9cca-44565cbc0856\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:6d60fcbb-e7a5-47ad-9cca-44565cbc0856\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>Stats</summary>\n<code class=\"bg3wiki-uid-box\">MAG_Lesser_Infernal_Metal_Helmet</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:MAG_Lesser_Infernal_Metal_Helmet+type:stat\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:MAG_Lesser_Infernal_Metal_Helmet+type:stat\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div> \n<h3><span class=\"mw-headline\" id=\"Special\">Special</span></h3>\n<p>The wearer of this item gains:\n\n</p>\n<ul><li><a href=\"/wiki/Constitution\" title=\"Constitution\">Constitution</a> <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp, /w/images/e/e7/Saving_Throw_Icon.png 1.5x\"><img alt=\"Saving Throw\" src=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/e7/Saving_Throw_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Saving_Throw\" class=\"mw-redirect\" title=\"Saving Throw\">Saving Throws</a> +1</li></ul>\n<dl><dt><a href=\"/wiki/Magical_Durability_(%2B2)\" title=\"Magical Durability (+2)\">Magical Durability</a></dt><dd>The wielder has a +2 bonus to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp, /w/images/e/e7/Saving_Throw_Icon.png 1.5x\"><img alt=\"Saving throw\" src=\"/w/images/thumb/e/e7/Saving_Throw_Icon.png/25px-Saving_Throw_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/e/e7/Saving_Throw_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Saving_throw\" class=\"mw-redirect\" title=\"Saving throw\">Saving throws</a> against spells.</dd></dl>\n<div style=\"clear: both;\"></div></div>    \n<h2><span class=\"mw-headline\" id=\"Where_to_find\"> Where to find </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li><a href=\"/wiki/Last_Light_Inn\" title=\"Last Light Inn\">Last Light Inn</a> <span class=\"bg3wiki-coordinates\">X:&nbsp;-33&nbsp;Y:&nbsp;164</span>: Crafted by <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Dammon\" title=\"Dammon\"><picture><source srcset=\"/w/images/thumb/b/b0/Portrait_Dammon.png/25px-Portrait_Dammon.png.webp, /w/images/thumb/b/b0/Portrait_Dammon.png/38px-Portrait_Dammon.png.webp 1.5x, /w/images/thumb/b/b0/Portrait_Dammon.png/50px-Portrait_Dammon.png.webp 2x\"><img alt=\"Dammon\" src=\"/w/images/thumb/b/b0/Portrait_Dammon.png/25px-Portrait_Dammon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b0/Portrait_Dammon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dammon\" title=\"Dammon\">Dammon</a></li></ul>\n</div> \n<h2><span class=\"mw-headline\" id=\"Notes\"> Notes </span></h2>\n<div class=\"bg3wiki-tooltip-box\">\n<ul><li>The party must give <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon bg3wiki-round-image\" typeof=\"mw:File\"><a href=\"/wiki/Dammon\" title=\"Dammon\"><picture><source srcset=\"/w/images/thumb/b/b0/Portrait_Dammon.png/25px-Portrait_Dammon.png.webp, /w/images/thumb/b/b0/Portrait_Dammon.png/38px-Portrait_Dammon.png.webp 1.5x, /w/images/thumb/b/b0/Portrait_Dammon.png/50px-Portrait_Dammon.png.webp 2x\"><img alt=\"Dammon\" src=\"/w/images/thumb/b/b0/Portrait_Dammon.png/25px-Portrait_Dammon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/b/b0/Portrait_Dammon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Dammon\" title=\"Dammon\">Dammon</a> two pieces of <span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-common\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Infernal_Iron\" title=\"Infernal Iron\"><picture><source srcset=\"/w/images/thumb/7/75/Infernal_Alloy_Unfaded_Icon.png/20px-Infernal_Alloy_Unfaded_Icon.png.webp, /w/images/thumb/7/75/Infernal_Alloy_Unfaded_Icon.png/30px-Infernal_Alloy_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/7/75/Infernal_Alloy_Unfaded_Icon.png/40px-Infernal_Alloy_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/7/75/Infernal_Alloy_Unfaded_Icon.png/20px-Infernal_Alloy_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/7/75/Infernal_Alloy_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> <a href=\"/wiki/Infernal_Iron\" title=\"Infernal Iron\">Infernal Iron</a>. Upon obtaining the second piece, he crafts this item.</li>\n<li>Asking Dammon to create <span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-rare\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Flawed_Helldusk_Armour\" title=\"Flawed Helldusk Armour\"><picture><source srcset=\"/w/images/thumb/2/24/Flawed_Helldusk_Armour_Unfaded_Icon.png/20px-Flawed_Helldusk_Armour_Unfaded_Icon.png.webp, /w/images/thumb/2/24/Flawed_Helldusk_Armour_Unfaded_Icon.png/30px-Flawed_Helldusk_Armour_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/2/24/Flawed_Helldusk_Armour_Unfaded_Icon.png/40px-Flawed_Helldusk_Armour_Unfaded_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/2/24/Flawed_Helldusk_Armour_Unfaded_Icon.png/20px-Flawed_Helldusk_Armour_Unfaded_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/24/Flawed_Helldusk_Armour_Unfaded_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span></span> <a href=\"/wiki/Flawed_Helldusk_Armour\" title=\"Flawed Helldusk Armour\">Flawed Helldusk Armour</a>, the <span class=\"nowrap bg3wiki-icontext-icon\"><span class=\"bg3wiki-itemicon bg3wiki-itemicon-rare\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Flawed_Helldusk_Helmet\" title=\"Flawed Helldusk Helmet\"><picture><source srcset=\"/w/images/thumb/4/45/Flawed_Helldusk_Helmet_Unfaded_Icon.png/20px-Flawed_Helldusk_Helmet_Unfaded_Icon.png.webp, /w/images/thumb/4/45/Flawed_Helldusk_Helmet_Unfaded_Icon.png/30px-Flawed_Helldusk_Helmet_Unfaded_Icon.png.webp 1.5x, /w/images/thumb/4/45/Flaw