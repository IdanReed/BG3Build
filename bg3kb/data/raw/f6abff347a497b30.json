ition_Icon.webp, /w/images/thumb/f/f3/Turned_Condition_Icon.webp/38px-Turned_Condition_Icon.webp 1.5x, /w/images/thumb/f/f3/Turned_Condition_Icon.webp/50px-Turned_Condition_Icon.webp 2x\"><img alt=\"Turned\" src=\"/w/images/thumb/f/f3/Turned_Condition_Icon.webp/25px-Turned_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f3/Turned_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Turned_(Condition)\" title=\"Turned (Condition)\">Turned</a>.</li></ul>\n</div>\n </div>\n</div><h2><span class=\"mw-headline\" id=\"Condition:_Possessing\"> Condition: Possessing </span></h2>\n<div class=\"bg3wiki-tooltip-box bg3wiki-tooltip-gradient-common\">\n<div class=\"bg3wiki-condition\"><strong><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Possessing_(Condition)\" title=\"Possessing (Condition)\"><picture><source srcset=\"/w/images/thumb/3/3c/Invisible_Weapon_Condition_Icon.webp/30px-Invisible_Weapon_Condition_Icon.webp, /w/images/thumb/3/3c/Invisible_Weapon_Condition_Icon.webp/45px-Invisible_Weapon_Condition_Icon.webp 1.5x, /w/images/thumb/3/3c/Invisible_Weapon_Condition_Icon.webp/60px-Invisible_Weapon_Condition_Icon.webp 2x\"><img alt=\"Possessing\" src=\"/w/images/thumb/3/3c/Invisible_Weapon_Condition_Icon.webp/30px-Invisible_Weapon_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/3c/Invisible_Weapon_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Possessing_(Condition)\" title=\"Possessing (Condition)\">Possessing</a></strong><p><span class=\"bg3wiki-icon bg3wiki-lightmode-drop-shadow\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/6/6a/Duration_Icons.png