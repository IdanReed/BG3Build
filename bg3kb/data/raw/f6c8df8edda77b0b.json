d_Condition_Icon.webp 1.5x, /w/images/thumb/0/09/Paralysed_Condition_Icon.webp/50px-Paralysed_Condition_Icon.webp 2x\"><img alt=\"Paralysed\" src=\"/w/images/thumb/0/09/Paralysed_Condition_Icon.webp/25px-Paralysed_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/09/Paralysed_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Paralysed_(Condition)\" title=\"Paralysed (Condition)\">Paralysed</a> or <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Restrained_(Condition)\" title=\"Restrained (Condition)\"><picture><source srcset=\"/w/images/thumb/2/20/Restrained_Condition_Icon.webp/25px-Restrained_Condition_Icon.webp, /w/images/thumb/2/20/Restrained_Condition_Icon.webp/38px-Restrained_Condition_Icon.webp 1.5x, /w/images/thumb/2/20/Restrained_Condition_Icon.webp/50px-Restrained_Condition_Icon.webp 2x\"><img alt=\"Restrained\" src=\"/w/images/thumb/2/20/Restrained_Condition_Icon.webp/25px-Restrained_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/2/20/Restrained_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Restrained_(Condition)\" title=\"Restrained (Condition)\">Restrained</a>. </li></ul>\n<p><span class=\"bg3wiki-condition-type\"></span>\n</p>\n<h2><span class=\"mw-headline\" id=\"Properties\">Properties</span></h2>\n<div class=\"noexcerpt navigation-not-searchable\">\n<p><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Stack_ID\" title=\"Stack ID\"><picture><source srcset=\"/w/images/thumb/b/b2/Info_Icon.png/25px-Info_Icon.png.webp, /w/images/b/b2/Info_Icon.png 1.5x\"><img alt=