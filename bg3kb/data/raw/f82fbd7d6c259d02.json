te.dev/search?q=name:CONS_Potion_Lightning_Resistance\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:CONS_Potion_Lightning_Resistance\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>UUID</summary>\n<code class=\"bg3wiki-uid-box\">05257244-ab59-4eab-9745-d1fea7b8cd10</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=uuid:05257244-ab59-4eab-9745-d1fea7b8cd10\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=uuid:05257244-ab59-4eab-9745-d1fea7b8cd10\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span> <details class=\"bg3wiki-uid\">\n<summary>Stats</summary>\n<code class=\"bg3wiki-uid-box\">OBJ_Potion_Of_Lightning_Resistance</code>\n</details> <span class=\"bg3wiki-uid-link\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"https://bg3.norbyte.dev/search?q=name:OBJ_Potion_Of_Lightning_Resistance+type:stat\" target=\"_blank\" rel=\"noreferrer noopener\"><img alt=\"https://bg3.norbyte.dev/search?q=name:OBJ_Potion_Of_Lightning_Resistance+type:stat\" src=\"/w/images/7/70/Search_icon.svg\" decoding=\"async\" width=\"14\" height=\"14\" class=\"mw-file-element\"></a></span></span></li></ul>\n</div>  \n<h3><span class=\"mw-headline\" id=\"Effect\"> Effect </span></h3>\n<p><span class=\"bg3wiki-info-blob\"> <span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp, /w/images/thumb/c/c9/Bonus_Action_Icon.png/35px-Bonus_Action_Icon.png.webp 1.5x, /w/images/thumb/c/c9/Bonus_Action_Icon.png/46px-Bonus_Action_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/c/c9/Bonus_Action_Icon.png/23px-Bonus_Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/c/c9/Bonus_Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Actions#Resources\" title=\"Actions\">Bonus Action</a> </span>\n</p>\n<ul><li>You gain <a href=\"/wiki/Damage_Types#Resistance\" class=\"mw-redirect\" title=\"Damage Types\">Resistance</a> to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lightning\" title=\"Lightning\"><picture><source srcset=\"/w/images/thumb/3/31/Lightning_Damage_Icon.png/20px-Lightning_Damage_Icon.png.webp, /w/images/thumb/3/31/Lightning_Damage_Icon.png/30px-Lightning_Damage_Icon.png.webp 1.5x, /w/images/thumb/3/31/Lightning_Damage_Icon.png/40px-Lightning_Damage_Icon.png.webp 2x\"><img alt=\"Lightning\" src=\"/w/images/thumb/3/31/Lightning_Damage_Icon.png/20px-Lightning_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/31/Lightning_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Lightning\" title=\"Lightning\"><span class=\"bg3wiki-damage-type-lightning\">Lightning</span></a> damage and can no longer be <a href=\"/wiki/Shocked_(Condition)\" title=\"Shocked (Condition)\">Shocked</a>, <a href=\"/wiki/Electrocuted_(Condition)\" title=\"Electrocuted (Condition)\">Electrocuted</a>, <a href=\"/wiki/Jolted_(Condition)\" title=\"Jolted (Condition)\">Jolted</a>, or otherwise affected by lightning.</li></ul>\n<p><span class=\"bg3wiki-info-blob\"><span style=\"margin: -3px\"><span class=\"mw-default-size bg3wiki-icon nowrap\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp, /w/images/thumb/f/f2/Action_Icon.png/35px-Action_Icon.png.webp 1.5x, /w/images/thumb/f/f2/Action_Icon.png/46px-Action_Icon.png.webp 2x\"><img alt=\"\" src=\"/w/images/thumb/f/f2/Action_Icon.png/23px-Action_Icon.png.webp\" decoding=\"async\" width=\"23\" height=\"23\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/f/f2/Action_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Actions#Resources\" title=\"Actions\">Action</a></span>\n</p>\n<ul><li><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Throw\" title=\"Throw\"><picture><source srcset=\"/w/images/thumb/e/e3/Throw_Icon.webp/25px-Throw_Icon.webp, /w/images/thumb/e/e3/Throw_Icon.webp/38px-Throw_Icon.webp 1.5x, /w/images/thumb/e/e3/Throw_Icon.webp/50px-Throw_Icon.webp 2x\"><img alt=\"Throw\" src=\"/w/images/thumb/e/e3/Throw_Icon.webp/25px-Throw_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/e3/Throw_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Throw\" title=\"Throw\">Throw</a> the potion to grant <a href=\"/wiki/Damage_Types#Resistance\" class=\"mw-redirect\" title=\"Damage Types\">Resistance</a> to <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Lightning\" title=\"Lightning\"><picture><source srcset=\"/w/images/thumb/3/31/Lightning_Damage_Icon.png/20px-Lightning_Damage_Icon.png.webp, /w/images/thumb/3/31/Lightning_Damage_Icon.png/30px-Lightning_Damage_Icon.png.webp 1.5x, /w/images/thumb/3/31/Lightning_Damage_Icon.png/40px-Lightning_Damage_Icon.png.webp 2x\"><img alt=\"Lightning\" src=\"/w/images/thumb/3/31/Lightning_Damage_Icon.png/20px-Lightning_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/31/Lightning_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Lightning\" title=\"Lightning\"><span class=\"bg3wiki-damage-type-lightning\">Lightning</span></a> damage for all creatures in a small radius. Affected creatures can no longer be <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Shocked_(Condition)\" title=\"Shocked (Condition)\"><picture><source srcset=\"/w/images/thumb/f/f3/Shocked_Condition_Icon.webp/25px-Shocked_Condition_Icon.webp, /w/images/thumb/f/f3/Shocked_Condition_Icon.webp/38px-Shocked_Condition_Icon.webp 1.5x, /w/images/thumb/f/f3/Shocked_Condition_Icon.webp/50px-Shocked_Condition_Icon.webp 2x\"><img alt=\"Shocked\" src=\"/w/images/thumb/f/f3/Shocked_Condition_Icon.webp/25px-Shocked_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/f/f3/Shocked_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Shocked_(Condition)\" title=\"Shocked (Condition)\">Shocked</a>, <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Electrocuted_(Condition)\" title=\"Electrocuted (Condition)\"><picture><source srcset=\"/w/images/thumb/c/cd/Electrocuted_Condition_Icon.webp/26px-Electrocuted_Condition_Icon.webp, /w/images/thumb/c/cd/Electrocuted_Condition_Icon.webp/39px-Electrocuted_Condition_Icon.webp 1.5x, /w/images/thumb/c/cd/Electrocuted_Condition_Icon.webp/52px-Electrocuted_Condition_Icon.webp 2x\"><img alt=\"Electrocuted\" src=\"/w/images/thumb/c/cd/Electrocuted_Condition_Icon.webp/26px-Electrocuted_Condition_Icon.webp\" decoding=\"async\" width=\"26\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/cd/Electrocuted_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Electrocuted_(Condition)\" title=\"Electrocuted (Condition)\">Electrocuted</a>, <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Jolted_(Condition)\" title=\"Jolted (Condition)\"><picture><source srcset=\"/w/images/thumb/c/c5/Jolted_Condition_Icon.webp/25px-Jolted_Condition_Icon.webp, /w/images/thumb/c/c5/Jolted_Condition_Icon.webp/38px-Jolted_Condition_Icon.webp 1.5x, /w/images/thumb/c/c5/Jolted_Condition_Icon.webp/50px-Jolted_Condition_Icon.webp 2x\"><img alt=\"Jolted\" src=\"/w/images/thumb/c/c5/Jolted_Condition_Icon.webp/25px-Jolted_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/c/c5/Jolted_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Jolted_(Condition)\" title=\"Jolted (Condition)\">Jolted</a>, or otherwise affected by lightning <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><span><picture><source srcset=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp, /w/images/thumb/d/d0/Aoe_Icon.png/38px-Aoe_Icon.png.webp 1.5x, /w/images/d/d0/Aoe_Icon.png 2x\"><img alt=\"AoE: 1 m (3 ft) Radius\" src=\"/w/images/thumb/d/d0/Aoe_Icon.png/25px-Aoe_Icon.png.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></span><a href=\"/w/images/d/d0/Aoe_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> AoE: 1 m (3 ft) Radius.</li></ul>\n<div style=\"clear: both;\"></div></div>\n<h2><span class=\"mw-headline\" id=\"Condition:_Lightning_Resistance\"> Condition: Lightning Resistan