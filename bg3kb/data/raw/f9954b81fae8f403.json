ite_Melee_Icon.webp/60px-Branding_Smite_Melee_Icon.webp 2x\"><img alt=\"Branding Smite (Melee)\" src=\"/w/images/thumb/5/5e/Branding_Smite_Melee_Icon.webp/30px-Branding_Smite_Melee_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/5/5e/Branding_Smite_Melee_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Branding_Smite_(Melee)\" title=\"Branding Smite (Melee)\">Branding Smite (Melee)</a></span></li>\n<li><span class=\"bg3wiki-icontext-block\" style=\"gap: 5px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Branding_Smite_(Ranged)\" title=\"Branding Smite (Ranged)\"><picture><source srcset=\"/w/images/thumb/e/ed/Branding_Smite_Ranged_Icon.webp/30px-Branding_Smite_Ranged_Icon.webp, /w/images/thumb/e/ed/Branding_Smite_Ranged_Icon.webp/45px-Branding_Smite_Ranged_Icon.webp 1.5x, /w/images/thumb/e/ed/Branding_Smite_Ranged_Icon.webp/60px-Branding_Smite_Ranged_Icon.webp 2x\"><img alt=\"Branding Smite (Ranged)\" src=\"/w/images/thumb/e/ed/Branding_Smite_Ranged_Icon.webp/30px-Branding_Smite_Ranged_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/e/ed/Branding_Smite_Ranged_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Branding_Smite_(Ranged)\" title=\"Branding Smite (Ranged)\">Branding Smite (Ranged)</a></span></li>\n</ul></div>\n<h2><span class=\"mw-headline\" id=\"Conditions_with_the_same_stack_ID\"> Conditions with the same stack ID </span></h2>\nConditions with the <a href=\"/wiki/Stack_ID\" class=\"mw-redirect\" title=\"Stack ID\">stack ID</a> <code>BRANDING_SMITE</code>, only one of these can be applied at the same time:<table class=\"wikitable sortable\" style=\"width:100%;\">\n<tbody><tr>\n  <th>Condition</th>\n  <th>Effects</th>\n</tr>\n<tr id=\"Branding_Smite\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Branding_Smite_(Condition)\" title=\"Branding Smite (Condition)\"><picture><source srcset=\"/w/images/thumb/3/3e/Branding_Smite_Condition_Icon.webp/30px-Branding_Smite_Condition_Icon.webp, /w/images/thumb/3/3e/Branding_Smite_Condition_Icon.webp/45px-Branding_Smite_Condition_Icon.webp 1.5x, /w/images/thumb/3/3e/Branding_Smite_Condition_Icon.webp/60px-Branding_Smite_Condition_Icon.webp 2x\"><img alt=\"Branding Smite\" src=\"/w/images/thumb/3/3e/Branding_Smite_Condition_Icon.webp/30px-Branding_Smite_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/3e/Branding_Smite_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a class=\"mw-selflink selflink\">Branding Smite</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>Cannot turn <a href=\"/wiki/Condition#Invisible\" class=\"mw-redirect\" title=\"Condition\">Invisible</a>.</li></ul>\n</td>\n\n</tr>\n<tr id=\"Sacred_Flame\">\n\n<th scope=\"row\">\n<span class=\"bg3wiki-icontext-block\" style=\"gap: 4px\"><span class=\"bg3wiki-icontext-icon nowrap\" style=\"\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Sacred_Flame_(Condition)\" title=\"Sacred Flame (Condition)\"><picture><source srcset=\"/w/images/thumb/3/3e/Branding_Smite_Condition_Icon.webp/30px-Branding_Smite_Condition_Icon.webp, /w/images/thumb/3/3e/Branding_Smite_Condition_Icon.webp/45px-Branding_Smite_Condition_Icon.webp 1.5x, /w/images/thumb/3/3e/Branding_Smite_Condition_Icon.webp/60px-Branding_Smite_Condition_Icon.webp 2x\"><img alt=\"Sacred Flame\" src=\"/w/images/thumb/3/3e/Branding_Smite_Condition_Icon.webp/30px-Branding_Smite_Condition_Icon.webp\" decoding=\"async\" width=\"30\" height=\"30\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/3e/Branding_Smite_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span><a href=\"/wiki/Sacred_Flame_(Condition)\" title=\"Sacred Flame (Condition)\">Sacred Flame</a></span></th>\n<td style=\"vertical-align: middle;\">\n<ul><li>The affected entity sheds light in 1.5m radius. It cannot become <span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"mw-default-size bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Invisible_(Condition)\" title=\"Invisible (Condition)\"><picture><source srcset=\"/w/images/thumb/d/d7/Invisible_Condition_Icon.webp/25px-Invisible_Condition_Icon.webp, /w/images/thumb/d/d7/Invisible_Condition_Icon.webp/38px-Invisible_Condition_Icon.webp 1.5x, /w/images/thumb/d/d7/Invisible_Condition_Icon.webp/50px-Invisible_Condition_Icon.webp 2x\"><img alt=\"Invisible\" src=\"/w/images/thumb/d/d7/Invisible_Condition_Icon.webp/25px-Invisible_Condition_Icon.webp\" decoding=\"async\" width=\"25\" height=\"25\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/d/d7/Invisible_Condition_Icon.webp\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span> <a href=\"/wiki/Invisible_(Condition)\" title=\"Invisible (Condition)\">Invisible</a>. Enemies are more likely to target this character during the trial.</li></ul>\n</td>\n\n</tr>\n</tbody></table>\n<!-- \nNewPP limit report\nCached time: 20260714234356\nCache expiry: 86400\nReduced expiry: false\nComplications: [vary‐revision‐sha1, no‐toc]\nCPU time usage: 0.063 seconds\nReal time usage: 0.067 seconds\nPreprocessor visited node count: 2527/1000000\nPost‐expand include size: 38677/4194304 bytes\nTemplate argument size: 9188/4194304 bytes\nHighest expansion depth: 26/200\nExpensive parser function count: 0/750\nUnstrip recursion depth: 0/20\nUn