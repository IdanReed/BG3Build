 source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Bludgeoning\" title=\"Bludgeoning\"><span class=\"bg3wiki-damage-type-bludgeoning\">Bludgeoning</span></a></td><td>Vulnerable</td></tr><tr><td><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Piercing\" title=\"Piercing\"><picture><source srcset=\"/w/images/thumb/0/0b/Piercing_Damage_Icon.png/20px-Piercing_Damage_Icon.png.webp, /w/images/thumb/0/0b/Piercing_Damage_Icon.png/30px-Piercing_Damage_Icon.png.webp 1.5x, /w/images/thumb/0/0b/Piercing_Damage_Icon.png/40px-Piercing_Damage_Icon.png.webp 2x\"><img alt=\"Piercing\" src=\"/w/images/thumb/0/0b/Piercing_Damage_Icon.png/20px-Piercing_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/0/0b/Piercing_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Piercing\" title=\"Piercing\"><span class=\"bg3wiki-damage-type-piercing\">Piercing</span></a></td><td>Resistant</td></tr><tr><td><span class=\"bg3wiki-icontext-icon nowrap\"><span class=\"bg3wiki-icon\" typeof=\"mw:File\"><a href=\"/wiki/Necrotic\" title=\"Necrotic\"><picture><source srcset=\"/w/images/thumb/3/39/Necrotic_Damage_Icon.png/20px-Necrotic_Damage_Icon.png.webp, /w/images/thumb/3/39/Necrotic_Damage_Icon.png/30px-Necrotic_Damage_Icon.png.webp 1.5x, /w/images/thumb/3/39/Necrotic_Damage_Icon.png/40px-Necrotic_Damage_Icon.png.webp 2x\"><img alt=\"Necrotic\" src=\"/w/images/thumb/3/39/Necrotic_Damage_Icon.png/20px-Necrotic_Damage_Icon.png.webp\" decoding=\"async\" width=\"20\" height=\"20\" class=\"mw-file-element\"></picture></a><a href=\"/w/images/3/39/Necrotic_Damage_Icon.png\" class=\"mw-file-source\" title=\"View source image\"><!-- Image link for Crawlers --></a></span></span>⁠<a href=\"/wiki/Necrotic\" title=\"Necrotic\"><span class=\"bg3wiki-damage-type-ne